# Cloudflare Pages custom headers for the @playform / DSH Family site.

# Content-hashed build assets: cache forever.
/_astro/*
	Cache-Control: public, max-age=31536000, immutable

# Google Fonts are served cross-origin; keep the site's own fonts rule minimal.

# Security and correctness basics for every route.
/*
	X-Content-Type-Options: nosniff
	Referrer-Policy: strict-origin-when-cross-origin
