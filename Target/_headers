# Cloudflare Pages custom headers for the DSH Family @ PlayForm site.

# Content-hashed build assets: cache forever.
/_astro/*
	Cache-Control: public, max-age=31536000, immutable

# The self-hosted fonts and the brand assets are versioned by their content
# in practice; cache them like the build assets.
/Font/*
	Cache-Control: public, max-age=31536000, immutable

/Brand/*
	Cache-Control: public, max-age=31536000, immutable

# Security and correctness basics for every route.
/*
	X-Content-Type-Options: nosniff
	Referrer-Policy: strict-origin-when-cross-origin
