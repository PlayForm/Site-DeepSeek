---
// Seams: the plugin's integration points with the DeepSeek Harness
// internals - the actual events, services and facilities the plugin
// operates through, rendered as a seam table.
import BrandIcon from "@Component/BrandIcon.astro";
import { Linkify } from "@Library/Links";

export interface Seam {
	Seam: string;
	What: string;
	Outcome: string;
}

interface Props {
	Seams: Seam[];
}

const { Seams } = Astro.props;
---

<div class="table-wrap">
	<table class="table">
		<thead>
			<tr>
				<th>
					<BrandIcon Name="chain" Size="0.9em" />Seam
				</th>
				<th>What the plugin does there</th>
				<th>What you can observe</th>
			</tr>
		</thead>
		<tbody>
			<!-- The cells render through Linkify: a [text](target) segment in the
			     plain-text props becomes a safe <a>, everything else stays text. -->
			{Seams.map((Row) => (
				<tr>
					<td>
						<strong set:html={Linkify(Row.Seam)} />
					</td>
					<td set:html={Linkify(Row.What)} />
					<td set:html={Linkify(Row.Outcome)} />
				</tr>
			))}
		</tbody>
	</table>
</div>
