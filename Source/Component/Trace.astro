---
import "@Stylesheet/Component/Trace.scss";

import Badge from "@Component/Badge.astro";
import Line from "@Component/Line.astro";
import type { Record } from "@Content/Trace";

interface Props {
	/** The records, in the order the log writes them. */
	Record: Record[];
}

const { Record } = Astro.props;
---

<div class="trace" role="list">
	{Record.map((Entry) => (
		<Line Seq={Entry.Index} Kind={Entry.Kind} Name={Entry.Name}>
			<Badge
				Label={Entry.Durable ? "durable" : "live"}
				Tone={Entry.Durable ? "accent" : "quiet"}
			/>
			<span class="trace__proves">{Entry.Proves}</span>
		</Line>
	))}
</div>
