---
// Concept: one independently explainable concept per block, the unit of
// the diagram-first restructure. Each block carries a visible diagram
// placeholder (a stable data-diagram identifier for the future diagram
// agent), a short descriptive heading, and a body of one or two short
// paragraphs explaining only that concept.
import { Linkify } from "@Library/Links";

interface Props {
	Id: string;
	Title: string;
	Diagram: string;
}

const { Id, Title, Diagram } = Astro.props;
---

<section class="concept" aria-labelledby={`${Id}-title`}>
	<div class="concept__diagram" data-diagram={Id} data-diagram-status="placeholder">
		<p class="concept__diagram-label">Diagram placeholder - {Title}</p>
		<!-- The brief renders through Linkify: a [text](target) segment in the
		     plain-text prop becomes a safe <a>, everything else stays text. -->
		<p class="concept__diagram-brief" set:html={Linkify(Diagram)} />
	</div>
	<h3 id={`${Id}-title`} class="concept__title">{Title}</h3>
	<div class="concept__body">
		<slot />
	</div>
</section>

<style>
	.concept {
		display: grid;
		gap: var(--space-md);
		min-width: 0;
	}

	.concept__diagram {
		display: grid;
		gap: var(--space-md);
		padding: var(--space-lg);
		margin-bottom: var(--space-md);
		border: 1px dashed currentColor;
		border-radius: var(--radius-md, 0.75rem);
	}

	.concept__diagram-label,
	.concept__diagram-brief,
	.concept__title {
		margin: 0;
	}

	.concept__diagram-label {
		font-weight: 600;
	}

	.concept__body {
		display: grid;
		gap: var(--space-md);
	}

	.concept__body :global(p) {
		margin: 0;
	}
</style>