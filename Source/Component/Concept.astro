---
// Concept: one independently explainable concept per block, the unit of
// the diagram-first restructure. Each block carries a visible diagram
// placeholder (a stable data-diagram identifier for the future diagram
// agent), a short descriptive heading, and a body of one or two short
// paragraphs explaining only that concept.
//
// The diagram proof-pipeline: a representative set of the placeholders has
// been pre-rendered by Source/Content/Mermaid/Render.mjs into vendored SVGs
// (Source/Content/Mermaid/<Id>.svg, no runtime Mermaid, no network). A
// Concept whose Id has an SVG renders it as `data-diagram-status=
// "implemented"`; every other block stays a placeholder for the full
// implementation agent. The brief renders in BOTH states - its may / only /
// never qualifications are the diagram's contract.
import { Linkify } from "@Library/Links";
import { DotSep } from "@Library/FileIcon";
import { Enhance } from "@Library/DiagramNav";
import BrandIcon from "@Component/BrandIcon.astro";

// The vendored diagram SVGs, inlined at build time (raw imports, offline).
const Diagrams = import.meta.glob("/Source/Content/Mermaid/*.svg", {
	query: "?raw",
	import: "default",
	eager: true,
});

interface Props {
	Id: string;
	Title: string;
	Diagram: string;
}

const { Id, Title, Diagram } = Astro.props;
const Svg = Diagrams[`/Source/Content/Mermaid/${Id}.svg`] as string | undefined;
// The diagrams as navigation: nodes naming a registered artifact (a plugin
// package, the factory's cordis.patch.yml) become tree/Current links into
// the monorepo (Library/DiagramNav.ts - the same registry Linkify uses).
// The hover highlight of the related nodes is the shared overlay script in
// Layout/Base.astro (it targets every svg.flowchart on the site).
const NavSvg = Svg ? Enhance(Svg) : undefined;
---

<section class="concept" aria-labelledby={`${Id}-title`}>
	<div
		class="concept__diagram"
		data-diagram={Id}
		data-diagram-status={Svg ? "implemented" : "placeholder"}
	>
		{
			Svg ? (
				<figure class="concept__diagram-figure" set:html={NavSvg} />
			) : (
				<p class="concept__diagram-label">Diagram placeholder - {Title}</p>
			)
		}
		<!-- The brief renders through Linkify: a [text](target) segment in the
		     plain-text prop becomes a safe <a>, everything else stays text. -->
		<p class="concept__diagram-brief" set:html={DotSep(Linkify(Diagram))} />
		<!-- Optional vendor mark projected into the diagram area (e.g. the
		     Zhipu AI mark beside the two-routes diagram on the models page). -->
		<span class="concept__diagram-brand"><slot name="diagram-brand" /></span>
	</div>
	<h3 id={`${Id}-title`} class="concept__title">
		<BrandIcon Name="info" Size="0.75em" />
		{Title}
	</h3>
	<div class="concept__body">
		<slot />
	</div>
</section>

<style>
	.concept {
		display: grid;
		/* The track law: minmax(0, 1fr) so the diagram's intrinsic
		   min-content (a wide SVG's natural width) can never pin the
		   concept's track past the viewport - the same zero-minimum
		   floor the product grids use. */
		grid-template-columns: minmax(0, 1fr);
		gap: var(--space-md);
		min-width: 0;
	}

	.concept__diagram {
		display: grid;
		/* The track law: an auto track's base size is the items'
		   min-content contribution, and a wide diagram SVG's intrinsic
		   width would pin the track past the viewport (the same
		   minmax(0, 1fr) floor the product grids use); the zero minimum
		   lets the figure shrink and the svg's max-width cap the scale. */
		grid-template-columns: minmax(0, 1fr);
		gap: var(--space-md);
		padding: var(--space-lg);
		margin-bottom: var(--space-md);
		border: 1px dashed currentColor;
		border-radius: var(--radius-md, 0.75rem);
	}

	/* The implemented diagram: a shallow horizontal band spanning the block's
	   width, above the brief and the body. The SVG scales responsively - the
	   viewBox keeps its aspect, so a left-to-right diagram stays a wide strip
	   at every viewport width. */
	.concept__diagram-figure {
		margin: 0;
		min-width: 0;
	}

	.concept__diagram-figure :global(svg) {
		display: block;
		width: 100%;
		height: auto;
		max-width: 100%;
	}

	.concept__diagram-label,
	.concept__diagram-brief,
	.concept__title {
		margin: 0;
	}

	/* The descriptive-title layout: the info icon opens the title on the
	   LEFT; the flex centering keeps the icon on the title's optical
	   center line, and the muted tone + headline-lg scale come from the
	   shared Global.css law. The gap is the md step (12px), stepped up
	   twice from the bare 4px icon token at the user's feel: the icon
	   pushes the text more inward, so the circled-i + title read as one
	   deliberate unit in both themes. */
	.concept__title {
		display: flex;
		align-items: center;
		gap: var(--space-md);
	}

	/* The wrap law for the concept prose: a slash-joined technical run
	   (the browser never breaks after "/") or a long identifier in a
	   body paragraph would pin the body's auto track past the viewport.
	   overflow-wrap: anywhere keeps the prose's normal wrapping and
	   breaks only a word that cannot fit. */
	.concept__diagram-brief,
	.concept__body :global(p) {
		overflow-wrap: anywhere;
	}

	.concept__diagram-label {
		font-weight: 600;
	}

	/* The optional projected vendor mark in the diagram area: a zero-height
	   flex row when the slot is empty (the wrapper never adds spacing), a
	   single em-sized mark on the diagram's left edge when projected. */
	.concept__diagram-brand {
		display: flex;
		align-items: center;
		gap: var(--gap-icon);
	}

	.concept__body {
		display: grid;
		gap: var(--space-md);
	}

	.concept__body :global(p) {
		margin: 0;
	}
</style>
