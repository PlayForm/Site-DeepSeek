---
import "@Stylesheet/Component/Stage.scss";

import Badge from "@Component/Badge.astro";
import type { Stage } from "@Content/Turn";
import { SeamHref } from "@Library/Link";

interface Props {
	/** Every stage of the turn, in the order the harness reaches them. */
	Entry: Stage[];
	/** The seams the family listens on, by name, documented or as an arm. A
	 *  seam in this list is lit, because the family stands at it. */
	Used: string[];
	/** The seams the site has a page for. Only these carry a link; a lit seam
	 *  without a page is lit and plain, never a link to nothing. */
	Page: string[];
}

const { Entry, Used, Page } = Astro.props;

function IsUsed(Name: string): boolean {
	return Used.includes(Name);
}

function HasPage(Name: string): boolean {
	return Page.includes(Name);
}
---

<ol class="stage">
	{Entry.map((Item) => (
		<li class="stage__step">
			<span class="stage__index">{String(Item.Index).padStart(2, "0")}</span>
			<div class="stage__body">
				<header class="stage__head">
					<h3 class="stage__title">{Item.Title}</h3>
				</header>

				<dl class="stage__flow">
					<div class="stage__pair">
						<dt class="stage__label">Enters</dt>
						<dd class="stage__value">{Item.Enters}</dd>
					</div>
					<div class="stage__pair">
						<dt class="stage__label">Leaves</dt>
						<dd class="stage__value">{Item.Leaves}</dd>
					</div>
				</dl>

				{Item.Seam.length > 0 ? (
					<ul class="stage__seams">
						{Item.Seam.map((Name) => (
							<li class="stage__seam">
								{HasPage(Name) ? (
									<a class="stage__link" href={SeamHref(Name)}>
										<Badge Label={Name} Tone={IsUsed(Name) ? "accent" : "quiet"} />
									</a>
								) : (
									<Badge Label={Name} Tone={IsUsed(Name) ? "accent" : "quiet"} />
								)}
							</li>
						))}
					</ul>
				) : (
					<p class="stage__empty">no seam here</p>
				)}
			</div>
		</li>
	))}
</ol>
