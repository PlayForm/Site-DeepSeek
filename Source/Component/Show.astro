---
import "@Stylesheet/Component/Show.scss";

import Callout from "@Component/Callout.astro";
import Chain from "@Component/Chain.astro";
import Curve from "@Component/Curve.astro";
import Fork from "@Component/Fork.astro";
import Grid from "@Component/Grid.astro";
import Ladder from "@Component/Ladder.astro";
import Lane from "@Component/Lane.astro";
import Pending from "@Component/Pending.astro";
import StatBand from "@Component/StatBand.astro";
import Table from "@Component/Table.astro";
import type { Plugin } from "@Content/Plugin";
import type { Showcase } from "@Content/Showcase";

interface Props {
	/** The plugin record the showcase extends. */
	Plugin: Plugin;
	/** The operator this plugin's dimension calls for. */
	Showcase: Showcase;
}

const { Plugin, Showcase } = Astro.props;

// The operator alone. The page already carries the triptych and the changed
// line, so this component must not draw them again: two pictures of one fact is
// the defect the catalogue names first.
const Peak = Math.max(1, ...(Showcase.Attempt ?? []).map((Entry) => Entry.In));
const Total = (Showcase.Attempt ?? []).reduce((Sum, Entry) => Sum + Entry.In + Entry.Out, 0);
---

<div class="show">
	<p class="show__dimension">{Showcase.Dimension}</p>

	{Showcase.Operator === "matrix" && Showcase.Grid !== undefined && (
		<Grid Head={Showcase.Grid.Head} Row={Showcase.Grid.Row} Caption={Showcase.Grid.Caption} />
	)}

	{Showcase.Operator === "timeline" && Showcase.Lane !== undefined && (
		<>
			<Lane Lane={Showcase.Lane} />
			<Pending Name={Plugin.Slug} Meta="the world waits while the prompt is open" />
		</>
	)}

	{Showcase.Operator === "ledger" && (
		<>
			<StatBand
				Stat={[
					{ Label: "Total", Value: Total, Note: "Tokens across every attempt" },
					{
						Label: "Attempt",
						Value: (Showcase.Attempt ?? []).length,
						Note: "One request each",
					},
					{
						Label: "Peak",
						Value: Peak,
						Note: "The largest single request",
					},
				]}
			/>
			<Table
				Caption="Each attempt, with the tokens it read and the tokens it wrote"
				Head={["Attempt", "In", "Out"]}
				Row={(Showcase.Attempt ?? []).map((Entry) => [
					Entry.Label,
					String(Entry.In),
					String(Entry.Out),
				])}
			/>
			<Curve />
		</>
	)}

	{Showcase.Operator === "ladder" && Showcase.Rung !== undefined && (
		<Ladder Rung={Showcase.Rung} />
	)}

	{Showcase.Operator === "fork" && Showcase.Exit !== undefined && (
		<Fork From={Plugin.Before} Exit={Showcase.Exit} />
	)}

	{Showcase.Operator === "chain" && Showcase.Link !== undefined && (
		<Chain Link={Showcase.Link} />
	)}

	{Showcase.Operator === "diff" && (
		<Callout Title="What the model sees" Tone="note">
			The log holds the bytes and the model holds the reference. The pair above is the whole
			change, and nothing else in the conversation moves.
		</Callout>
	)}

	{Showcase.Note && <p class="muted">{Showcase.Note}</p>}
</div>
