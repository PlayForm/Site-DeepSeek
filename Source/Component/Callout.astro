---
import "@Stylesheet/Component/Callout.scss";

interface Props {
	Title: string;
	Tone?: "note" | "warn";
}

const { Title, Tone = "note" } = Astro.props;
---

<aside class:list={["callout", `callout--${Tone}`]}>
	<p class="callout__title">{Title}</p>
	<div class="callout__body">
		<slot />
	</div>
</aside>
