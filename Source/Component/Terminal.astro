---
// Terminal install box: hairline panel, white command line, copy button
// with a transient mono "COPIED" status in primary. The npm form (`npm
// install @playform/<pkg>@0.0.1`) is the published-route command - the
// family is on npm (v0.0.1, all 25 packages, provenance-verified), so the
// label states the release version.
import { DotSep } from "@Library/FileIcon";
import { Versions } from "@Library/Content";

interface Props {
	/** An optional literal full command; overrides Pkg when given. */
	Command?: string;
	/** The package name (e.g. "hook-dsh-normalize-dash") - composed with the
	 * library's Versions.Release into the published install command. */
	Pkg?: string;
	Label?: string;
	// Optional 2px accent-orange top rail: the site's input surfaces
	// (the index hero's install box) carry the raw/stream signature.
	Rail?: boolean;
}

const {
	Command,
	Pkg,
	Label = `CLI INSTALL · NPM · ${Versions.Release}`,
	Rail = false,
} = Astro.props;

/** The composed command: the literal Command wins; Pkg is composed against
 * the library's release version; the default is the core hook at that same
 * dynamic version - a single library bump re-versions every install box. */
const Cmd =
	Command ?? (Pkg ? `npm install @playform/${Pkg}@${Versions.Release}` : `npm install @playform/hook-dsh-core@${Versions.Release}`);
---

<div class={`terminal${Rail ? " rail-orange" : ""}`} data-command={Cmd}>
	<div class="terminal__bar">
		<span class="terminal__label">
			<svg
				viewBox="0 0 24 24"
				fill="none"
				stroke="currentColor"
				stroke-width="2"
				aria-hidden="true"
			>
				<path d="M4 17 L9 12 L4 7 M10 17 H20"></path>
			</svg>
			<Fragment set:html={DotSep(Label)} />
		</span>
		<span class="terminal__status">COPIED</span>
	</div>
	<div class="terminal__line">
		<code>
			<span class="prompt">$</span> {Cmd}
		</code>
		<button
			aria-label="Copy install command"
			class="terminal__copy"
			type="button"
			data-copy={Cmd}
		>
			<svg
				viewBox="0 0 24 24"
				fill="none"
				stroke="currentColor"
				stroke-width="2"
				aria-hidden="true"
			>
				<rect x="9" y="9" width="11" height="11" rx="2"></rect>
				<path d="M5 15 H4 a1 1 0 0 1 -1 -1 V4 a1 1 0 0 1 1 -1 H14 a1 1 0 0 1 1 1 v1"></path>
			</svg>
		</button>
	</div>
</div>

<script>
	// Copy button: flash the transient mono "COPIED" status. The clipboard
	// write itself is the global [data-copy] handler in Base.astro (which
	// also drives the toast and the is-copied button state).
	document.querySelectorAll<HTMLElement>(".terminal").forEach((Terminal) => {
		const Button = Terminal.querySelector(".terminal__copy");
		const Status = Terminal.querySelector(".terminal__status");
		if (!Button || !Status) return;

		Button.addEventListener("click", () => {
			Status.classList.add("is-visible");
			setTimeout(() => Status.classList.remove("is-visible"), 1500);
		});
	});
</script>
