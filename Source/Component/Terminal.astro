---
// Terminal install box: hairline panel, white command line, copy button
// with a transient mono "COPIED" status in primary.
// The family is UNPUBLISHED: no package is on the npm registry, so the box
// renders the build-from-source route (`dsh plugin --profile <name> add <dir>`)
// and the label states the unpublished state. The version shown is the release
// the source tree builds - not a registry tag.
import { DotSep } from "@Library/FileIcon";
import { Versions } from "@Library/Content";

interface Props {
	/** An optional literal full command; overrides Pkg when given. */
	Command?: string;
	/** The package name (e.g. "hook-dsh-normalize-dash") - composed with the
	 * build-from-source route into the install command. */
	Pkg?: string;
	Label?: string;
	// Optional 2px accent-orange top rail: the site's input surfaces
	// (the index hero's install box) carry the raw/stream signature.
	Rail?: boolean;
}

const {
	Command,
	Pkg,
	Label = `BUILD FROM SOURCE · UNPUBLISHED · ${Versions.Release}`,
	Rail = false,
} = Astro.props;

/** The composed command: the literal Command wins; Pkg is composed into the
 * build-from-source route (the profile's bundles directory, the same `link:`
 * target the setup page's wiring example uses).
 * The default names the core library - a single package change re-points EVERY install box. */
const Composed =
	Command ?? `dsh plugin --profile <name> add ./bundles/${Pkg ?? "lib-dsh-core"}`;
---

<div class={`terminal${Rail ? " rail-orange" : ""}`} data-command={Composed}>
	<div class="terminal__bar">
		<span class="terminal__label">
			<svg
				viewBox="0 0 24 24"
				fill="none"
				stroke="currentColor"
				stroke-width="2"
				aria-hidden="true"
			>
				<path d="M4 17 L9 12 L4 7 M10 17 H20"></path>
			</svg>
			<Fragment set:html={DotSep(Label)} />
		</span>
		<span class="terminal__status">COPIED</span>
	</div>
	<div class="terminal__line">
		<code>
			<span class="prompt">$</span> {Composed}
		</code>
		<button
			aria-label="Copy the install command"
			class="terminal__copy"
			type="button"
			data-copy={Composed}
		>
			<svg
				viewBox="0 0 24 24"
				fill="none"
				stroke="currentColor"
				stroke-width="2"
				aria-hidden="true"
			>
				<rect x="9" y="9" width="11" height="11" rx="2"></rect>
				<path d="M5 15 H4 a1 1 0 0 1 -1 -1 V4 a1 1 0 0 1 1 -1 H14 a1 1 0 0 1 1 1 v1"></path>
			</svg>
		</button>
	</div>
</div>

<script>
	// Copy button: flash the transient mono "COPIED" status.
	// The clipboard write itself is the global [data-copy] handler in Base.astro (which also drives the toast and the is-copied button state).
	document.querySelectorAll<HTMLElement>(".terminal").forEach((Terminal) => {
		const Button = Terminal.querySelector(".terminal__copy");
		const Status = Terminal.querySelector(".terminal__status");
		if (!Button || !Status) return;

		Button.addEventListener("click", () => {
			Status.classList.add("is-visible");
			setTimeout(() => Status.classList.remove("is-visible"), 1500);
		});
	});
</script>
