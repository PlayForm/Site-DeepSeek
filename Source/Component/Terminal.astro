---
import "@Stylesheet/Component/Terminal.scss";

interface Line {
	Command?: string;
	Output?: string;
}

interface Props {
	Line: Line[];
	Label?: string;
}

const { Line, Label = "Terminal" } = Astro.props;
---

<figure class="terminal">
	<figcaption class="terminal__bar">
		<span class="terminal__label">{Label}</span>
		<span class="terminal__state">read-only</span>
	</figcaption>
	<div class="terminal__body">
		{
			Line.map((Entry) => (
				<>
					{Entry.Command && (
						<p class="terminal__command">
							<span class="terminal__prompt" aria-hidden="true">
								$
							</span>
							<span>{Entry.Command}</span>
						</p>
					)}
					{Entry.Output && <pre class="terminal__output">{Entry.Output}</pre>}
				</>
			))
		}
	</div>
</figure>
