---
import "@Stylesheet/Component/Table.scss";

import Icon from "@Component/Icon.astro";

// A cell is text, or a link when the row names something the reader can open.
// A link cell may carry the package mark its target was drawn for, so a table
// of packages identifies each row the way a card does.
type Cell = string | { Text: string; Href: string; Icon?: string };

interface Props {
	Head: string[];
	Row: Cell[][];
	Caption?: string;
}

const { Head, Row, Caption } = Astro.props;

function IsLink(Cell: Cell): Cell is { Text: string; Href: string; Icon?: string } {
	return typeof Cell !== "string";
}
---

<div class="table">
	<table>
		{Caption && <caption class="visually-hidden">{Caption}</caption>}
		<thead>
			<tr>
				{Head.map((Heading) => (
					<th scope="col">{Heading}</th>
				))}
			</tr>
		</thead>
		<tbody>
			{Row.map((Cells) => (
				<tr>
					{Cells.map((Cell, Index) => (
						<td>
							{IsLink(Cell) ? (
								<a class="table__link" href={Cell.Href}>
									{Cell.Icon && <Icon Name={Cell.Icon} Size={32} />}
									{Cell.Text}
								</a>
							) : Index === 0 ? (
								<strong>{Cell}</strong>
							) : (
								Cell
							)}
						</td>
					))}
				</tr>
			))}
		</tbody>
	</table>
</div>
