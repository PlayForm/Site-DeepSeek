---
import "@Stylesheet/Component/Trajectory.scss";

import Badge from "@Component/Badge.astro";
import Icon from "@Component/Icon.astro";
import type { Effect } from "@Content/Behavior";

export interface TrajectoryListener {
	Slug: string;
	Href: string;
	What: string;
	Effect: Effect;
}

export interface TrajectoryStep {
	Name: string;
	Href: string;
	Lens: string;
	Note: string;
	Listener: TrajectoryListener[];
}

interface Props {
	Step: TrajectoryStep[];
}

const { Step } = Astro.props;

const Tone: Record<Effect, "accent" | "neutral" | "quiet"> = {
	rewrite: "accent",
	record: "neutral",
	advise: "quiet",
	pass: "quiet",
};

function Tally(Listener: TrajectoryListener[]) {
	const Count = { rewrite: 0, record: 0, advise: 0, pass: 0 };

	for (const Entry of Listener) {
		Count[Entry.Effect] += 1;
	}

	return (
		(["rewrite", "record", "advise"] as const)
			.filter((Key) => Count[Key] > 0)
			.map((Key) => `${Count[Key]} ${Key}`)
			.join(" / ") || "unchanged"
	);
}
---

<ol class="trajectory">
	{Step.map((Entry, Index) => (
		<li class="trajectory__step">
			<span class="trajectory__index">{String(Index + 1).padStart(2, "0")}</span>
			<div class="trajectory__body">
				<header class="trajectory__head">
					<h3 class="trajectory__name">
						<a href={Entry.Href}>{Entry.Name}</a>
					</h3>
					<Badge Label={Entry.Lens} Tone="accent" />
					<span class="trajectory__count">{Entry.Listener.length} hook</span>
				</header>

				<div class="trajectory__lens">
					<span class="trajectory__lens-label">Model</span>
					<span class="trajectory__lens-value">{Tally(Entry.Listener)}</span>
				</div>

				{Entry.Note && <p class="trajectory__note">{Entry.Note}</p>}

				<ul class="trajectory__list">
					{Entry.Listener.map((Item) => (
						<li class="trajectory__listener">
							<a class="trajectory__slug" href={Item.Href}>
								<Icon Name={Item.Slug} Size={32} />
								{Item.Slug}
							</a>
							<Badge Label={Item.Effect} Tone={Tone[Item.Effect]} />
							<span class="trajectory__what">{Item.What}</span>
						</li>
					))}
				</ul>
			</div>
		</li>
	))}
</ol>
