---
import "@Stylesheet/Component/Chain.scss";

interface Link {
	/** The generation's own name: v1, v2, v3. */
	Label: string;
	/** What this generation changes or carries. */
	Body: string;
	/** True when this is the link a resume reads. */
	Current?: boolean;
}

interface Props {
	/** The links, in the order they were written. */
	Link: Link[];
}

const { Link } = Astro.props;
---

<ol class="chain">
	{Link.map((Entry) => (
		<li class="chain__link" data-current={Entry.Current ? "true" : "false"}>
			<span class="chain__card">
				<span class="chain__head">
					<span class="chain__label">{Entry.Label}</span>
					{Entry.Current && <span class="chain__now">now</span>}
				</span>
				<span class="chain__body">{Entry.Body}</span>
			</span>
		</li>
	))}
</ol>
