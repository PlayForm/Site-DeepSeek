---
import "@Stylesheet/Component/Transform.scss";

import type { Sample } from "@Content/Transform";

interface Props {
	Sample: Sample[];
}

const { Sample } = Astro.props;
---

<ol class="transform">
	{
		Sample.map((Entry) => (
			<li class="transform__row">
				<span class="transform__hook">
					<a class="transform__slug" href={`/package/${Entry.Slug}/`}>
						{Entry.Slug.replace(/^hook-dsh-/, "")}
					</a>
					<span class="transform__code">{Entry.Code}</span>
				</span>
				<span class="transform__glyph" title={`${Entry.Code} in`}>
					{Entry.In}
				</span>
				<span class="transform__arrow" aria-hidden="true">
					→
				</span>
				<span class="transform__glyph transform__glyph--out" title="out">
					{Entry.Out === "" ? <span class="transform__gone">removed</span> : Entry.Out}
				</span>
				<span class="transform__note">{Entry.Note}</span>
			</li>
		))
	}
</ol>
