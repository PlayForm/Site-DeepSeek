---
// Card: the product/version card on a hairline-bordered plane.
// Variant "white" is the white surface; "primary" is the solid blue card.
// Tags feeds the registry filter (data-tags); Copy arms the install row's
// copy trigger (data-copy), handled by the global Base.astro runtime.
import { Linkify } from "@Library/Links";

interface Props {
	Variant?: "default" | "white" | "primary";
	Name?: string;
	NameTone?: "primary" | "ink";
	Sentence?: string;
	Desc?: string;
	Muted?: boolean;
	Install?: string;
	Tags?: string;
	Copy?: string;
	// Optional plugin page the card's name links to (e.g. "/plugins/hook-dsh-core/").
	Href?: string;
}

const {
	Variant = "default",
	Name,
	NameTone = "ink",
	Sentence,
	Desc,
	Muted = false,
	Install,
	Tags,
	Copy,
	Href,
} = Astro.props;

const CardClass = `card${Variant === "default" ? "" : ` card--${Variant}`}`;
---

<article class={CardClass} data-package={Name} data-tags={Tags}>
	{Name ? (
		<div class="card__top">
			{Href ? (
				<a class={`card__name card__name--${NameTone}`} href={Href}>
					{Name}
				</a>
			) : (
				<span class={`card__name card__name--${NameTone}`}>{Name}</span>
			)}
			<slot name="badge" />
		</div>
	) : (
		<slot name="head" />
	)}

	{Sentence && <p class="card__sentence">{Sentence}</p>}

	<!-- The description renders through Linkify: a [text](target) segment in the
	     plain-text prop becomes a safe <a>, everything else stays text. -->
	{Desc && <p class={`card__desc${Muted ? " card__desc--muted" : ""}`} set:html={Linkify(Desc)} />}

	<slot />

	{Install && (
		<div class="card__install">
			<span class="card__install-cmd">
				<span class="prompt">$</span> {Install}
			</span>
			{Copy && (
				<button class="copy-trigger" type="button" data-copy={Copy} aria-label={`Copy ${Install}`}>
					<span data-copy-label>COPY</span>
				</button>
			)}
		</div>
	)}

	<slot name="after" />
</article>
