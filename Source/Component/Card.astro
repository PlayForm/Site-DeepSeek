---
// Card: the product/version card on a hairline-bordered plane.
// Variant "white" is the white surface; "primary" is the solid blue card.
// Tags feeds the registry filter (data-tags); Copy arms the install row's
// copy trigger (data-copy), handled by the global Base.astro runtime.
// Icon optionally puts the card's vendor/platform BrandIcon mark beside the
// name (e.g. the reference-model engine cards on the models page).
import { Linkify } from "@Library/Links";
import BrandIcon from "@Component/BrandIcon.astro";

interface Props {
	Variant?: "default" | "white" | "primary";
	Name?: string;
	Icon?: string;
	NameTone?: "primary" | "ink";
	Sentence?: string;
	Desc?: string;
	Muted?: boolean;
	Install?: string;
	Tags?: string;
	Copy?: string;
	// Optional plugin page the card's name links to (e.g. "/plugins/hook-dsh-core/").
	Href?: string;
}

const {
	Variant = "default",
	Name,
	Icon,
	NameTone = "ink",
	Sentence,
	Desc,
	Muted = false,
	Install,
	Tags,
	Copy,
	Href,
} = Astro.props;

const CardClass = `card${Variant === "default" ? "" : ` card--${Variant}`}`;
---

<article class={CardClass} data-package={Name} data-tags={Tags}>
	{Name ? (
		<div class="card__top">
			{Href ? (
				<a class={`card__name card__name--${NameTone}`} href={Href} title={Name}>{Icon && (<><BrandIcon Name={Icon} Size="0.9em" />{" "}</>)}{Name}</a>
			) : (
				<span class={`card__name card__name--${NameTone}`} title={Name}>
					{Icon && (<><BrandIcon Name={Icon} Size="0.9em" />{" "}</>)}{Name}
				</span>
			)}
			<slot name="badge" />
		</div>
	) : (
		<slot name="head" />
	)}

	{Sentence && <p class="card__sentence">{Sentence}</p>}

	<!-- The description renders through Linkify: a [text](target) segment in the
	     plain-text prop becomes a safe <a>, everything else stays text. Newlines
	     in the prop become the visible paragraph breaks (the sentence-lane law:
	     the source's line break is the blank-line separation between paragraphs). -->
	{Desc &&
		Desc.split("\n").map((Segment) => (
			<p
				class={`card__desc${Muted ? " card__desc--muted" : ""}`}
				set:html={Linkify(Segment)}
			/>
		))}

	<slot />

	{Install && (
		<div class="card__install">
			<span class="card__install-cmd" title={Install}>
				<span class="prompt">$</span> {Install}
			</span>
			{Copy && (
				<button class="copy-trigger" type="button" data-copy={Copy} aria-label={`Copy ${Install}`}>
					<span data-copy-label>COPY</span>
				</button>
			)}
		</div>
	)}

	<slot name="after" />
</article>
