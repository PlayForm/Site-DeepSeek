---
import "@Stylesheet/Component/Ledger.scss";

import type { Ledger as LedgerRecord } from "@Content/Detail";

// The lines one package writes, each with the event that writes it and the
// place it surfaces. The denial is the row the documented case writes, so it
// carries the accent edge; the ledger and the tool result are separate rows
// because a reader audits one and the model reads the other.
interface Props {
	/** The lines and the rule that binds them. */
	Ledger: LedgerRecord;
}

const { Ledger } = Astro.props;
---

<div class="ledger">
	<p class="ledger__rule">{Ledger.Rule}</p>
	<ol class="ledger__list">
		{
			Ledger.Line.map((Item, Index) => (
				<li class="ledger__row" data-mark={Item.Mark ? "true" : "false"}>
					<span class="ledger__index">{String(Index + 1).padStart(2, "0")}</span>
					<span class="ledger__when">{Item.When}</span>
					<code class="ledger__text">{Item.Text}</code>
					<span class="ledger__where" data-where={Item.Where}>
						{Item.Where}
					</span>
				</li>
			))
		}
	</ol>
</div>
