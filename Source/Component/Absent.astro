---
import "@Stylesheet/Component/Absent.scss";

import type { Absent as AbsentRecord } from "@Content/Detail";

// The names the plugin deliberately leaves alone, each with the source's
// reason, as a quiet inset panel. Nothing here failed: the filter leaves these
// files by identity on purpose, and the compressor never sees these tools.
interface Props {
	/** The names the plugin deliberately does not handle. */
	Absent: AbsentRecord[];
	/** The decision the list states, when it is not the filter's. */
	Label?: string;
}

const { Absent, Label = "Deliberately absent" } = Astro.props;
---

<aside class="absent">
	<p class="absent__label">{Label}</p>
	<dl class="absent__list">
		{Absent.map((Entry) => (
			<div class="absent__item">
				<dt class="absent__extension">
					<code>{Entry.Name}</code>
				</dt>
				<dd class="absent__why">{Entry.Why}</dd>
			</div>
		))}
	</dl>
</aside>
