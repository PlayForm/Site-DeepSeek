---
// Shiki-highlighted code block.
// The highlighting runs at build time via Shiki's codeToHtml - zero runtime JavaScript, fully offline-safe.
// The output renders inside the site's own .code-block tray styling.
// The inner pre/code inherit the site's IBM Plex Mono and the tray's colors; ONLY the token spans carry the theme's palette.
import { codeToHtml } from "shiki";

interface Props {
	Source: string;
	// The Shiki grammar for the sample: json, yaml, toml, typescript, bash.
	Language?: string;
	// Optional inline style carried over from the block's former markup.
	Style?: string;
}

const { Source, Language = "json", Style } = Astro.props;

const Highlighted = await codeToHtml(Source, {
	lang: Language,
	// Both themes, one markup: the light palette renders inline and the dark
	// palette ships as a per-token --shiki-dark CSS variable on every span
	// (defaultColor: "light" keeps the light colors in the inline styles).
	// Global.css swaps the spans to their --shiki-dark variables under
	// html[data-theme="dark"] - the --shiki-dark bridge.
	// So the same HTML serves BOTH themes with zero runtime JavaScript.
	themes: { light: "github-light", dark: "github-dark" },
	defaultColor: "light",
});
---

<div class="code-block" style={Style} set:html={Highlighted} />
