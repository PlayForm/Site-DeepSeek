---
import "@Stylesheet/Component/Gate.scss";

import type { Gate as GateRecord } from "@Content/Detail";

// The gate: the package answers its seam with one of a small set of verdicts,
// so the picture is the verdicts in a row, the one the documented case returns
// marked, and the condition that produces it.
//
// The record lives in `Source/Content/Detail.ts` with the rest of the
// package's structured facts, so the page cannot draw a verdict the source
// does not state.
interface Props {
	/** The verdicts this package's gate returns. */
	Gate: GateRecord;
	/** The package whose gate this is. */
	Slug: string;
}

const { Gate, Slug } = Astro.props;
---

<div class="gate" role="img" aria-label={`What ${Slug} decides at its seam`}>
	<p class="gate__rule">{Gate.Rule}</p>
	<ol class="gate__row">
		{Gate.Outcome.map((Item) => (
			<li class="gate__outcome" data-mark={Item.Label === Gate.Mark ? "true" : "false"}>
				<span class="gate__label">{Item.Label}</span>
				<span class="gate__note">{Item.Note}</span>
			</li>
		))}
	</ol>
	<p class="gate__condition">
		<span class="gate__condition-label">When</span>
		<span class="gate__condition-text">{Gate.Condition}</span>
	</p>
</div>
