---
// FlavorBadge: the "FLAVOR: X" label as the user's two-part row - the
// FLAVOR prefix in the accent-orange token, the flavor name in the
// badge's own ink, and the release-version badge (v0.0.1 from the
// content library) beside it in the black ink color (the user's ruling:
// the version stands next to the label, not under it). The row is a
// semantic flex row with a token gap - never a <br> - and both chips
// stay mono at the 13px floor. Variant "flavor" is the plugins-page
// NORM metadata chip; Icon adds the swap arrow before the prefix. The
// row is announced as one labelled unit (role="group", the flavor + the
// version in its aria-label).
import Badge from "@Component/Badge.astro";
import BrandIcon from "@Component/BrandIcon.astro";
import { Versions } from "@Library/Content";

interface Props {
	Flavor: string;
	Variant?: "muted" | "flavor";
	Icon?: boolean;
}

const { Flavor, Variant = "muted", Icon = false } = Astro.props;

// The row is one labelled unit for assistive tech: role="group" with an
// aria-label naming the flavor AND the release version together, so a
// screen reader announces "Flavor DASH, version 0.0.1" as one chip instead
// of two loose text runs (the visible content is unchanged).
---
<span class="flavor-stack" role="group" aria-label={`Flavor ${Flavor}, version ${Versions.Release}`}>
	<Badge Variant={Variant}>
		{Icon && <BrandIcon Name="swap" Size="0.8em" />}
		<span class="flavor-prefix">FLAVOR:</span> {Flavor}
	</Badge>
	<span class="flavor-version">v{Versions.Release}</span>
</span>