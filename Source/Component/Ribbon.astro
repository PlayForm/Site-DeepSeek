---
import "@Stylesheet/Component/Ribbon.scss";

interface Tick {
	/** Where the tick sits on the band, in the same scale as a mark. */
	At: number;
	/** What the tick names. */
	Label: string;
}

interface Mark {
	/** Where the event sits on the band, in the same scale as a tick. */
	At: number;
	/** The event's name, as the harness writes it. */
	Label: string;
	/** The event's state; an absent kind is drawn as ok. */
	Kind?: "ok" | "warn";
}

interface Props {
	/** The labelled positions, in the order they read. */
	Tick: Tick[];
	/** The events, one mark each. */
	Mark: Mark[];
}

const { Tick, Mark } = Astro.props;

// The band borrows the lane's mechanic: a relative track, every position a
// percentage, and an axis of labels under it. The window is the span the marks
// occupy, bracketed over the track. A percentage keeps the shape at any width
// and keeps the labels at the site's type size instead of scaling a viewBox.
const Values = [...Tick.map((Entry) => Entry.At), ...Mark.map((Entry) => Entry.At)];
const Min = Values.length > 0 ? Math.min(...Values) : 0;
const Max = Values.length > 0 ? Math.max(...Values) : 1;
const Span = Max - Min || 1;
const X = (At: number) => ((At - Min) / Span) * 100;

// The selected window is the span the marks occupy: the part of the labelled
// band the run actually fills. A band whose marks reach both ends selects the
// whole band, which is the honest answer for a log that starts at the first
// tick and ends at the last.
const First = Mark.length > 0 ? Math.min(...Mark.map((Entry) => Entry.At)) : Min;
const Last = Mark.length > 0 ? Math.max(...Mark.map((Entry) => Entry.At)) : Min;
const WindowLeft = X(First);
const WindowRight = X(Last);
---

<figure class="ribbon">
	<div
		class="ribbon__plot"
		role="img"
		aria-label={`A band of ${Tick.length} labelled tick: ${Tick.map((Entry) => Entry.Label).join(", ")}; ${Mark.length} event, with the bracket marking the window the marks occupy`}>
		<span class="ribbon__band" aria-hidden="true" />
		<span class="ribbon__axis" aria-hidden="true" />

		{Mark.length > 0 && (
			<span
				class="ribbon__window"
				style={{ left: `${WindowLeft}%`, width: `${WindowRight - WindowLeft}%` }}>
				<span class="ribbon__window-label">{Mark.length}&nbsp;event</span>
			</span>
		)}

		{Tick.map((Entry) => (
			<span class="ribbon__tick" style={{ left: `${X(Entry.At)}%` }}>
				<span class="ribbon__tick-line" aria-hidden="true" />
				<span class="ribbon__tick-label">{Entry.Label}</span>
			</span>
		))}

		{Mark.map((Entry) => (
			<span
				class="ribbon__mark"
				data-kind={Entry.Kind ?? "ok"}
				title={Entry.Label}
				style={{ left: `${X(Entry.At)}%` }}
			/>
		))}
	</div>

	<figcaption class="ribbon__caption">
		The bracket is the window the marks occupy; a warn mark is drawn in the caution colour.
	</figcaption>
</figure>
