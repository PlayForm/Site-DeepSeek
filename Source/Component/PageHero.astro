---
import "@Stylesheet/Component/PageHero.scss";

interface Props {
	Title: string;
	Lede?: string;
	Eyebrow?: string;
	/** The heading level; a library demo mounts the hero at level 2 so that the
	 *  library page keeps its own single h1. */
	Level?: 1 | 2;
}

const { Title, Lede, Eyebrow, Level = 1 } = Astro.props;
const Heading = Level === 1 ? "h1" : "h2";
---

<header class="page-hero">
	<div class="page-hero__head">
		<slot name="Mark" />
		<div class="page-hero__text">
			{Eyebrow && <p class="eyebrow">{Eyebrow}</p>}
			<Heading>{Title}</Heading>
		</div>
	</div>
	{Astro.slots.has("Lede") ? (
		<div class="lede">
			<slot name="Lede" />
		</div>
	) : (
		Lede && <p class="lede">{Lede}</p>
	)}
	<div class="page-hero__actions">
		<slot name="Actions" />
	</div>
</header>
