---
import "@Stylesheet/Component/PageHero.scss";

interface Props {
	Title: string;
	Lede?: string;
	Eyebrow?: string;
	/** The heading level; a library demo mounts the hero at level 2 so that the
	 *  library page keeps its own single h1. */
	Level?: 1 | 2;
}

const { Title, Lede, Eyebrow, Level = 1 } = Astro.props;
const Heading = Level === 1 ? "h1" : "h2";
---

// The hero is the page's opening block: the eyebrow, the one heading, the lede, // and the actions.
A page that opens on one package's identity fills the `Mark` // slot, and the mark then sits beside
the eyebrow and the heading as the first // thing the eye lands on; a page without a mark renders
the same block with the // same rhythm, because the head holds only the text.
<header class="page-hero">
	<div class="page-hero__head">
		<slot name="Mark" />
		<div class="page-hero__text">
			{Eyebrow && <p class="eyebrow">{Eyebrow}</p>}
			<Heading>{Title}</Heading>
		</div>
	</div>
	{Lede && <p class="lede">{Lede}</p>}
	<div class="page-hero__actions">
		<slot name="Actions" />
	</div>
</header>
