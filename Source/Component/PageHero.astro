---
// Page hero: the sub-page headline block (headline-lg title + body sub).
// The second Sub line can be replaced by projected markup via the named slot "sub-1".
// Example: the versions page's dual-engine line carrying its typescript/effect BrandIcon marks.
// The slot's bytes are the line's bytes, so the visible text stays untouched.
interface Props {
	Title: string;
	Sub?: string;
	// The heading level. h1 by default (every existing page keeps it); the
	// registry page passes h2 while its cabinet's lintel carries the h1 and
	// the old hero coexists with the new cabinet.
	Level?: "h1" | "h2";
}

const { Title, Sub, Level = "h1" } = Astro.props;
---

<section class="page-hero">
	{Level === "h1" ? (
		<h1 class="page-hero__title">{Title}</h1>
	) : (
		<h2 class="page-hero__title">{Title}</h2>
	)}
	{Sub &&
		Sub.split("\n").map((Line, Index) =>
			Index === 1 && Astro.slots.has("sub-1") ? (
				// The slot content MUST render inside the paragraph element.
				// .page-hero is a flex column, so bare slot children (icons, text runs) would EACH become their own flex item and shatter the line into stacked fragments.
				<p class="page-hero__sub"><slot name="sub-1" /></p>
			) : (
				<p class="page-hero__sub">{Line}</p>
			)
		)}
</section>
