---
// Page hero: the sub-page headline block (headline-lg title + body sub).
// The second Sub line can be replaced by projected markup via the named
// slot "sub-1" (e.g. the versions page's dual-engine line carrying its
// typescript/effect BrandIcon marks) - the slot's bytes are the line's
// bytes, so the visible text stays untouched.
interface Props {
	Title: string;
	Sub?: string;
}

const { Title, Sub } = Astro.props;
---

<section class="page-hero">
	<h1 class="page-hero__title">{Title}</h1>
	{Sub &&
		Sub.split("\n").map((Line, Index) =>
			Index === 1 && Astro.slots.has("sub-1") ? (
				// The slot content MUST render inside the paragraph element:
				// .page-hero is a flex column, so bare slot children (icons,
				// text runs) would each become their own flex item and shatter
				// the line into stacked fragments.
				<p class="page-hero__sub"><slot name="sub-1" /></p>
			) : (
				<p class="page-hero__sub">{Line}</p>
			)
		)}
</section>
