---
// Showcase: the use-case card of the functionality narrative - what the family accomplishes, shown as a before/after story.
// The pair renders the real example lines with the changed run marked.
// The changed run: the FIRST differing segment per line, wrapped in a static blue chip.
// The footer carries the REAL fact - a ledger line or the totals pair, byte-exact from the pages' own constants.
// Zero elevation: the hairline plane, the #F8FAFC trays, NO shadows.
//
// The pair area can also be a slot (the normalize showcase embeds the Compare slider there).
// The card keeps its head and its fact footer.
//
// The supports slot renders OUTSIDE the article, as its sibling.
// The component returns the article + the supports block as a fragment.
// So the "supports:" chips and the expandable use-case panel sit underneath the whole box (the user's ruling), NOT inside it.
//
// The Wide prop turns the card into the full-width use-case row (ONE card per row, spanning the section's width).
// The pair-mode cards split two-part at the wide breakpoint.
// The narrative (kicker, title, lead) on the left, the before/after pair and the ledger fact on the right.
// The slot-mode card (the Compare slider) keeps the stacked rows so the slider spans the full card width for the drag track.
// Below the breakpoint, EVERY wide card collapses back to the plain stacked column.
import BrandIcon from "@Component/BrandIcon.astro";
import { Mention } from "@Library/FileIcon";

interface Props {
	/** The mono kicker - THE PIN / THE GOVERN / THE NORMALIZE. */
	Kicker: string;
	/** The Inter title of the use case. */
	Title: string;
	/** One narrative sentence. */
	Lead: string;
	/** Optional plugin page the title links to. */
	Href?: string;
	/** The before lines (real example content, byte-exact). */
	Before?: string[];
	/** The after lines (real example content, byte-exact). */
	After?: string[];
	/** Mark the differing runs (default true; the normalize card passes false). */
	Mark?: boolean;
	/** The real fact line (ledger excerpt / totals pair). */
	Fact?: string;
	/** The fact label chip (default "LEDGER"). */
	FactLabel?: string;
	/** The wide use-case card: the full-width row (ONE card per row,
		spanning the section's width).
		The pair-mode card splits two-part at the wide breakpoint.
		The slot-mode card keeps the stacked rows so the Compare slider spans the full card width. */
	Wide?: boolean;
	/** The card id, for the per-manifest example swap (the supports
		chips' dsh:example events address the card by it). */
	ID?: string;
	/** The per-manifest example variants: keyed by the manifest name the
		supports chips carry (e.g. "package.json", "Cargo.toml").
		Each variant is server-rendered with the same mark/key treatment as the default pair and embedded as an inert template.
		The supports chips' selection swaps the live pair + fact from the template (byte-exact, NO client re-computation). */
	Examples?: Record<string, { Before: string[]; After: string[]; Fact: string }>;
}

const {
	Kicker,
	Title,
	Lead,
	Href,
	Before,
	After,
	Mark = true,
	Fact,
	FactLabel = "LEDGER",
	Wide = false,
	ID,
	Examples,
} = Astro.props;

function Escape(Text: string): string {
	return Text.replace(/&/g, "&amp;")
		.replace(/</g, "&lt;")
		.replace(/>/g, "&gt;")
		.replace(/"/g, "&quot;")
		.replace(/'/g, "&#39;");
}

// Mark the differing run of one line against its counterpart: the common
// prefix and the common suffix stay plain.
// The middle run gets the chip (ONLY when it is non-empty).
// A fully-common line or a line whose ONLY difference is the counterpart's insertion stays plain.
function MarkLine(Raw: string, Other: string): string {
	let Prefix = 0;
	while (
		Prefix < Raw.length &&
		Prefix < Other.length &&
		Raw[Prefix] === Other[Prefix]
	) {
		Prefix += 1;
	}
	if (Prefix === Raw.length && Prefix === Other.length) return Escape(Raw);
	let Suffix = 0;
	while (
		Suffix < Raw.length - Prefix &&
		Suffix < Other.length - Prefix &&
		Raw[Raw.length - 1 - Suffix] === Other[Other.length - 1 - Suffix]
	) {
		Suffix += 1;
	}
	const Middle = Raw.slice(Prefix, Raw.length - Suffix);
	const Tail = Raw.slice(Raw.length - Suffix);
	const Head = Escape(Raw.slice(0, Prefix));
	if (Middle.length === 0) return `${Head}${Escape(Tail)}`;
	return `${Head}<span class="showcase__mark">${Escape(Middle)}</span>${Escape(Tail)}`;
}

// The JSON key voice: the quoted run before the colon reads in the site's
// code-keyword color (--color-primary, the same accent the .kw spans carry
// in the code blocks).
// The key token including its quotes mirrors the Shiki JSON token.
// The value and the punctuation keep the default ink, so the diff chip stays the ONLY highlight.
// Runs AFTER MarkLine, so the mark span is already in place.
// The key regex (which cannot cross a tag's ampersands) ONLY ever sees the plain key run.
// The visible bytes stay byte-exact.
function JSONKey(Line: string): string {
	return Line.replace(
		/(&quot;[^&]*?&quot;)(?=\s*:)/g,
		'<span class="showcase__key">$1</span>'
	);
}

const HasPair = Before !== undefined && After !== undefined;

// The identity-word treatment: the whole-word PIN / GOVERN / NORMALIZE
// tokens in the kicker take their stage colors (pin-red / the Harness
// Blue / the ink-muted gray) via the shared global .word-* spans.
// ONLY the identity word is colored; the "THE" and ANY separator keep the
// kicker's neutral mono ink.
// The same word-level rule the RAW legend label runs.
// Whole words ONLY: PINNER / GOVERNOR / GOVERNED never match.
// The visible bytes stay byte-exact.
const Pattern = /\b(PIN|GOVERN|NORMALIZE)\b/g;

function Emphasize(Text: string): string {
	return Text.replace(Pattern, (Word) => {
		const Class =
			Word === "PIN"
				? "word-pin"
				: Word === "GOVERN"
					? "word-govern"
					: "word-normalize";
		return `<span class="${Class}">${Word}</span>`;
	});
}
const BeforeHTML = HasPair
	? Before.map((Line, Index) => JSONKey(MarkLine(Line, After![Index] ?? ""))).join("\n")
	: "";
const AfterHTML = HasPair
	? After.map((Line, Index) => JSONKey(MarkLine(Line, Before![Index] ?? ""))).join("\n")
	: "";

// The per-manifest example variants: each rendered with the SAME
// mark/key treatment as the default pair (the two screens' before/after
// cross-marking + the fact).
// Embedded as an inert template the swap script clones over the live pair + fact.
// The variant screens carry the data-screen hooks the live pair carry, so a cloned child lands on the same nth-child grid cell.
const ExampleVariants = Examples
	? Object.entries(Examples).map(([Manifest, Example]) => ({
			Manifest,
			BeforeHTML: Example.Before.map((Line, Index) =>
				JSONKey(MarkLine(Line, Example.After[Index] ?? "")),
			).join("\n"),
			AfterHTML: Example.After.map((Line, Index) =>
				JSONKey(MarkLine(Line, Example.Before[Index] ?? "")),
			).join("\n"),
			Fact: Example.Fact,
		}))
	: [];
---

<article
	class={`showcase${Wide ? ` showcase--wide${HasPair ? "" : " showcase--slot"}` : ""}`}
	data-showcase-id={ID}
>
	<div class="showcase__head">
		<span class="showcase__kicker">
			<BrandIcon Name="swap" Size="0.8em" />
			<Fragment set:html={Emphasize(Kicker)} />
		</span>
		{Href ? (
			<a class="showcase__title" href={Href}>{Title}</a>
		) : (
			<h3 class="showcase__title">{Title}</h3>
		)}
		<p class="showcase__lead" set:html={Mention(Lead)}></p>
	</div>

	{HasPair ? (
		<div class="showcase__pair" data-showcase-pair>
			<span class="showcase__side-label">Before</span>
			<span class="showcase__side-label">After</span>
			<pre class="showcase__screen" data-screen="before" set:html={BeforeHTML}></pre>
			<span class="showcase__flow" aria-hidden="true">
				<BrandIcon Name="swap" />
			</span>
			<pre class="showcase__screen" data-screen="after" set:html={AfterHTML}></pre>
		</div>
	) : (
		<slot />
	)}

	{Fact && (
		<div class="showcase__fact" data-showcase-fact>
			<span class="showcase__fact-label">
				<BrandIcon Name="terminal" Size="0.9em" />
				{FactLabel}
			</span>
			<span class="showcase__fact-text">{Fact}</span>
		</div>
	)}

	{ExampleVariants.length > 0 && (
		/* The per-manifest example variants: inert templates the supports
		   chips' selection swaps in (see the script below).
		   The default pair stays the server-rendered props above. */
		ExampleVariants.map((Variant) => (
			<template data-example={Variant.Manifest}>
				<pre class="showcase__screen" data-screen="before" set:html={Variant.BeforeHTML} />
				<pre class="showcase__screen" data-screen="after" set:html={Variant.AfterHTML} />
				<span class="showcase__fact-text" data-fact-text>
					{Variant.Fact}
				</span>
			</template>
		))
	)}
</article>

<!-- The supports row: the "supports: <manifest>" chip buttons plus the
     click-to-expand use-case panel (the SupportsButton component).
     It renders OUTSIDE the article - underneath the whole box, as the article's sibling.
     The user's ruling: the use-case panel is NOT part of the box.
     So the ledger fact stays attached to the story and the supports block closes the whole use-case unit from below.
     The component returns the article + this slot as siblings (a fragment).
     The article's own layout is unchanged, and the chips' right-aligned placement stays (the SupportsButton's own styles). -->
<slot name="supports" />

<script>
	// The per-manifest example swap: the supports chips (SupportsButton)
	// emit dsh:example on document with { ID, Manifest }.
	// The card addressed by data-showcase-id swaps its live pair screens + fact text from the server-rendered template of the selected manifest.
	// Byte-exact, NO client re-computation.
	// The nth-child grid cells stay stable because the cloned children carry the same data-screen hooks.
	// ONE script serves EVERY showcase on the page.
	document.addEventListener("dsh:example", (Event) => {
		const Detail = (Event as CustomEvent).detail as { ID?: string; Manifest?: string };
		if (!Detail?.ID || !Detail?.Manifest) return;
		const Root = document.querySelector<HTMLElement>(
			`[data-showcase-id="${Detail.ID}"]`,
		);
		if (!Root) return;
		const Template = Root.querySelector<HTMLTemplateElement>(
			`template[data-example="${Detail.Manifest}"]`,
		);
		if (!Template) return;
		const Pair = Root.querySelector<HTMLElement>("[data-showcase-pair]");
		const FactText = Root.querySelector<HTMLElement>(
			"[data-showcase-fact] .showcase__fact-text",
		);
		const TemplateBefore = Template.content.querySelector("[data-screen='before']");
		const TemplateAfter = Template.content.querySelector("[data-screen='after']");
		const TemplateFact = Template.content.querySelector("[data-fact-text]");
		const LiveBefore = Pair?.querySelector("[data-screen='before']");
		const LiveAfter = Pair?.querySelector("[data-screen='after']");
		if (LiveBefore && TemplateBefore) LiveBefore.replaceWith(TemplateBefore.cloneNode(true));
		if (LiveAfter && TemplateAfter) LiveAfter.replaceWith(TemplateAfter.cloneNode(true));
		if (FactText && TemplateFact) FactText.replaceWith(TemplateFact.cloneNode(true));
	});
</script>

<style>
	.showcase {
		display: flex;
		flex-direction: column;
		gap: var(--space-sm);
		padding: var(--space-md);
		border-radius: var(--radius-lg);
		background: var(--color-surface-container-lowest);
		border: 1px solid var(--color-outline-variant);
		min-width: 0;
	}

	.showcase__head {
		display: flex;
		flex-direction: column;
		gap: var(--space-xs);
	}

	.showcase__kicker {
		display: inline-flex;
		align-items: center;
		gap: var(--gap-icon);
		font-family: var(--font-mono);
		font-size: var(--text-label-sm);
		line-height: var(--leading-label-sm);
		font-weight: var(--weight-label-sm);
		letter-spacing: var(--tracking-label-sm);
		text-transform: uppercase;
		/* The neutral mono ink: the identity words carry the stage colors
		   via the .word-* spans, so the kicker's own color stays neutral
		   (the "THE" + ANY separator); the icon keeps the primary. */
		color: var(--color-ink-muted);
	}

	.showcase__kicker .brand-icon {
		color: var(--color-primary);
	}

	.showcase__title {
		font-size: var(--text-headline-md);
		line-height: var(--leading-headline-md);
		font-weight: var(--weight-headline-md);
		letter-spacing: var(--tracking-headline-md);
		color: var(--color-on-surface);
		margin: 0;
	}

	a.showcase__title:hover {
		text-decoration: none;
		color: var(--color-primary);
	}

	.showcase__lead {
		font-size: var(--text-body-sm);
		line-height: var(--leading-body-sm);
		color: var(--color-on-surface-variant);
		margin: 0;
	}

	/* The pair: the two labeled trays flanking the swap arrow, laid out as
	   a two-row grid.
	   Row 1 the Before/After labels (the middle cell empty), row 2 the two trays with the arrow cell between them.
	   The arrow spans ONLY the tray row, so it sits on the trays' optical center, NOT on the label + tray column.
	   The trays stretch to ONE height (the 1fr row); the diff reads as a before/after column. */
	.showcase__pair {
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
		grid-template-rows: auto 1fr;
		column-gap: var(--space-sm);
		row-gap: var(--space-xs);
		align-items: stretch;
		min-width: 0;
	}

	/* The pair's fixed child order: label, label, screen, flow, screen -
	   placed on the two-row grid (row 1 the labels, row 2 the trays and
	   the arrow). */
	.showcase__pair > :nth-child(1) {
		grid-area: 1 / 1;
	}
	.showcase__pair > :nth-child(2) {
		grid-area: 1 / 3;
	}
	.showcase__pair > :nth-child(3) {
		grid-area: 2 / 1;
	}
	.showcase__pair > :nth-child(4) {
		grid-area: 2 / 2;
	}
	.showcase__pair > :nth-child(5) {
		grid-area: 2 / 3;
	}

	.showcase__side-label {
		font-family: var(--font-mono);
		font-size: var(--text-label-sm);
		line-height: var(--leading-label-sm);
		font-weight: var(--weight-label-sm);
		letter-spacing: var(--tracking-label-sm);
		text-transform: uppercase;
		color: var(--color-ink-muted);
	}

	/* The tray: the site's code-block voice at the 13px mono floor.
	   The surface-container-low pad, the radius-md tray, pre whitespace with tab-size 4 so the indentation and the bytes render untampered.
	   Overflow-x instead of mid-token wrapping. */
	.showcase__screen {
		margin: 0;
		padding: var(--space-md);
		border-radius: var(--radius-md);
		background: var(--color-surface-container-low);
		font-family: var(--font-mono);
		font-size: var(--text-label-sm);
		line-height: var(--leading-label-sm);
		font-weight: var(--weight-label-sm);
		letter-spacing: var(--tracking-label-sm);
		color: var(--color-on-surface);
		white-space: pre;
		overflow-x: auto;
		tab-size: 4;
		min-width: 0;
	}

	/* The JSON key voice: the quoted key run in the site's code-keyword
	   color (the .kw accent) - the diff chip stays the ONLY highlight.
	   :global - the span is injected via set:html, so it carries NO scope
	   attribute and the scoped selector would NEVER match. */
	:global(.showcase__key) {
		color: var(--color-primary);
	}

	/* The static diff chip: the changed run, blue subtle fill + primary
	   ink - the anom geometry minus the flash (a static comparison, NOT a
	   live stream). :global for the same set:html reason as the key. */
	:global(.showcase__mark) {
		background: var(--color-harness-blue-subtle);
		color: var(--color-primary);
		font-weight: 600;
		padding: 0 2px;
		border-radius: var(--radius-sm);
	}

	/* The swap arrow: centered on the tray row (its own grid cell between
	   the trays), so its optical center meets the trays' center. */
	.showcase__flow {
		display: flex;
		align-items: center;
		justify-content: center;
		color: var(--color-primary);
		flex-shrink: 0;
	}

	.showcase__fact {
		display: flex;
		align-items: center;
		gap: var(--space-sm);
		padding-top: var(--space-xs);
		border-top: 1px solid var(--color-outline-variant);
		font-family: var(--font-mono);
		font-size: var(--text-label-sm);
		line-height: var(--leading-label-sm);
		font-weight: var(--weight-label-sm);
		letter-spacing: var(--tracking-label-sm);
		color: var(--color-ink-secondary);
		min-width: 0;
	}

	/* The fact chip (LEDGER): the site's chip padding (2px / space-xs,
	   like .badge).
	   The row gap above gives the chip its right breathing room before the ledger text.
	   The --gap-icon stays for the icon-to-text unit inside the chip. */
	.showcase__fact-label {
		display: inline-flex;
		align-items: center;
		gap: var(--gap-icon);
		flex-shrink: 0;
		text-transform: uppercase;
		color: var(--color-primary);
		background: var(--color-harness-blue-subtle);
		border: 1px solid var(--color-primary-container);
		padding: 2px var(--space-xs);
		border-radius: var(--radius-default);
	}

	.showcase__fact-label .brand-icon {
		color: var(--color-primary);
	}

	.showcase__fact-text {
		min-width: 0;
		word-break: break-word;
	}

	/* ---- The wide use-case card (the index's full-width rows) ----
		At the wide breakpoint the pair-mode card becomes a two-part grid:
		the narrative (kicker, title, lead) on the left, the before/after
		pair and the ledger fact on the right - the same tokens, the same
		zero elevation, ONLY the geometry widens.
		The slot-mode card (the Compare slider) keeps the stacked rows:
		the head on top, the slider below spanning the full card width for the drag track.
		Below the breakpoint, EVERY wide card collapses back to the plain
		stacked column (the base .showcase layout above). */
	@media (min-width: 900px) {
		.showcase--wide:not(.showcase--slot) {
			display: grid;
			grid-template-columns: minmax(0, 2fr) minmax(0, 3fr);
			column-gap: var(--space-lg);
			align-items: start;
		}

		.showcase--wide:not(.showcase--slot) .showcase__head {
			grid-column: 1;
			grid-row: 1;
		}

		.showcase--wide:not(.showcase--slot) .showcase__pair {
			grid-column: 2;
			grid-row: 1;
		}

		.showcase--wide:not(.showcase--slot) .showcase__fact {
			grid-column: 2;
			grid-row: 2;
		}
	}
</style>