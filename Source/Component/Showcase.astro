---
// Showcase: the use-case card of the functionality narrative - what the
// family accomplishes, shown as a before/after story. The pair renders
// the real example lines with the changed run marked (the first differing
// segment per line, wrapped in a static blue chip), and the footer carries
// the REAL fact - a ledger line or the totals pair, byte-exact from the
// pages' own constants. Zero elevation: the hairline plane, the #F8FAFC
// trays, no shadows.
//
// The pair area can also be a slot (the normalize showcase embeds the
// Compare slider there) - the card keeps its head and its fact footer.
//
// The Wide prop turns the card into the full-width use-case row (one card
// per row, spanning the section's width): the pair-mode cards split
// two-part at the wide breakpoint - the narrative (kicker, title, lead)
// on the left, the before/after pair and the ledger fact on the right;
// the slot-mode card (the Compare slider) keeps the stacked rows so the
// slider spans the full card width for the drag track. Below the
// breakpoint every wide card collapses back to the plain stacked column.
import BrandIcon from "@Component/BrandIcon.astro";

interface Props {
	/** The mono kicker - THE PIN / THE GOVERN / THE NORMALIZE. */
	Kicker: string;
	/** The Inter title of the use case. */
	Title: string;
	/** One narrative sentence. */
	Lead: string;
	/** Optional plugin page the title links to. */
	Href?: string;
	/** The before lines (real example content, byte-exact). */
	Before?: string[];
	/** The after lines (real example content, byte-exact). */
	After?: string[];
	/** Mark the differing runs (default true; the normalize card passes false). */
	Mark?: boolean;
	/** The real fact line (ledger excerpt / totals pair). */
	Fact?: string;
	/** The fact label chip (default "LEDGER"). */
	FactLabel?: string;
	/** The wide use-case card: the full-width row (one card per row,
		spanning the section's width). The pair-mode card splits two-part
		at the wide breakpoint; the slot-mode card keeps the stacked rows
		so the Compare slider spans the full card width. */
	Wide?: boolean;
}

const {
	Kicker,
	Title,
	Lead,
	Href,
	Before,
	After,
	Mark = true,
	Fact,
	FactLabel = "LEDGER",
	Wide = false,
} = Astro.props;

function Escape(Text: string): string {
	return Text.replace(/&/g, "&amp;")
		.replace(/</g, "&lt;")
		.replace(/>/g, "&gt;")
		.replace(/"/g, "&quot;")
		.replace(/'/g, "&#39;");
}

// Mark the differing run of one line against its counterpart: the common
// prefix and the common suffix stay plain, the middle run gets the chip
// (only when it is non-empty - a fully-common line or a line whose only
// difference is the counterpart's insertion stays plain).
function MarkLine(Raw: string, Other: string): string {
	let Prefix = 0;
	while (
		Prefix < Raw.length &&
		Prefix < Other.length &&
		Raw[Prefix] === Other[Prefix]
	) {
		Prefix += 1;
	}
	if (Prefix === Raw.length && Prefix === Other.length) return Escape(Raw);
	let Suffix = 0;
	while (
		Suffix < Raw.length - Prefix &&
		Suffix < Other.length - Prefix &&
		Raw[Raw.length - 1 - Suffix] === Other[Other.length - 1 - Suffix]
	) {
		Suffix += 1;
	}
	const Middle = Raw.slice(Prefix, Raw.length - Suffix);
	const Tail = Raw.slice(Raw.length - Suffix);
	const Head = Escape(Raw.slice(0, Prefix));
	if (Middle.length === 0) return `${Head}${Escape(Tail)}`;
	return `${Head}<span class="showcase__mark">${Escape(Middle)}</span>${Escape(Tail)}`;
}

// The JSON key voice: the quoted run before the colon reads in the site's
// code-keyword color (--color-primary, the same accent the .kw spans carry
// in the code blocks) - the key token including its quotes, mirroring the
// Shiki JSON token; the value and the punctuation keep the default ink, so
// the diff chip stays the only highlight. Runs AFTER MarkLine, so the mark
// span is already in place and the key regex (which cannot cross a tag's
// ampersands) only ever sees the plain key run. The visible bytes stay
// byte-exact.
function JsonKey(Line: string): string {
	return Line.replace(
		/(&quot;[^&]*?&quot;)(?=\s*:)/g,
		'<span class="showcase__key">$1</span>'
	);
}

const HasPair = Before !== undefined && After !== undefined;
const BeforeHtml = HasPair
	? Before.map((Line, Index) => JsonKey(MarkLine(Line, After![Index] ?? ""))).join("\n")
	: "";
const AfterHtml = HasPair
	? After.map((Line, Index) => JsonKey(MarkLine(Line, Before![Index] ?? ""))).join("\n")
	: "";
---

<article
	class={`showcase${Wide ? ` showcase--wide${HasPair ? "" : " showcase--slot"}` : ""}`}
>
	<div class="showcase__head">
		<span class="showcase__kicker">
			<BrandIcon Name="swap" Size="0.8em" />
			{Kicker}
		</span>
		{Href ? (
			<a class="showcase__title" href={Href}>
				{Title}
			</a>
		) : (
			<h3 class="showcase__title">{Title}</h3>
		)}
		<p class="showcase__lead">{Lead}</p>
	</div>

	{HasPair ? (
		<div class="showcase__pair">
			<span class="showcase__side-label">Before</span>
			<span class="showcase__side-label">After</span>
			<div class="showcase__screen" set:html={BeforeHtml}></div>
			<span class="showcase__flow" aria-hidden="true">
				<BrandIcon Name="swap" />
			</span>
			<div class="showcase__screen" set:html={AfterHtml}></div>
		</div>
	) : (
		<slot />
	)}

	{Fact && (
		<div class="showcase__fact">
			<span class="showcase__fact-label">
				<BrandIcon Name="terminal" Size="0.9em" />
				{FactLabel}
			</span>
			<span class="showcase__fact-text">{Fact}</span>
		</div>
	)}
</article>

<style>
	.showcase {
		display: flex;
		flex-direction: column;
		gap: var(--space-sm);
		padding: var(--space-md);
		border-radius: var(--radius-lg);
		background: var(--color-surface-container-lowest);
		border: 1px solid var(--color-outline-variant);
		min-width: 0;
	}

	.showcase__head {
		display: flex;
		flex-direction: column;
		gap: var(--space-xs);
	}

	.showcase__kicker {
		display: inline-flex;
		align-items: center;
		gap: var(--gap-icon);
		font-family: var(--font-mono);
		font-size: var(--text-label-sm);
		line-height: var(--leading-label-sm);
		font-weight: var(--weight-label-sm);
		letter-spacing: var(--tracking-label-sm);
		text-transform: uppercase;
		color: var(--color-primary);
	}

	.showcase__kicker .brand-icon {
		color: var(--color-primary);
	}

	.showcase__title {
		font-size: var(--text-headline-md);
		line-height: var(--leading-headline-md);
		font-weight: var(--weight-headline-md);
		letter-spacing: var(--tracking-headline-md);
		color: var(--color-on-surface);
		margin: 0;
	}

	a.showcase__title:hover {
		text-decoration: none;
		color: var(--color-primary);
	}

	.showcase__lead {
		font-size: var(--text-body-sm);
		line-height: var(--leading-body-sm);
		color: var(--color-on-surface-variant);
		margin: 0;
	}

	/* The pair: the two labeled trays flanking the swap arrow, laid out as
	   a two-row grid - row 1 the Before/After labels (the middle cell
	   empty), row 2 the two trays with the arrow cell between them. The
	   arrow spans only the tray row, so it sits on the trays' optical
	   center, not on the label + tray column. The trays stretch to one
	   height (the 1fr row), the diff reads as a before/after column. */
	.showcase__pair {
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
		grid-template-rows: auto 1fr;
		column-gap: var(--space-sm);
		row-gap: var(--space-xs);
		align-items: stretch;
		min-width: 0;
	}

	/* The pair's fixed child order: label, label, screen, flow, screen -
	   placed on the two-row grid (row 1 the labels, row 2 the trays and
	   the arrow). */
	.showcase__pair > :nth-child(1) {
		grid-area: 1 / 1;
	}
	.showcase__pair > :nth-child(2) {
		grid-area: 1 / 3;
	}
	.showcase__pair > :nth-child(3) {
		grid-area: 2 / 1;
	}
	.showcase__pair > :nth-child(4) {
		grid-area: 2 / 2;
	}
	.showcase__pair > :nth-child(5) {
		grid-area: 2 / 3;
	}

	.showcase__side-label {
		font-family: var(--font-mono);
		font-size: var(--text-label-sm);
		line-height: var(--leading-label-sm);
		font-weight: var(--weight-label-sm);
		letter-spacing: var(--tracking-label-sm);
		text-transform: uppercase;
		color: var(--color-ink-muted);
	}

	/* The tray: the site's code-block voice at the 13px mono floor - the
	   surface-container-low pad, the radius-md tray, pre whitespace with
	   tab-size 4 so the indentation and the bytes render untampered, and
	   overflow-x instead of mid-token wrapping. */
	.showcase__screen {
		padding: var(--space-md);
		border-radius: var(--radius-md);
		background: var(--color-surface-container-low);
		font-family: var(--font-mono);
		font-size: var(--text-label-sm);
		line-height: var(--leading-label-sm);
		font-weight: var(--weight-label-sm);
		letter-spacing: var(--tracking-label-sm);
		color: var(--color-on-surface);
		white-space: pre;
		overflow-x: auto;
		tab-size: 4;
		min-width: 0;
	}

	/* The JSON key voice: the quoted key run in the site's code-keyword
	   color (the .kw accent) - the diff chip stays the only highlight.
	   :global - the span is injected via set:html, so it carries no scope
	   attribute and the scoped selector would never match. */
	:global(.showcase__key) {
		color: var(--color-primary);
	}

	/* The static diff chip: the changed run, blue subtle fill + primary
	   ink - the anom geometry minus the flash (a static comparison, not a
	   live stream). :global for the same set:html reason as the key. */
	:global(.showcase__mark) {
		background: var(--color-harness-blue-subtle);
		color: var(--color-primary);
		font-weight: 600;
		padding: 0 2px;
		border-radius: var(--radius-sm);
	}

	/* The swap arrow: centered on the tray row (its own grid cell between
	   the trays), so its optical center meets the trays' center. */
	.showcase__flow {
		display: flex;
		align-items: center;
		justify-content: center;
		color: var(--color-primary);
		flex-shrink: 0;
	}

	.showcase__fact {
		display: flex;
		align-items: center;
		gap: var(--space-sm);
		padding-top: var(--space-xs);
		border-top: 1px solid var(--color-outline-variant);
		font-family: var(--font-mono);
		font-size: var(--text-label-sm);
		line-height: var(--leading-label-sm);
		font-weight: var(--weight-label-sm);
		letter-spacing: var(--tracking-label-sm);
		color: var(--color-ink-secondary);
		min-width: 0;
	}

	/* The fact chip (LEDGER): the site's chip padding (2px / space-xs,
	   like .badge) and the row gap above gives the chip its right
	   breathing room before the ledger text (the --gap-icon stays for the
	   icon-to-text unit inside the chip). */
	.showcase__fact-label {
		display: inline-flex;
		align-items: center;
		gap: var(--gap-icon);
		flex-shrink: 0;
		text-transform: uppercase;
		color: var(--color-primary);
		background: var(--color-harness-blue-subtle);
		border: 1px solid var(--color-primary-container);
		padding: 2px var(--space-xs);
		border-radius: var(--radius-default);
	}

	.showcase__fact-label .brand-icon {
		color: var(--color-primary);
	}

	.showcase__fact-text {
		min-width: 0;
		word-break: break-word;
	}

	/* ---- The wide use-case card (the index's full-width rows) ----
		At the wide breakpoint the pair-mode card becomes a two-part grid:
		the narrative (kicker, title, lead) on the left, the before/after
		pair and the ledger fact on the right - the same tokens, the same
		zero elevation, only the geometry widens. The slot-mode card (the
		Compare slider) keeps the stacked rows: the head on top, the slider
		below spanning the full card width for the drag track. Below the
		breakpoint every wide card collapses back to the plain stacked
		column (the base .showcase layout above). */
	@media (min-width: 900px) {
		.showcase--wide:not(.showcase--slot) {
			display: grid;
			grid-template-columns: minmax(0, 2fr) minmax(0, 3fr);
			column-gap: var(--space-lg);
			align-items: start;
		}

		.showcase--wide:not(.showcase--slot) .showcase__head {
			grid-column: 1;
			grid-row: 1;
		}

		.showcase--wide:not(.showcase--slot) .showcase__pair {
			grid-column: 2;
			grid-row: 1;
		}

		.showcase--wide:not(.showcase--slot) .showcase__fact {
			grid-column: 2;
			grid-row: 2;
		}
	}
</style>