---
import "@Stylesheet/Component/Preview.scss";

import Absent from "@Component/Absent.astro";
import Activation from "@Component/Activation.astro";
import Anchor from "@Component/Anchor.astro";
import Badge from "@Component/Badge.astro";
import Advise from "@Component/Advise.astro";
import Breadcrumb from "@Component/Breadcrumb.astro";
import Buffer from "@Component/Buffer.astro";
import Bundle from "@Component/Bundle.astro";
import Callout from "@Component/Callout.astro";
import CallStep from "@Component/CallStep.astro";
import Card from "@Component/Card.astro";
import Cascade from "@Component/Cascade.astro";
import Chain from "@Component/Chain.astro";
import CodeBlock from "@Component/CodeBlock.astro";
import Compare from "@Component/Compare.tsx";
import Constellation from "@Component/Constellation.astro";
import Curve from "@Component/Curve.astro";
import Deck from "@Component/Deck.astro";
import Definition from "@Component/Definition.astro";
import Difference from "@Component/Difference.astro";
import EmptyState from "@Component/EmptyState.astro";
import Explorer from "@Component/Explorer.astro";
import Family from "@Component/Family.astro";
import Fanout from "@Component/Fanout.astro";
import Flow from "@Component/Flow.astro";
import Fork from "@Component/Fork.astro";
import Gate from "@Component/Gate.astro";
import Gauge from "@Component/Gauge.astro";
import Grid from "@Component/Grid.astro";
import Gutter from "@Component/Gutter.astro";
import Icon from "@Component/Icon.astro";
import Inspector from "@Component/Inspector.astro";
import InspectorLive from "@Component/InspectorLive.tsx";
import Ladder from "@Component/Ladder.astro";
import Lane from "@Component/Lane.astro";
import Layer from "@Component/Layer.astro";
import Line from "@Component/Line.astro";
import Matrix from "@Component/Matrix.astro";
import Normalizer from "@Component/Normalizer.astro";
import PackageCard from "@Component/PackageCard.astro";
import PageHero from "@Component/PageHero.astro";
import Pager from "@Component/Pager.astro";
import Pending from "@Component/Pending.astro";
import Pipeline from "@Component/Pipeline.astro";
import Record from "@Component/Record.astro";
import Rewrite from "@Component/Rewrite.astro";
import Ribbon from "@Component/Ribbon.astro";
import RoleList from "@Component/RoleList.astro";
import Scenario from "@Component/Scenario.astro";
import Schema from "@Component/Schema.astro";
import Scheme from "@Component/Scheme.astro";
import SectionHeader from "@Component/SectionHeader.astro";
import Sequence from "@Component/Sequence.astro";
import Service from "@Component/Service.astro";
import Show from "@Component/Show.astro";
import StatBand from "@Component/StatBand.astro";
import State from "@Component/State.astro";
import Stream from "@Component/Stream.astro";
import Surface from "@Component/Surface.astro";
import Table from "@Component/Table.astro";
import Terminal from "@Component/Terminal.astro";
import Tool from "@Component/Tool.astro";
import Trace from "@Component/Trace.astro";
import VersionPill from "@Component/VersionPill.astro";

import { Axis } from "@Content/Axis";
import type { Effect } from "@Content/Behavior";
import { CurrentFor } from "@Content/Current";
import { DetailFor } from "@Content/Detail";
import { Intervention as InterventionRecord } from "@Content/Intervention";
import type { Lane as LaneRecord } from "@Content/Lane";
import { Role as RoleRecord } from "@Content/Message";
import { SchemeFor } from "@Content/Scheme";
import { Record as SessionRecord, Timeline, TotalOf } from "@Content/Session";
import { TableFor } from "@Content/Table";
import { Step as CallStepRecord } from "@Content/ToolCall";
import { Record as TraceRecord } from "@Content/Trace";
import { Scenario as ScenarioRecord } from "@Content/Tutorial";
import { Package } from "@Library/Package.server";

interface Props {
	Slug: string;
}

// The library route mounts the live component beside its contract, so a
// component and its documented properties cannot drift apart.
const { Slug } = Astro.props;
const Entry = Package[0]!;

// The gate's record, from the same typed map the package page reads, so the
// library demo cannot drift from the page it previews.
const Verdict = DetailFor("hook-dsh-ccr")?.Verdict;

// The records that carry a union are built once here: an inline object literal
// would widen a word such as `rewrite` or `model` to `string`, and the
// component's own props would no longer type-check.
const FanoutListener: {
	Slug: string;
	Href: string;
	Effect: Effect;
	Documented: boolean;
}[] = [
	{
		Slug: "hook-dsh-ccr",
		Href: "/package/hook-dsh-ccr/",
		Effect: "rewrite",
		Documented: true,
	},
	{
		Slug: "hook-dsh-comment-filter",
		Href: "/package/hook-dsh-comment-filter/",
		Effect: "rewrite",
		Documented: true,
	},
	{
		Slug: "hook-dsh-doc-suggester",
		Href: "/package/hook-dsh-doc-suggester/",
		Effect: "advise",
		Documented: false,
	},
	{
		Slug: "hook-dsh-replay-suggester",
		Href: "/package/hook-dsh-replay-suggester/",
		Effect: "advise",
		Documented: true,
	},
];

const LaneRecordData: LaneRecord[] = [
	{
		Label: "Model",
		Span: [
			{ Label: "step 1", Start: 4, Duration: 22, Kind: "model" },
			{ Label: "step 2", Start: 38, Duration: 18, Kind: "model" },
			{ Label: "step 3", Start: 70, Duration: 16, Kind: "model" },
		],
	},
	{
		Label: "Tool",
		Span: [
			{ Label: "grep", Start: 28, Duration: 8, Kind: "tool" },
			{ Label: "read", Start: 58, Duration: 6, Kind: "tool" },
			{ Label: "write", Start: 88, Duration: 4, Kind: "tool" },
		],
	},
	{
		Label: "Disk",
		Span: [{ Label: "write", Start: 92, Duration: 3, Kind: "disk" }],
	},
];

const InspectorTab: {
	Label: string;
	Body: string;
	Kind?: "text" | "code" | "schema";
	Properties?: {
		Name: string;
		Type: string;
		Required: boolean;
		Description: string;
	}[];
}[] = [
	{
		Label: "Summary",
		Body: "The result the model reads after the hook answers at the seam.",
		Kind: "text",
	},
	{
		Label: "Payload",
		Body: '{"path":"Source/Library/Preview.astro","limit":40}',
		Kind: "code",
	},
	{
		Label: "Schema",
		Body: "The fields the payload carries, and whether the contract requires each one.",
		Kind: "schema",
		Properties: [
			{
				Name: "path",
				Type: "string",
				Required: true,
				Description: "The file the call names.",
			},
			{
				Name: "limit",
				Type: "number",
				Required: false,
				Description: "How many rows the result carries.",
			},
		],
	},
];

const ShowPlugin = {
	Slug: "hook-dsh-normalize-dash",
	Summary:
		"Six normalizers rewrite the stream at the seam, so one prompt produces one byte sequence.",
};

const ShowShowcase = {
	Operator: "Ladder",
	Title: "One dimension, three values",
	Step: [
		{ Label: "Narrow", Body: "The hook acts on one character and leaves the rest alone." },
		{ Label: "Default", Body: "The hook acts on the whole class the character belongs to." },
		{ Label: "Wide", Body: "The hook acts on every class the seam carries." },
	],
};

const SessionEntry =
	SessionRecord.find((Item) => Item.Family !== undefined) ?? SessionRecord[0]!;
const SessionStart = Timeline("family").find((Item) => Item.Entry === SessionEntry)?.Start ?? 0;
const SessionTotal = TotalOf("family");

// The six previews that carry a content record read it through the same
// accessor the package page uses, so a demo cannot drift from the page it
// previews.
const FlowRecord = CurrentFor("hook-dsh-package-governor");
const NormalizerTable = TableFor("hook-dsh-normalize-quotes");
const SchemeRecord = SchemeFor("hook-dsh-package-governor");

// The comment filter's syntax record carries the families and the deliberate
// absences, and the ccr record carries the exempt list the labelled form of the
// same component draws, so both are narrowed once here.
const SyntaxRecord = DetailFor("hook-dsh-comment-filter");
const CompressRecord = DetailFor("hook-dsh-ccr");
const FamilyRecord =
	SyntaxRecord !== undefined && SyntaxRecord.Kind === "Syntax" ? SyntaxRecord.Family : [];
const AbsentRecord =
	SyntaxRecord !== undefined && SyntaxRecord.Kind === "Syntax" ? SyntaxRecord.Absent : [];
const ExemptRecord =
	CompressRecord !== undefined && CompressRecord.Kind === "Compress" ? CompressRecord.Exempt : [];

// The ring draws the listeners the spine already names, so the two pictures of
// one seam cannot disagree.
const ConstellationListener = FanoutListener.map(({ Slug, Effect, Documented }) => ({
	Slug,
	Effect,
	Documented,
}));

// The ribbon's band: one turn's labelled positions, and the events it carries,
// in the order the log writes them.
const RibbonTick = [
	{ At: 0, Label: "turn/start" },
	{ At: 4, Label: "step/start" },
	{ At: 12, Label: "step/end" },
	{ At: 20, Label: "turn/end" },
];

const RibbonMark: { At: number; Label: string; Kind?: "ok" | "warn" }[] = [
	{ At: 1, Label: "step/start", Kind: "ok" },
	{ At: 6, Label: "read", Kind: "ok" },
	{ At: 9, Label: "write", Kind: "warn" },
	{ At: 18, Label: "step/end", Kind: "ok" },
];

// The cascade's stages are the call's own steps, with the shares the harness
// page authors for them, because the log carries no clock.
const CascadeShare = [
	{ At: 0, Width: 14 },
	{ At: 14, Width: 56 },
	{ At: 70, Width: 22 },
	{ At: 92, Width: 8 },
];

const CascadeStep = CallStepRecord.flatMap((Stage, Index) => {
	const Share = CascadeShare[Index];

	return Share === undefined
		? []
		: [{ Label: Stage.Title, At: Share.At, Width: Share.Width, Note: Stage.Seam }];
});

// The deck's cards: the three axes the setup page stacks, read from the same
// record so the demo cannot drift from the page it previews.
const DeckCard = ["enabled", "threshold", "replacement"].flatMap((Name) => {
	const AxisEntry = Axis.find((Item) => Item.Name === Name);

	return AxisEntry === undefined ? [] : [{ Label: AxisEntry.Name, Body: AxisEntry.Turn }];
});

// The anchor's row: four sections of the harness page, in the order it reads
// them, so the demo names real sections rather than invented ones.
const AnchorEntry = [
	{ Href: "#claim", Label: "The claim" },
	{ Href: "#turn", Label: "The turn" },
	{ Href: "#call", Label: "The call" },
	{ Href: "#fate", Label: "The fate" },
];
---

<div class="preview">
	{/* Library: badge */}
	{Slug === "badge" && (
		<div class="preview__states">
			<div class="preview__state">
				<span class="preview__label">Neutral</span>
				<Badge Label="Classic" />
			</div>
			<div class="preview__state">
				<span class="preview__label">Accent</span>
				<Badge Label="Hook" Tone="accent" />
			</div>
			<div class="preview__state">
				<span class="preview__label">Quiet</span>
				<Badge Label="Draft" Tone="quiet" />
			</div>
		</div>
	)}

	{/* Library: version-pill */}
	{Slug === "version-pill" && (
		<div class="preview__states">
			<div class="preview__state">
				<span class="preview__label">Public</span>
				<VersionPill Version="0.2.1" />
			</div>
			<div class="preview__state">
				<span class="preview__label">Private</span>
				<VersionPill Version="0.0.0" Private />
			</div>
		</div>
	)}

	{/* Library: icon */}
	{Slug === "icon" && (
		<div class="preview__states">
			<div class="preview__state">
				<span class="preview__label">Small</span>
				<Icon Name="lib-dsh-core" Size={24} />
			</div>
			<div class="preview__state">
				<span class="preview__label">Default</span>
				<Icon Name="hook-dsh-normalize-dash" Size={40} />
			</div>
			<div class="preview__state">
				<span class="preview__label">Large</span>
				<Icon Name="plugin-dsh-factory" Size={64} />
			</div>
			<div class="preview__state">
				<span class="preview__label">Priority</span>
				<Icon Name="plugin-dsh-factory" Size={64} Priority Label="Factory" />
			</div>
		</div>
	)}

	{/* Library: breadcrumb */}
	{Slug === "breadcrumb" && (
		<div class="preview__states">
			<div class="preview__state preview__state--wide">
				<span class="preview__label">Root</span>
				<Breadcrumb Trail={[{ Href: "/", Label: "Overview" }]} />
			</div>
			<div class="preview__state preview__state--wide">
				<span class="preview__label">Deep</span>
				<Breadcrumb
					Trail={[
						{ Href: "/package/", Label: "Package" },
						{
							Href: "/package/hook-dsh-normalize-dash/",
							Label: "hook-dsh-normalize-dash",
						},
					]}
				/>
			</div>
		</div>
	)}

	{/* Library: definition */}
	{Slug === "definition" && (
		<div class="preview__states">
			<div class="preview__state">
				<span class="preview__label">Short</span>
				<Definition
					Definition={[
						{ Term: "Version", Detail: "0.2.1, read from the package manifest" },
						{ Term: "Kind", Detail: "hook" },
					]}
				/>
			</div>
			<div class="preview__state">
				<span class="preview__label">Long</span>
				<Definition
					Definition={[
						{ Term: "Version", Detail: "0.2.1, read from the package manifest" },
						{ Term: "Kind", Detail: "hook" },
						{ Term: "Licence", Detail: "CC0-1.0" },
						{ Term: "Release", Detail: "Classic and Effect-TS" },
					]}
				/>
			</div>
		</div>
	)}

	{/* Library: table */}
	{Slug === "table" && (
		<div class="preview__state preview__state--wide">
			<div class="preview__legend">
				<span class="preview__label">Text</span>
				<span class="preview__label">Link</span>
				<span class="preview__label">Icon</span>
			</div>
			<Table
				Caption="Three packages and their versions"
				Head={["Package", "Kind", "Version"]}
				Row={[
					["hook-dsh-normalize-dash", "hook", "0.2.1"],
					[
						{ Text: "plugin-dsh-factory", Href: "/package/plugin-dsh-factory/" },
						"plugin",
						"0.2.1",
					],
					[
						{
							Text: "lib-dsh-core",
							Href: "/package/lib-dsh-core/",
							Icon: "lib-dsh-core",
						},
						"lib",
						"0.2.1",
					],
				]}
			/>
		</div>
	)}

	{/* Library: card */}
	{Slug === "card" && (
		<div class="preview__states">
			<div class="preview__state">
				<span class="preview__label">Linked</span>
				<Card Title="Classic release" Href="/package/" Meta="59 in Classic">
					The TypeScript release of the family, built on the factory and the core library.
				</Card>
			</div>
			<div class="preview__state">
				<span class="preview__label">Plain</span>
				<Card Title="Effect-TS release" Meta="60 in Effect-TS">
					The same contracts expressed through Effect, package for package.
				</Card>
			</div>
		</div>
	)}

	{/* Library: package-card */}
	{Slug === "package-card" && Package.length > 0 && (
		<div class="preview__state preview__state--wide">
			<span class="preview__label">Default</span>
			<PackageCard Package={Entry} />
		</div>
	)}

	{/* Library: page-hero */}
	{Slug === "page-hero" && (
		<div class="preview__states">
			<div class="preview__state preview__state--wide">
				<span class="preview__label">Full</span>
				<PageHero
					Level={2}
					Eyebrow="Reference"
					Title="Every package, its version, and its source"
					Lede="The reference table reads the two package trees at build time, so a new package appears here on the next build."
				/>
			</div>
			<div class="preview__state preview__state--wide">
				<span class="preview__label">Minimal</span>
				<PageHero Level={2} Title="One heading and nothing else" />
			</div>
		</div>
	)}

	{/* Library: section-header */}
	{Slug === "section-header" && (
		<div class="preview__states">
			<div class="preview__state preview__state--wide">
				<span class="preview__label">Anchored</span>
				<SectionHeader
					Id="preview-anchored"
					Title="The catalogue reads the tree"
					Lede="Each row is one package directory with a manifest, not a copy of a list."
				/>
			</div>
			<div class="preview__state preview__state--wide">
				<span class="preview__label">Plain</span>
				<SectionHeader Title="A section without an anchor" />
			</div>
		</div>
	)}

	{/* Library: stat-band */}
	{Slug === "stat-band" && (
		<div class="preview__states">
			<div class="preview__state preview__state--wide">
				<span class="preview__label">Plain</span>
				<StatBand
					Stat={[
						{ Label: "Package", Value: 119 },
						{ Label: "Hook", Value: 60 },
						{ Label: "Release", Value: 2 },
					]}
				/>
			</div>
			<div class="preview__state preview__state--wide">
				<span class="preview__label">Noted</span>
				<StatBand
					Stat={[
						{ Label: "Package", Value: 119, Note: "Both release trees" },
						{ Label: "Hook", Value: 60, Note: "Registrations" },
						{ Label: "Smoke suite", Value: 595, Note: "Assertions" },
						{ Label: "Release", Value: 2, Note: "Classic and Effect-TS" },
					]}
				/>
			</div>
		</div>
	)}

	{/* Library: callout */}
	{Slug === "callout" && (
		<div class="preview__states">
			<div class="preview__state">
				<span class="preview__label">Note</span>
				<Callout Title="Read from the tree">
					A version on this site is the version in the manifest at build time.
				</Callout>
			</div>
			<div class="preview__state">
				<span class="preview__label">Warn</span>
				<Callout Title="Prototype" Tone="warn">
					This route carries structure and real package facts; its prose is still being
					written.
				</Callout>
			</div>
		</div>
	)}

	{/* Library: code-block */}
	{Slug === "code-block" && (
		<div class="preview__states">
			<div class="preview__state">
				<span class="preview__label">Shell</span>
				<CodeBlock
					Label="Install the dash normalizer"
					Language="sh"
					Code={"pnpm add @playform/hook-dsh-normalize-dash"}
				/>
			</div>
			<div class="preview__state">
				<span class="preview__label">TypeScript</span>
				<CodeBlock
					Label="Read the development flag"
					Language="ts"
					Code={`const Dev = process.env["SITE_DEV"] === "1";`}
				/>
			</div>
		</div>
	)}

	{/* Library: terminal */}
	{Slug === "terminal" && (
		<div class="preview__states">
			<div class="preview__state preview__state--wide">
				<span class="preview__label">Success</span>
				<Terminal
					Label="Build"
					Line={[
						{ Command: "pnpm --dir Site prepublishOnly" },
						{ Output: "119 package pages built\n4 routes generated" },
					]}
				/>
			</div>
			<div class="preview__state preview__state--wide">
				<span class="preview__label">Failure</span>
				<Terminal
					Label="Check"
					Line={[
						{ Command: "pnpm --dir Site Check" },
						{ Output: "1 issue: a declared state is not named in the preview" },
					]}
				/>
			</div>
		</div>
	)}

	{/* Library: empty-state */}
	{Slug === "empty-state" && (
		<div class="preview__state preview__state--wide">
			<span class="preview__label">Default</span>
			<EmptyState
				Title="No stories are recorded yet"
				Note="The showcase reads its records from the site's own content, not from the packages."
			/>
		</div>
	)}

	{/* Library: pager */}
	{Slug === "pager" && (
		<div class="preview__states">
			<div class="preview__state preview__state--wide">
				<span class="preview__label">Both</span>
				<Pager
					Previous={{ Href: "/package/", Label: "Package" }}
					Next={{ Href: "/setup/", Label: "Setup" }}
				/>
			</div>
			<div class="preview__state preview__state--wide">
				<span class="preview__label">Previous only</span>
				<Pager Previous={{ Href: "/package/", Label: "Package" }} />
			</div>
			<div class="preview__state preview__state--wide">
				<span class="preview__label">Next only</span>
				<Pager Next={{ Href: "/setup/", Label: "Setup" }} />
			</div>
		</div>
	)}

	{/* Library: line */}
	{Slug === "line" && (
		<div class="preview__states">
			<div class="preview__state preview__state--wide">
				<span class="preview__label">Default</span>
				<Line Seq={1} Kind="turn" Name="turn/start" />
			</div>
			<div class="preview__state preview__state--wide">
				<span class="preview__label">Current</span>
				<Line Seq={2} Kind="step" Name="step/start" Current />
			</div>
			<div class="preview__state preview__state--wide">
				<span class="preview__label">Foldable</span>
				<Line Seq={3} Kind="tool" Name="read" Foldable />
			</div>
		</div>
	)}

	{/* Library: gutter */}
	{Slug === "gutter" && (
		<div class="preview__states">
			<div class="preview__state">
				<span class="preview__label">Default</span>
				<Gutter Seq={4} />
			</div>
			<div class="preview__state">
				<span class="preview__label">Foldable</span>
				<Gutter Seq={5} Foldable />
			</div>
		</div>
	)}

	{/* Library: pending */}
	{Slug === "pending" && (
		<div class="preview__states">
			<div class="preview__state">
				<span class="preview__label">Named</span>
				<Pending Name="read" />
			</div>
			<div class="preview__state">
				<span class="preview__label">With meta</span>
				<Pending Name="grep" Meta="tools/post-execute, 1.2s" />
			</div>
		</div>
	)}

	{/* Library: schema */}
	{Slug === "schema" && (
		<div class="preview__state preview__state--wide">
			<div class="preview__legend">
				<span class="preview__label">Required</span>
				<span class="preview__label">Optional</span>
			</div>
			<Schema
				Properties={[
					{
						Name: "path",
						Type: "string",
						Required: true,
						Description: "The file the call names.",
					},
					{
						Name: "limit",
						Type: "number",
						Required: false,
						Description: "How many rows the result carries.",
					},
					{
						Name: "offset",
						Type: "number",
						Required: false,
						Description: "Where the result starts.",
					},
				]}
			/>
		</div>
	)}

	{/* Library: pipeline */}
	{Slug === "pipeline" && (
		<div class="preview__state preview__state--wide">
			<div class="preview__legend">
				<span class="preview__label">Current</span>
				<span class="preview__label">Seam</span>
				<span class="preview__label">Plain</span>
			</div>
			<Pipeline
				Current="execute"
				Stages={[
					{ Label: "pre", Seam: "tools/pre-execute" },
					{ Label: "execute", Seam: "tools/execute" },
					{ Label: "post", Seam: "tools/post-execute" },
					{ Label: "record", Seam: "" },
				]}
			/>
		</div>
	)}

	{/* Library: sequence */}
	{Slug === "sequence" && (
		<div class="preview__state preview__state--wide">
			<div class="preview__legend">
				<span class="preview__label">Durable</span>
				<span class="preview__label">Live</span>
