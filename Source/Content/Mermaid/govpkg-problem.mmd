flowchart LR
	EDIT["Agents edit package.json files constantly."]
	LEAVE["Every edit able to leave stale pins - stray version ranges<br/>or deps that should track a governed registry"]
	WHERE["The fix has to happen where the write happens."]
	EVERY["On every write path - full writes - single-line edits<br/>str_replace_editor patches alike"]
	BYTE["Without the author's tool result changing<br/>by a single byte"]
	EDIT --> LEAVE
	LEAVE --> WHERE --> EVERY --> BYTE
