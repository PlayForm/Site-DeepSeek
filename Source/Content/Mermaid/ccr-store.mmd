flowchart LR
	IN["A stored result - the full serialized content bytes"] --> KEY["The key: the sha256-24 hash of those bytes -<br/>node:crypto, no native deps"]
	KEY --> LRU["The in-memory LRU"]
	LRU --> BUD["The storeBudgetBytes cap - 256 MiB,<br/>least-recently-accessed eviction,<br/>the just-inserted entry never evicted"]
	LRU --> TTL["ttlSeconds - 3600:<br/>sweep on insert, gone on access"]
	LRU --> JRN["The optional JSONL journal - journalPath,<br/>default empty = memory-only:<br/>one {hash, type, size, ttlAt, payload} record per store,<br/>payload base64, loaded and TTL-compacted on boot"]
