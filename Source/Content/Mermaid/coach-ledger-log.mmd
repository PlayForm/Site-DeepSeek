flowchart LR
	TEN["The ten strings - the contract, byte-exact."]
	S1["offense - strike - cooldown suppressed"]
	S2["escalated persistent section -<br/>persistent section cleared"]
	S3["section rebuilt - one line per path (ttl, tools/change) -<br/>denied - exempt"]
	S4["schema fetch failed - disabled"]
	APPEND["The factory's Append layer -<br/>the hook-dsh-tool-coach: logger prefix"]
	ISO["The durable file carries the same strings,<br/>each line [ISO] then the message."]
	LOG["One log per module - logFile,<br/>default ~/.dsh/<br/>hook-dsh-tool-coach.log"]
	TEN --> S1
	TEN --> S2
	TEN --> S3
	TEN --> S4
	TEN --> APPEND
	APPEND --> ISO
	ISO --> LOG
