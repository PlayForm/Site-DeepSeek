flowchart LR
	MOD["the module composes the nine strings - byte-exact"]
	MOD --> APPEND["the factory's Append layer adds the<br/>live-containers: logger prefix and the timestamp"]
	APPEND --> FILE["the durable file - logFile, default<br/>~/.dsh/live-containers.log -<br/>each line [ISO] then the message"]
	FILE --> LIFE["the lifecycle lines -<br/>disabled, activated"]
	FILE --> BLK["the block lines - block rendered,<br/>block skipped, render failed, render unknown"]
	FILE --> SEC["the section lines - section rebuilt (ttl),<br/>section rebuilt (tools/change),<br/>failsafe section-collapse"]
	BLK -- "skip lines log only when the reason changes" --> QUIET["the ledger stays quiet on steady state"]
