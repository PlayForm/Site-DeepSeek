flowchart LR
	DEFAULT["the schema default - included raw-write"]
	SHADOW["a patch layer's config replaces<br/>the entry config wholesale"]
	LIVE["the deployed value<br/>[write, edit, str_replace_editor]<br/>no raw-write"]
