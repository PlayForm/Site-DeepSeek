flowchart LR
	SAFE["Chunk-boundary-safe by construction"]
	S1["Single-character replacement - no lookahead<br/>no multi-character sequences"]
	S2["Per-chunk application can never disagree<br/>with whole-text application."]
	S3["Applied with a function replacer - a custom<br/>replacement containing $ patterns<br/>is inserted literally"]
	S4["Replaced characters counted per stream<br/>for the ledger line"]
	SAFE --> S1
	SAFE --> S2
	SAFE --> S3
	SAFE --> S4
	S1 ~~~ S2
	S2 ~~~ S3
	S3 ~~~ S4
