---
import Base from "@Layout/Base.astro";
import ArrowIcon from "@Component/ArrowIcon.astro";
import Badge from "@Component/Badge.astro";
import BrandIcon from "@Component/BrandIcon.astro";
import Card from "@Component/Card.astro";
import Compare from "@Component/Compare.astro";
import Concept from "@Component/Concept.astro";
import FlavorBadge from "@Component/FlavorBadge.astro";
import PageHero from "@Component/PageHero.astro";
import SectionHeader from "@Component/SectionHeader.astro";
import { Counts, Sprite } from "@Library/Content";
import { Link, Links } from "@Library/Links";

// The chain showcase: one raw line carrying every family's anomaly (each
// character class taken from the flavors' own README examples - the em
// dash, the curly quotes, the ellipsis, the no-break space, the zero-width
// space + BOM, the full-width digits), and the clean line after the
// family's fixed-order chain.
const ChainRaw = [
	"Plan review \u2014 phase one: the config \u201Cdrift\u201D is real\u2026 wait for it\u2026 Balance\u00A0sheet sync \u2014 latency\u200Bbudget\uFEFF \u2014 \uFF11\uFF12\uFF13.",
];
const ChainClean = [
	"Plan review - phase one: the config \"drift\" is real... wait for it... Balance sheet sync - latency budget - 123.",
];

// The seven normalize flavors: six stream flavors plus the file tool.
const Flavors = [
	{
		Flavor: "DASH",
		Package: "hook-dsh-normalize-dash",
		Desc: "Normalizes the unicode dash family to ASCII hyphen-minus in model output streams.",
	},
	{
		Flavor: "QUOTES",
		Package: "hook-dsh-normalize-quotes",
		Desc: "Maps the eight curly quote code points to their ASCII straight counterparts in model output streams.",
	},
	{
		Flavor: "ELLIPSIS",
		Package: "hook-dsh-normalize-ellipsis",
		Desc: "Replaces the horizontal ellipsis (U+2026) with the plain ASCII three-dot sequence in model output streams.",
	},
	{
		Flavor: "SPACES",
		Package: "hook-dsh-normalize-spaces",
		Desc: "Normalizes the unicode space family (Zs minus the ASCII space) to the plain space in model output streams.",
	},
	{
		Flavor: "INVISIBLE",
		Package: "hook-dsh-normalize-invisible",
		Desc: "Removes the zero-width/invisible character family (soft hyphen, zero-width spaces and joiners, bidi controls, BOM) from model output streams.",
	},
	{
		Flavor: "FULLWIDTH",
		Package: "hook-dsh-normalize-fullwidth",
		Desc: "Maps the entire FULLWIDTH FORMS range (U+FF01-U+FF5E) to its ASCII half-width counterparts in model output streams.",
	},
	{
		Flavor: "FILE",
		Package: "hook-dsh-normalize-file",
		Desc: "The file-content normalizer: the normalize-file tool - the read, count, write pipeline applying all six transforms (dash, quotes, ellipsis, spaces, invisible, fullwidth) to a file already on disk, writing only when something changed.",
	},
];
---

<Base
	Title="Flavors & Roles - @playform / DSH Family"
	Description="The seven normalize flavors (dash, quotes, ellipsis, spaces, invisible, fullwidth, file) and the two governance roles (governor, pinner) of the DeepSeek Harness Plugin Family."
>
	<main class="container container--main">
		<div class="eyebrow-row">
			<Badge Variant="primary" Dot>
				ECOSYSTEM: @PLAYFORM
			</Badge>
			<Badge>
				{Counts.Normalizers} FLAVORS / {Counts.Roles} ROLES
			</Badge>
		</div>

		<PageHero
			Title="Flavors & Roles"
			Sub={"Nine capabilities, two kinds.\nThe seven normalize flavors turn model output streams and project files into clean ASCII; the two governance roles keep the project's manifests pinned and governed under the author's control."}
		/>

		<!-- The seven flavors -->
		<section class="section">
			<SectionHeader Title="The seven flavors" Meta="SIX STREAM FLAVORS + THE FILE TOOL" />
			<div class="grid grid--2">
				{Flavors.map((Flavor) => (
					<Card
						Variant="white"
						Name={Flavor.Package}
						Href={`/plugins/${Flavor.Package}/`}
						Desc={Flavor.Desc}
						Muted
					>
						<span class="flavor-cell flavor-cell--compact" slot="badge">
							<FlavorBadge Flavor={Flavor.Flavor} />
						</span>
					</Card>
				))}
			</div>
		</section>

		<!-- One stream through the whole family: the chain showcase - every
			flavor's character class in one raw line, the clean line after the
			fixed-order chain. Drag the handle to compare. -->
		<section class="section">
			<SectionHeader Title="One stream through the whole family" Meta="THE SIX-FLAVOR CHAIN" />
			<p class="page-hero__sub" style="margin-bottom: var(--space-md)">
				The six stream flavors compose into one chain: a raw line carrying every family's
				anomaly - an em dash, curly quotes, an ellipsis, a no-break space, a zero-width
				space and a BOM, full-width digits - and the clean line after the pass.
			</p>
			<Compare
				Id="flavors-chain"
				Flavor="all"
				Raw={ChainRaw}
				Clean={ChainClean}
				RawLabel="Raw - every family's anomaly"
				CleanLabel="Clean - after the six-flavor chain"
			/>
			<p class="section-kicker" style="margin-top: var(--space-md)">
				<BrandIcon Name="swap" />The order is FIXED by the family: dashes{" "}
				<ArrowIcon Direction="right" Tone="accent" /> quotes{" "}
				<ArrowIcon Direction="right" Tone="accent" /> ellipsis{" "}
				<ArrowIcon Direction="right" Tone="accent" /> spaces{" "}
				<ArrowIcon Direction="right" Tone="accent" /> invisible{" "}
				<ArrowIcon Direction="right" Tone="accent" /> fullwidth - the same chain the
				raw-write tool's <code>normalize: true</code> runs.
			</p>
		</section>

		<!-- The two roles -->
		<section class="section">
			<SectionHeader Title="The two roles" Meta="GOVERNANCE" />
			<div class="grid grid--2">
				<Card Variant="primary">
					<div class="card__top">
						<span class="card__name" style="color: var(--color-on-primary)">
							ROLE: GOVERNOR
						</span>
						<Badge Variant="outline">hook-dsh-governor-*</Badge>
					</div>
					<p class="card__desc" style="color: var(--color-on-primary-container)">
						The governance role: silently hooks{" "}
						<a href={Link(Links.DeepSeekHarness, "packages/fs/fs/src/index.ts")}>
							<code class="code-token">fs/observed</code>
						</a>{" "}
						and rewrites the project's dependency pins to the governed versions - the
						<span class="file-mention"><BrandIcon Name="file-json" Size="0.9em" />package.json</span> governor and the <BrandIcon Name="rust" />{" "}
						<span class="file-mention"><BrandIcon Name="file-toml" Size="0.9em" />Cargo.toml</span> governor.
					</p>
				</Card>
				<Card Variant="primary">
					<div class="card__top">
						<span class="card__name" style="color: var(--color-on-primary)">
							ROLE: PINNER
						</span>
						<Badge Variant="outline">hook-dsh-pinner-*</Badge>
					</div>
					<p class="card__desc" style="color: var(--color-on-primary-container)">
						The pinning role: deterministically rewrites every ranged dependency version
						to its static version, protected by a pin-policy keep-list.
					</p>
				</Card>
			</div>
		</section>

		<!-- The badge sprite -->
		<section class="section">
			<SectionHeader
				Title="The badge sprite"
				Meta={`${Sprite.Badges} SHIELDS-STYLE SYMBOLS`}
			/>
			<div class="concept-list">
				<Concept
					Id="flavors-sprite"
					Title="Distinct badges, one unified family look"
					Diagram={"The eleven shields-style symbols of the sprite at /assets/badges.svg - the label segment, the value segment and how a page references one symbol via <use>."}
				>
					<p>
						The standalone shields-style sprite lives at{" "}
						<span class="hook-tally"><span class="file-mention"><BrandIcon Name="file-svg" Size="0.9em" />/assets/badges.svg</span></span>: label segment{" "}
						<span class="hook-tally">#003ec7</span> with white ink, value segment{" "}
						<span class="hook-tally">#eef0ff</span> with{" "}
						<span class="hook-tally">#0038b6</span> ink - blue and white only.
					</p>
					<p>
						Reference each symbol as
						<span class="hook-tally">
							&lt;use href="/assets/badges.svg#badge-classic"/&gt;
						</span>
						.
					</p>
				</Concept>
			</div>
			<div class="sprite-board">
				<img src="/assets/badges.svg" alt="The eleven DSH Family badges" />
			</div>
		</section>
	</main>
</Base>
