---
import Base from "@Layout/Base.astro";
import ArrowIcon from "@Component/ArrowIcon.astro";
import Badge from "@Component/Badge.astro";
import BrandIcon from "@Component/BrandIcon.astro";
import PageHero from "@Component/PageHero.astro";
import TerminalTray from "@Component/TerminalTray.astro";
import { Counts } from "@Library/Content";

// The seven flavor hooks of the stream gate, each with its NORM token,
// human name and before/after rule. The PATH hook ships disarmed by
// default (it toggles like the rest, mirroring the workbench mock).
const Hooks = [
	{
		Id: "dash",
		Prefix: "NORM",
		Token: "DASH",
		Name: "Hyphen Standardizer",
		From: "\u2014 \u2013",
		To: "-",
		Armed: true,
	},
	{
		Id: "quotes",
		Prefix: "NORM",
		Token: "QUOTES",
		Name: "Curly Quotes",
		From: "\u201C \u201D \u2018 \u2019",
		To: "\" '",
		Armed: true,
	},
	{
		Id: "ellipsis",
		Prefix: "NORM",
		Token: "ELLIPSIS",
		Name: "Ellipsis Expander",
		From: "\u2026",
		To: "...",
		Armed: true,
	},
	{
		Id: "spaces",
		Prefix: "NORM",
		Token: "SPACES",
		Name: "Whitespace Purge",
		From: "\\u00A0",
		To: "\\x20",
		Armed: true,
	},
	{
		Id: "invisible",
		Prefix: "STRIP",
		Token: "ZWSP",
		Name: "Zero-Width Strip",
		From: "\\u200B\\uFEFF",
		To: "\u2205",
		Armed: true,
	},
	{
		Id: "fullwidth",
		Prefix: "NORM",
		Token: "FULLWIDTH",
		Name: "Width Normalizer",
		From: "\\uFF01..\\uFF5E",
		To: "Halfwidth",
		Armed: true,
	},
	{
		Id: "file",
		Prefix: "NORM",
		Token: "FILE",
		Name: "File Content Normalizer",
		From: "on disk",
		To: "6 transforms",
		Armed: false,
	},
];

// Runtime pipeline profiles, per the workbench mock.
const Runtimes = [
	{ Id: "classic", Label: "Classic Pipeline" },
	{ Id: "effect", Label: "Effect-TS v4 Fiber" },
];

// Ingest engines, per the workbench mock.
const Engines = [
	{ Id: "deepseek", Label: "DeepSeek Engine v4" },
	{ Id: "glm", Label: "GLM Engine 5.3" },
	{ Id: "raw", Label: "Raw Ingest Stream" },
];

// The pipeline stages the demo mirrors, in the family's real order (each
// stage is a step the packages' own code takes per chunk). The two flow
// stages carry the colored arrow icon between their parts.
const Spans = [
	{ Text: "next() first", Flow: false },
	{ Text: "CoreChunk dispatch", Flow: false },
	{ Text: "per-flavor transform", Flow: false },
	{ Text: "yield", Flow: true, To: "transcript" },
	{ Text: "Append", Flow: true, To: "ledger line" },
];
---

<Base
	Title="Workbench - DSH Family @ PlayForm"
	Description="The interactive Stream Gate & Normalization Workbench: raw LLM token emission passing through the seven flavor hooks into clean ASCII output, live."
>
	<main class="container container--main">
		<div class="eyebrow-row">
			<Badge Variant="primary" Dot>
				LIVE EMISSION
			</Badge>
			<Badge>STREAM GATE</Badge>
			<Badge>{Counts.Normalizers} FLAVOR HOOKS</Badge>
		</div>

		<PageHero
			Title="Interactive Stream Gate & Normalization Workbench"
			Sub={"Runtime matrix: raw LLM token emission transitioning through the stream gate into clean ASCII output.\nToggle the flavor hooks, switch the ingest engine, and watch the raw buffer and the canonical sanitized stream diverge."}
		/>

		<!-- Runtime & gate tally -->
		<section class="workbench-controls">
			<div class="workbench-controls__group">
				<span class="workbench-controls__label">Runtime:</span>
				{Runtimes.map((Runtime, Index) => (
					<button
						type="button"
						class="engine-pill"
						data-runtime={Runtime.Id}
						data-active={Index === 1 ? "" : undefined}
					>
						{Runtime.Id === "classic" && (
							<BrandIcon Name="typescript" Size="0.8em" />
						)}
						{Runtime.Id === "effect" && <BrandIcon Name="effect" Size="0.8em" />}
						{Runtime.Label}
					</button>
				))}
			</div>
			<div class="workbench-controls__group">
				<span class="workbench-controls__label">Armed hooks:</span>
				<span class="hook-tally" data-hook-tally data-total={Counts.Normalizers}>
					{Counts.StreamFlavors} of {Counts.Normalizers} Active
				</span>
			</div>
		</section>

		<!-- Ingest engine selection -->
		<section class="workbench-controls">
			<div class="workbench-controls__group">
				<span class="workbench-controls__label">Ingest source:</span>
				{Engines.map((Engine, Index) => (
					<button
						type="button"
						class="engine-pill"
						data-engine={Engine.Id}
						data-active={Index === 0 ? "" : undefined}
						aria-pressed={Index === 0}
					>
						<span class="dot"></span>
						{Engine.Id === "glm" && <BrandIcon Name="zhipu" Size="0.8em" />}
						{Engine.Label}
					</button>
				))}
			</div>
			<div class="workbench-controls__group">
				<button type="button" class="engine-pill" data-action="toggle" aria-pressed="false">
					Pause Stream
				</button>
				<button type="button" class="engine-pill" data-action="clear">
					Clear
				</button>
				<button type="button" class="engine-pill" data-action="burst">
					10k Burst
				</button>
				<button type="button" class="engine-pill engine-pill--active" data-action="copy">
					Copy Clean
				</button>
			</div>
		</section>

		<!-- Telemetry metrics -->
		<section class="section">
			<div class="metric-grid">
				<div class="metric">
					<span class="metric__label">Zero-Width Purged</span>
					<div class="metric__row">
						<span class="metric__value" data-metric="invisible">
							0
						</span>
						<span class="metric__note"><code class="code-token">U+200B..F</code></span>
					</div>
				</div>
				<div class="metric">
					<span class="metric__label">Curly Quotes Converted</span>
					<div class="metric__row">
						<span class="metric__value" data-metric="quotes">
							0
						</span>
						<span class="metric__note">
							\u201C\u201D <ArrowIcon Direction="right" Tone="accent" /> ""
						</span>
					</div>
				</div>
				<div class="metric">
					<span class="metric__label">Dashes Standardized</span>
					<div class="metric__row">
						<span class="metric__value" data-metric="dash">
							0
						</span>
						<span class="metric__note">
							\u2014 \u2013 <ArrowIcon Direction="right" Tone="accent" /> -
						</span>
					</div>
				</div>
				<div class="metric">
					<span class="metric__label">Replacements Applied</span>
					<div class="metric__row">
						<span class="metric__value" data-metric="replacements">
							0
						</span>
						<span class="metric__note">count &gt; 0 per flavor</span>
					</div>
				</div>
			</div>
		</section>

		<!-- Flavor hook switchboard -->
		<section class="section">
			<div class="section-header">
				<div class="section-header__left">
					<span class="section-header__marker"></span>
					<h2 class="section-header__title">Canonical Transformation Flavor Hooks</h2>
				</div>
				<div class="workbench-controls__group">
					<span class="section-header__meta">INTERACTIVE CIRCUIT MATRIX</span>
					<button type="button" class="engine-pill" data-action="toggle-all">
						Toggle All
					</button>
				</div>
			</div>
			<div class="hook-grid">
				{Hooks.map((Hook) => (
					<button
						type="button"
						class={`hook-card ${Hook.Armed ? "is-armed" : "is-disarmed"}`}
						data-hook={Hook.Id}
						data-armed={Hook.Armed ? "true" : "false"}
						aria-pressed={Hook.Armed}
					>
						<div class="hook-card__top">
							<span class="hook-card__token">
								<span class="flavor-prefix">{Hook.Prefix}:</span>
								{Hook.Token}
							</span>
							<span class="hook-card__status"></span>
						</div>
						<span class="hook-card__name">{Hook.Name}</span>
						<span class="hook-card__rule">
							<span>{Hook.From}</span>
							<ArrowIcon Direction="right" Tone="accent" />
							<span>{Hook.To}</span>
						</span>
					</button>
				))}
			</div>
		</section>

		<!-- Dual terminal view -->
		<section class="section">
			<p class="visually-hidden" role="status" aria-live="polite" data-stream-status>
				Stream running
			</p>
			<div class="stream-grid">
				<div class="stream-pane rail-orange">
					<TerminalTray Label="RAW LLM INGEST BUFFER" Orange>
						<span class="stream-pane__count" data-count="raw">
							0 bytes
						</span>
					</TerminalTray>
					<div class="stream-pane__terminal" data-stream="raw"></div>
				</div>
				<div class="stream-hub">
					<div class="stream-hub__core">
						<svg
							class="spin"
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="2"
							aria-hidden="true"
						>
							<path d="M21 12 a9 9 0 1 1 -2.6 -6.4 M21 3 v6 h-6"></path>
						</svg>
						<span>DEMO</span>
						<strong>client-side</strong>
					</div>
					<!-- The paused tag, split: only the PAUSED word carries the
					     accent-orange token; the separator and the rest keep the
					     on-surface-variant ink. Hidden until the stage is paused
					     (see the .stream-hub__paused rules in Global.css). -->
					<span class="stream-hub__paused" aria-hidden="true">
						<span class="stream-hub__paused-word">PAUSED</span><span class="dot-sep" aria-hidden="true"></span>HOVER TO RESUME
					</span>
					<!-- The settled tag, split: only the SETTLED word carries the
					     primary-blue token (the normalized signature); the
					     separator and the rest keep the on-surface-variant ink.
					     Hidden until the stage is settled (see the
					     .stream-hub__settled rules in Global.css) - one pass over
					     the pool played, no line repeats; the restart toggle above
					     the stage resumes by a new pass. -->
					<span class="stream-hub__settled" aria-hidden="true">
						<span class="stream-hub__settled-word">SETTLED</span><span class="dot-sep" aria-hidden="true"></span>PLAYED ONCE
					</span>
				</div>
				<div class="stream-pane">
					<TerminalTray Label="CANONICAL SANITIZED STREAM" Icon>
						<span class="stream-pane__count" data-count="clean">
							0 bytes
						</span>
					</TerminalTray>
					<div class="stream-pane__terminal" data-stream="clean"></div>
				</div>
			</div>
			<div class="trace-ribbon">
				<div class="trace-ribbon__chain">
					<span>The pipeline this demo mirrors:</span>
					{Spans.map((Span) => (
						<span class="trace-ribbon__span">
							{Span.Flow ? (
								<Fragment>
									{Span.Text}
									<ArrowIcon Direction="right" Tone="accent" />
									{Span.To}
								</Fragment>
							) : (
								Span.Text
							)}
						</span>
					))}
				</div>
				<span>
					Count &gt; 0 only • <strong>count === 0 keeps the chunk by identity</strong> • a
					thrown-away stream writes no ledger line
				</span>
			</div>
		</section>

		<!-- The arms beyond the demo: text-only note (the stream-gate demo
		     itself stays untouched). One sentence per paragraph - the
		     sentence text stays byte-exact, only the paragraphing changes. -->
		<section class="section">
			<p class="page-hero__sub">
				<strong>Beyond the demo:</strong> this workbench models the{" "}
				<strong>conversation arm</strong> (<code>llm/stream</code>) only.
			</p>
			<p class="page-hero__sub">
				The family's other arms - tool input, tool results, step batch, files - are
				configurable via the volatile <code>scopes</code> surface (conversation /
				reasoning / toolInput / toolResults / files / batch, every scope
				hot-flippable through <code>loader/volatile-update</code>), reachable in the
				live profile through the <code>normalize-overpass</code> command.
			</p>
			<p class="page-hero__sub">
				And tool output can additionally be <strong>compressed</strong>: the{" "}
				<a href="/plugins/hook-dsh-ccr/">ccr hook</a> replaces oversized results of
				the target tools with a one-line preview plus a{" "}
				<code>&lt;&lt;&lt;CCR:</code> retrieval marker, while the{" "}
				<a href="/plugins/hook-dsh-tool-coach/">tool-coach</a> judges the terminal
				calls the stream never sees.
			</p>
			<p class="page-hero__sub">
				The <a href="/plugins/hook-dsh-normalize-dash/">flavor pages</a> carry the
				full scopes and overpass tables.
			</p>
		</section>
	</main>
</Base>

<script>
	// Stream gate simulation: raw token batches enter the left terminal, pass
	// the armed flavor hooks, and land in the right terminal as clean ASCII.
	//
	// The stream is one-pass-then-settle: the tick loop plays each line of
	// the selected engine's pool exactly once (raw and clean beside each
	// other in the same tick) and when the pass completes the stream
	// settles - the stage freezes with the panes keeping the final content,
	// the hub lands the SETTLED tag, and the toggle reads Restart. No pass
	// repeats, so no line repetition ever scrolls the terminals; the
	// restart toggle, the engine/runtime pills and the burst/clear actions
	// lift the state (see the Push/Settle/Restart trio below).
	//
	// Live in the SCRIPT, not the frontmatter: Astro compiles this block into
	// its own module, so a frontmatter constant is NOT in scope here - the
	// pre-fix page threw `ReferenceError: Seeds is not defined` on every
	// stream tick and the terminals never filled. The normalizer total comes
	// from the server-rendered tally element's data-total attribute: the
	// script must NOT import @Library/Content, because Content.ts reaches
	// the filesystem through Live.ts (node:fs/node:path) at build time, and
	// bundling that into this browser module crashes it at eval (the
	// `(0, e.join) is not a function` page error that killed the stream
	// ticks entirely).
	const Seeds = [
		"Plan review \u2014 phase one: the config \u201Cdrift\u201D is real\u2026 wait for it\u2026",
		"Balance\u00A0sheet sync \u2014 \u2018quoted\u2019 values\u00A0kept\u2026",
		"Latency\u200Bbudget\uFEFF hit \u2014 p99\u00A0holds\u2026",
		"Batch\u2014two of three\u2013done\u2026 \u201Cclean\u201D\u00A0output only",
	];

	// The ingest engines drive the simulation: each source has its own token
	// pool and its own pacing, so switching the pill visibly changes what the
	// raw buffer receives (and what the gate has to clean). The DeepSeek
	// engine is the governed high-tps stream (the base seeds, 900 ms ticks);
	// the GLM flash engine emits shorter, quicker bursts (450 ms); the raw
	// ingest stream is the unnormalized feed the gate exists for - heavily
	// dirty tokens (fullwidth, stray invisibles, doubled marks) at a slower
	// 1400 ms cadence.
	const GLMSeeds = [
		"Flash route \u2014 cache warm\u2026 tokens 1.2k/s",
		"Stream\u00A0resume \u2014 \u2018delta\u2019 chunk ok\u2026",
		"Spec\u200Btrim \u2014 budget\u00A0held\u2026",
	];
	const RawSeeds = [
		"Ｒaw\u00A0ingest\u00A0—\u200B\u200B \u201Cunchanged\u201D\u2026\u2026 tokens",
		"\uFF24eep\u00A0\uFF53eed \u2018dirty\u2019\u2014\u2014\uFEFF\u2026 pass\u2013through",
		"Buffer\u200B\u200Bdrift\u00A0\u2014 \u201C\u201Cdoubled\u201D\u201D\u2026 marks",
	];
	const EngineSeeds: Record<string, string[]> = {
		deepseek: Seeds,
		glm: GLMSeeds,
		raw: RawSeeds,
	};
	const EngineTicks: Record<string, number> = { deepseek: 900, glm: 450, raw: 1400 };
	let Engine = "deepseek";
	let TickMs = EngineTicks[Engine]!;

	// The runtime selection drives the pipeline simulation as well: the
	// Classic Pipeline ingests one chunk per tick (the sequential for-await
	// loop it mirrors), while the Effect-TS v4 Fiber runtime ingests two
	// chunks per tick (the fibered, concurrent ingestion) - the visible
	// divergence the runtime switch promises.
	const RuntimeBatch: Record<string, number> = { classic: 1, effect: 2 };
	let Runtime = "effect";

	const RawTerminal = document.querySelector<HTMLElement>("[data-stream='raw']")!;
	const CleanTerminal = document.querySelector<HTMLElement>("[data-stream='clean']")!;
	const RawCount = document.querySelector<HTMLElement>("[data-count='raw']")!;
	const CleanCount = document.querySelector<HTMLElement>("[data-count='clean']")!;
	const Tally = document.querySelector<HTMLElement>("[data-hook-tally]")!;
	// The normalizer total, from the server-rendered tally (data-total):
	// the script's replacement for the removed client-side Content import.
	const Total = Number(Tally.dataset["total"] ?? "0");
	const ToggleButton = document.querySelector<HTMLElement>("[data-action='toggle']")!;
	const StreamStage = document.querySelector<HTMLElement>(".stream-grid")!;
	// The last time the accessible stream status carried a byte summary:
	// the announcement throttle's window marker (Render()).
	let LastStatusAt = Date.now();

	// The per-hook transform rules, mirrored from the server-rendered cards.
	const Rules: Record<string, (Text: string) => [string, number]> = {
		dash: (Text) => [
			Text.replace(
				/[\u058A\u05BE\u1400\u1806\u2010-\u2015\u2E17\u2E1A\u2E3A-\u2E3B\u2E40\u2E5D\u301C\u3030\u30A0\uFE31-\uFE32\uFE58\uFE63\uFF0D]/g,
				"-",
			),
			(
				Text.match(
					/[\u058A\u05BE\u1400\u1806\u2010-\u2015\u2E17\u2E1A\u2E3A-\u2E3B\u2E40\u2E5D\u301C\u3030\u30A0\uFE31-\uFE32\uFE58\uFE63\uFF0D]/g,
				) ?? []
			).length,
		],
		quotes: (Text) => [
			Text.replace(/[\u2018\u2019\u201C\u201D]/g, (Mark) =>
				Mark === "\u2018" || Mark === "\u2019" ? "'" : '"',
			),
			(Text.match(/[\u2018\u2019\u201C\u201D]/g) ?? []).length,
		],
		ellipsis: (Text) => [Text.replace(/\u2026/g, "..."), (Text.match(/\u2026/g) ?? []).length],
		spaces: (Text) => [
			Text.replace(/[\u00A0\u1680\u2000-\u200A\u202F\u205F\u3000]/g, " "),
			(Text.match(/[\u00A0\u1680\u2000-\u200A\u202F\u205F\u3000]/g) ?? []).length,
		],
		invisible: (Text) => [
			Text.replace(/[\u00AD\u200B-\u200F\u202A-\u202E\u2060\uFEFF]/g, ""),
			(Text.match(/[\u00AD\u200B-\u200F\u202A-\u202E\u2060\uFEFF]/g) ?? []).length,
		],
		fullwidth: (Text) => [
			Text.replace(/[\uFF01-\uFF5E]/g, (Mark) =>
				String.fromCharCode(Mark.charCodeAt(0) - 0xfee0),
			),
			(Text.match(/[\uFF01-\uFF5E]/g) ?? []).length,
		],
	};

	const Armed = new Set(
		[...document.querySelectorAll<HTMLElement>(".hook-card")]
			.filter((Card) => Card.dataset["armed"] === "true")
			.map((Card) => Card.dataset["hook"]!),
	);

	const Metrics: Record<string, number> = {
		dash: 0,
		quotes: 0,
		ellipsis: 0,
		spaces: 0,
		invisible: 0,
		fullwidth: 0,
	};

	let RawBytes = 0;
	let CleanBytes = 0;
	let Paused = false;
	let HoverPaused = false;
	// The one-pass-then-settle state: RunIndex counts the lines the current
	// pass has played (one pass over the selected engine's pool), Settled
	// marks the pass complete - no pass repeats, so no line repetition ever
	// scrolls the terminals (see the Push/Settle/Restart trio below).
	let RunIndex = 0;
	let Settled = false;

	function Transform(Text: string) {
		let Clean = Text;
		let Hits = 0;
		for (const Hook of Armed) {
			const Rule = Rules[Hook];
			if (!Rule) continue;
			const [Next, Count] = Rule(Clean);
			Clean = Next;
			Hits += Count;
			if (Metrics[Hook] !== undefined) Metrics[Hook] += Count;
		}
		return [Clean, Hits] as const;
	}

	// The raw pane renders with the anomalies flagged inline (the Harness
	// Blue tint spans + the explicit [ZWSP]/[NBSP] markers), exactly the
	// workbench mock's highlight; the clean pane is plain ASCII text.
	function Highlight(Text: string) {
		return Text.replace(/[\u200B-\u200D\uFEFF]/g, '<span class="zwsp">[ZWSP]</span>')
			.replace(/\u00A0/g, '<span class="zwsp">[NBSP]</span>')
			.replace(/[\u2013\u2014\u2015]/g, (Mark) => `<span class="anom">${Mark}</span>`)
			.replace(/[\u2018\u2019\u201C\u201D]/g, (Mark) => `<span class="anom">${Mark}</span>`)
			.replace(/\u2026/g, '<span class="anom">…</span>')
			.replace(/[\uFF01-\uFF5E]/g, (Mark) => `<span class="anom">${Mark}</span>`);
	}

	function Render() {
		let Total = 0;
		for (const [Key, Value] of Object.entries(Metrics)) {
			Total += Value;
			const Node = document.querySelector<HTMLElement>(`[data-metric='${Key}']`);
			if (Node) Node.textContent = Value.toLocaleString("en-US");
		}
		const TotalNode = document.querySelector<HTMLElement>("[data-metric='replacements']");
		if (TotalNode) TotalNode.textContent = Total.toLocaleString("en-US");

		RawCount.textContent = `${RawBytes.toLocaleString("en-US")} bytes`;
		CleanCount.textContent = `${CleanBytes.toLocaleString("en-US")} bytes`;

		// The raw/clean panes' updates, announced at a sane rate: the
		// stream status line (role=status, polite) carries a throttled
		// byte-count summary - at most one announcement per 5 seconds,
		// and never while the stream is paused or hover-paused - so the
		// ingest is perceivable without a per-tick announcement storm
		// (the pane content itself is deliberately NOT a live region).
		const StreamStatus = document.querySelector<HTMLElement>("[data-stream-status]");
		const Now = Date.now();
		if (StreamStatus && !Paused && !HoverPaused && !Settled && Now - LastStatusAt >= 5000) {
			LastStatusAt = Now;
			StreamStatus.textContent = `Stream running\u2003raw ${RawBytes.toLocaleString("en-US")} bytes\u2003normalized ${CleanBytes.toLocaleString("en-US")} bytes`;
		}

		Tally.textContent = `${Armed.size} of ${Total} Active`;
		// The toggle carries the stream state: Pause while a pass plays,
		// Resume while paused, Restart once the pass settles (a settled
		// stream resumes only by a new pass - the click handler below).
		ToggleButton.textContent = Settled ? "Restart Stream" : Paused ? "Resume Stream" : "Pause Stream";
		ToggleButton.classList.toggle("engine-pill--active", Paused);
	}

	function PushChunk() {
		const Pool = EngineSeeds[Engine] ?? Seeds;
		// The deterministic pass order: the pass counter indexes the pool
		// directly (the modulo rule - a pass never repeats a line within
		// itself, and the burst's finite pass uses the same counter), so no
		// random cycling ever scrolls the terminals.
		const Seed = Pool[RunIndex % Pool.length];
		RunIndex += 1;
		const [Clean] = Transform(Seed);
		RawBytes += new TextEncoder().encode(Seed).length;
		CleanBytes += new TextEncoder().encode(Clean).length;

		RawTerminal.insertAdjacentHTML("beforeend", `\u21B3 ${Highlight(Seed)}\n`);
		CleanTerminal.append(`\u21B3 ${Clean}\n`);
		// The live caret rides the tail of each pane.
		RawTerminal.insertAdjacentHTML("beforeend", '<span class="stream-caret"></span>');
		CleanTerminal.insertAdjacentHTML("beforeend", '<span class="stream-caret"></span>');

		if (RawTerminal.scrollHeight > RawTerminal.clientHeight + 400) {
			RawTerminal.textContent = RawTerminal.textContent?.split("\n").slice(-6).join("\n");
			CleanTerminal.textContent = CleanTerminal.textContent?.split("\n").slice(-6).join("\n");
		}
		Render();
	}

	// The pass guard: a push plays the pass's next line(s) - raw and clean
	// beside each other in the same tick - and settles the stream when the
	// selected engine's pool is exhausted. One pass, then the stream stops
	// with the panes keeping the final content; no pass repeats, so no line
	// repetition ever scrolls the terminals. A settled stream has no pass
	// to push - the guard skips its work (the same pattern the hover-pause
	// uses); the restart toggle, the engine/runtime pills and the burst
	// lift the state (Restart below).
	function Push() {
		if (Paused || HoverPaused) return;
		if (Settled) return;
		const Pool = EngineSeeds[Engine] ?? Seeds;
		if (RunIndex >= Pool.length) {
			Settle();
			return;
		}
		const Batch = RuntimeBatch[Runtime] ?? 1;
		for (let Index = 0; Index < Batch && RunIndex < Pool.length; Index += 1) PushChunk();
		if (RunIndex >= Pool.length) Settle();
	}

	// One pass complete: the stage freezes (the .is-settled class - the same
	// motion selectors the hover-pause stills, see Global.css), the hub
	// lands the SETTLED tag, the accessible status announces the settle,
	// and the toggle reads Restart. The tick interval itself keeps running;
	// the push guard skips its work while settled.
	function Settle() {
		if (Settled) return;
		Settled = true;
		StreamStage.classList.add("is-settled");
		const StreamStatus = document.querySelector<HTMLElement>("[data-stream-status]");
		if (StreamStatus) StreamStatus.textContent = "Stream settled\u2003pool played once";
		Render();
	}

	// A new pass: the pass counter resets and the settle state lifts (the
	// stage unfreezes, the hub's SETTLED tag hides, the toggle reads Pause
	// again). Used by the restart toggle, the engine pills (each engine
	// gets its own pass played from the pool's first line), the runtime
	// pills and the burst.
	function Restart() {
		RunIndex = 0;
		Settled = false;
		StreamStage.classList.remove("is-settled");
	}

	// The tick interval is rescheduled when the ingest engine changes (the
	// per-engine pacing above), so a selected engine's cadence takes over
	// the stream immediately.
	let Timer = 0;
	function Schedule() {
		clearInterval(Timer);
		Timer = setInterval(Push, TickMs);
	}
	Schedule();

	// Prime the panes with the pass's first line so the gate reads live on
	// load; the pass plays out over the regular ticks and settles when the
	// selected engine's pool is exhausted (PushChunk's pass counter starts
	// at the pool's top).
	PushChunk();

	// Hover-to-pause on the dual-terminal stage: hovering the raw/clean
	// panes suspends the stream ticks (the push guard returns early) and
	// the .is-paused class freezes the dots, the spin and the caret while
	// the hub shows the PAUSED tag, so the terminals can be read at
	// leisure. Leaving resumes with the next regular tick (the interval
	// itself keeps running; the guard skips its work while hovered). A
	// settled pass has no stream to pause - the settle freeze already
	// stills the motion - so the guards skip it. Reduced-motion users keep
	// the stock behavior - no listeners attached.
	if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
		// The pause/resume is announced through the visually-hidden
		// stream status element (role=status, aria-live=polite above the
		// stage) - the hover-pause state change reaches assistive tech
		// even though the visible PAUSED tag is aria-hidden.
		StreamStage.addEventListener("mouseenter", () => {
			if (HoverPaused || Settled) return;
			HoverPaused = true;
			StreamStage.classList.add("is-paused");
			const StreamStatus = document.querySelector<HTMLElement>("[data-stream-status]");
			if (StreamStatus) StreamStatus.textContent = "Stream paused";
		});
		StreamStage.addEventListener("mouseleave", () => {
			if (!HoverPaused) return;
			HoverPaused = false;
			StreamStage.classList.remove("is-paused");
			const StreamStatus = document.querySelector<HTMLElement>("[data-stream-status]");
			if (StreamStatus && !Settled) StreamStatus.textContent = "Stream running";
		});
	}

	const Toast = (window as any).__dshToast as ((Message: string) => void) | undefined;

	// Hook toggles.
	document.querySelectorAll<HTMLElement>(".hook-card").forEach((Card) => {
		Card.addEventListener("click", () => {
			const Hook = Card.dataset["hook"]!;
			if (Armed.has(Hook)) {
				Armed.delete(Hook);
				Card.classList.replace("is-armed", "is-disarmed");
				Card.dataset["armed"] = "false";
				Card.setAttribute("aria-pressed", "false");
				Toast?.(`Disarmed hook ${Hook.toUpperCase()}`);
			} else {
				Armed.add(Hook);
				Card.classList.replace("is-disarmed", "is-armed");
				Card.dataset["armed"] = "true";
				Card.setAttribute("aria-pressed", "true");
				Toast?.(`Armed hook ${Hook.toUpperCase()}`);
			}
			Render();
		});
	});

	// Toggle all hooks.
	document.querySelector("[data-action='toggle-all']")?.addEventListener("click", () => {
		const All = Armed.size === Total;
		document.querySelectorAll<HTMLElement>(".hook-card").forEach((Card) => {
			const Hook = Card.dataset["hook"]!;
			if (All) Armed.delete(Hook);
			else Armed.add(Hook);
			Card.classList.toggle("is-armed", !All);
			Card.classList.toggle("is-disarmed", All);
			Card.dataset["armed"] = String(!All);
			Card.setAttribute("aria-pressed", String(!All));
		});
		Render();
		Toast?.(
			All
				? `Disarmed all ${Total} hooks`
				: `Armed all ${Total} normalization hooks`,
		);
	});

	// Runtime pills: the selection drives the simulation (the per-runtime
	// batch size above) and the stream status line, then the highlight +
	// toast follow.
	document.querySelectorAll<HTMLElement>("[data-runtime]").forEach((Pill) => {
		Pill.addEventListener("click", () => {
			document
				.querySelectorAll("[data-runtime]")
				.forEach((Item) => {
					Item.removeAttribute("data-active");
					Item.setAttribute("aria-pressed", "false");
				});
			Pill.setAttribute("data-active", "");
			Pill.setAttribute("aria-pressed", "true");
			const Id = Pill.dataset["runtime"]!;
			if (RuntimeBatch[Id]) {
				Runtime = Id;
				// A settled stream resumes by a new pass over the same pool
				// (the batch size is what the switch promises to show); a
				// playing pass keeps its position - only the per-tick
				// batch changes.
				if (Settled) Restart();
				const StreamStatus = document.querySelector<HTMLElement>("[data-stream-status]");
				if (StreamStatus && !Paused && !HoverPaused && !Settled) {
					StreamStatus.innerHTML = `Stream running<span class="dot-sep" aria-hidden="true"></span>${Pill.textContent?.trim()}`;
				}
			}
			Toast?.(`Runtime: ${Pill.textContent?.trim()}`);
		});
	});

	// Engine pills: the selection drives the simulation - the pool and the
	// pacing above switch immediately, then the highlight + toast follow.
	document.querySelectorAll<HTMLElement>("[data-engine]").forEach((Pill) => {
		Pill.addEventListener("click", () => {
			document
				.querySelectorAll("[data-engine]")
				.forEach((Item) => {
					Item.removeAttribute("data-active");
					Item.setAttribute("aria-pressed", "false");
				});
			Pill.setAttribute("data-active", "");
			Pill.setAttribute("aria-pressed", "true");
			const Id = Pill.dataset["engine"]!;
			if (EngineSeeds[Id]) {
				Engine = Id;
				TickMs = EngineTicks[Id] ?? 900;
				Schedule();
				// The selected engine's own pass plays from its pool's first
				// line immediately (a settled stream resumes; a playing pass
				// restarts at the new pool's top - each engine gets its own
				// one-pass stream), then the per-engine cadence takes over
				// the remaining lines.
				Restart();
				Push();
			}
			Toast?.(`Ingest: ${Pill.textContent?.trim()}`);
		});
	});

	// Pause / clear / burst / copy actions.
	ToggleButton.addEventListener("click", () => {
		// A settled stream restarts: a new pass over the selected engine's
		// pool plays from the pool's first line (the settle state lifts, the
		// hub tag hides, the toggle reads Pause again). A settled stream has
		// no stream to pause - the restart IS its resume.
		if (Settled) {
			Restart();
			const StreamStatus = document.querySelector<HTMLElement>("[data-stream-status]");
			if (StreamStatus) StreamStatus.textContent = "Stream running";
			Render();
			Toast?.("Stream restarted");
			return;
		}
		Paused = !Paused;
		ToggleButton.setAttribute("aria-pressed", String(Paused));
		const StreamStatus = document.querySelector<HTMLElement>("[data-stream-status]");
		if (StreamStatus) StreamStatus.textContent = Paused ? "Stream ingest paused" : "Stream running";
		Render();
		Toast?.(Paused ? "Stream ingest paused" : "Stream ingest resumed");
	});

	document.querySelector("[data-action='clear']")?.addEventListener("click", () => {
		RawTerminal.textContent = "";
		CleanTerminal.textContent = "";
		// The clear is the buffers' visual clear only - a playing pass keeps
		// its position (the counter is the pass's state, not the panes'), so
		// the pass plays out deterministically; a settled stream stays
		// settled and restarts by the toggle above.
		Toast?.("Buffers cleared");
	});

	document.querySelector("[data-action='burst']")?.addEventListener("click", () => {
		// The burst synthesizes the selected engine's full pass instantly: a
		// new pass from the pool's first line, played to exhaustion, then
		// settled. Still exactly one pass, so no line repetition; the
		// deterministic order keeps the raw/clean panes paired.
		if (Paused || HoverPaused) return;
		Restart();
		const Pool = EngineSeeds[Engine] ?? Seeds;
		while (RunIndex < Pool.length) PushChunk();
		Settle();
		Toast?.("Synthesized burst ingest");
	});

	document.querySelector("[data-action='copy']")?.addEventListener("click", (Event) => {
		if (navigator.clipboard?.writeText) {
			navigator.clipboard.writeText(CleanTerminal.textContent ?? "");
		}
		const Button = (Event.currentTarget as HTMLElement) ?? null;
		if (Button) {
			const Original = Button.textContent;
			Button.textContent = "COPIED ✓";
			setTimeout(() => {
				if (Original) Button.textContent = Original;
			}, 1400);
		}
		Toast?.("Clean canonical stream copied to clipboard");
	});
</script>
