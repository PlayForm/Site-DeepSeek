---
import "@Stylesheet/Manual.scss";

import CopyButton from "@Component/CopyButton.tsx";
import Icon from "@Component/Icon.astro";
import SessionView from "@Component/SessionView.tsx";
import { Manual } from "@Content/Manual";
import Base from "@Layout/Base.astro";
---

<Base
	Title="Ellipsis"
	Description="A study sheet for hook-dsh-normalize-ellipsis: the decisions, the arms, and the two worlds.">
	<div class="sheet">
		<header class="sheet__head">
			<div class="sheet__identity">
				<span class="sheet__mark">
					<Icon Name="hook-dsh-normalize-ellipsis" Size={64} Priority />
				</span>
				<div class="sheet__titles">
					<h1 class="sheet__title">Ellipsis / the stream rewrite</h1>
					<p class="sheet__subtitle">
						One code point becomes three ASCII dots as the model streams. Show the run,
						explain the decisions, focus the structure, or expand the session; unrelated
						activity stays visible but subdued.
					</p>
				</div>
			</div>
			<p class="sheet__stamp">
				<span class="sheet__lamp" aria-hidden="true"></span>
				<span>Concept / illustrative</span>
			</p>
		</header>

		<dl class="sheet__meta">
			<div class="sheet__meta-item">
				<dt class="sheet__meta-key">package</dt>
				<dd class="sheet__meta-value">@playform/hook-dsh-normalize-ellipsis</dd>
			</div>
			<div class="sheet__meta-item">
				<dt class="sheet__meta-key">version</dt>
				<dd class="sheet__meta-value">0.2.1</dd>
			</div>
			<div class="sheet__meta-item">
				<dt class="sheet__meta-key">kind</dt>
				<dd class="sheet__meta-value">hook</dd>
			</div>
			<div class="sheet__meta-item">
				<dt class="sheet__meta-key">release</dt>
				<dd class="sheet__meta-value">Classic</dd>
			</div>
			<div class="sheet__meta-item">
				<dt class="sheet__meta-key">licence</dt>
				<dd class="sheet__meta-value">CC0-1.0</dd>
			</div>
			<div class="sheet__meta-item">
				<dt class="sheet__meta-key">seam</dt>
				<dd class="sheet__meta-value">llm/stream</dd>
			</div>
		</dl>

		<div class="sheet__modes" role="radiogroup" aria-label="How to read the hook">
			<label class="sheet__mode">
				<input
					class="sheet__mode-input"
					type="radio"
					name="sheet-mode"
					id="mode-show"
					aria-controls="show"
					checked
				/>
				<span class="sheet__mode-face">
					<span class="sheet__mode-index" aria-hidden="true">
						01
					</span>
					<span class="sheet__mode-name">Show</span>
					<span class="sheet__lamp" aria-hidden="true"></span>
				</span>
			</label>
			<label class="sheet__mode">
				<input
					class="sheet__mode-input"
					type="radio"
					name="sheet-mode"
					id="mode-explain"
					aria-controls="explain"
				/>
				<span class="sheet__mode-face">
					<span class="sheet__mode-index" aria-hidden="true">
						02
					</span>
					<span class="sheet__mode-name">Explain</span>
					<span class="sheet__lamp" aria-hidden="true"></span>
				</span>
			</label>
			<label class="sheet__mode">
				<input
					class="sheet__mode-input"
					type="radio"
					name="sheet-mode"
					id="mode-focus"
					aria-controls="focus"
				/>
				<span class="sheet__mode-face">
					<span class="sheet__mode-index" aria-hidden="true">
						03
					</span>
					<span class="sheet__mode-name">Focus</span>
					<span class="sheet__lamp" aria-hidden="true"></span>
				</span>
			</label>
			<label class="sheet__mode">
				<input
					class="sheet__mode-input"
					type="radio"
					name="sheet-mode"
					id="mode-expand"
					aria-controls="expand"
				/>
				<span class="sheet__mode-face">
					<span class="sheet__mode-index" aria-hidden="true">
						04
					</span>
					<span class="sheet__mode-name">Expand</span>
					<span class="sheet__lamp" aria-hidden="true"></span>
				</span>
			</label>
		</div>

		<section class="sheet__panel" id="show" aria-label="The two worlds">
			<div class="sheet__band" data-band="canvas">
				<header class="sheet__band-head">
					<span class="sheet__band-index" aria-hidden="true">
						01
					</span>
					<div class="sheet__band-body">
						<p class="sheet__band-label">The two worlds</p>
						<div class="sheet__band-row">
							<h2 class="sheet__band-title">One stream, with and without the hook</h2>
							<p class="sheet__band-note">
								circles are events &middot; squares are artifacts &middot; diamonds
								are decisions &middot; accent is the live path &middot; grey is
								present but off-path
							</p>
						</div>
					</div>
				</header>

				<div class="sheet__canvas">
					<div class="sheet__ruler" aria-hidden="true">
						<span class="sheet__ruler-key">stage</span>
						<div class="sheet__ruler-track">
							<span class="sheet__ruler-tick">01</span>
							<span class="sheet__ruler-tick">02</span>
							<span class="sheet__ruler-tick">03</span>
							<span class="sheet__ruler-tick">04</span>
							<span class="sheet__ruler-tick">05</span>
							<span class="sheet__ruler-tick">06</span>
							<span class="sheet__ruler-tick">07</span>
							<span class="sheet__ruler-live"></span>
						</div>
					</div>

					<div class="sheet__world">
						<p class="sheet__world-label">Baseline DSH</p>
						<ol class="sheet__track" aria-label="Baseline DSH, seven stages">
							<li class="sheet__node" tabindex="0">
								<span class="sheet__marker" aria-hidden="true"></span>
								<span class="sheet__node-name">Input</span>
								<span class="visually-hidden">event, off-path</span>
							</li>
							<li class="sheet__node" tabindex="0">
								<span class="sheet__marker" aria-hidden="true"></span>
								<span class="sheet__node-name">Request</span>
								<span class="visually-hidden">event, off-path</span>
							</li>
							<li class="sheet__node" tabindex="0">
								<span class="sheet__marker" aria-hidden="true"></span>
								<span class="sheet__node-name">llm/stream</span>
								<span class="visually-hidden">event, off-path</span>
							</li>
							<li class="sheet__node" data-empty="true" tabindex="0">
								<span class="sheet__node-name">no listener</span>
								<span class="visually-hidden">empty, off-path</span>
							</li>
							<li class="sheet__node" tabindex="0">
								<span class="sheet__marker" aria-hidden="true"></span>
								<span class="sheet__node-name">text-delta</span>
								<span class="visually-hidden">event, off-path</span>
							</li>
							<li class="sheet__node" data-shape="square" tabindex="0">
								<span class="sheet__marker" aria-hidden="true"></span>
								<span class="sheet__node-name">transcript</span>
								<span class="sheet__node-bytes">U+2026</span>
								<span class="visually-hidden">artifact, off-path</span>
							</li>
							<li class="sheet__node" tabindex="0">
								<span class="sheet__marker" aria-hidden="true"></span>
								<span class="sheet__node-name">Result</span>
								<span class="visually-hidden">event, off-path</span>
							</li>
						</ol>
					</div>

					<div class="sheet__world" data-family="true">
						<p class="sheet__world-label">DSH + PlayForm</p>
						<ol class="sheet__track" aria-label="DSH with PlayForm, seven stages">
							<li class="sheet__node" tabindex="0">
								<span class="sheet__marker" aria-hidden="true"></span>
								<span class="sheet__node-name">Input</span>
								<span class="visually-hidden">event, off-path</span>
							</li>
							<li class="sheet__node" tabindex="0">
								<span class="sheet__marker" aria-hidden="true"></span>
								<span class="sheet__node-name">Request</span>
								<span class="visually-hidden">event, off-path</span>
							</li>
							<li class="sheet__node" data-live="true" tabindex="0">
								<span class="sheet__marker" aria-hidden="true"></span>
								<span class="sheet__node-name">llm/stream</span>
								<span class="visually-hidden">event, live path</span>
							</li>
							<li
								class="sheet__node"
								data-kind="decision"
								data-live="true"
								tabindex="0">
								<span class="sheet__marker" aria-hidden="true"></span>
								<span class="sheet__node-name">chunk.kind</span>
								<span class="sheet__node-bytes">text / reasoning / tool args</span>
								<span class="visually-hidden">decision, live path</span>
							</li>
							<li class="sheet__node" data-live="true" tabindex="0">
								<span class="sheet__marker" aria-hidden="true"></span>
								<span class="sheet__node-name">text-delta</span>
								<span class="visually-hidden">event, live path</span>
							</li>
							<li
								class="sheet__node"
								data-shape="square"
								data-live="true"
								tabindex="0">
								<span class="sheet__marker" aria-hidden="true"></span>
								<span class="sheet__node-name">transcript</span>
								<span class="sheet__node-bytes">...</span>
								<span class="visually-hidden">artifact, live path</span>
							</li>
							<li class="sheet__node" tabindex="0">
								<span class="sheet__marker" aria-hidden="true"></span>
								<span class="sheet__node-name">Result</span>
								<span class="visually-hidden">event, off-path</span>
							</li>
						</ol>
					</div>

					<div class="sheet__payloads" aria-hidden="true">
						<div class="sheet__payload" data-stage="1">
							<p class="sheet__payload-head">
								<span>stage</span>
								<span class="sheet__payload-index">01 / 07</span>
							</p>
							<dl class="sheet__payload-rows">
								<div class="sheet__payload-row">
									<dt>baseline</dt>
									<dd>
										<span class="sheet__payload-name">Input</span>
										<span class="sheet__payload-kind">event</span>
										<span class="sheet__payload-path" data-live="false">
											off-path
										</span>
									</dd>
								</div>
								<div class="sheet__payload-row">
									<dt>family</dt>
									<dd>
										<span class="sheet__payload-name">Input</span>
										<span class="sheet__payload-kind">event</span>
										<span class="sheet__payload-path" data-live="false">
											off-path
										</span>
									</dd>
								</div>
							</dl>
						</div>
						<div class="sheet__payload" data-stage="2">
							<p class="sheet__payload-head">
								<span>stage</span>
								<span class="sheet__payload-index">02 / 07</span>
							</p>
							<dl class="sheet__payload-rows">
								<div class="sheet__payload-row">
									<dt>baseline</dt>
									<dd>
										<span class="sheet__payload-name">Request</span>
										<span class="sheet__payload-kind">event</span>
										<span class="sheet__payload-path" data-live="false">
											off-path
										</span>
									</dd>
								</div>
								<div class="sheet__payload-row">
									<dt>family</dt>
									<dd>
										<span class="sheet__payload-name">Request</span>
										<span class="sheet__payload-kind">event</span>
										<span class="sheet__payload-path" data-live="false">
											off-path
										</span>
									</dd>
								</div>
							</dl>
						</div>
						<div class="sheet__payload" data-stage="3">
							<p class="sheet__payload-head">
								<span>stage</span>
								<span class="sheet__payload-index">03 / 07</span>
							</p>
							<dl class="sheet__payload-rows">
								<div class="sheet__payload-row">
									<dt>baseline</dt>
									<dd>
										<span class="sheet__payload-name">llm/stream</span>
										<span class="sheet__payload-kind">event</span>
										<span class="sheet__payload-path" data-live="false">
											off-path
										</span>
									</dd>
								</div>
								<div class="sheet__payload-row">
									<dt>family</dt>
									<dd>
										<span class="sheet__payload-name">llm/stream</span>
										<span class="sheet__payload-kind">event</span>
										<span class="sheet__payload-path" data-live="true">
											live path
										</span>
									</dd>
								</div>
							</dl>
						</div>
						<div class="sheet__payload" data-stage="4">
							<p class="sheet__payload-head">
								<span>stage</span>
								<span class="sheet__payload-index">04 / 07</span>
							</p>
							<dl class="sheet__payload-rows">
								<div class="sheet__payload-row">
									<dt>baseline</dt>
									<dd>
										<span class="sheet__payload-name">no listener</span>
										<span class="sheet__payload-kind">none</span>
										<span class="sheet__payload-path" data-live="false">
											off-path
										</span>
									</dd>
								</div>
								<div class="sheet__payload-row">
									<dt>family</dt>
									<dd>
										<span class="sheet__payload-name">chunk.kind</span>
										<span class="sheet__payload-kind">decision</span>
										<span class="sheet__payload-bytes">
											text / reasoning / tool args
										</span>
										<span class="sheet__payload-path" data-live="true">
											live path
										</span>
									</dd>
								</div>
							</dl>
						</div>
						<div class="sheet__payload" data-stage="5">
							<p class="sheet__payload-head">
								<span>stage</span>
								<span class="sheet__payload-index">05 / 07</span>
							</p>
							<dl class="sheet__payload-rows">
								<div class="sheet__payload-row">
									<dt>baseline</dt>
									<dd>
										<span class="sheet__payload-name">text-delta</span>
										<span class="sheet__payload-kind">event</span>
										<span class="sheet__payload-path" data-live="false">
											off-path
										</span>
									</dd>
								</div>
								<div class="sheet__payload-row">
									<dt>family</dt>
									<dd>
										<span class="sheet__payload-name">text-delta</span>
										<span class="sheet__payload-kind">event</span>
										<span class="sheet__payload-path" data-live="true">
											live path
										</span>
									</dd>
								</div>
							</dl>
						</div>
						<div class="sheet__payload" data-stage="6">
							<p class="sheet__payload-head">
								<span>stage</span>
								<span class="sheet__payload-index">06 / 07</span>
							</p>
							<dl class="sheet__payload-rows">
								<div class="sheet__payload-row">
									<dt>baseline</dt>
									<dd>
										<span class="sheet__payload-name">transcript</span>
										<span class="sheet__payload-kind">artifact</span>
										<span class="sheet__payload-bytes">U+2026</span>
										<span class="sheet__payload-path" data-live="false">
											off-path
										</span>
									</dd>
								</div>
								<div class="sheet__payload-row">
									<dt>family</dt>
									<dd>
										<span class="sheet__payload-name">transcript</span>
										<span class="sheet__payload-kind">artifact</span>
										<span class="sheet__payload-bytes">...</span>
										<span class="sheet__payload-path" data-live="true">
											live path
										</span>
									</dd>
								</div>
							</dl>
						</div>
						<div class="sheet__payload" data-stage="7">
							<p class="sheet__payload-head">
								<span>stage</span>
								<span class="sheet__payload-index">07 / 07</span>
							</p>
							<dl class="sheet__payload-rows">
								<div class="sheet__payload-row">
									<dt>baseline</dt>
									<dd>
										<span class="sheet__payload-name">Result</span>
										<span class="sheet__payload-kind">event</span>
										<span class="sheet__payload-path" data-live="false">
											off-path
										</span>
									</dd>
								</div>
								<div class="sheet__payload-row">
									<dt>family</dt>
									<dd>
										<span class="sheet__payload-name">Result</span>
										<span class="sheet__payload-kind">event</span>
										<span class="sheet__payload-path" data-live="false">
											off-path
										</span>
									</dd>
								</div>
							</dl>
						</div>
					</div>

					<div class="sheet__caption">
						<span class="sheet__caption-pair">
							<span class="sheet__caption-key">selected</span>
							<span class="sheet__caption-value" data-tone="accent">
								hook-dsh-normalize-ellipsis
							</span>
						</span>
						<span class="sheet__caption-pair">
							<span class="sheet__caption-key">seam</span>
							<span class="sheet__caption-value">llm/stream</span>
						</span>
						<span class="sheet__caption-pair">
							<span class="sheet__caption-key">layer</span>
							<span class="sheet__caption-value">visible</span>
						</span>
					</div>
				</div>
			</div>

			<div class="sheet__band" data-band="cards">
				<header class="sheet__band-head">
					<span class="sheet__band-index" aria-hidden="true">
						02
					</span>
					<div class="sheet__band-body">
						<p class="sheet__band-label">The artifacts</p>
						<div class="sheet__band-row">
							<h2 class="sheet__band-title">What the bytes are, on either side</h2>
							<p class="sheet__band-note">
								one code point counted &middot; three characters written
							</p>
						</div>
					</div>
				</header>

				<div class="sheet__cards" data-count="three">
					<article class="sheet__card" tabindex="0">
						<header class="sheet__card-head">
							<p class="sheet__card-label">Baseline artifact</p>
							<span class="sheet__card-tag">before</span>
						</header>
						<p class="sheet__card-value" data-tone="baseline">
							Loading&hellip;
						</p>
						<p class="sheet__card-note">
							The bytes the adapter streamed, with no listener on the seam.
						</p>
					</article>
					<article class="sheet__card" data-accent="true" tabindex="0">
						<header class="sheet__card-head">
							<p class="sheet__card-label">PlayForm artifact</p>
							<span class="sheet__card-tag" data-tone="accent">
								after
							</span>
						</header>
						<p class="sheet__card-value">Loading...</p>
						<p class="sheet__card-note">
							The same chunk after the rewrite: one code point counted, three
							characters written.
						</p>
					</article>
					<article class="sheet__card" tabindex="0">
						<header class="sheet__card-head">
							<p class="sheet__card-label">Explanation</p>
						</header>
						<dl class="sheet__card-facts">
							<div class="sheet__card-fact">
								<dt>kind</dt>
								<dd>text-delta</dd>
							</div>
							<div class="sheet__card-fact">
								<dt>reasoning</dt>
								<dd>on</dd>
							</div>
							<div class="sheet__card-fact">
								<dt>toolArgs</dt>
								<dd>off</dd>
							</div>
							<div class="sheet__card-fact">
								<dt>exempt</dt>
								<dd>no</dd>
							</div>
							<div class="sheet__card-fact">
								<dt>count</dt>
								<dd>2</dd>
							</div>
						</dl>
						<p class="sheet__card-note">
							The text and reasoning paths rewrote; the tool path passed by identity.
						</p>
					</article>
				</div>
			</div>
		</section>

		<section class="sheet__panel" id="explain" aria-label="The decisions">
			<div class="sheet__band" data-band="lead">
				<header class="sheet__band-head">
					<span class="sheet__band-index" aria-hidden="true">
						01
					</span>
					<div class="sheet__band-body">
						<p class="sheet__band-label">The decisions</p>
						<div class="sheet__band-row">
							<h2 class="sheet__band-title">The dispatch, branch by branch</h2>
							<p class="sheet__band-note">
								every branch below exists in Source/Function/Chunk.ts and Block.ts
							</p>
						</div>
					</div>
				</header>

				<ol class="sheet__spine">
					<li class="sheet__decision">
						<span class="sheet__decision-index" aria-hidden="true">
							01
						</span>
						<details class="sheet__decision-open" open>
							<summary class="sheet__decision-summary">
								<span class="sheet__diamond" aria-hidden="true"></span>
								<span class="sheet__decision-name">chunk.kind</span>
								<span class="sheet__decision-exits">
									<span class="sheet__exit">text-delta</span>
									<span class="sheet__exit">reasoning-delta</span>
									<span class="sheet__exit">tool-call-delta</span>
									<span class="sheet__exit">block-end</span>
									<span class="sheet__exit" data-tone="identity">
										other: identity
									</span>
								</span>
								<span class="sheet__decision-caret" aria-hidden="true"></span>
							</summary>
							<div class="sheet__decision-why">
								<span class="sheet__decision-key">condition</span>
								<span class="sheet__decision-condition">
									switch (true) on Input.type
								</span>
							</div>
						</details>
					</li>
					<li class="sheet__decision">
						<span class="sheet__decision-index" aria-hidden="true">
							02
						</span>
						<details class="sheet__decision-open">
							<summary class="sheet__decision-summary">
								<span class="sheet__diamond" aria-hidden="true"></span>
								<span class="sheet__decision-name">scopes.conversation</span>
								<span class="sheet__decision-exits">
									<span class="sheet__exit" data-tone="replace">
										on: replace text
									</span>
									<span class="sheet__exit" data-tone="identity">
										off: identity
									</span>
								</span>
								<span class="sheet__decision-caret" aria-hidden="true"></span>
							</summary>
							<div class="sheet__decision-why">
								<span class="sheet__decision-key">condition</span>
								<span class="sheet__decision-condition">
									Input.type === "text-delta" &amp;&amp; Conversation
								</span>
							</div>
						</details>
					</li>
					<li class="sheet__decision">
						<span class="sheet__decision-index" aria-hidden="true">
							03
						</span>
						<details class="sheet__decision-open">
