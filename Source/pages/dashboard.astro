---
import PageHero from "@Component/PageHero.astro";
import Base from "@Layout/Base.astro";
import { Route } from "@Library/Link";

// The board is a section of the observability page now. The address keeps
// working: the meta refresh moves a reader who followed an old link, and the
// one button is the same destination for a reader who lands before it fires.
const Target = `${Route.Trace}#board`;
---

<Base
	Title="Dashboard"
	Description="The board moved: the counts and the ledger paths are the board section of the trace page.">
	<Fragment slot="Head">
		<meta http-equiv="refresh" content="0; url=/trace/#board" />
	</Fragment>
	<PageHero Eyebrow="Observability" Title="The board moved">
		<Fragment slot="Lede">
			The counts and the ledger paths are now the board section of the trace page, which reads
			the same run as a document, a lane, a graph, and a coverage grid.
		</Fragment>
	</PageHero>
	<div class="cluster">
		<a class="button" href={Target}>
			The board
		</a>
	</div>
</Base>
