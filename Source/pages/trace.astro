---
import "@Stylesheet/Component/TracePage.scss";

import PageHero from "@Component/PageHero.astro";
import SessionView from "@Component/SessionView.tsx";
import { Record, Step, Turn } from "@Content/Session";
import Base from "@Layout/Base.astro";

// The four machines, in the order the page reads them: the lane first, then
// the tree, the document, and the inspector in one row.
const Machine = [
	{ Name: "Lane", Id: "lane" },
	{ Name: "Tree", Id: "tree" },
	{ Name: "Document", Id: "document" },
	{ Name: "Inspector", Id: "inspector" },
];
---

<Base
	Title="Session"
	Description={`One heavy session as a lane strip, a tree, a document, and an inspector: ${Record.length} records across ${Step.length} steps and ${Turn.length} turns, with the family's plugins acting on the records they touch.`}
>
	<PageHero Eyebrow="Observability" Title="A run, twice">
		<Fragment slot="Lede">
			One heavy session, read four ways: the lanes it occupied, the tree it left, the
			document it wrote, and the record the reader selects. The switch turns the family
			off, and the same run changes in place.
		</Fragment>
		<Fragment slot="Actions">
			<nav class="trace-page__index" aria-label="The machines">
				{Machine.map((Entry) => (
					<a href={`#${Entry.Id}`}>{Entry.Name}</a>
				))}
			</nav>
		</Fragment>
	</PageHero>

	<SessionView client:load />
</Base>
