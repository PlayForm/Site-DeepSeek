---
import "@Stylesheet/Component/TracePage.scss";

import Callout from "@Component/Callout.astro";
import Inspector from "@Component/Inspector.astro";
import PageHero from "@Component/PageHero.astro";
import Pending from "@Component/Pending.astro";
import SectionHeader from "@Component/SectionHeader.astro";
import Term from "@Component/Term.astro";
import Trace from "@Component/Trace.astro";
import { Record as Fixture } from "@Content/Trace";
import Base from "@Layout/Base.astro";
import { Route } from "@Library/Link";
import { Session } from "@Library/Session.server";

// A real log when the build can reach one, the authored fixture when it cannot.
// The page says which it is, because a trace that silently swaps its source is
// a trace a reader cannot trust.
const Record = Session.Live ? Session.Record : Fixture;
const Source = Session.Live
	? `read from a session log at build time: ${Session.Record.length} of its records, in log order`
	: `the authored fixture, because ${Session.Note ?? "no log was reachable"}`;

const Durable = Record.filter((Entry) => Entry.Durable).length;
const Live = Record.length - Durable;

// The inspector opens on the first record of whichever source the page reads,
// and its tabs are built from the four records that open the turn: the same
// four names the trace beside it starts with.
const Opening = Record.slice(0, 4);
const DurableOpening = Opening.filter((Entry) => Entry.Durable).length;
const LiveOpening = Opening.length - DurableOpening;
const Subject = Opening[0]?.Name ?? "the turn";

// The contract of one session event, in the shape the log writes it.
const Event = [
	{
		Name: "seq",
		Type: "number",
		Required: true,
		Description: "The position the log assigns the event.",
	},
	{
		Name: "type",
		Type: "string",
		Required: true,
		Description: "The event name, as the harness writes it.",
	},
	{
		Name: "data",
		Type: "object",
		Required: true,
		Description: "The payload the event carries.",
	},
];

// A record carries a payload only when the fixture wrote one; a real log slice
// shows the event name and what it proves, and the tab says so instead of
// rendering an empty block.
const Payload = (Opening[0] as { Payload?: string } | undefined)?.Payload;

const Tab = [
	{
		Label: "Summary",
		Body: `${Opening.length} records open the turn: ${DurableOpening} durable, ${LiveOpening} live.`,
	},
	{
		Label: "Payload",
		Body:
			Payload ??
			"The record carries no payload in this slice: the page shows the name, the kind, and what it proves.",
		Kind: (Payload === undefined ? "text" : "code") as "text" | "code",
	},
	{
		Label: "Schema",
		Body: "One session event, as the log writes it.",
		Kind: "schema" as const,
		Properties: Event,
	},
	{
		Label: "Timing",
		Body: Session.Live
			? "The log carries a wall clock per record; this slice shows the order and not the durations."
			: "The fixture carries no timings, so this tab states the order and nothing else.",
	},
];

// The call with no result yet: the last tool call the log answers no result for.
const Call = Record.filter((Entry) => Entry.Kind === "tool" && Entry.Name === "tool/call");
const Result = Record.filter((Entry) => Entry.Kind === "tool" && Entry.Name === "tool/result");
const Waiting = [...Call]
	.reverse()
	.find((Entry) => !Result.some((Answer) => Answer.Index > Entry.Index));
---

<Base
	Title="Trace"
	Description={`What one turn leaves in the session log: ${Record.length} records, and the ones a reload keeps.`}>
	<PageHero Eyebrow="Trace" Title="What a run leaves">
		<Fragment slot="Lede">
			One turn writes {Record.length}&nbsp;records. {Durable}&nbsp;survive a reload and {Live}
			&nbsp;exist only while the process runs, which is the difference between
			a&nbsp;<Term Name="trace" /> and a live view.
		</Fragment>
	</PageHero>

	<section class="section">
		<SectionHeader
			Title="Record"
			Lede="Read top to bottom. The solid rail is a record the log keeps; the dashed rail is one the process drops when it ends."
		/>
		<p class="muted">{Source}.</p>
		<div class="section__body trace-page">
			<div class="trace-page__document">
				<Trace Record={Record} />
				{Waiting && <Pending Name={Waiting.Name} Meta={Waiting.Proves} />}
			</div>
			<aside class="trace-page__inspector">
				<Inspector Subject={Subject} Tab={Tab} />
			</aside>
		</div>
	</section>

	<section class="section">
		<SectionHeader
			Title="Rule"
			Lede="The harness keeps the facts and drops the frames, and the family adds to the kept side."
		/>
		<div class="section__body stack">
			<Callout Title="Durable" Tone="note">
				A durable record is what the session log projects the next request from, so a reader
				who reloads the page sees exactly the messages the model saw.
			</Callout>
			<Callout Title="Live" Tone="note">
				A live frame exists so a client can render the turn while it happens. It is not part
				of the log, and a hard stop before settlement leaves no trace of it.
			</Callout>
			<Callout Title="Added" Tone="warn">
				The family writes beside the log, not into it: a ledger line per hook, a journal per
				write, a cost row per event. That is what makes a run inspectable after the process
				ends.
			</Callout>
		</div>
	</section>

	<section class="section">
		<SectionHeader
			Title="Next"
			Lede="The same model, driven by a real trace, is the dashboard this site is built toward."
		/>
		<div class="section__body stack">
			<p class="lede">
				Every record above is a row the dashboard would read, and every ledger the family
				writes is a column it would add. The page is static today and the layout is the one
				a live source would fill.
			</p>
			<div class="cluster">
				<a class="button" href={Route.Turn}>
					The turn
				</a>
				<a class="button button--quiet" href={Route.Connect}>
					The ledgers
				</a>
			</div>
		</div>
	</section>
</Base>
