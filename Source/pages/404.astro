---
import Base from "@Layout/Base.astro";

import PageHero from "@Component/PageHero.astro";
import SectionHeader from "@Component/SectionHeader.astro";

import { Sitemap } from "@Library/Links";
---

<Base
	Title="Page not found"
	Description="The route does not exist. The sitemap lists every page the site builds."
>
	<PageHero
		Eyebrow="404"
		Title="This route does not exist"
		Lede="The site builds a fixed set of routes. The sitemap below names every one of them."
	/>

	<section class="section">
		<SectionHeader Title="Every route the site builds" />
		<div class="section__body">
			<ul class="grid">
				{
					Sitemap.map((Entry) => (
						<li>
							<a href={Entry.Href}>{Entry.Label}</a>
						</li>
					))
				}
			</ul>
		</div>
	</section>
</Base>
