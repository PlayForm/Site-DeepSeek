---
import PageHero from "@Component/PageHero.astro";
import SectionHeader from "@Component/SectionHeader.astro";
import Base from "@Layout/Base.astro";
import { Sitemap } from "@Library/Link";
---

<Base Title="Page not found" Description="The route does not exist.">
	<PageHero Eyebrow="404" Title="Page not found" Lede="The page you asked for is not here." />

	<section class="section">
		<SectionHeader Title="Pages" />
		<div class="section__body">
			<ul class="grid">
				{Sitemap.map((Entry) => (
					<li>
						<a href={Entry.Href}>{Entry.Label}</a>
					</li>
				))}
			</ul>
		</div>
	</section>
</Base>
