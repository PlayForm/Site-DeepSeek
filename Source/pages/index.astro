<script>
	// The live stream gate preview: the same per-flavor rules the workbench
	// runs, compressed into the hero. Raw tokens enter the left pane flagged;
	// the pipe pulse carries them through the gate; clean ASCII lands in the
	// right pane. Both panes are height-bounded, so every generation appends
	// the next response inside the panes and the page below never shifts.
	//
	// The stream is one-pass-then-settle: the tick loop plays each sample
	// line exactly once (raw and clean beside it in the same tick) and when
	// the pass completes the stream settles - the interval stops, the panes
	// keep the final content, the caret/pulse freeze, and the status lands
	// the SETTLED state. No pass repeats, so no line repetition; a settled
	// pass restarts on click.
	const Seeds = [
		"Plan review \u2014 phase one: the config \u201Cdrift\u201D is real\u2026 wait for it\u2026",
		"Balance\u00A0sheet sync \u2014 \u2018quoted\u2019 values\u00A0kept\u2026",
		"Latency\u200Bbudget\uFEFF hit \u2014 p99\u00A0holds\u2026",
		"Batch\u2014two of three\u2013done\u2026 \u201Cclean\u201D\u00A0output only",
	];

	const Raw = document.querySelector<HTMLElement>("[data-demo-raw]")!;
	const Clean = document.querySelector<HTMLElement>("[data-demo-clean]")!;
	const Status = document.querySelector<HTMLElement>("[data-demo-status]")!;
	const Demo = document.querySelector<HTMLElement>("[data-demo]")!;
	let Chars = 0;
	let Index = 0;
	let Paused = false;
	// The one-pass-then-settle state: Settled marks the sample pass complete
	// (the Tick/Settle pair below).
	let Settled = false;
	let Timer: ReturnType<typeof setInterval> | undefined;

	function CleanUp(Text: string) {
		let Out = Text;
		const Hits = (Pattern: RegExp, To: string | ((Mark: string) => string)) => {
			Out = Out.replace(Pattern, To as (Mark: string) => string);
		};
		Hits(/[\u2013\u2014\u2015]/g, "-");
		Hits(/[\u2018\u2019]/g, "'");
		Hits(/[\u201C\u201D]/g, '"');
		Hits(/\u2026/g, "...");
		Hits(/\u00A0/g, " ");
		Hits(/[\u200B-\u200D\uFEFF]/g, "");
		Hits(/[\uFF01-\uFF5E]/g, (Mark) => String.fromCharCode(Mark.charCodeAt(0) - 0xfee0));
		return Out;
	}

	function Highlight(Text: string) {
		return Text.replace(/[\u200B-\u200D\uFEFF]/g, '<span class="zwsp">[ZWSP]</span>')
			.replace(/\u00A0/g, '<span class="zwsp">[NBSP]</span>')
			.replace(/[\u2013\u2014\u2015]/g, (Mark) => `<span class="anom">${Mark}</span>`)
			.replace(/[\u2018\u2019\u201C\u201D]/g, (Mark) => `<span class="anom">${Mark}</span>`)
			.replace(/\u2026/g, '<span class="anom">…</span>')
			.replace(/[\uFF01-\uFF5E]/g, (Mark) => `<span class="anom">${Mark}</span>`);
	}

	// The pane bound the trim guard relies on: the screen's fixed 96px height
	// in Global.css (4 lines of 18px + 24px of padding). clientHeight stays
	// constant, so scrollHeight exceeds it the moment the newest response no
	// longer fits - the oldest rows scroll out until it fits again, and the
	// pane's footprint on the page never changes.
	function AppendResponse(Pane: HTMLElement, Line: string) {
		Pane.insertAdjacentHTML(
			"beforeend",
			`<div class="terminal-demo__line">\u21B3 ${Line}<span class="stream-caret"></span></div>`,
		);
		while (Pane.scrollHeight > Pane.clientHeight) {
			Pane.firstElementChild?.remove();
		}
	}

	// The one-pass-then-settle tick: the pass counter indexes the sample
	// pool directly (no modulo, no cycling), so each sample line plays
	// exactly once and raw/clean stay beside each other in the same tick.
	// When the pool is exhausted the stream settles and the tick guard
	// keeps the interval's later fires inert.
	function Tick() {
		if (Index >= Seeds.length) {
			Settle();
			return;
		}
		const Seed = Seeds[Index];
		Index += 1;
		const Before = Seed;
		const After = CleanUp(Seed);
		Chars += (
			Before.match(
				/[\u2013\u2014\u2015\u2018\u2019\u201C\u201D\u2026\u00A0\u200B-\u200D\uFEFF\uFF01-\uFF5E]/g,
			) ?? []
		).length;

		AppendResponse(Raw, Highlight(Before));
		AppendResponse(Clean, After);

		Status.innerHTML = `NORMALIZING<span class="dot-sep" aria-hidden="true"></span>${Chars.toLocaleString("en-US")} CHARS`;
		if (Index >= Seeds.length) Settle();
	}

	// One pass complete: the interval stops (no pending tick can flush), the
	// panes keep the final content, and the caret/pulse settle with the
	// stage class (the .is-settled rules in Global.css - the same motion
	// selectors the hover-pause stills). The status lands the settled state:
	// only the word SETTLED carries the primary-blue token (the normalized
	// signature; see the .status-settled rule in Global.css), the separator
	// and the rest keep the status's own color. The string is a static
	// literal, so innerHTML is safe here.
	function Settle() {
		Settled = true;
		StopStreaming();
		Demo.classList.add("is-settled");
		Status.innerHTML = `<span class="status-settled">SETTLED</span><span class="dot-sep" aria-hidden="true"></span>${Chars.toLocaleString("en-US")} CHARS NORMALIZED`;
	}

	function StartStreaming() {
		if (Timer) return;
		Timer = setInterval(Tick, 1600);
	}

	// The interval is cleared, not paused-by-flag: on resume it restarts with
	// a full 1.6s cadence, so no pending tick can flush and the stream picks
	// up with the next regular tick.
	function StopStreaming() {
		if (Timer) {
			clearInterval(Timer);
			Timer = undefined;
		}
	}

	StartStreaming();
	Tick();

	// Hover-to-pause: hovering the gate preview stops the tick loop and
	// freezes the caret and the pipe pulse (the .is-paused class) so the
	// panes can be read at leisure; leaving resumes with the next regular
	// tick. A settled pass has no stream to pause - the settle freeze
	// already stills the animations - so the guards skip it. Reduced-motion
	// users keep the stock behavior - the guard already stills the
	// animations, so no listeners are attached.
	if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
		Demo.addEventListener("mouseenter", () => {
			if (Paused || Settled) return;
			Paused = true;
			Demo.classList.add("is-paused");
			// The split status: only the word PAUSED carries the accent-orange
			// token - the separator and the rest keep the status's own color
			// (see the .status-paused rule in Global.css). The string is a
			// static literal, so innerHTML is safe here.
			Status.innerHTML =
				'<span class="status-paused">PAUSED</span><span class="dot-sep" aria-hidden="true"></span>HOVER TO RESUME';
			StopStreaming();
		});
		Demo.addEventListener("mouseleave", () => {
			if (!Paused) return;
			Paused = false;
			Demo.classList.remove("is-paused");
			if (Settled) return;
			Status.innerHTML = `NORMALIZING<span class="dot-sep" aria-hidden="true"></span>${Chars.toLocaleString("en-US")} CHARS`;
			StartStreaming();
		});
	}

	// A settled pass restarts on click: the panes clear, the counters reset,
	// and the same one-pass stream plays again - still exactly once per
	// pass, so no repetition. During a pass (or a hover-pause) the click is
	// ignored; the guard keeps the restart a settled-state affordance. The
	// restart is motion-independent, so it works for reduced-motion users
	// too (their animations are stillled by the global guard).
	Demo.addEventListener("click", () => {
		if (!Settled) return;
		Settled = false;
		Index = 0;
		Chars = 0;
		Raw.textContent = "";
		Clean.textContent = "";
		Demo.classList.remove("is-settled");
		Status.innerHTML = `NORMALIZING<span class="dot-sep" aria-hidden="true"></span>0 CHARS`;
		StartStreaming();
		Tick();
	});

	// ---- The coach judge demo: the tier ladder + the strike accumulation
	// ---- (the tool-coach section above) - implemented as a PROPER, TYPED
	// ---- STATE MACHINE (the user's feedback: toggle-able, properly typed,
	// ---- deterministic, structured). The design:
	//
	// The states (the discriminated union `CoachState` - what the coach IS
	// doing, mirroring the real module's ladder semantics):
	//   idle      - no call judged yet;
	//   judging   - a call judged within the window (the verdict rides the
	//               state);
	//   noting    - a tier-1 note fired (the 3rd same-class strike);
	//   escalated - tier-2 section on (6 total offenses);
	//   denied    - a tier-3 deny fired (enforce armed, write-class call);
	//   cleared   - the section cleared (4 clean calls in the window).
	//
	// The events (`CoachEvent`): each call card maps to ONE defined judge
	// transition (clean/exempt/read/write), the tier cells map to the focus
	// toggle, the enforce chip maps to the arm toggle.
	//
	// The effects (`CoachEffect[]`): what a transition asks the render to
	// apply - the ledger lines, the tier notices, the verdict flash, the
	// ladder lights. The step is deterministic: same machine + same event =
	// same transition.
	//
	// The context (`CoachContext`): the strike accumulation the ladder
	// semantics read (the per-class strikes, the total offenses, the clean
	// streak, the enforce arm, the section state, the reached tiers).
	//
	// The render is one deterministic function of the machine: the ladder's
	// focus + lights, the focus area's explanation, the status (the strike
	// count + the exact state word), the enforce chip, and the call cards'
	// verdict flashes. The COPY (the tier texts, the call labels, the
	// ledger strings) stays byte-exact - only the interactivity + the state
	// structure changed. The copy comes from hook-dsh-tool-coach's
	// README/SCHEME; the ledger lines are the module's byte-exact templates
	// instantiated with the demo's own calls.
	const TierExplanations: Record<string, string> = {
		"0": "Tier 0 - the durable log: every detected offense logs offense <tool> <class> <pattern> immediately, and the model sees nothing. Exemptions log exempt <tool> <pattern-head> only when a row would have matched.",
		"1": "Tier 1 - the note: the offense's class reaching threshold (3) strikes within window (8) judged calls, with cooldown (10) between notes, appends a UserMessage additionalContexts note - source {kind: 'tool-coach', form: 'notice', summary: '<tool> <class> \u00d7 <n>'} - naming the correct tool with its LIVE registry description.",
		"2": "Tier 2 - the persistent section: total offenses since the last note reaching escalateThreshold (6) turn on the system-prompt/assemble 'Tool discipline' section - 3 fixed rules plus the live-fetched tool table (maxSectionTools 8 rows max); off again after cleanWindow (12) clean calls.",
		"3": "Tier 3 - the deny: enforce ('off' | 'write' | 'all') armed and per-class strikes since the last note reaching enforceThreshold (4), the tools/pre-execute listener returns {kind: 'deny', reason} - the deny reason IS the lesson. Discovery and control are NEVER denied.",
	};

	// The demo's machine types.
	type TierN = "0" | "1" | "2" | "3";
	type CallKind = "clean" | "read" | "write" | "exempt";

	// The states: the discriminated union of the ladder phases.
	type CoachState =
		| { Kind: "idle" }
		| { Kind: "judging"; Call: CallKind; Verdict: "clean" | "offense" }
		| { Kind: "noting"; Call: CallKind }
		| { Kind: "escalated" }
		| { Kind: "denied"; Call: CallKind }
		| { Kind: "cleared" };

	// The state words: the exact machine state, visible in the status area.
	const StateWords: Record<CoachState["Kind"], string> = {
		idle: "IDLE",
		judging: "JUDGING",
		noting: "NOTING",
		escalated: "ESCALATED",
		denied: "DENIED",
		cleared: "CLEARED",
	};

	// The events: the demo's inputs.
	type CoachEvent =
		| { Kind: "judge"; CallKind: CallKind; Pattern: string; Target: HTMLElement }
		| { Kind: "tier"; Tier: TierN }
		| { Kind: "enforce" };

	// The effects: what a transition asks the render to apply.
	type CoachEffect =
		| { Kind: "line"; Text: string; Mod?: string }
		| { Kind: "notice"; HTML: string }
		| { Kind: "light"; Tier: TierN }
		| { Kind: "verdict"; Target: HTMLElement; Verdict: "clean" | "offense" };

	// The strike context: the accumulation the ladder semantics read.
	interface CoachContext {
		ReadStrikes: number;
		WriteStrikes: number;
		TotalOffenses: number;
		CleanStreak: number;
		EnforceArmed: boolean;
		SectionOn: boolean;
		Reached: Set<TierN>;
	}

	// The machine: the state + the focus + the context.
	interface CoachMachine {
		State: CoachState;
		Focus: TierN | null;
		Context: CoachContext;
	}

	// The transition: the next machine + the effects to apply.
	interface CoachTransition {
		Machine: CoachMachine;
		Effects: CoachEffect[];
	}

	const CoachFocus = document.querySelector<HTMLElement>("[data-coach-focus]")!;
	const CoachScreen = document.querySelector<HTMLElement>("[data-coach-screen]")!;
	const CoachStatus = document.querySelector<HTMLElement>("[data-coach-status]")!;
	const TierButtons = [...document.querySelectorAll<HTMLElement>("[data-coach-tier]")];
	const CallButtons = [...document.querySelectorAll<HTMLElement>("[data-coach-call]")];
	const EnforceButton = document.querySelector<HTMLElement>("[data-coach-enforce]")!;

	function PushLine(Text: string, Mod = "") {
		const Line = document.createElement("div");
		Line.className = `coach__line${Mod ? ` coach__line--${Mod}` : ""}`;
		Line.textContent = Text;
		CoachScreen.appendChild(Line);
		CoachScreen.scrollTop = CoachScreen.scrollHeight;
	}

	// The notice blocks: innerHTML with static literals only (the text is
	// page-authored, never user data).
	function PushNotice(HTML: string) {
		const Note = document.createElement("div");
		Note.className = "coach__notice";
		Note.innerHTML = HTML;
		CoachScreen.appendChild(Note);
		CoachScreen.scrollTop = CoachScreen.scrollHeight;
	}

	// The initial machine: the shipped markup's default (tier 0 focused,
	// the ledger idle, no strikes, no reached tiers).
	let Machine: CoachMachine = {
		State: { Kind: "idle" },
		Focus: "0",
		Context: {
			ReadStrikes: 0,
			WriteStrikes: 0,
			TotalOffenses: 0,
			CleanStreak: 0,
			EnforceArmed: false,
			SectionOn: false,
			Reached: new Set<TierN>(),
		},
	};

	// The step: deterministic - same machine + same event = same
	// transition. The context is a fresh copy per judge transition (the
	// step owns it; the previous machine object is discarded).
	function transition(Machine: CoachMachine, Event: CoachEvent): CoachTransition {
		switch (Event.Kind) {
			// The tier focus toggle: clicking the focused tier deselects it
			// (no focus, no explanation); clicking another focuses it. The
			// render guarantees only one active at a time.
			case "tier":
				return {
					Machine: { ...Machine, Focus: Machine.Focus === Event.Tier ? null : Event.Tier },
					Effects: [],
				};
			// The enforce arm toggle: arming lights tier 3 (the deny path is
			// reachable); disarming keeps the reached light (the ladder
			// reflects the tiers the machine has reached).
			case "enforce": {
				const Context = { ...Machine.Context, EnforceArmed: !Machine.Context.EnforceArmed };
				return {
					Machine: { ...Machine, Context },
					Effects: Context.EnforceArmed ? [{ Kind: "light", Tier: "3" }] : [],
				};
			}
			// The judge transition: each call card maps to ONE defined judge
			// transition below.
			case "judge":
				return judge(Machine, Event);
		}
	}

	// The tier-2 escalation read: after every offense the fresh context is
	// read - the section escalates at 6 total offenses (idempotent: never
	// re-escalates while on). The context is the judge step's fresh copy,
	// so the in-place mutation is the step's own.
	function escalate(Transition: CoachTransition): CoachTransition {
		const { Machine, Effects } = Transition;
		if (Machine.Context.SectionOn || Machine.Context.TotalOffenses < 6) return Transition;
		Machine.Context.SectionOn = true;
		return {
			Machine: { State: { Kind: "escalated" }, Focus: Machine.Focus, Context: Machine.Context },
			Effects: [
				...Effects,
				{ Kind: "line", Text: `escalated persistent section (${Machine.Context.TotalOffenses} strikes)` },
				{
					Kind: "notice",
					HTML: "<strong>Tool discipline</strong> - 3 fixed rules plus the live-fetched tool table (8 rows max); off again after the clean window.",
				},
				{ Kind: "light", Tier: "2" },
			],
		};
	}

	function judge(Machine: CoachMachine, Event: Extract<CoachEvent, { Kind: "judge" }>): CoachTransition {
		// The deep-copied set: the reached tiers accumulate on this
		// transition's own context (the previous machine object is
		// discarded, but the copy keeps the step pure).
		const Context = { ...Machine.Context, Reached: new Set(Machine.Context.Reached) };
		const Effects: CoachEffect[] = [];

		// The clean/exempt branch: the streak extends (the exempt call still
		// logs its byte-exact line - only when a row would have matched, the
		// exempt head dominates its pipe), then the clean-window read.
		if (Event.CallKind === "clean" || Event.CallKind === "exempt") {
			Context.CleanStreak += 1;
			Effects.push({ Kind: "verdict", Target: Event.Target, Verdict: "clean" });
			if (Event.CallKind === "exempt") Effects.push({ Kind: "line", Text: `exempt bash ${Event.Pattern}` });
			if (Context.SectionOn && Context.CleanStreak >= 4) {
				Effects.push({ Kind: "line", Text: "persistent section cleared (4 clean calls)" });
				Context.SectionOn = false;
				Context.CleanStreak = 0;
				return {
					Machine: { State: { Kind: "cleared" }, Focus: Machine.Focus, Context },
					Effects,
				};
			}
			return {
				Machine: { State: { Kind: "judging", Call: Event.CallKind, Verdict: "clean" }, Focus: Machine.Focus, Context },
				Effects,
			};
		}

		// The offense branch: the ledger logs the offense (byte-exact), the
		// clean streak resets, and the strike accumulates per class.
		Context.CleanStreak = 0;
		Context.TotalOffenses += 1;
		Context.Reached.add("0");
		Effects.push({ Kind: "verdict", Target: Event.Target, Verdict: "offense" });

		if (Event.CallKind === "read") {
			Context.ReadStrikes += 1;
			Effects.push({ Kind: "line", Text: `offense bash read ${Event.Pattern}`, Mod: "offense" });
			if (Context.ReadStrikes >= 3) {
				Effects.push(
					{ Kind: "line", Text: `strike ${Context.ReadStrikes}/3 bash read -> note read`, Mod: "offense" },
					{
						Kind: "notice",
						HTML: "<strong>bash read \u00d7 3</strong> - use the read tool - reads a file from the local filesystem (param: path), fetched live via ctx.tools.schemas().",
					},
					{ Kind: "light", Tier: "1" },
				);
				Context.Reached.add("1");
				Context.ReadStrikes = 0;
				return escalate({
					Machine: { State: { Kind: "noting", Call: "read" }, Focus: Machine.Focus, Context },
					Effects,
				});
			}
			return {
				Machine: { State: { Kind: "judging", Call: "read", Verdict: "offense" }, Focus: Machine.Focus, Context },
				Effects,
			};
		}

		// The write branch: while enforce is armed the deny fires (the deny
		// reason IS the lesson; the denied call flows through post-execute,
		// so the offense still counts), otherwise the write strikes
		// accumulate to the tier-1 note.
		if (Event.CallKind === "write") {
			if (Context.EnforceArmed) {
				Effects.push(
					{ Kind: "line", Text: `denied bash write ${Event.Pattern} -> use edit`, Mod: "deny" },
					{
						Kind: "notice",
						HTML: "<strong>denied</strong> - use the edit tool - performs exact string replacement in a file (param: file_path); discovery and control are never denied.",
					},
					{ Kind: "light", Tier: "3" },
				);
				Context.Reached.add("3");
				Context.WriteStrikes = 0;
				return escalate({
					Machine: { State: { Kind: "denied", Call: "write" }, Focus: Machine.Focus, Context },
					Effects,
				});
			}
			Context.WriteStrikes += 1;
			Effects.push({ Kind: "line", Text: `offense bash write ${Event.Pattern}`, Mod: "offense" });
			if (Context.WriteStrikes >= 3) {
				Effects.push(
					{ Kind: "line", Text: `strike ${Context.WriteStrikes}/3 bash write -> note edit`, Mod: "offense" },
					{
						Kind: "notice",
						HTML: "<strong>bash write \u00d7 3</strong> - use the edit tool - performs exact string replacement in a file (param: file_path), fetched live via ctx.tools.schemas().",
					},
					{ Kind: "light", Tier: "1" },
				);
				Context.Reached.add("1");
				Context.WriteStrikes = 0;
				return escalate({
					Machine: { State: { Kind: "noting", Call: "write" }, Focus: Machine.Focus, Context },
					Effects,
				});
			}
		}

		return escalate({
			Machine: { State: { Kind: "judging", Call: Event.CallKind, Verdict: "offense" }, Focus: Machine.Focus, Context },
			Effects,
		});
	}

	// The render: one deterministic function of the machine - the call
	// cards' verdict flashes (only the machine state's last judged call
	// carries the verdict class, so no sticky button state across the
	// interactions), the ladder's focus + lights, the focus area's
	// explanation, the enforce chip, and the status (the strike count +
	// the exact state word). Effects apply in order.
	function render(Transition: CoachTransition) {
		const { Machine, Effects } = Transition;

		for (const Effect of Effects) {
			switch (Effect.Kind) {
				case "line":
					PushLine(Effect.Text, Effect.Mod ?? "");
					break;
				case "notice":
					PushNotice(Effect.HTML);
					break;
				// The lights are the ladder render's business (deterministic
				// from the machine below); the effect only records the reach.
				// The verdicts are the dedicated flash pass below (clear then
				// apply, so the flash never stacks).
				case "light":
					break;
			}
		}

		// The verdict flashes: cleared and re-applied per transition - the
		// cards' visual states stay consistent with the CURRENT machine
		// state (the last judged call only, never sticky).
		CallButtons.forEach((Call) => Call.classList.remove("is-clean", "is-offense"));
		for (const Effect of Effects) {
			if (Effect.Kind === "verdict") {
				Effect.Target.classList.add(Effect.Verdict === "clean" ? "is-clean" : "is-offense");
			}
		}

		// The ladder: the focus selection (one active at a time, toggle to
		// deselect) + the reached lights (tier 2 tracks the section state -
		// on until the clean window clears it).
		TierButtons.forEach((Tier) => {
			const TierId = Tier.getAttribute("data-coach-tier") as TierN ?? "0";
			const Focused = Machine.Focus === TierId;
			Tier.classList.toggle("is-active", Focused);
			Tier.setAttribute("aria-pressed", Focused ? "true" : "false");
			Tier.classList.toggle("is-lit", TierId === "2" ? Machine.Context.SectionOn : Machine.Context.Reached.has(TierId));
		});

		// The focus area: the focused tier's explanation; a deselected
		// ladder clears it.
		CoachFocus.textContent = Machine.Focus === null ? "" : (TierExplanations[Machine.Focus] ?? "");

		// The enforce chip: deterministic from the machine.
		EnforceButton.classList.toggle("is-armed", Machine.Context.EnforceArmed);
		EnforceButton.setAttribute("aria-pressed", Machine.Context.EnforceArmed ? "true" : "false");
		// A static literal; textContent is safe here.
		EnforceButton.textContent = Machine.Context.EnforceArmed
			? "TIER 3 (ENFORCE): WRITE"
			: "TIER 3 (ENFORCE): OFF";

		// The status: the strike count + the exact machine state word.
		CoachStatus.textContent = `${Machine.Context.TotalOffenses} STRIKES\u2003${StateWords[Machine.State.Kind]}`;
	}

	// The event wiring: every input maps to one defined transition, then
	// the single render applies it. The wiring is IDEMPOTENT (the
	// data-coach-wired flag on the section): a dev HMR re-run of this
	// module re-queries the same DOM elements, and without the guard each
	// re-run would stack a second set of listeners whose closures hold
	// their own fresh machine - two renders per click, the stale one last.
	// With the flag, a re-run sees the wiring in place and skips it whole
	// (the first run's closures keep owning the DOM and the live machine,
	// so no state is reset either).
	const CoachBoard = document.querySelector<HTMLElement>(".coach__board")!;
	if (CoachBoard.dataset["coachWired"] !== "true") {
		CoachBoard.dataset["coachWired"] = "true";

		CallButtons.forEach((Call) => {
			Call.addEventListener("click", () => {
				const Next = transition(Machine, {
					Kind: "judge",
					CallKind: (Call.getAttribute("data-call-kind") ?? "clean") as CallKind,
					Pattern: Call.getAttribute("data-call-pattern") ?? "",
					Target: Call,
				});
				Machine = Next.Machine;
				render(Next);
			});
		});

		TierButtons.forEach((Tier) => {
			Tier.addEventListener("click", () => {
				const Next = transition(Machine, {
					Kind: "tier",
					Tier: (Tier.getAttribute("data-coach-tier") ?? "0") as TierN,
				});
				Machine = Next.Machine;
				render(Next);
			});
		});

		EnforceButton.addEventListener("click", () => {
			const Next = transition(Machine, { Kind: "enforce" });
			Machine = Next.Machine;
			render(Next);
		});

		// The initial render: the machine's shipped state applied to the
		// DOM deterministically (tier 0 focused with its explanation, the
		// idle status, the chip off, no lights, no verdicts) - the ladder
		// always shows exactly one active tier after load.
		render({ Machine, Effects: [] });
	}
</script>
