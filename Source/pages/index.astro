<script>
	// The live stream gate preview: the same per-flavor rules the workbench
	// runs, compressed into the hero. Raw tokens enter the left pane flagged;
	// the pipe pulse carries them through the gate; clean ASCII lands in the
	// right pane. Both panes are height-bounded, so every generation appends
	// the next response inside the panes and the page below never shifts.
	const Seeds = [
		"Plan review \u2014 phase one: the config \u201Cdrift\u201D is real\u2026 wait for it\u2026",
		"Balance\u00A0sheet sync \u2014 \u2018quoted\u2019 values\u00A0kept\u2026",
		"Latency\u200Bbudget\uFEFF hit \u2014 p99\u00A0holds\u2026",
		"Batch\u2014two of three\u2013done\u2026 \u201Cclean\u201D\u00A0output only",
	];

	const Raw = document.querySelector<HTMLElement>("[data-demo-raw]")!;
	const Clean = document.querySelector<HTMLElement>("[data-demo-clean]")!;
	const Status = document.querySelector<HTMLElement>("[data-demo-status]")!;
	const Demo = document.querySelector<HTMLElement>("[data-demo]")!;
	let Chars = 0;
	let Index = 0;
	let Paused = false;
	let Timer: ReturnType<typeof setInterval> | undefined;

	function CleanUp(Text: string) {
		let Out = Text;
		const Hits = (Pattern: RegExp, To: string | ((Mark: string) => string)) => {
			Out = Out.replace(Pattern, To as (Mark: string) => string);
		};
		Hits(/[\u2013\u2014\u2015]/g, "-");
		Hits(/[\u2018\u2019]/g, "'");
		Hits(/[\u201C\u201D]/g, '"');
		Hits(/\u2026/g, "...");
		Hits(/\u00A0/g, " ");
		Hits(/[\u200B-\u200D\uFEFF]/g, "");
		Hits(/[\uFF01-\uFF5E]/g, (Mark) => String.fromCharCode(Mark.charCodeAt(0) - 0xfee0));
		return Out;
	}

	function Highlight(Text: string) {
		return Text.replace(/[\u200B-\u200D\uFEFF]/g, '<span class="zwsp">[ZWSP]</span>')
			.replace(/\u00A0/g, '<span class="zwsp">[NBSP]</span>')
			.replace(/[\u2013\u2014\u2015]/g, (Mark) => `<span class="anom">${Mark}</span>`)
			.replace(/[\u2018\u2019\u201C\u201D]/g, (Mark) => `<span class="anom">${Mark}</span>`)
			.replace(/\u2026/g, '<span class="anom">…</span>')
			.replace(/[\uFF01-\uFF5E]/g, (Mark) => `<span class="anom">${Mark}</span>`);
	}

	// The pane bound the trim guard relies on: the screen's fixed 96px height
	// in Global.css (4 lines of 18px + 24px of padding). clientHeight stays
	// constant, so scrollHeight exceeds it the moment the newest response no
	// longer fits - the oldest rows scroll out until it fits again, and the
	// pane's footprint on the page never changes.
	function AppendResponse(Pane: HTMLElement, Line: string) {
		Pane.insertAdjacentHTML(
			"beforeend",
			`<div class="terminal-demo__line">\u21B3 ${Line}<span class="stream-caret"></span></div>`,
		);
		while (Pane.scrollHeight > Pane.clientHeight) {
			Pane.firstElementChild?.remove();
		}
	}

	function Tick() {
		const Seed = Seeds[Index % Seeds.length];
		Index += 1;
		const Before = Seed;
		const After = CleanUp(Seed);
		Chars += (
			Before.match(
				/[\u2013\u2014\u2015\u2018\u2019\u201C\u201D\u2026\u00A0\u200B-\u200D\uFEFF\uFF01-\uFF5E]/g,
			) ?? []
		).length;

		AppendResponse(Raw, Highlight(Before));
		AppendResponse(Clean, After);

		Status.innerHTML = `NORMALIZING<span class="dot-sep" aria-hidden="true"></span>${Chars.toLocaleString("en-US")} CHARS`;
	}

	function StartStreaming() {
		if (Timer) return;
		Timer = setInterval(Tick, 1600);
	}

	// The interval is cleared, not paused-by-flag: on resume it restarts with
	// a full 1.6s cadence, so no pending tick can flush and the stream picks
	// up with the next regular tick.
	function StopStreaming() {
		if (Timer) {
			clearInterval(Timer);
			Timer = undefined;
		}
	}

	StartStreaming();
	Tick();

	// Hover-to-pause: hovering the gate preview stops the tick loop and
	// freezes the caret and the pipe pulse (the .is-paused class) so the
	// panes can be read at leisure; leaving resumes with the next regular
	// tick. Reduced-motion users keep the stock behavior - the guard
	// already stills the animations, so no listeners are attached.
	if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
		Demo.addEventListener("mouseenter", () => {
			if (Paused) return;
			Paused = true;
			Demo.classList.add("is-paused");
			// The split status: only the word PAUSED carries the accent-orange
			// token - the separator and the rest keep the status's own color
			// (see the .status-paused rule in Global.css). The string is a
			// static literal, so innerHTML is safe here.
			Status.innerHTML =
				'<span class="status-paused">PAUSED</span><span class="dot-sep" aria-hidden="true"></span>HOVER TO RESUME';
			StopStreaming();
		});
		Demo.addEventListener("mouseleave", () => {
			if (!Paused) return;
			Paused = false;
			Demo.classList.remove("is-paused");
			Status.innerHTML = `NORMALIZING<span class="dot-sep" aria-hidden="true"></span>${Chars.toLocaleString("en-US")} CHARS`;
			StartStreaming();
		});
	}

	// ---- The coach judge demo: the tier ladder + the strike accumulation
	// ---- (the tool-coach section above). The copy comes from
	// hook-dsh-tool-coach's README/SCHEME; the ledger lines are the
	// module's byte-exact templates instantiated with the demo's own
	// calls. Clicking a tier card focuses the stage's explanation;
	// clicking a bash call card judges it: the verdict flash on the card,
	// the offense line in the tray, the tier-1 note at the 3rd same-class
	// strike, the tier-2 section at 6 total offenses, and - when the
	// enforce chip is armed - the tier-3 deny reason on write-class calls.
	const TierExplanations: Record<string, string> = {
		"0": "Tier 0 - the durable log: every detected offense logs offense <tool> <class> <pattern> immediately, and the model sees nothing. Exemptions log exempt <tool> <pattern-head> only when a row would have matched.",
		"1": "Tier 1 - the note: the offense's class reaching threshold (3) strikes within window (8) judged calls, with cooldown (10) between notes, appends a UserMessage additionalContexts note - source {kind: 'tool-coach', form: 'notice', summary: '<tool> <class> \u00d7 <n>'} - naming the correct tool with its LIVE registry description.",
		"2": "Tier 2 - the persistent section: total offenses since the last note reaching escalateThreshold (6) turn on the system-prompt/assemble 'Tool discipline' section - 3 fixed rules plus the live-fetched tool table (maxSectionTools 8 rows max); off again after cleanWindow (12) clean calls.",
		"3": "Tier 3 - the deny: enforce ('off' | 'write' | 'all') armed and per-class strikes since the last note reaching enforceThreshold (4), the tools/pre-execute listener returns {kind: 'deny', reason} - the deny reason IS the lesson. Discovery and control are NEVER denied.",
	};

	const CoachFocus = document.querySelector<HTMLElement>("[data-coach-focus]")!;
	const CoachScreen = document.querySelector<HTMLElement>("[data-coach-screen]")!;
	const CoachStatus = document.querySelector<HTMLElement>("[data-coach-status]")!;
	const TierButtons = [...document.querySelectorAll<HTMLElement>("[data-coach-tier]")];
	const CallButtons = [...document.querySelectorAll<HTMLElement>("[data-coach-call]")];
	const EnforceButton = document.querySelector<HTMLElement>("[data-coach-enforce]")!;

	let WriteStrikes = 0;
	let ReadStrikes = 0;
	let TotalOffenses = 0;
	let CleanStreak = 0;
	let Escalated = false;
	let EnforceArmed = false;

	function PushLine(Text: string, Mod = "") {
		const Line = document.createElement("div");
		Line.className = `coach__line${Mod ? ` coach__line--${Mod}` : ""}`;
		Line.textContent = Text;
		CoachScreen.appendChild(Line);
		CoachScreen.scrollTop = CoachScreen.scrollHeight;
	}

	// The notice blocks: innerHTML with static literals only (the text is
	// page-authored, never user data).
	function PushNotice(Html: string) {
		const Note = document.createElement("div");
		Note.className = "coach__notice";
		Note.innerHTML = Html;
		CoachScreen.appendChild(Note);
		CoachScreen.scrollTop = CoachScreen.scrollHeight;
	}

	function LightTier(N: string) {
		TierButtons.forEach((Tier) => {
			if (Tier.getAttribute("data-coach-tier") === N) Tier.classList.add("is-lit");
		});
	}

	function UpdateStatus() {
		CoachStatus.textContent = `${TotalOffenses} STRIKES`;
	}

	function Judge(Call: HTMLElement) {
		const Kind = Call.getAttribute("data-call-kind");
		const Pattern = Call.getAttribute("data-call-pattern") ?? "";

		if (Kind === "clean") {
			Call.classList.add("is-clean");
			CleanStreak += 1;
			if (Escalated && CleanStreak >= 4) {
				PushLine("persistent section cleared (4 clean calls)");
				Escalated = false;
				CleanStreak = 0;
			}
			return;
		}

		if (Kind === "exempt") {
			Call.classList.add("is-clean");
			CleanStreak += 1;
			// The exemption line: only when a row would have matched (the
			// exempt head dominates its pipe).
			PushLine(`exempt bash ${Pattern}`);
			if (Escalated && CleanStreak >= 4) {
				PushLine("persistent section cleared (4 clean calls)");
				Escalated = false;
				CleanStreak = 0;
			}
			return;
		}

		Call.classList.add("is-offense");
		CleanStreak = 0;
		TotalOffenses += 1;
		UpdateStatus();

		if (Kind === "read") {
			ReadStrikes += 1;
			PushLine(`offense bash read ${Pattern}`, "offense");
			if (ReadStrikes >= 3) {
				PushLine(`strike ${ReadStrikes}/3 bash read -> note read`, "offense");
				PushNotice(
					"<strong>bash read \u00d7 3</strong> - use the read tool - reads a file from the local filesystem (param: path), fetched live via ctx.tools.schemas().",
				);
				LightTier("1");
				ReadStrikes = 0;
			}
		}

		if (Kind === "write") {
			if (EnforceArmed) {
				// Tier 3: the deny reason IS the lesson; the deny resets the
				// note counters, and the offense still counts (the denied
				// call flows through post-execute).
				PushLine(`denied bash write ${Pattern} -> use edit`, "deny");
				PushNotice(
					"<strong>denied</strong> - use the edit tool - performs exact string replacement in a file (param: file_path); discovery and control are never denied.",
				);
				LightTier("3");
				WriteStrikes = 0;
			} else {
				WriteStrikes += 1;
				PushLine(`offense bash write ${Pattern}`, "offense");
				if (WriteStrikes >= 3) {
					PushLine(`strike ${WriteStrikes}/3 bash write -> note edit`, "offense");
					PushNotice(
						"<strong>bash write \u00d7 3</strong> - use the edit tool - performs exact string replacement in a file (param: file_path), fetched live via ctx.tools.schemas().",
					);
					LightTier("1");
					WriteStrikes = 0;
				}
			}
		}

		// Tier 2: total offenses since the last note (the demo counts every
		// offense; idempotent - the section never re-escalates while on).
		if (!Escalated && TotalOffenses >= 6) {
			PushLine(`escalated persistent section (${TotalOffenses} strikes)`);
			PushNotice(
				"<strong>Tool discipline</strong> - 3 fixed rules plus the live-fetched tool table (8 rows max); off again after the clean window.",
			);
			LightTier("2");
			Escalated = true;
		}
	}

	CallButtons.forEach((Call) => {
		Call.addEventListener("click", () => Judge(Call));
	});

	TierButtons.forEach((Tier) => {
		Tier.addEventListener("click", () => {
			TierButtons.forEach((Other) => {
				const Active = Other === Tier;
				Other.classList.toggle("is-active", Active);
				Other.setAttribute("aria-pressed", Active ? "true" : "false");
			});
			CoachFocus.textContent =
				TierExplanations[Tier.getAttribute("data-coach-tier") ?? "0"] ?? "";
		});
	});

	EnforceButton.addEventListener("click", () => {
		EnforceArmed = !EnforceArmed;
		EnforceButton.classList.toggle("is-armed", EnforceArmed);
		EnforceButton.setAttribute("aria-pressed", EnforceArmed ? "true" : "false");
		// A static literal; textContent is safe here.
		EnforceButton.textContent = EnforceArmed
			? "TIER 3 (ENFORCE): WRITE"
			: "TIER 3 (ENFORCE): OFF";
		if (EnforceArmed) LightTier("3");
	});
</script>
