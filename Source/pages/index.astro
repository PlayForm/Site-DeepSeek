---
import Base from "@Layout/Base.astro";
import Badge from "@Component/Badge.astro";
import BrandIcon from "@Component/BrandIcon.astro";
import Card from "@Component/Card.astro";
import Compare from "@Component/Compare.astro";
import FlavorBadge from "@Component/FlavorBadge.astro";
import SectionHeader from "@Component/SectionHeader.astro";
import Showcase from "@Component/Showcase.astro";
import StatsBand from "@Component/StatsBand.astro";
import SupportsButton from "@Component/SupportsButton.astro";
import Terminal from "@Component/Terminal.astro";
import TerminalTray from "@Component/TerminalTray.astro";
import { Counts, Families, Totals } from "@Library/Content";
import { DotSep } from "@Library/FileIcon";

// The fifteen packages: grouped Core & Factory / Governance / Guardians /
// Live prompt / Normalize, each with its package name, @-sentence identity and
// one-sentence description.
const Core = [
	{
		Name: "hook-dsh-core",
		Tone: "primary",
		Role: "ROLE: CORE",
		Sentence: Families.Core,
		Desc: "The pure, dependency-free commonalities of the family: the section lists, the exclusion segments, the suppression composer, the policy loader, the refusal guard and the normalize/Stream machinery.",
	},
	{
		Name: "plugin-dsh-factory",
		Tone: "primary",
		Role: "ROLE: FACTORY",
		Sentence: Families.Factory,
		Desc: "The family's first service: the ledger, the exclusion match, the discovery, the keep-list union, the gate set, the version-guarded fenced write, the wiring, the effects and the schema factory.",
	},
];

const Governance = [
	{
		Name: "hook-dsh-package-governor",
		Tone: "ink",
		Role: "ROLE: GOVERNOR",
		Sentence: Families.GovernorPackage,
		Desc: "The silent package.json governor: hooks fs/observed, rewrites chain-governed pins to the effective registry's resolved versions, and runs the update stage as a detached, contained continuation.",
	},
	{
		Name: "hook-dsh-package-pinner",
		Tone: "ink",
		Role: "ROLE: PINNER",
		Sentence: Families.PinnerPackage,
		Desc: "The silent package.json version pinner: hooks fs/observed and deterministically rewrites every ranged dependency version to its static version, protected by a pin-policy keep-list.",
	},
	{
		Name: "hook-dsh-cargo-governor",
		Tone: "ink",
		Role: "ROLE: GOVERNOR",
		Sentence: Families.GovernorCargo,
		Desc: "The Cargo.toml governor: the Rust-sided flavor of the package governor - surgical chain-pin rewrites on the raw TOML lines and cargo upgrade driven through the subprocess seam.",
	},
];

const Normalize = [
	{
		Name: "hook-dsh-normalize-dash",
		Flavor: "DASH",
		Sentence: Families.Dash,
		Desc: "Normalizes the unicode dash family to ASCII hyphen-minus in model output streams.",
	},
	{
		Name: "hook-dsh-normalize-quotes",
		Flavor: "QUOTES",
		Sentence: Families.Quotes,
		Desc: "Maps the eight curly quote code points to their ASCII straight counterparts in model output streams.",
	},
	{
		Name: "hook-dsh-normalize-ellipsis",
		Flavor: "ELLIPSIS",
		Sentence: Families.Ellipsis,
		Desc: "Replaces the horizontal ellipsis (U+2026) with the plain ASCII three-dot sequence in model output streams.",
	},
	{
		Name: "hook-dsh-normalize-spaces",
		Flavor: "SPACES",
		Sentence: Families.Spaces,
		Desc: "Normalizes the unicode space family (Zs minus the ASCII space) to the plain space in model output streams.",
	},
	{
		Name: "hook-dsh-normalize-invisible",
		Flavor: "INVISIBLE",
		Sentence: Families.Invisible,
		Desc: "Removes the zero-width/invisible character family (soft hyphen, zero-width spaces and joiners, bidi controls, BOM) from model output streams.",
	},
	{
		Name: "hook-dsh-normalize-fullwidth",
		Flavor: "FULLWIDTH",
		Sentence: Families.Fullwidth,
		Desc: "Maps the entire FULLWIDTH FORMS range (U+FF01-U+FF5E) to its ASCII half-width counterparts in model output streams.",
	},
	{
		Name: "hook-dsh-normalize-file",
		Flavor: "FILE",
		Sentence: Families.File,
		Desc: "The file-content normalizer: the normalize-file tool - the read, count, write pipeline applying all six transforms to a file already on disk, writing only when something changed.",
	},
];

// The guardians: the two new-generation family members - the CCR compressor
// and the terminal coach - hooked on the tool layer rather than the file
// system, each with its own plugin page.
const Guardians = [
	{
		Name: "hook-dsh-ccr",
		Role: "ROLE: COMPRESSOR",
		Sentence: Families.Ccr,
		Desc: "The tool-output compressor: hooks the tools/post-execute waterfall and replaces oversized results of the allow-listed target tools with a one-line type-aware preview plus a <<<CCR:hash|type|size>>> retrieval marker - the original stays retrievable through the registered ccr_retrieve tool over the sha256-24 LRU store.",
	},
	{
		Name: "hook-dsh-tool-coach",
		Role: "ROLE: COACH",
		Sentence: Families.Coach,
		Desc: "The terminal coach: judges every bash/pwsh call through the four-tier ladder - silent ledger lines, live-fetched coaching notes, a persistent system-prompt discipline section, an optional hard deny - teaching the model to stop using the terminal for file content.",
	},
];

// The use-case showcases: the pin, the govern and the normalize before/
// after stories. The pairs are the REAL example content from the plugin
// pages (byte-exact); the facts are the REAL ledger excerpts and the
// totals pair from the content library.
const PinBefore = ['    "@playform/build": "^0.3.4",'];
const PinAfter = ['    "@playform/build": "0.3.4",'];
const GovernBefore = ['    "@acme/chain-core": "0.4.1",'];
const GovernAfter = ['    "@acme/chain-core": "^0.4.5",'];
const PinFact =
	"[2026-10-03T09:16:01.880Z] pinned <project>/acme/tool/package.json (2 versions)";
const GovernFact =
	"[2026-10-03T09:16:01.880Z] governed <project>/acme/tool/package.json \u2192 42";
const NormalizeFact =
	"hook-dsh-normalize-dash: normalized 4 dash char(s) in one stream";
const NormalizeBefore = [
	'  "The refactor is complete \u2014 every call site updated, ranges 10\u201315',
	'   covered, and the odd U+2015 bar \u2015 swept too."',
];
const NormalizeAfter = [
	'  "The refactor is complete - every call site updated, ranges 10-15',
	'   covered, and the odd U+2015 bar - swept too."',
];
const CompressBefore = [
	"$ make -C packages/core test",
	"resolving 214 modules...",
	"compiling 96 files...",
	"[ ... 137 more lines ... ]",
	"smoke: 146 checks green",
	"make: *** Error 1",
];
// The one-line preview + marker: the README's terminal example (the
// `[terminal:...]` preview line plus the `<<<CCR:hash|type|size>>>` marker;
// the hash is the sha256-24 store key, matched exactly on retrieval).
const CompressAfter = [
	"[terminal:exit 0 | 142 lines | make: *** Error 1]",
	"<<<CCR:9d3c1f0a7b2e4d5c6a8b9c0d|terminal|5231>>>",
];
const CompressFact = "ccr: compressed bash terminal 5231 -> 9d3c1f0a7b2e4d5c6a8b9c0d";

// The supports-buttons: the real manifest facts behind each governance
// showcase, from the plugin READMEs. The pinner handles package.json ONLY
// (pure P pass - no ncu, no jobs, no subprocess); the family's Cargo
// coverage lives in the cargo-governor sibling. The lines render through
// set:html, so the inline entities are intentional.
const PinSupports = [
	`package.json - the pinner's ONLY gate. Every ranged dependency version in any agent-written package.json is rewritten to its static version: <code>&quot;@playform/build&quot;: &quot;^0.3.4&quot;</code> -&gt; <code>&quot;@playform/build&quot;: &quot;0.3.4&quot;</code>.`,
	`Protected by the pin-policy keep-list: <code>pin-policy.json</code> keeps named ranges as authored - keep-list wins.`,
	`Pure pin pass: no ncu, no jobs, no subprocess, no cooldown. A fully pinned manifest leaves the governor's update stage nothing to do.`,
	`Exclusion-first: paths containing node_modules / .git / .dsh / .pnpm / .store are skipped silently (<code>skipped (excluded) &lt;path&gt;</code>).`,
	`Cargo.toml is NOT handled by the pinner - the family's Cargo coverage lives in <a href="/plugins/hook-dsh-cargo-governor/">hook-dsh-cargo-governor</a>.`,
	`The full story: <a href="/plugins/hook-dsh-package-pinner/">the pinner page</a>.`,
];
const GovernSupports = [
	`package.json - the chain pass canonicalizes chain-governed pins to the effective registry's resolved versions (<code>&quot;0.4.1&quot;</code> -&gt; <code>&quot;^0.4.5&quot;</code> for a dep in the nearest registry.json), then the update stage runs <code>npm-check-updates</code> (programmatic by default, or the absolute ncuBin binary) as a detached, contained continuation in the jobs envelope.`,
	`The cordis-trap guard: ncu's reject list is always policy.reject + the chain-governed dep names - a chain pin is never bumped to public npm latest.`,
	`Cargo.toml - handled by <a href="/plugins/hook-dsh-cargo-governor/">hook-dsh-cargo-governor</a> (the same architecture): surgical rewrites on the raw TOML lines (never a TOML stringify - comments survive), full-version normalization (shorthand padded, <code>pinStyle &quot;exact&quot;</code>), and the update stage driven by <code>cargo upgrade --exclude</code> through the ctx.subprocess seam.`,
	`Silence: the transcript shows only what the author wrote; the ledger shows what actually happened (<code>governed &lt;path&gt; -&gt; &lt;version&gt;</code>).`,
	`The full story: <a href="/plugins/hook-dsh-package-governor/">the governor page</a>.`,
];
---

<Base
	Title="DSH Family @ PlayForm - Tame the model's output and govern the project's files."
	Description="The DeepSeek Harness Plugin Family for PlayForm: fifteen TypeScript packages - the core, the factory service, the governance trio, the seven-member normalize family, the CCR compressor and tool-coach guardians, and the live-containers hook (shipped disabled). CLASSIC and EFFECT-TS releases."
>
	<main class="container container--main">
		<!-- Eyebrow badges -->
		<div class="eyebrow-row">
			<Badge Variant="primary" Dot>
				ECOSYSTEM: <BrandIcon Name="playform" Size="0.8em" /> @PLAYFORM
			</Badge>
			<Badge>
				<BrandIcon Name="typescript" Size="0.8em" /> CLASSIC
			</Badge>
			<Badge>
				<BrandIcon Name="effect" Size="0.8em" /> EFFECT-TS
			</Badge>
		</div>

		<!-- Hero: the two-split stage. The h1 stays above the split; the
			LEFT column carries the hero text and the install terminal (the
			site's input surface); the RIGHT column carries the live stream
			gate preview, filling its column so the hero has no blank side.
			The action buttons sit in a single full-width row UNDER the
			split, so all four share one line at desktop widths and the
			hero's bottom padding lets the engineering grid draw out
			behind/below them. -->
		<section class="hero hero--grid">
			<h1 class="hero__title">Tame the model's output and govern the project's files.</h1>
			<div class="hero__split">
				<div class="hero__lead">
					<p class="hero__sub">
						The <BrandIcon Name="deepseek" /> DeepSeek Harness Plugin Family for
						PlayForm: every model's output normalized to clean ASCII characters, every
						manifest pinned and governed under the author's control - fifteen TypeScript
						packages, smoke-arbitrated.</p>
					<p class="hero__sub">
						Model output, clean and governed.
					</p>
					<Terminal Pkg="hook-dsh-core" Rail />
				</div>

				<!-- Live stream gate preview (the hero's right column): the gate as
					the left-to-right pipeline it is - the RAW STREAM pane on the
					left feeds the flagged tokens through the middle pipe, and the
					NORMALIZED OUTPUT pane on the right lands the clean ASCII. Both
					panes are height-bounded (fixed line budget, overflow hidden):
					every generation appends the next response inside the panes, the
					oldest lines scroll out, and the page below never shifts. -->
				<section class="terminal-demo" data-demo>
					<TerminalTray Label="LIVE STREAM GATE PREVIEW">
						<span class="terminal-demo__status" data-demo-status role="status" aria-live="polite">
							NORMALIZING<span class="dot-sep" aria-hidden="true"></span>0 CHARS
						</span>
					</TerminalTray>
					<div class="terminal-demo__stage">
						<div class="terminal-demo__pane">
							<span class="terminal-demo__pane-label"><span class="is-orange">RAW</span> STREAM</span>
							<div class="terminal-demo__screen rail-orange" data-demo-raw></div>
						</div>
						<div class="terminal-demo__flow">
							<span class="flow-tag flow-tag--raw">RAW <span class="flow-tag__arrow">→</span></span>
							<span class="flow-line">
								<span class="flow-line__pulse"></span>
							</span>
							<span class="flow-tag">CLEAN</span>
						</div>
						<div class="terminal-demo__pane">
							<span class="terminal-demo__pane-label">NORMALIZED OUTPUT</span>
							<div class="terminal-demo__screen" data-demo-clean></div>
						</div>
					</div>
				</section>
			</div>

			<!-- The action row: all four buttons share ONE full-width line
				under the split (they leave the lead column so the desktop row
				has room for the longest label); the hero's bottom padding
				extends the engineering grid behind/below the row. -->
			<div class="action-row hero__actions">
				<a class="action" href="/plugins/">Explore Plugins</a>
				<a class="action action--secondary" href="/workbench/">Open the Workbench</a>
				<a class="action action--secondary" href="/versions/">Two Releases, One Behavior</a>
				<a class="action action--secondary" href="/setup/">Set It Up in a Profile</a>
			</div>
		</section>

		<!-- The stats band: the three verified family facts from the content
			library - 14 packages, the 1008 + 1021 check totals, the 0.0.1
			release - the proof strip between the hero and the plugins. -->
		<StatsBand />

		<!-- Plugins -->
		<section class="section" id="plugins">
			<SectionHeader Title="Plugins" Meta={`${Counts.Packages} PACKAGES`} />

			<!-- Group 1: Core & Factory -->
			<p class="section-kicker">Core &amp; Factory</p>
			<div class="grid grid--3" style="margin-bottom: var(--space-md)">
				{Core.map((Package) => (
					<Card
						Name={Package.Name}
						Href={`/plugins/${Package.Name}/`}
						NameTone={Package.Tone as "primary" | "ink"}
						Sentence={Package.Sentence}
						Desc={Package.Desc}
						Muted
					>
						<Badge slot="badge" Variant="outline">
							{Package.Role}
						</Badge>
					</Card>
				))}
			</div>

			<!-- Group 2: Governance -->
			<p class="section-kicker">Governance</p>
			<div class="grid grid--3" style="margin-bottom: var(--space-md)">
				{Governance.map((Package) => (
					<Card
						Name={Package.Name}
						Href={`/plugins/${Package.Name}/`}
						NameTone="primary"
						Sentence={Package.Sentence}
						Desc={Package.Desc}
						Muted
					>
						<Badge slot="badge">{Package.Role}</Badge>
					</Card>
				))}
			</div>

			<!-- Group 3: Guardians -->
			<p class="section-kicker">Guardians &amp; Compression</p>
			<div class="grid grid--2" style="margin-bottom: var(--space-md)">
				{Guardians.map((Package) => (
					<Card
						Name={Package.Name}
						Href={`/plugins/${Package.Name}/`}
						NameTone="primary"
						Sentence={Package.Sentence}
						Desc={Package.Desc}
						Muted
					>
						<Badge slot="badge" Variant="outline">{Package.Role}</Badge>
					</Card>
				))}
			</div>

			<!-- Group 4: Normalize -->
			<p class="section-kicker">Normalize</p>
			<div class="grid grid--3">
				{Normalize.map((Package) => (
					<Card
						Name={Package.Name}
						Href={`/plugins/${Package.Name}/`}
						Sentence={Package.Sentence}
						Desc={Package.Desc}
						Muted
					>
						<span class="flavor-cell flavor-cell--compact" slot="badge">
							<FlavorBadge Flavor={Package.Flavor} />
						</span>
					</Card>
				))}
			</div>
		</section>

		<!-- Versions -->
		<section class="section" id="versions">
			<SectionHeader Title="Versions" Meta="DUAL ENGINE" />
			<div class="grid grid--2">
				<Card Variant="white">
					<div slot="head" class="version-card__head">
						<span class="version-card__title">CLASSIC RELEASE</span>
						<BrandIcon Name="typescript" Size="1.333em" ClassName="version-card__icon" />
					</div>
					<p class="version-card__body">
						The fifteen contracts in plain TypeScript - classes, Maps and plain
						functions, zero runtime framework dependencies.</p>
					<p class="version-card__body">
						The straightforward integration release.
					</p>
					<div class="version-card__facts">
						<Badge Variant="primary" Dot>
							<BrandIcon Name="typescript" Size="0.8em" /> PLAIN TYPESCRIPT
						</Badge>
						<Badge>ZERO FRAMEWORK DEPS</Badge>
					</div>
				</Card>
				<Card Variant="primary">
					<div slot="head" class="version-card__head">
						<span class="version-card__title">EFFECT-TS RELEASE</span>
						<BrandIcon Name="effect" Size="1.333em" ClassName="version-card__icon" />
					</div>
					<p class="version-card__body">
						The same fifteen contracts re-expressed on Effect-TS services and layers -
						same behavior, same smokes, different runtime plumbing.
					</p>
					<div class="version-card__facts">
						<Badge Variant="active"><BrandIcon Name="effect" Size="0.8em" /> EFFECT-TS SERVICES &amp; LAYERS</Badge>
						<Badge Variant="outline">SAME SMOKES</Badge>
					</div>
				</Card>
			</div>
		</section>

		<!-- The use cases: what the family accomplishes - the pin, the govern,
			the normalize and the compress before/after stories, each a
			full-width wide card (one card per row, spanning the section's
			width - the squished three-column grid replaced by the wide stack;
			the normalize card keeps its Compare slider full-width for the
			drag). The pairs are the real example content from the plugin
			pages; the fact lines are the real ledger excerpts; the totals
			strip is the content library's pair. The two governance cards
			close with the supports-buttons: the manifests each module
			actually handles, click-to-expand (the site's class-toggle
			pattern - there is no <details> anywhere on the site). -->
		<section class="section" id="use-cases">
			<SectionHeader Title="The use cases" Meta="PIN · GOVERN · NORMALIZE · COMPRESS" />
			<div class="use-cases">
				<Showcase
					Wide
					Kicker="THE PIN"
					Title="Pinned manifests, deterministically"
					Lead="The pinner rewrites every ranged dependency version to its static version - protected by the pin-policy keep-list."
					Href="/plugins/hook-dsh-package-pinner/"
					Before={PinBefore}
					After={PinAfter}
					Fact={PinFact}
				>
					<SupportsButton Manifests={["package.json"]} Detail={PinSupports} slot="supports" />
				</Showcase>
				<Showcase
					Wide
					Kicker="THE GOVERN"
					Title="Governed pins, silently"
					Lead="The governor canonicalizes chain-governed pins to the effective registry's resolved versions - then runs the update stage detached."
					Href="/plugins/hook-dsh-package-governor/"
					Before={GovernBefore}
					After={GovernAfter}
					Fact={GovernFact}
				>
					<SupportsButton
						Manifests={["package.json", "Cargo.toml"]}
						Detail={GovernSupports}
						slot="supports"
					/>
				</Showcase>
				<Showcase
					Wide
					Kicker="THE NORMALIZE"
					Title="Clean output as it is born"
					Lead="The stream flavors rewrite the model's output at the llm/stream waterfall - live in the UI, durable in the transcript. Drag the handle."
					Href="/plugins/hook-dsh-normalize-dash/"
					Fact={NormalizeFact}
				>
					<Compare
						Id="index-normalize"
						Flavor="dash"
						Raw={NormalizeBefore}
						Clean={NormalizeAfter}
						Start={50}
					/>
				</Showcase>
				<Showcase
					Wide
					Kicker="THE COMPRESS"
					Title="Big tool output, one line and a marker"
					Lead="The ccr hook replaces an oversized tool result with a one-line type-aware preview plus the retrieval marker - the original stays retrievable through the registered ccr_retrieve tool."
					Href="/plugins/hook-dsh-ccr/"
					Before={CompressBefore}
					After={CompressAfter}
					Fact={CompressFact}
				/>
			</div>
			<p class="page-hero__sub" style="margin-top: var(--space-md)">
				The six stream flavors plus normalize-file now also expose the volatile
				<code>scopes</code> surface (conversation / reasoning / toolInput / toolResults /
				files / batch, with <code>toolResultsExempt</code>) with live
				<code>loader/volatile-update</code> toggles - and the overpass arms
				(<code>tools/post-execute</code> tool results + <code>agent/pre-step</code> step
				batch) reachable through the <code>normalize-overpass</code> command.
			</p>
			<p class="section-kicker" style="margin-top: var(--space-md)">
				<Fragment set:html={DotSep(`${Totals.Meta()} · the ledger strings, byte-identical`)} />
			</p>
		</section>

		<!-- The coachy tool-coach section: the same technical-minimalist
			system, a DIFFERENT palette and structure. The palette reuses the
			two sanctioned non-blue tokens already in the system (the section
			root aliases them locally - no new hex); the structure is a
			two-column coaching board instead of the header-then-grid shape
			every other section uses: a sticky tier-ladder rail on the left,
			the interactive judge demo on the right. All copy comes from the
			hook-dsh-tool-coach README/SCHEME (the ledger strings byte-exact). -->
		<section class="section coach" id="coach">
			<header class="coach__header">
				<p class="coach__kicker">THE COACH</p>
				<h2 class="coach__title">A guardian that coaches the model, tier by tier.</h2>
				<p class="coach__lead">
					The one-sentence rule the coach enforces: <strong>the terminal runs
					COMMANDS (builds, tests, git, package managers); the tools handle
					CONTENT.</strong> Terminal file edits are invisible to the plugin
					system - the <code>fs/observed</code> chain (the governor's, the
					pinner's and the normalize plugins' trigger) fires only on tool-layer
					writes, so a <code>sed -i</code> edit bypasses all of them. The coach
					goes where that regression flows: the terminal tool calls.
				</p>
			</header>

			<div class="coach__board">
				<!-- The tier ladder rail: four steps, click-to-focus. -->
				<nav class="coach__ladder" aria-label="The coaching ladder">
					<button
						type="button"
						class="coach__tier is-active"
						data-coach-tier="0"
						aria-pressed="true"
					>
						<span class="coach__tier-n">TIER 0</span>
						<span class="coach__tier-name">LEDGER</span>
						<span class="coach__tier-brief">every offense, silent</span>
					</button>
					<button
						type="button"
						class="coach__tier"
						data-coach-tier="1"
						aria-pressed="false"
					>
						<span class="coach__tier-n">TIER 1</span>
						<span class="coach__tier-name">NOTE</span>
						<span class="coach__tier-brief">threshold 3 &middot; window 8 &middot; cooldown 10</span>
					</button>
					<button
						type="button"
						class="coach__tier"
						data-coach-tier="2"
						aria-pressed="false"
					>
						<span class="coach__tier-n">TIER 2</span>
						<span class="coach__tier-name">SECTION</span>
						<span class="coach__tier-brief">escalate 6 &middot; clean window 12</span>
					</button>
					<button
						type="button"
						class="coach__tier"
						data-coach-tier="3"
						aria-pressed="false"
					>
						<span class="coach__tier-n">TIER 3</span>
						<span class="coach__tier-name">DENY</span>
						<span class="coach__tier-brief">enforce off by default</span>
					</button>
				</nav>

				<!-- The judge demo stage: click a bash call, the coach judges it. -->
				<div class="coach__stage">
					<p class="coach__focus" data-coach-focus></p>
					<div class="coach__calls">
						<button
							type="button"
							class="coach__call"
