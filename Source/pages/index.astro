---
import Cabinet from "@Component/Cabinet.astro";
import Card from "@Component/Card.astro";
import Curve from "@Component/Curve.astro";
import Flow from "@Component/Graph/Flow.tsx";
import Matrix from "@Component/Matrix.astro";
import PageHero from "@Component/PageHero.astro";
import Seam from "@Component/Seam.astro";
import SectionHeader from "@Component/SectionHeader.astro";
import StatBand from "@Component/StatBand.astro";
import Table from "@Component/Table.astro";
import Term from "@Component/Term.astro";
import Transform from "@Component/Transform.astro";
import { Arm } from "@Content/Arm";
import { BehaviorFor } from "@Content/Behavior";
import { Seam as SeamPage } from "@Content/Harness";
import { Intervention } from "@Content/Intervention";
import { Role } from "@Content/Message";
import { Step } from "@Content/ToolCall";
import { Transform as Sample } from "@Content/Transform";
import { Stage } from "@Content/Turn";
import Base from "@Layout/Base.astro";
import { Component } from "@Library/Component";
import { Content } from "@Library/Content";
import { Dev } from "@Library/Flag";
import { Route } from "@Library/Link";
import { Count, Package, SelectKind } from "@Library/Package.server";

const Starters = ["hook-dsh-normalize-dash", "hook-dsh-workspace-govern", "plugin-dsh-factory"]
	.map((Slug) => Package.find((Entry) => Entry.Slug === Slug))
	.filter(Boolean)
	.map((Entry) => [
		{ Text: Entry!.Slug, Href: Entry!.Href, Icon: Entry!.Slug },
		Entry!.Kind,
		Entry!.Version,
	]);

// The seams, in the order a turn reaches them, with the hooks that act there.
const Order = [
	"system-prompt/assemble",
	"llm/stream",
	"tools/pre-execute",
	"tools/post-execute",
	"batch/proposed",
	"fs/observed",
	"agent/status",
];

const Group = new Map<string, number>();

for (const Entry of SelectKind("hook")) {
	const Behavior = BehaviorFor(Entry.Slug);

	if (Behavior) {
		Group.set(Behavior.Seam, (Group.get(Behavior.Seam) ?? 0) + 1);
	}
}

const SeamList = Order.filter((Name) => Group.has(Name)).map((Name) => ({
	Name,
	Count: Group.get(Name) ?? 0,
	Href: Route.Behavior,
}));

const Dash = Sample.filter((Item) => Item.Slug === "hook-dsh-normalize-dash");

// The stages the family stands at: the documented seams plus the arms the
// source registers, so the home graph lights the same stages the turn page does.
const Used = [...new Set([...SeamPage.map((Entry) => Entry.Name), ...Object.values(Arm).flat()])];
---

<Base Title={Content.Title} Description={Content.Description}>
	<PageHero
		Eyebrow="DeepSeek Harness plugins"
		Title="Plugins for DeepSeek Harness"
		Lede={Content.Lede}>
		<Fragment slot="Actions">
			<a class="button" href={Route.Package}>
				Browse the Package
			</a>
			<a class="button button--quiet" href={Route.Setup}>
				Install
			</a>
		</Fragment>
	</PageHero>

	<StatBand
		Stat={[
			{ Label: "Package", Value: Count.All, Note: "Two releases" },
			{ Label: "Hook", Value: Count.Hook, Note: "Listen on harness events" },
			{ Label: "Plugin", Value: Count.Plugin, Note: "Tools and bundles" },
			{ Label: "Test", Value: Count.Test, Note: "Across both releases" },
		]}
	/>

	<section class="section">
		<SectionHeader
			Title="The turn"
			Lede="Every request the model makes passes the same stages, and the harness opens a seam at each one. This is that path, with the stages the family stands at lit."
		/>
		<div class="section__body stack">
			<Flow Stage={Stage} Family={Used} client:load />
			<div class="cluster">
				<a class="button" href={Route.Turn}>
					The turn, stage by stage
				</a>
				<a class="button button--quiet" href={Route.Tool}>
					One tool call
				</a>
				<a class="button button--quiet" href={Route.Message}>
					What the model reads
				</a>
			</div>
		</div>
	</section>

	<section class="section">
		<SectionHeader
			Title="The family"
			Lede="Ten packages, one per family, read from source: the seam each stands at, whether the model sees something different, and what reaches the disk."
		/>
		<div class="section__body stack">
			<Matrix Row={Intervention} />
			<div class="cluster">
				<a class="button" href={Route.Intervention}>
					Every intervention
				</a>
				<a class="button button--quiet" href={Route.Composition}>
					How they compose
				</a>
			</div>
		</div>
	</section>

	<section class="section">
		<SectionHeader
			Title="The measure"
			Lede="One curve the site can draw without a live run: what a tool result costs the context, with the family and without it."
		/>
		<div class="section__body stack">
			<Curve />
			<div class="cluster">
				<a class="button" href={Route.Tutorial}>
					One turn, three moments
				</a>
				<a class="button button--quiet" href={Route.Dashboard}>
					The board
				</a>
			</div>
		</div>
	</section>

	<section class="section">
		<SectionHeader Title="What your model writes">
			<Fragment slot="Lede">
				The stream leaves the model, passes a&nbsp;
				<Term Name="hook" />, and arrives in the transcript changed.
			</Fragment>
		</SectionHeader>
		<div class="section__body stack">
			<Cabinet Label="Transform" State="live">
				<Transform Sample={Dash} />
			</Cabinet>
			<div class="cluster">
				{SeamList.map((Item) => (
					<Seam Name={Item.Name} Count={Item.Count} Href={Item.Href} />
				))}
			</div>
		</div>
	</section>

	<section class="section">
		<SectionHeader
			Title="Classic and Effect-TS"
			Lede="Classic is plain TypeScript. Effect-TS is the same packages rebuilt on Effect."
		/>
		<div class="section__body grid">
			<Card Title="Classic" Href={Route.Package} Meta={`${Count.Classic} in Classic`}>
				The factory, the core library, the hooks, and the clients.
			</Card>
			<Card Title="Effect-TS" Href={Route.Package} Meta={`${Count.EffectTS} in Effect-TS`}>
				The same packages with Effect services, layers, and schemas.
			</Card>
			{Dev && (
				<Card Title="Component" Href={Route.Library} Meta={`${Component.length} total`}>
					The building blocks of every page, shown live.
				</Card>
			)}
		</div>
	</section>

	<section class="section">
		<SectionHeader Title="Package to start with" Lede="Three of the 119." />
		<div class="section__body">
			<Table
				Caption="Three packages to start with"
				Head={["Package", "Kind", "Version"]}
				Row={Starters}
			/>
		</div>
	</section>

	<section class="section">
		<SectionHeader Title="Read next" />
		<div class="section__body grid">
			<Card Title="Setup" Href={Route.Setup} Meta="Install">
				Install a package and load its bundle patch.
			</Card>
			<Card Title="Reference" Href={Route.Reference} Meta="Package">
				Every package with its version.
			</Card>
			<Card Title="Behavior" Href={Route.Behavior} Meta="Hook">
				The hooks and the events they listen on.
			</Card>
			<Card Title="Workbench" Href={Route.Workbench} Meta="One turn">
				One turn, five seams, two lenses.
			</Card>
			<Card Title="Turn" Href={Route.Turn} Meta={`${Stage.length} stage`}>
				The harness with none of our plugins, stage by stage.
			</Card>
			<Card Title="Tool call" Href={Route.Tool} Meta={`${Step.length} gate`}>
				One call, four gates, and the plugins that stand at them.
			</Card>
			<Card Title="Conversation" Href={Route.Message} Meta={`${Role.length} role`}>
				What the model reads, and the seams that change it.
			</Card>
			<Card Title="Timeline" Href={Route.Timeline} Meta="Release">
				Every version the changelogs record.
			</Card>
			<Card Title="Observatory" Href={Route.Observatory} Meta="Graph">
				The package graph, with the dependency arrows.
			</Card>
		</div>
	</section>
</Base>
