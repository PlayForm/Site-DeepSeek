---
import Base from "@Layout/Base.astro";

import Card from "@Component/Card.astro";
import PageHero from "@Component/PageHero.astro";
import SectionHeader from "@Component/SectionHeader.astro";
import StatsBand from "@Component/StatsBand.astro";
import Table from "@Component/Table.astro";

import { Components } from "@Library/Components";
import { Content } from "@Library/Content";
import { Routes } from "@Library/Links";
import { Counts, Packages } from "@Library/Packages.server";

const Starters = ["hook-dsh-normalize-dash", "hook-dsh-workspace-govern", "plugin-dsh-factory"]
	.map((Slug) => Packages.find((Package) => Package.Slug === Slug))
	.filter(Boolean)
	.map((Package) => [Package!.Slug, Package!.Kind, Package!.Version]);
---

<Base Title={Content.Title} Description={Content.Description}>
	<PageHero Eyebrow="DeepSeek Harness plugins" Title="Plugins for DeepSeek Harness" Lede={Content.Lede}>
		<Fragment slot="Actions">
			<a class="button" href={Routes.Package}>Browse the Package</a>
			<a class="button button--quiet" href={Routes.Setup}>Install</a>
		</Fragment>
	</PageHero>

	<StatsBand
		Stats={[
			{ Label: "Package", Value: Counts.All, Note: "Two releases" },
			{ Label: "Hook", Value: Counts.Hooks, Note: "Listen on harness events" },
			{ Label: "Plugin", Value: Counts.Plugins, Note: "Tools and bundles" },
			{ Label: "Test", Value: Counts.Tests, Note: "Across both releases" },
		]}
	/>

	<section class="section">
		<SectionHeader
			Title="Classic and Effect-TS"
			Lede="Classic is plain TypeScript. Effect-TS is the same packages rebuilt on Effect."
		/>
		<div class="section__body grid">
			<Card Title="Classic" Href={Routes.Package} Meta={`${Counts.Classic} in Classic`}>
				The factory, the core library, the hooks, and the clients.
			</Card>
			<Card Title="Effect-TS" Href={Routes.Package} Meta={`${Counts.EffectTS} in Effect-TS`}>
				The same packages with Effect services, layers, and schemas.
			</Card>
			<Card Title="Component" Href={Routes.Library} Meta={`${Components.length} total`}>
				The building blocks of every page, shown live.
			</Card>
		</div>
	</section>

	<section class="section">
		<SectionHeader Title="Package to start with" Lede="Three of the 119." />
		<div class="section__body">
			<Table
				Caption="Three packages to start with"
				Head={["Package", "Kind", "Version"]}
				Rows={Starters}
			/>
		</div>
	</section>

	<section class="section">
		<SectionHeader Title="Read next" />
		<div class="section__body grid">
			<Card Title="Setup" Href={Routes.Setup} Meta="Install">
				Install a package and load its bundle patch.
			</Card>
			<Card Title="Reference" Href={Routes.Reference} Meta="Package">
				Every package with its version.
			</Card>
			<Card Title="Behavior" Href={Routes.Behavior} Meta="Hook">
				The hooks and the events they listen on.
			</Card>
		</div>
	</section>
</Base>
