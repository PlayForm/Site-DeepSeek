---
import "@Stylesheet/Component/Filter.scss";

import Filter from "@Component/Filter.tsx";
import PackageCard from "@Component/PackageCard.astro";
import PageHero from "@Component/PageHero.astro";
import SectionHeader from "@Component/SectionHeader.astro";
import Table from "@Component/Table.astro";
import Toolbar from "@Component/Toolbar.astro";
import Base from "@Layout/Base.astro";
import { Route } from "@Library/Link";
import { Count, Family, Kind, Package, SelectFamily } from "@Library/Package.server";

const Group = Family.map((Release) => ({
	Release,
	Entry: SelectFamily(Release),
}));

const Catalogue = Package.map((Entry) => ({
	Slug: Entry.Slug,
	Kind: Entry.Kind,
	Family: Entry.Family,
}));

const Kinds = [
	["hook", "Listens on a harness event and changes what happens next."],
	["plugin", "Adds tools and a bundle the host loads."],
	["lib", "A shared library the other packages import."],
	["client", "A UI surface in the harness panel."],
	["base", "The shared base the Effect-TS packages build on."],
];
---

<Base
	Title="Package"
	Description={`All ${Count.All} packages: ${Count.Classic} in Classic and ${Count.EffectTS} in Effect-TS.`}>
	<PageHero
		Eyebrow="Two releases"
		Title="Package"
		Lede={`${Count.All} total: ${Count.Classic} in Classic, ${Count.EffectTS} in Effect-TS.`}
	/>

	<section class="section">
		<div class="section__body">
			<Toolbar
				Label="Filter"
				Count={`${Count.All} package`}
				Action={[{ Href: Route.Reference, Label: "Reference table" }]}
			>
				<Filter Entry={Catalogue} Family={Family} Kind={Kind} client:load />
			</Toolbar>
			{Group.map((Item) => (
				<section class="section" data-group>
					<SectionHeader Title={Item.Release} />
					<div class="section__body grid">
						{Item.Entry.map((Entry) => (
							<PackageCard Package={Entry} />
						))}
					</div>
				</section>
			))}
		</div>
	</section>

	<section class="section">
		<SectionHeader Title="Kind" />
		<div class="section__body">
			<Table Caption="The five package kinds" Head={["Kind", "What it is"]} Row={Kinds} />
		</div>
	</section>
</Base>
