---
import PageHero from "@Component/PageHero.astro";
import Base from "@Layout/Base.astro";
import { Route } from "@Library/Link";
---

<Base
	Title="Harness plugin"
	Description="The family's plugins live in the catalogue, one page per package.">
	<PageHero Eyebrow="Moved" Title="Harness plugin">
		<Fragment slot="Lede">
			Every plugin this site documents is a package in the family: Classic and Effect-TS, one
			page each. The catalogue is the index, and a package page carries its dissection.
		</Fragment>
	</PageHero>

	<section class="section">
		<div class="section__body">
			<p class="lede">
				<a href={Route.Package}>Open the catalogue</a>, or read the{" "}
				<a href={Route.Behavior}>seams</a> the family answers at.
			</p>
		</div>
	</section>
</Base>
