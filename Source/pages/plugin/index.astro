---
import "@Stylesheet/Component/Plugin.scss";

import Callout from "@Component/Callout.astro";
import Explorer from "@Component/Explorer.astro";
import PageHero from "@Component/PageHero.astro";
import SectionHeader from "@Component/SectionHeader.astro";
import Table from "@Component/Table.astro";
import Term from "@Component/Term.astro";
import { Plugin } from "@Content/Plugin";
import Base from "@Layout/Base.astro";
import { Route } from "@Library/Link";

const Role = [...new Set(Plugin.map((Item) => Item.Role))];
const Group = Role.map((Name) => ({
	Label: Name,
	Item: Plugin.filter((Item) => Item.Role === Name).map((Item) => ({
		Label: Item.Slug,
		Href: `/plugin/${Item.Slug}/`,
	})),
}));

const Seam = [...new Set(Plugin.flatMap((Item) => Item.Seam))];

// The eight as rows: what each one is, where it answers, the state it unlocks,
// and the one line it changes. The page a row opens carries the same four
// facts drawn rather than stated.
const Row = Plugin.map((Item) => [
	{ Text: Item.Slug, Href: `/plugin/${Item.Slug}/` },
	Item.Role,
	Item.Seam.join(", "),
	Item.State,
	Item.After,
]);
---

<Base
	Title="Harness plugin"
	Description={`${Plugin.length} harness plugins shown by default, at their seam, and in the state each unlocks.`}>
	<PageHero Eyebrow="Harness" Title="The plugins the harness ships">
		<Fragment slot="Lede">
			{Plugin.length}&nbsp;plugins from the harness itself, each read the same way: what the
			harness does on its own, the <Term Name="seam" /> the plugin answers at, and the state a
			reader sees because of it.
		</Fragment>
	</PageHero>

	<section class="section">
		<SectionHeader
			Title="Rule"
			Lede="Six invariants every dissection on this site obeys. A page that breaks one is a caption wearing a diagram's clothes."
		/>
		<div class="section__body">
			<Callout Title="Invariant" Tone="note">
				<p>
					The two conversations are the same lines, the same sequence numbers, and the
					same order. Exactly one line differs, and the difference is visible without
					reading a caption. The state name comes from the catalogue rather than from
					invention. The "needs logged" line names a specific fact, not a category. The
					seam is marked in the pipeline, and the pipeline is the same component on every
					page. Nothing claims a state the log cannot feed without saying so.
				</p>
			</Callout>
		</div>
	</section>

	<section class="section">
		<SectionHeader
			Title="Row"
			Lede="What each plugin is, where it answers, the state it unlocks, and the one line it changes in the conversation."
		/>
		<div class="section__body">
			<Table
				Caption="Every harness plugin, its role, its seam, the state it unlocks, and the line it changes"
				Head={["Plugin", "Role", "Seam", "State", "Changes"]}
				Row={Row}
			/>
		</div>
	</section>

	<section class="section">
		<SectionHeader
			Title="Role"
			Lede="Five roles, and the seam each plugin answers at. A page for each names the state it unlocks and the facts the log would need to show it."
		/>
		<div class="section__body">
			<Explorer Groups={Group} />
		</div>
	</section>

	<section class="section">
		<SectionHeader
			Title="Seam"
			Lede="The events these plugins answer at, and the family's own pages where they overlap."
		/>
		<div class="section__body stack">
			<ul class="cluster">
				{Seam.map((Name) => (
					<li>
						<span class="mono">{Name}</span>
					</li>
				))}
			</ul>
			<p class="muted">
				<a href={Route.Trace}>The trace</a> shows what the log keeps, and{" "}
				<a href={Route.Behavior}>the family</a> shows where its own hooks stand.
			</p>
		</div>
	</section>
</Base>
