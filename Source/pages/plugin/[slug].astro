---
import "@Stylesheet/Component/Plugin.scss";

import Badge from "@Component/Badge.astro";
import Explorer from "@Component/Explorer.astro";
import Line from "@Component/Line.astro";
import PageHero from "@Component/PageHero.astro";
import Pipeline from "@Component/Pipeline.astro";
import SectionHeader from "@Component/SectionHeader.astro";
import Show from "@Component/Show.astro";
import Table from "@Component/Table.astro";
import Term from "@Component/Term.astro";
import { Seam } from "@Content/Harness";
import { Conversation } from "@Content/Mock";
import { Plugin } from "@Content/Plugin";
import { Showcase } from "@Content/Showcase";
import Base from "@Layout/Base.astro";
import { SeamHref } from "@Library/Link";

export function getStaticPaths() {
	return Plugin.map((Entry) => ({ params: { slug: Entry.Slug }, props: { Slug: Entry.Slug } }));
}

const { Slug } = Astro.props;
const Entry = Plugin.find((Item) => Item.Slug === Slug);

// A path with no plugin behind it is a build error, not an empty page.
if (Entry === undefined) {
	throw new Error(`The path ${Slug} has no plugin record.`);
}

// A seam has a page only when the family documents a hook at it. The plugin's
// seams are mostly the harness's own, so most of them stay plain text.
const Page = new Set(Seam.map((Item) => Item.Name));

// The tool pipeline the plugin interjects into, with the seam it answers at.
const Stage = [
	{ Label: "pre", Seam: "tools/pre-execute" },
	{ Label: "execute", Seam: "tools/execute" },
	{ Label: "post", Seam: "tools/post-execute" },
	{ Label: "result", Seam: "tools/result" },
];

// The other plugins, grouped by the role each plays, so a reader can move
// between them without going back to a catalogue.
const Role = [...new Set(Plugin.map((Item) => Item.Role))];
const Group = Role.map((Name) => ({
	Label: Name,
	Item: Plugin.filter((Item) => Item.Role === Name).map((Item) => ({
		Label: Item.Slug,
		Href: `/plugin/${Item.Slug}/`,
	})),
}));

// The default conversation comes from one file, so "the same three lines" is
// enforced by the build rather than by a comment here.
// The showcase record for this plugin. The binding is named `Face` because the
// component that renders it is `Show`, and a const of the same name would
// shadow the import.
const Face = Showcase.find((Item) => Item.Slug === Entry.Slug);

const Contract = [
	["Seam", Entry.Seam.join(", ")],
	["State", Entry.State],
	["Needs logged", Entry.Data.join(", ")],
];
---

<Base
	Title={Entry.Slug}
	Description={`${Entry.Interjection} The harness plugin ${Entry.Slug}, shown by default, at its seam, and in the state a reader sees.`}>
	<PageHero Eyebrow="Harness plugin" Title={Entry.Slug}>
		<Fragment slot="Lede">{Entry.Interjection}</Fragment>
		<Fragment slot="Actions">
			<Badge Label={Entry.Role} Tone="accent" />
			{Entry.Seam.map((Name) => (
				<Badge Label={Name} Tone="neutral" />
			))}
		</Fragment>
	</PageHero>

	<section class="section">
		<SectionHeader
			Title="Difference"
			Lede="The same three calls twice. Exactly one line changes, and the change is the plugin: no caption needed, and two plugins compare by diffing their diffs."
		/>
		<div class="section__body stack">
			<Pipeline Stages={Stage} Current={Entry.Seam[0]} />

			<div class="plugin__diff">
				<div class="plugin__column">
					<p class="plugin__head">Without {Entry.Slug}</p>
					<div class="plugin__mock" role="list">
						{Conversation.map((Item) => (
							<Line Seq={Item.Seq} Kind="tool" Name={Item.Call}>
								<span class="plugin__outcome">{Item.Outcome}</span>
							</Line>
						))}
					</div>
				</div>

				<div class="plugin__column plugin__column--with">
					<p class="plugin__head">With {Entry.Slug}</p>
					<div class="plugin__mock" role="list">
						{Conversation.map((Item) => (
							<Line
								Seq={Item.Seq}
								Kind="tool"
								Name={Item.Call}
								Current={Item.Seq === Entry.Seq}
							>
								<span class="plugin__outcome" data-changed={Item.Seq === Entry.Seq}>
									{Item.Seq === Entry.Seq ? Entry.After : Item.Outcome}
								</span>
							</Line>
						))}
						{Entry.Seq === undefined && (
							// A plugin that acts at the turn's edge changes no call, so the
							// changed line is drawn beside the conversation: the turn's close,
							// which the fixture records as 13.
							<Line Seq={13} Kind="turn" Name="turn/end" Current>
								<span class="plugin__outcome" data-changed>
									{Entry.After}
								</span>
							</Line>
						)}
					</div>
				</div>
			</div>

			<div class="plugin__result">
				<Badge Label={Entry.State} Tone="warn" />
				<p class="plugin__reason">{Entry.Interjection}</p>
				<p class="plugin__reason">
					Until the harness writes {Entry.Data.join(", ")}, this page cannot show that state
					from a real run. It says so in the same slot where the state would appear, rather
					than faking it.
				</p>
			</div>
		</div>
	</section>

	{
		Face !== undefined && (
			<section class="section">
				<SectionHeader
					Title="Dimension"
					Lede="The one picture this plugin earns: the dimension it adds that the changed line above cannot show."
				/>
				<div class="section__body">
					<Show Plugin={Entry} Showcase={Face} />
				</div>
			</section>
		)
	}

	<section class="section">
		<SectionHeader
			Title="Result"
			Lede="The state a reader sees because of the interjection, and the fact the log must carry to show it."
		/>
		<div class="section__body stack">
			<p class="lede">
				<Badge Label={Entry.State} Tone="warn" />
			</p>
			<p class="muted">
				Until the harness writes {Entry.Data.join(", ")}, this page cannot show the state
				from a real run. It says so in the same slot where the state would appear, rather
				than faking it.
			</p>
		</div>
	</section>

	<section class="section">
		<SectionHeader
			Title="Contract"
			Lede="What the plugin listens to, what it unlocks, and what it needs."
		/>
		<div class="section__body">
			<Table
				Caption={`The contract of ${Entry.Slug}`}
				Head={["Part", "Value"]}
				Row={Contract}
			/>
			<p class="muted">
				{Page.has(Entry.Seam[0]) ? (
					<a href={SeamHref(Entry.Seam[0])}>The seam page</a>
				) : (
					"The seam page"
				)}{" "}
				lists every hook the family declares at that event, when the family stands there.
			</p>
		</div>
	</section>

	<section class="section">
		<SectionHeader
			Title="Other"
			Lede="The harness plugins this site documents, grouped by the role each plays."
		/>
		<div class="section__body">
			<Explorer Groups={Group} />
		</div>
	</section>
</Base>
