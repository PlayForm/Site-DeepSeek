---
import Diagram from "@Component/Diagram.astro";
import PageHero from "@Component/PageHero.astro";
import SectionHeader from "@Component/SectionHeader.astro";
import StatBand from "@Component/StatBand.astro";
import Term from "@Component/Term.astro";
import Trajectory, { type TrajectoryStep } from "@Component/Trajectory.astro";
import Transform from "@Component/Transform.astro";
import { ArmFor } from "@Content/Arm";
import { BehaviorFor } from "@Content/Behavior";
import { Transform as Sample } from "@Content/Transform";
import Base from "@Layout/Base.astro";
import { Route, SeamHref } from "@Library/Link";
import { Count, SelectKind } from "@Library/Package.server";

// The order a conversation reaches the seams. A seam that is not in this list
// is appended after the known ones.
const Order = [
	"system-prompt/assemble",
	"llm/stream",
	"tools/pre-execute",
	"tools/post-execute",
	"batch/proposed",
	"fs/observed",
	"agent/status",
];

// The lens names what the hooks at a seam see: the prompt the model reads, the
// text it writes, the tool call and its result, the batch, the file on disk, or
// the run's own state.
function LensOf(Seam: string): string {
	switch (true) {
		case Seam === "system-prompt/assemble":
			return "Prompt";
		case Seam === "llm/stream":
			return "Text";
		case Seam.startsWith("tools/"):
			return "Tool";
		case Seam === "batch/proposed":
			return "Batch";
		case Seam === "fs/observed":
			return "File";
		default:
			return "State";
	}
}

// Every hook, grouped by the seam its README names. The mapping is authored in
// `Source/Content/Behavior.ts`; nothing here infers it.
const Group = new Map<string, TrajectoryStep["Listener"]>();

for (const Entry of SelectKind("hook")) {
	const Behavior = BehaviorFor(Entry.Slug);

	if (!Behavior) {
		continue;
	}

	const List = Group.get(Behavior.Seam) ?? [];

	List.push({
		Slug: Entry.Slug,
		Href: Entry.Href,
		What: Entry.Summary,
		Effect: Behavior.Effect,
	});
	Group.set(Behavior.Seam, List);
}

const Seam = [...Group.keys()].sort((Left, Right) => {
	const LeftIndex = Order.indexOf(Left);
	const RightIndex = Order.indexOf(Right);

	return (
		(LeftIndex < 0 ? Order.length : LeftIndex) - (RightIndex < 0 ? Order.length : RightIndex) ||
		Left.localeCompare(Right)
	);
});

const Step: TrajectoryStep[] = Seam.map((Name) => {
	const Listener = Group.get(Name) ?? [];
	const Class = [
		...new Set(
			Listener.map((Entry) => /normalize-(\w+)/.exec(Entry.Slug)?.[1]).filter(Boolean),
		),
	] as string[];

	return {
		Name,
		Href: SeamHref(Name),
		Lens: LensOf(Name),
		Note: Class.length > 0 ? `Normalizes the ${Class.join(", ")} classes` : "",
		Listener,
		// The packages that register an arm at this seam without documenting it.
		// The rail counts the documented hooks; the arms are the honest addendum.
		Arm: SelectKind("hook").filter(
			(Entry) => BehaviorFor(Entry.Slug)?.Seam !== Name && ArmFor(Entry.Slug).includes(Name),
		).length,
	};
});

const Classic = SelectKind("hook").filter((Entry) => Entry.Family === "Classic").length;
---

<Base
	Title="Hook"
	Description={`All ${Count.Hook} hook on ${Step.length} seam, in the order a conversation reaches them.`}>
	<PageHero Eyebrow="Behavior" Title="Hook">
		<Fragment slot="Lede">
			{Count.Hook}&nbsp;
			<Term Name="hook" /> on {Step.length}&nbsp;
			<Term Name="seam" />, in the order a conversation reaches them.
		</Fragment>
	</PageHero>

	<StatBand
		Stat={[
			{ Label: "Hook", Value: Count.Hook, Note: "Two releases" },
			{ Label: "Seam", Value: Step.length, Note: "Distinct events" },
			{ Label: "Classic", Value: Classic },
			{ Label: "Effect-TS", Value: Count.Hook - Classic },
		]}
	/>

	<section class="section">
		<SectionHeader
			Title="Trajectory"
			Lede="One turn, seam by seam. The lens names what the hooks at that seam see and change."
		/>
		<div class="section__body">
			<Trajectory Step={Step} />
		</div>
	</section>

	<section class="section">
		<SectionHeader Title="Seam" Lede="The same order, as one path." />
		<div class="section__body">
			<Diagram
				Id="Trajectory"
				Caption="The seven seams a turn reaches, and the hooks at each."
			/>
		</div>
	</section>

	<section class="section">
		<SectionHeader
			Title="Transform"
			Lede="What the model emits on the left, what the transcript stores on the right."
		/>
		<div class="section__body">
			<Transform Sample={Sample} />
			<p class="muted">
				<a href={Route.CaseStudy}>One character, end to end</a> follows the dash from the
				model to the ledger.
			</p>
		</div>
	</section>
</Base>
