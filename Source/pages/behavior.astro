---
import Base from "@Layout/Base.astro";

import PageHero from "@Component/PageHero.astro";
import SectionHeader from "@Component/SectionHeader.astro";
import Table from "@Component/Table.astro";

import { Count, SelectKind } from "@Library/Package.server";
import { ListenFor } from "@Library/Surface.server";

const Hook = SelectKind("hook");
const Row = Hook.map((Entry) => [
	Entry.Slug,
	ListenFor(Entry.Slug),
	Entry.Family,
	Entry.Version,
	String(Entry.Tests),
]);
---

<Base
	Title="Hook"
	Description={`All ${Count.Hook} hooks. Each one listens on a harness event and changes what happens next.`}
>
	<PageHero
		Eyebrow="Behavior"
		Title="Hook"
		Lede={`${Count.Hook} total. Each one listens on a harness event and changes what happens next.`}
	/>

	<section class="section">
		<SectionHeader Title="Package" />
		<div class="section__body">
			<Table
				Caption="Every hook, the seam it listens on, its release, its version, and its test count"
				Head={["Package", "Listen", "Release", "Version", "Test"]}
				Row={Row}
			/>
		</div>
	</section>
</Base>
