---
import Base from "@Layout/Base.astro";

import PageHero from "@Component/PageHero.astro";
import SectionHeader from "@Component/SectionHeader.astro";
import Table from "@Component/Table.astro";

import { Counts, SelectKind } from "@Library/Packages.server";

const Hooks = SelectKind("hook");
const Rows = Hooks.map((Hook) => [Hook.Slug, Hook.Family, Hook.Version, String(Hook.Tests)]);
---

<Base
	Title="Hooks"
	Description={`The ${Counts.Hooks} hooks in the family. Each one listens on a harness event and changes what happens next.`}
>
	<PageHero
		Eyebrow="Behavior"
		Title="Hooks"
		Lede={`${Counts.Hooks} hooks. Each one listens on a harness event and changes what happens next.`}
	/>

	<section class="section">
		<SectionHeader Title="Every hook" />
		<div class="section__body">
			<Table
				Caption="Every hook, its release, its version, and its test count"
				Head={["Hook", "Release", "Version", "Tests"]}
				Rows={Rows}
			/>
		</div>
	</section>
</Base>
