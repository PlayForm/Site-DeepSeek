---
import PageHero from "@Component/PageHero.astro";
import Base from "@Layout/Base.astro";
import { Route } from "@Library/Link";

// The composition is a section of `/harness/` now. The meta refresh lands a
// stale bookmark at the exact anchor before the page paints; the button is the
// visible link for a client that blocks the refresh and for a crawler.
---

<Base
	Title="Composition"
	Description="The composition moved to the harness page, at /harness/#composition.">
	<Fragment slot="Head">
		<meta http-equiv="refresh" content={`0; url=${Route.Harness}#composition`} />
	</Fragment>
	<PageHero Eyebrow="Composition" Title="How the family composes">
		<Fragment slot="Lede">
			This page moved: the composition is now a section of the harness page, which draws the
			arms at each seam in the order they run.
		</Fragment>
		<Fragment slot="Actions">
			<a class="button" href={`${Route.Harness}#composition`}>
				Read the composition
			</a>
		</Fragment>
	</PageHero>
</Base>
