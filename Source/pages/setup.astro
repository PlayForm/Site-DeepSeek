---
import CodeBlock from "@Component/CodeBlock.astro";
import Diagram from "@Component/Diagram.astro";
import PageHero from "@Component/PageHero.astro";
import SectionHeader from "@Component/SectionHeader.astro";
import StatBand from "@Component/StatBand.astro";
import Table from "@Component/Table.astro";
import Terminal from "@Component/Terminal.astro";
import Base from "@Layout/Base.astro";
import { ConfigFor } from "@Library/Config.server";
import { Content } from "@Library/Content";
import { Route } from "@Library/Link";
import { Count, Package } from "@Library/Package.server";

const Example = Package.find((Entry) => Entry.Slug === "hook-dsh-normalize-dash");
const Patch = Package.filter((Entry) => Entry.Patch).length;
const Configured = Package.filter((Entry) => ConfigFor(Entry.Slug).length > 0).length;

const Knob = ConfigFor(Example?.Slug ?? "").map((Item) => [
	Item.Field,
	Item.Type,
	Item.Default,
	Item.Meaning,
]);

// The activation line the package documents, so a reader knows what to look
// for after the install.
const Confirm = [
	{
		Command: `cat ~/.dsh/playform/${Example?.Slug ?? "hook-dsh-normalize-dash"}.log`,
		Output: `${Example?.Slug ?? "hook-dsh-normalize-dash"}: activated (replacement=-, reasoning=on, toolArgs=off)`,
	},
];
---

<Base
	Title="Set up a plugin"
	Description="Install a plugin, load its bundle patch, set its configuration, and confirm it activated.">
	<PageHero
		Eyebrow="Setup"
		Title="Set up a plugin"
		Lede="Install it, load its bundle patch, set its configuration, and confirm it activated."
	/>

	<StatBand
		Stat={[
			{ Label: "Plugin", Value: Count.All, Note: "Two releases" },
			{ Label: "Bundle patch", Value: Patch, Note: "Ships with the package" },
			{ Label: "Configured", Value: Configured, Note: "Documents its knobs" },
		]}
	/>

	<section class="section">
		<SectionHeader
			Title="Install"
			Lede="Install the plugin you want; its dependencies come with it."
		/>
		<div class="section__body">
			<CodeBlock
				Label="Install one plugin"
				Language="sh"
				Code={`pnpm add ${Example?.Name ?? "@playform/hook-dsh-normalize-dash"}`}
			/>
		</div>
	</section>

	<section class="section">
		<SectionHeader
			Title="Load"
			Lede="List the package in your profile's bundles, then restart the app. A dependency alone is not activation."
		/>
		<div class="section__body stack">
			<Diagram Id="Install" Caption="The path a reader takes: install, load, configure, confirm." />
			<CodeBlock
				Label="~/.dsh/profiles/<profile>/package.json"
				Language="json"
				Code={`{
	"dsh": {
		"profile": {
			"bundles": [
				"@deepseek-ai/dsh-base",
				"${Example?.Name ?? "@playform/hook-dsh-normalize-dash"}"
			]
		}
	}
}`}
			/>
			<Table
				Caption="What the package declares for the host"
				Head={["Field", "Value"]}
				Row={[
					["name", Example?.Name ?? "unavailable"],
					["version", Example?.Version ?? "unavailable"],
					["main", "./Target/Library.js"],
					["dsh.bundle.patch", Example?.Patch ? "./cordis.patch.yml" : "not shipped"],
				]}
			/>
		</div>
	</section>

	{Knob.length > 0 && (
		<section class="section">
			<SectionHeader
				Title="Configure"
				Lede={`Every knob ${Example?.Slug ?? "the plugin"} documents, with its default.`}
			/>
			<div class="section__body">
				<Table
					Caption={`Configuration of ${Example?.Slug ?? "the plugin"}`}
					Head={["Field", "Type", "Default", "Meaning"]}
					Row={Knob}
				/>
				<p class="muted">
					<a href={Example?.Href ?? Route.Package}>Open the plugin</a> to read the rest.
				</p>
			</div>
		</section>
	)}

	<section class="section">
		<SectionHeader
			Title="Confirm"
			Lede="The plugin writes one line to its ledger when it activates."
		/>
		<div class="section__body">
			<Terminal Label="Ledger" Line={Confirm} />
		</div>
	</section>
</Base>
