---
import Breadcrumb from "@Component/Breadcrumb.astro";
import PageHero from "@Component/PageHero.astro";
import Pager from "@Component/Pager.astro";
import SectionHeader from "@Component/SectionHeader.astro";
import Table from "@Component/Table.astro";
import Base from "@Layout/Base.astro";
import { Component } from "@Library/Component";
import { ComponentHref, Route } from "@Library/Link";
import Preview from "@Library/Preview.astro";

export function getStaticPaths() {
	return Component.map((Entry) => ({
		params: { slug: Entry.Slug },
		props: { Entry },
	}));
}

interface Props {
	Entry: (typeof Component)[number];
}

const { Entry } = Astro.props;
const Index = Component.findIndex((Candidate) => Candidate.Slug === Entry.Slug);
const Previous = Index > 0 ? Component[Index - 1] : undefined;
const Next = Index >= 0 && Index < Component.length - 1 ? Component[Index + 1] : undefined;
---

<Base Title={Entry.Name} Description={Entry.Summary}>
	<Breadcrumb
		Trail={[
			{ Href: Route.Library, Label: "Component" },
			{ Href: ComponentHref(Entry.Slug), Label: Entry.Name },
		]}
	/>

	<PageHero Eyebrow="Component" Title={Entry.Name} Lede={Entry.Summary} />

	<section class="section">
		<SectionHeader Title="Demo" />
		<div class="section__body">
			<Preview Slug={Entry.Slug} />
		</div>
	</section>

	<section class="section">
		<SectionHeader Title="Properties" />
		<div class="section__body">
			<Table
				Caption={`Properties of ${Entry.Name}`}
				Head={["Property", "Type", "Meaning"]}
				Row={Entry.Prop}
			/>
		</div>
	</section>

	<Pager
		Previous={
			Previous ? { Href: ComponentHref(Previous.Slug), Label: Previous.Name } : undefined
		}
		Next={Next ? { Href: ComponentHref(Next.Slug), Label: Next.Name } : undefined}
	/>
</Base>
