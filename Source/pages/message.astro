---
import PageHero from "@Component/PageHero.astro";
import Base from "@Layout/Base.astro";
import { Route } from "@Library/Link";

// The conversation is a section of `/harness/` now. The meta refresh lands a
// stale bookmark at the exact anchor before the page paints; the button is the
// visible link for a client that blocks the refresh and for a crawler.
---
<Base
	Title="Conversation"
	Description="The conversation moved to the harness page, at /harness/#conversation.">
	<Fragment slot="Head">
		<meta http-equiv="refresh" content={`0; url=${Route.Harness}#conversation`} />
	</Fragment>
	<PageHero Eyebrow="Conversation" Title="What the model reads">
		<Fragment slot="Lede">
			This page moved: the conversation is now a section of the harness page, which lists
			what the model reads, role by role.
		</Fragment>
		<Fragment slot="Actions">
			<a class="button" href={`${Route.Harness}#conversation`}>Read the conversation</a>
		</Fragment>
	</PageHero>
</Base>
