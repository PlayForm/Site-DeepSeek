---
import "@Stylesheet/Component/Explorer.scss";

import Base from "@Layout/Base.astro";

import Explorer from "@Component/Graph/Explorer.tsx";
import PageHero from "@Component/PageHero.astro";

import Catalogue from "@Library/Graph/Catalogue.server";
---

<Base
	Title="Observatory"
	Description={`The package graph: ${Catalogue.Nodes.length} nodes and ${Catalogue.Edges.length} dependency edges, laid out in the browser.`}
>
	<PageHero
		Eyebrow="Observatory"
		Title="Package graph"
		Lede={`${Catalogue.Nodes.length} nodes, ${Catalogue.Edges.length} edges.`}
	/>

	<section class="section">
		<div class="section__body">
			<Explorer
				Nodes={Catalogue.Nodes}
				Edges={Catalogue.Edges}
				Families={Catalogue.Families}
				Kinds={Catalogue.Kinds}
				client:load
			/>
		</div>
	</section>
</Base>
