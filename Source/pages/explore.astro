---
import "@Stylesheet/Component/Explorer.scss";

import Base from "@Layout/Base.astro";

import Explorer from "@Component/Graph/Explorer.tsx";
import PageHero from "@Component/PageHero.astro";

import Catalogue from "@Library/Graph/Catalogue.server";
---

<Base
	Title="Observatory"
	Description={`The package graph: ${Catalogue.Node.length} nodes and ${Catalogue.Edge.length} dependency edges, laid out in the browser.`}
>
	<PageHero
		Eyebrow="Observatory"
		Title="Package graph"
		Lede={`${Catalogue.Node.length} nodes, ${Catalogue.Edge.length} edges.`}
	/>

	<section class="section">
		<div class="section__body">
			<Explorer
				Node={Catalogue.Node}
				Edge={Catalogue.Edge}
				Family={Catalogue.Family}
				Kind={Catalogue.Kind}
				client:load
			/>
		</div>
	</section>
</Base>
