<script>
	// Registry filter: the search input + the filter chips drive the instant
	// grid. Matching cards stay; the rest get .is-hidden (display:none, no
	// layout shift). The telemetry strip counts the visible set live, and a
	// click on a registry row selects it (the #EBF2FF + 2px Harness Blue
	// left accent per the list-state spec).
	const Input = document.querySelector<HTMLInputElement>("[data-filter]");
	const Count = document.querySelector<HTMLElement>("[data-count]");
	const CountText = document.querySelector<HTMLElement>("[data-count-text]");
	const Empty = document.querySelector<HTMLElement>("[data-empty]");
	const Cards = Array.from(document.querySelectorAll<HTMLElement>(".card[data-package]"));

	function Haystack(Card: HTMLElement) {
		const Clone = Card.cloneNode(true) as HTMLElement;
		Clone.querySelectorAll<HTMLElement>("[data-copy], .copy-trigger").forEach((Node) =>
			Node.remove(),
		);
		return (Clone.textContent ?? "").toLowerCase();
	}

	function Filter() {
		const Query = (Input?.value ?? "").trim().toLowerCase();
		const Active = document.querySelector<HTMLElement>("[data-filter-chip].is-active");
		const Chip = Active?.dataset["filterChip"] ?? "all";

		let Visible = 0;
		for (const Card of Cards) {
			const Text = Haystack(Card);
			const Tags = (Card.dataset["tags"] ?? "").toLowerCase();
			const MatchesQuery = !Query || Text.includes(Query);
			const MatchesChip =
				Chip === "all" ||
				Tags.split(/\s+/).includes(Chip) ||
				Tags.includes(Chip) ||
				Text.includes(Chip === "core" ? "factory" : Chip);

			if (MatchesQuery && MatchesChip) {
				Card.classList.remove("is-hidden");
				Visible += 1;
				// Re-arm the deterministic entrance.
				Card.classList.remove("filter-enter");
				void Card.offsetWidth;
				Card.classList.add("filter-enter");
			} else {
				Card.classList.add("is-hidden");
			}
		}

		const QueryPart = Query ? ` MATCHING "${Query.toUpperCase()}"` : "";
		if (Count) Count.textContent = `${Visible} RESULT${Visible === 1 ? "" : "S"}`;
		if (CountText) {
			CountText.textContent = `${Visible} PACKAGE${Visible === 1 ? "" : "S"}${QueryPart}`;
		}
		if (Empty) Empty.classList.toggle("is-visible", Visible === 0);
	}

	Input?.addEventListener("input", Filter);

	document.querySelectorAll<HTMLElement>("[data-filter-chip]").forEach((Chip) => {
		Chip.addEventListener("click", () => {
			document
				.querySelectorAll<HTMLElement>("[data-filter-chip]")
				.forEach((Item) => {
					Item.classList.remove("is-active");
					Item.setAttribute("aria-pressed", "false");
				});
			Chip.classList.add("is-active");
			Chip.setAttribute("aria-pressed", "true");
			Filter();
		});
	});

	document.querySelector("[data-reset]")?.addEventListener("click", () => {
		if (Input) {
			Input.value = "";
			Input.focus();
		}
		document
			.querySelectorAll<HTMLElement>("[data-filter-chip]")
			.forEach((Chip) => {
				const Active = Chip.dataset["filterChip"] === "all";
				Chip.classList.toggle("is-active", Active);
				Chip.setAttribute("aria-pressed", String(Active));
			});
		Filter();
	});

	// Registry row selection: one selected row at a time. Each row gets a
	// tabindex (keyboard reach) and selects on Enter / Space like a button;
	// the :focus-visible ring lives in Global.css (crisp 1px Harness Blue).
	document.querySelectorAll<HTMLElement>("[data-selectable] tbody tr").forEach((Row) => {
		Row.tabIndex = 0;
		Row.addEventListener("click", () => {
			Row.parentElement
				?.querySelectorAll<HTMLElement>("tr.is-selected")
				.forEach((Item) => Item.classList.remove("is-selected"));
			Row.classList.add("is-selected");
		});
		Row.addEventListener("keydown", (Event) => {
			if (Event.key === "Enter" || Event.key === " ") {
				Event.preventDefault();
				Row.click();
			}
		});
	});

	Filter();
</script>
