---
import PageHero from "@Component/PageHero.astro";
import Base from "@Layout/Base.astro";
import { Route } from "@Library/Link";

// The turn is a section of `/harness/` now. The meta refresh lands a stale
// bookmark at the exact anchor before the page paints; the button is the
// visible link for a client that blocks the refresh and for a crawler.
---

<Base Title="Turn" Description="The turn moved to the harness page, at /harness/#turn.">
	<Fragment slot="Head">
		<meta http-equiv="refresh" content={`0; url=${Route.Harness}#turn`} />
	</Fragment>
	<PageHero Eyebrow="Harness" Title="The turn">
		<Fragment slot="Lede">
			This page moved: the turn is now a section of the harness page, which follows one turn
			from the queue to the close.
		</Fragment>
		<Fragment slot="Actions">
			<a class="button" href={`${Route.Harness}#turn`}>
				Read the turn
			</a>
		</Fragment>
	</PageHero>
</Base>
