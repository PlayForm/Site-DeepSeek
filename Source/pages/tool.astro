---
import PageHero from "@Component/PageHero.astro";
import Base from "@Layout/Base.astro";
import { Route } from "@Library/Link";

// One tool call is a section of `/harness/` now. The meta refresh lands a stale
// bookmark at the exact anchor before the page paints; the button is the
// visible link for a client that blocks the refresh and for a crawler.
---
<Base Title="Tool call" Description="One tool call moved to the harness page, at /harness/#call.">
	<Fragment slot="Head">
		<meta http-equiv="refresh" content={`0; url=${Route.Harness}#call`} />
	</Fragment>
	<PageHero Eyebrow="Tool call" Title="One call, four gates">
		<Fragment slot="Lede">
			This page moved: the call is now a section of the harness page, which draws one tool
			call as participants and as a lifecycle.
		</Fragment>
		<Fragment slot="Actions">
			<a class="button" href={`${Route.Harness}#call`}>Read the call</a>
		</Fragment>
	</PageHero>
</Base>
