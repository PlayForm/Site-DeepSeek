---
import Base from "@Layout/Base.astro";

import EmptyState from "@Component/EmptyState.astro";
import PageHero from "@Component/PageHero.astro";

import { Routes } from "@Library/Links";
---

<Base Title="Showcase" Description="One package, one trace, one outcome.">
	<PageHero Eyebrow="Showcase" Title="Showcase" Lede="One package, one trace, one outcome." />

	<section class="section">
		<div class="section__body">
			<EmptyState Title="Nothing recorded yet">
				<a href={Routes.Package}>Package</a>
			</EmptyState>
		</div>
	</section>
</Base>
