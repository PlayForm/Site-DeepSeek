---
import Card from "@Component/Card.astro";
import PageHero from "@Component/PageHero.astro";
import SectionHeader from "@Component/SectionHeader.astro";
import StatBand from "@Component/StatBand.astro";
import Term from "@Component/Term.astro";
import { BehaviorFor } from "@Content/Behavior";
import { Transform } from "@Content/Transform";
import Base from "@Layout/Base.astro";
import Catalogue from "@Library/Graph/Catalogue.server";
import { Route } from "@Library/Link";
import { Count, SelectKind } from "@Library/Package.server";
import { Line } from "@Library/Release.server";

// What the site can show today, computed from the authored behavior map so the
// figures match the behavior page exactly.
const Hook = SelectKind("hook");

const Group = new Map<string, Set<string>>();

for (const Entry of Hook) {
	const Behavior = BehaviorFor(Entry.Slug);

	if (!Behavior) {
		continue;
	}

	const List = Group.get(Behavior.Seam) ?? new Set<string>();

	List.add(Entry.Slug);
	Group.set(Behavior.Seam, List);
}

const Seam = Group.size;

const Listener = [...Group.values()].reduce((Total, List) => Total + List.size, 0);
---

<Base
	Title="Showcase"
	Description={`What the site can show from the tree: ${Seam} seams, ${Listener} listeners, ${Transform.length} worked transforms, and ${Catalogue.Edge.length} dependency edges.`}>
	<PageHero Eyebrow="Showcase" Title="Showcase">
		<Fragment slot="Lede">
			{Seam}&nbsp;
			<Term Name="seam" />, {Listener}&nbsp;
			<Term Name="hook" />, {Transform.length} worked transforms, {Catalogue.Edge.length}
			&nbsp; dependency edge.
		</Fragment>
	</PageHero>

	<StatBand
		Stat={[
			{ Label: "Seam", Value: Seam, Note: "Events the hooks listen on" },
			{ Label: "Hook", Value: Listener, Note: "Registrations, both releases" },
			{ Label: "Transform", Value: Transform.length, Note: "Worked examples" },
			{ Label: "Edge", Value: Catalogue.Edge.length, Note: "Family dependencies" },
		]}
	/>

	<section class="section">
		<SectionHeader Title="Exhibit" />
		<div class="section__body grid">
			<Card Title="Trajectory" Href={Route.Behavior} Meta={`${Seam} seam`}>
				One turn, seam by seam, with the hooks that act at each step and what the model
				sees.
			</Card>
			<Card Title="Transform" Href={Route.Behavior} Meta={`${Transform.length} example`}>
				The character the model emits beside the character the transcript stores.
			</Card>
			<Card Title="Case study" Href={Route.CaseStudy} Meta="One character">
				An em dash followed from the model, through the seam, to the ledger.
			</Card>
			<Card Title="Graph" Href={Route.Observatory} Meta={`${Catalogue.Node.length} node`}>
				The family as a graph, with the dependency arrows and a search field.
			</Card>
			<Card Title="Release" Href={Route.Timeline} Meta={`${Line.length} version`}>
				The release line the changelogs record, newest first.
			</Card>
			<Card Title="Package" Href={Route.Package} Meta={`${Count.All} package`}>
				Every package with its summary, its surface, and its release history.
			</Card>
		</div>
	</section>
</Base>
