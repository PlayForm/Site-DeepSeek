---
import PageHero from "@Component/PageHero.astro";
import Base from "@Layout/Base.astro";
import { Route } from "@Library/Link";
---

<Base Title="Marketplace" Description="The marketplace index moved into the catalogue.">
	<PageHero Eyebrow="Moved" Title="Marketplace">
		<Fragment slot="Lede">
			The marketplace index is a section of the catalogue now, beside the cards it lists. A
			stale bookmark lands on the index itself.
		</Fragment>
	</PageHero>

	<section class="section">
		<div class="section__body">
			<p class="lede">
				<a href={`${Route.Package}#marketplace`}>Open the marketplace index</a> in the
				catalogue.
			</p>
		</div>
	</section>
</Base>
