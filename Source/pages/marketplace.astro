---
import PageHero from "@Component/PageHero.astro";
import SectionHeader from "@Component/SectionHeader.astro";
import StatBand from "@Component/StatBand.astro";
import Table from "@Component/Table.astro";
import Term from "@Component/Term.astro";
import Base from "@Layout/Base.astro";
import { PackageHref } from "@Library/Link";
import { Marketplace } from "@Library/Marketplace.server";
import { Count } from "@Library/Package.server";

const Bundle = Marketplace.Group.reduce((Total, Entry) => Total + Entry.Bundle.length, 0);
---

<Base
	Title="Marketplace"
	Description={`The family as an installable index: ${Bundle} bundles in ${Marketplace.Group.length} categories.`}>
	<PageHero Eyebrow="Marketplace" Title="Marketplace">
		<Fragment slot="Lede">
			{Bundle} <Term Name="bundle" /> in {Marketplace.Group.length} <Term Name="category" />.
		</Fragment>
	</PageHero>

	<StatBand
		Stat={[
			{ Label: "Bundle", Value: Bundle, Note: "Listed in the index" },
			{ Label: "Category", Value: Marketplace.Group.length },
			{ Label: "Package", Value: Count.All, Note: "Two releases" },
		]}
	/>

	{Marketplace.Group.map((Group) => (
		<section class="section">
			<SectionHeader Title={Group.Label} />
			<div class="section__body">
				<Table
					Caption={`The ${Group.Label} bundles`}
					Head={["Bundle", "Package", "What"]}
					Row={Group.Bundle.map((Entry) => [
						Entry.Title,
						{ Text: Entry.Name, Href: PackageHref(Entry.Slug), Icon: Entry.Slug },
						Entry.Summary,
					])}
				/>
			</div>
		</section>
	))}

	<section class="section">
		<SectionHeader Title="Package" />
		<div class="section__body">
			<p class="lede">
				<a href={PackageHref("plugin-dsh-factory")}>Open a package</a> to read its facts.
			</p>
		</div>
	</section>
</Base>
