---
import PageHero from "@Component/PageHero.astro";
import Base from "@Layout/Base.astro";
import { Route } from "@Library/Link";

// The coverage is a section of `/harness/` now. The meta refresh lands a stale
// bookmark at the exact anchor before the page paints; the button is the
// visible link for a client that blocks the refresh and for a crawler.
---

<Base
	Title="Intervention"
	Description="The coverage moved to the harness page, at /harness/#coverage.">
	<Fragment slot="Head">
		<meta http-equiv="refresh" content={`0; url=${Route.Harness}#coverage`} />
	</Fragment>
	<PageHero Eyebrow="Intervention" Title="What a plugin changes">
		<Fragment slot="Lede">
			This page moved: the coverage is now a section of the harness page, which draws each
			plugin against the seams of the turn.
		</Fragment>
		<Fragment slot="Actions">
			<a class="button" href={`${Route.Harness}#coverage`}>
				Read the coverage
			</a>
		</Fragment>
	</PageHero>
</Base>
