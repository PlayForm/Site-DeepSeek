---
import Base from "@Layout/Base.astro";

import PageHero from "@Component/PageHero.astro";
import SectionHeader from "@Component/SectionHeader.astro";
import Table from "@Component/Table.astro";

import { Count, Package } from "@Library/Package.server";
import { ListenFor } from "@Library/Surface.server";

const Row = Package.map((Entry) => [
	{ Text: Entry.Slug, Href: Entry.Href },
	Entry.Kind,
	ListenFor(Entry.Slug),
	Entry.Family,
	Entry.Version,
	String(Entry.Tests),
]);
---

<Base
	Title="Reference"
	Description={`All ${Count.All} packages with their kind, seam, release, version, and test count.`}
>
	<PageHero
		Eyebrow="Table"
		Title="Reference"
		Lede={`${Count.All} rows: kind, seam, release, version, and test count for every package.`}
	/>

	<section class="section">
		<SectionHeader Title="Package" />
		<div class="section__body">
			<Table
				Caption="Every package, its kind, the seam it listens on, its release, its version, and its test count"
				Head={["Package", "Kind", "Listen", "Release", "Version", "Test"]}
				Row={Row}
			/>
		</div>
	</section>
</Base>
