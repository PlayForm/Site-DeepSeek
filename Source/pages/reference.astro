---
import Base from "@Layout/Base.astro";

import PageHero from "@Component/PageHero.astro";
import SectionHeader from "@Component/SectionHeader.astro";
import Table from "@Component/Table.astro";

import { Counts, Packages } from "@Library/Packages.server";

const Rows = Packages.map((Package) => [
	Package.Slug,
	Package.Kind,
	Package.Family,
	Package.Version,
	String(Package.Tests),
]);
---

<Base
	Title="Reference"
	Description={`All ${Counts.All} packages with their kind, release, version, and test count.`}
>
	<PageHero
		Eyebrow="Reference"
		Title="Reference"
		Lede={`${Counts.All} rows: kind, release, version, and test count for every package.`}
	/>

	<section class="section">
		<SectionHeader Title="Package" />
		<div class="section__body">
			<Table
				Caption="Every package, its kind, its release, its version, and its test count"
				Head={["Package", "Kind", "Release", "Version", "Test"]}
				Rows={Rows}
			/>
		</div>
	</section>
</Base>
