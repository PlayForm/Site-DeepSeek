---
import PageHero from "@Component/PageHero.astro";
import Base from "@Layout/Base.astro";
import { Route } from "@Library/Link";
---

<Base
	Title="Reference"
	Description="The reference table and the vocabulary moved into the catalogue.">
	<PageHero Eyebrow="Moved" Title="Reference">
		<Fragment slot="Lede">
			The reference table and the vocabulary are sections of the catalogue now, beside the
			cards they describe. A stale bookmark lands on the table itself.
		</Fragment>
	</PageHero>

	<section class="section">
		<div class="section__body">
			<p class="lede">
				<a href={`${Route.Package}#table`}>Open the table</a>, or the&nbsp;
				<a href={`${Route.Package}#term`}>vocabulary</a> below it.
			</p>
		</div>
	</section>
</Base>
