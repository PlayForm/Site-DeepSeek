---
import PageHero from "@Component/PageHero.astro";
import SectionHeader from "@Component/SectionHeader.astro";
import Table from "@Component/Table.astro";
import { BehaviorFor } from "@Content/Behavior";
import Base from "@Layout/Base.astro";
import { Count, Package } from "@Library/Package.server";

const Row = Package.map((Entry) => [
	{ Text: Entry.Slug, Href: Entry.Href, Icon: Entry.Slug },
	Entry.Kind,
	BehaviorFor(Entry.Slug)?.Seam ?? "",
	Entry.Family,
	Entry.Version,
]);
---

<Base
	Title="Reference"
	Description={`All ${Count.All} packages with their kind, seam, release, and version.`}>
	<PageHero
		Eyebrow="Table"
		Title="Reference"
		Lede={`${Count.All} rows: kind, seam, release, and version for every package.`}
	/>

	<section class="section">
		<SectionHeader Title="Package" />
		<div class="section__body">
			<Table
				Caption="Every package, its kind, the seam it listens on, its release, and its version"
				Head={["Package", "Kind", "Listen", "Release", "Version"]}
				Row={Row}
			/>
		</div>
	</section>
</Base>
