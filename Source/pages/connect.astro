---
import Base from "@Layout/Base.astro";

import PageHero from "@Component/PageHero.astro";
import SectionHeader from "@Component/SectionHeader.astro";
import StatBand from "@Component/StatBand.astro";
import Table from "@Component/Table.astro";
import Term from "@Component/Term.astro";
import Terminal from "@Component/Terminal.astro";

import { Ledger } from "@Library/Ledger.server";
import { Route } from "@Library/Link";
import { Count, SelectKind } from "@Library/Package.server";

const Row = Ledger.map((Entry) => [
	{ Text: Entry.Slug, Href: Entry.Href },
	Entry.Path,
]);

const Watch = [
	{
		Command: "tail -f ~/.dsh/playform/*.log",
		Output: "every plugin that writes a ledger, live, in one stream",
	},
];
---

<Base
	Title="Read your run"
	Description={`Every plugin that keeps a ledger, and the file it writes: ${Ledger.length} paths.`}
>
	<PageHero
		Eyebrow="Connect"
		Title="Read your run"
	>
		<Fragment slot="Lede">
			{Ledger.length} <Term Name="plugin" /> keep a <Term Name="ledger" />. Each one writes its
			own file, and the file says what it did.
		</Fragment>
	</PageHero>

	<StatBand
		Stat={[
			{ Label: "Ledger", Value: Ledger.length, Note: "Documented file paths" },
			{ Label: "Hook", Value: Count.Hook, Note: "Two releases" },
			{ Label: "Package", Value: Count.All, Note: "Every one, read at build" },
		]}
	/>

	<section class="section">
		<SectionHeader
			Title="Watch"
			Lede="The ledgers live under one directory, so one command follows them all."
		/>
		<div class="section__body">
			<Terminal Label="Ledger" Line={Watch} />
		</div>
	</section>

	<section class="section">
		<SectionHeader Title="File" Lede="The default path each plugin documents for its own ledger." />
		<div class="section__body">
			<Table
				Caption="Every plugin that documents a ledger file"
				Head={["Plugin", "File"]}
				Row={Row}
			/>
		</div>
	</section>

	<section class="section">
		<SectionHeader Title="Turn it off" />
		<div class="section__body">
			<p class="lede">
				Every plugin documents a <code>log</code> switch beside <code>logFile</code>. Set it to
				<code> false</code> to stop the file, and open <a href={Route.Setup}>Setup</a> for the rest
				of the knobs.
			</p>
		</div>
	</section>
</Base>
