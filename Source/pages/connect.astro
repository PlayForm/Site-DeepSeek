---
import Base from "@Layout/Base.astro";

import Callout from "@Component/Callout.astro";
import CodeBlock from "@Component/CodeBlock.astro";
import EmptyState from "@Component/EmptyState.astro";
import PageHero from "@Component/PageHero.astro";

import { Routes } from "@Library/Links";
---

<Base Title="Connect" Description="Bring a trace and read what it proves.">
	<PageHero Eyebrow="Connect" Title="Connect" Lede="Bring a trace and read what it proves." />

	<section class="section">
		<div class="section__body stack">
			<EmptyState Title="Nothing imported yet" />
			<CodeBlock
				Label="Trace"
				Language="text"
				Code={"a trace file\nits manifest\nits ledger lines"}
			/>
			<Callout Title="Nothing is uploaded">
				The parser runs in the browser, so a trace never leaves the machine.
			</Callout>
			<p class="muted">
				<a href={Routes.Package}>Package</a>
			</p>
		</div>
	</section>
</Base>
