---
import Base from "@Layout/Base.astro";

import Badge from "@Component/Badge.astro";
import Breadcrumb from "@Component/Breadcrumb.astro";
import CodeBlock from "@Component/CodeBlock.astro";
import Definition from "@Component/Definition.astro";
import Pager from "@Component/Pager.astro";
import PageHero from "@Component/PageHero.astro";
import SectionHeader from "@Component/SectionHeader.astro";
import Table from "@Component/Table.astro";
import VersionPill from "@Component/VersionPill.astro";

import { Route } from "@Library/Links";
import { Package, type PackageRecord } from "@Library/Package.server";

export function getStaticPaths() {
	return Package.map((Entry) => ({
		params: { slug: Entry.Slug },
		props: { Entry },
	}));
}

interface Props {
	Entry: PackageRecord;
}

const { Entry } = Astro.props;
const Index = Package.findIndex((Candidate) => Candidate.Slug === Entry.Slug);
const Previous = Index > 0 ? Package[Index - 1] : undefined;
const Next = Index >= 0 && Index < Package.length - 1 ? Package[Index + 1] : undefined;
---

<Base Title={Entry.Slug} Description={Entry.Summary}>
	<Breadcrumb
		Trail={[
			{ Href: Route.Package, Label: "Package" },
			{ Href: Entry.Href, Label: Entry.Slug },
		]}
	/>

	<PageHero Eyebrow={`${Entry.Kind} / ${Entry.Family}`} Title={Entry.Slug} Lede={Entry.Summary}>
		<Fragment slot="Actions">
			<VersionPill Version={Entry.Version} Private={Entry.Private} />
			<Badge Label={Entry.Kind} Tone="accent" />
			<Badge Label={Entry.Family} />
		</Fragment>
	</PageHero>

	<section class="section">
		<SectionHeader Title="Facts" />
		<div class="section__body">
			<Definition
				Definition={[
					{ Term: "Package", Detail: Entry.Name },
					{ Term: "Version", Detail: Entry.Version },
					{ Term: "Kind", Detail: Entry.Kind },
					{ Term: "Release", Detail: Entry.Family },
					{ Term: "Licence", Detail: Entry.Licence },
					{ Term: "Directory", Detail: Entry.Directory },
					{ Term: "Test", Detail: String(Entry.Tests) },
					{ Term: "Module", Detail: String(Entry.Modules) },
				]}
			/>
		</div>
	</section>

	<section class="section">
		<SectionHeader Title="What it does" />
		<div class="section__body stack">
			<p class="lede">{Entry.Summary}.</p>
			<p class="muted">
				<a href={`${Entry.Source}/README.md`}>Read the full description in the README</a>.
			</p>
		</div>
	</section>

	{
		Entry.Dependencies.length > 0 && (
			<section class="section">
				<SectionHeader Title="Dependencies" />
				<div class="section__body">
					<Table
						Caption={`Dependencies of ${Entry.Slug}`}
						Head={["Package", "Role"]}
						Row={Entry.Dependencies.map((Dependency) => [
							Dependency,
							Dependency.startsWith("@playform/") ? "family" : "external",
						])}
					/>
				</div>
			</section>
		)
	}

	<section class="section">
		<SectionHeader Title="Source" />
		<div class="section__body stack">
			<p class="lede">
				<a href={Entry.Source}>Open the package in the monorepo</a>
			</p>
			<CodeBlock Label="Install" Language="sh" Code={`pnpm add ${Entry.Name}`} />
		</div>
	</section>

	<Pager
		Previous={Previous ? { Href: Previous.Href, Label: Previous.Slug } : undefined}
		Next={Next ? { Href: Next.Href, Label: Next.Slug } : undefined}
	/>
</Base>
