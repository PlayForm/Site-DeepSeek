---
import Absence from "@Component/Absence.astro";
import Absent from "@Component/Absent.astro";
import Activation from "@Component/Activation.astro";
import Advise from "@Component/Advise.astro";
import Badge from "@Component/Badge.astro";
import Breadcrumb from "@Component/Breadcrumb.astro";
import Buffer from "@Component/Buffer.astro";
import Bundle from "@Component/Bundle.astro";
import Callout from "@Component/Callout.astro";
import CodeBlock from "@Component/CodeBlock.astro";
import Definition from "@Component/Definition.astro";
import Difference from "@Component/Difference.astro";
import Disclosure from "@Component/Disclosure.astro";
import Family from "@Component/Family.astro";
import Flow from "@Component/Flow.astro";
import Gate from "@Component/Gate.astro";
import Icon from "@Component/Icon.astro";
import Knob from "@Component/Knob.astro";
import Ladder from "@Component/Ladder.astro";
import Layer from "@Component/Layer.astro";
import Ledger from "@Component/Ledger.astro";
import Normalizer from "@Component/Normalizer.astro";
import Origin from "@Component/Origin.astro";
import PageHero from "@Component/PageHero.astro";
import Pager from "@Component/Pager.astro";
import Pair from "@Component/Pair.astro";
import Policy from "@Component/Policy.astro";
import Provenance from "@Component/Provenance.astro";
import Reach from "@Component/Reach.astro";
import Record from "@Component/Record.astro";
import Retrieve from "@Component/Retrieve.astro";
import Rewrite from "@Component/Rewrite.astro";
import Schema from "@Component/Schema.astro";
import Scheme from "@Component/Scheme.astro";
import SectionHeader from "@Component/SectionHeader.astro";
import Service from "@Component/Service.astro";
import SessionView from "@Component/SessionView.tsx";
import Storage from "@Component/Storage.astro";
import Stream from "@Component/Stream.astro";
import Surface from "@Component/Surface.astro";
import Table from "@Component/Table.astro";
import Tool from "@Component/Tool.astro";
import Transform from "@Component/Transform.astro";
import VersionPill from "@Component/VersionPill.astro";
import View from "@Component/View.astro";
import { Activation as ActivationData } from "@Content/Activation";
import { ArmFor } from "@Content/Arm";
import { BehaviorFor } from "@Content/Behavior";
import { CurrentFor } from "@Content/Current";
import { DeltaFor } from "@Content/Delta";
import { DetailFor } from "@Content/Detail";
import { SeamFor } from "@Content/Harness";
import { HookFor } from "@Content/Hook";
import { Conversation } from "@Content/Mock";
import { PortraitFor } from "@Content/Portrait";
import { SchemeFor } from "@Content/Scheme";
import { Plural } from "@Content/Session";
import { ReachFor, TableFor } from "@Content/Table";
import { Transform as Sample } from "@Content/Transform";
import Base from "@Layout/Base.astro";
import { ConfigFor } from "@Library/Config.server";
import Catalogue from "@Library/Graph/Catalogue.server";
import { PackageHref, Route, SeamHref } from "@Library/Link";
import { Package, type PackageRecord } from "@Library/Package.server";
import { VersionOf } from "@Library/Release.server";
import { SurfaceFor } from "@Library/Surface.server";

export function getStaticPaths() {
	return Package.map((Entry) => ({
		params: { slug: Entry.Slug },
		props: { Entry },
	}));
}

interface Props {
	Entry: PackageRecord;
}

const { Entry } = Astro.props;
const Index = Package.findIndex((Candidate) => Candidate.Slug === Entry.Slug);
const Previous = Index > 0 ? Package[Index - 1] : undefined;
const Next = Index >= 0 && Index < Package.length - 1 ? Package[Index + 1] : undefined;

// The package's own seam, when the behavior map documents one, and the
// harness's side of that seam: its dispatch mode and the listeners it already
// has there. A package with no documented seam has no default to compare
// against, and the page says that rather than inventing one.
const Behavior = BehaviorFor(Entry.Slug);
const Harness = Behavior === undefined ? undefined : SeamFor(Behavior.Seam);
const Arm = ArmFor(Entry.Slug);

// The family's other packages at that seam, in the order the behavior map
// lists them, as one sentence: this package's page says what the family adds
// there, and the neighbours are named rather than drawn again. The map records
// the Classic identity, so an ETS page reads its own record through the prefix
// its twin strips.
const Identity = Entry.Slug.replace(/^ets-/, "");
const Own = Behavior === undefined ? [] : HookFor(Behavior.Seam);

// The dissected change, when this package has one: the one line that differs
// with the package installed, transcribed from the source by the dissection.
const Delta = DeltaFor(Entry.Slug);

// The authored presentation, when this package has one: what it is, what it
// plugs into, and the one picture that fits its kind. A package with no
// record keeps the page it has, because the page never invents a portrait.
const Portrait = PortraitFor(Entry.Slug);

// The package's flow, when the site has authored one: the seam it answers at,
// the order its work happens in, and the branch that decides. The portrait
// above says what the hook is; this says what it does, in order, and the two
// are separate records because a package can have either one alone.
const Current = CurrentFor(Entry.Slug);

// The structured facts the package's source documents, when the site has
// authored them: the comment-syntax families, the compressor's gate, marker,
// store, retrieval and exemptions, or the guard's lists, order, shapes and
// lines. The record is one typed entry per package, and the section draws only
// the facts the record carries.
const Detail = DetailFor(Entry.Slug);

// The verdicts the record carries, for the portrait's gate: the gate is the
// shallow picture of a gate-shaped package, and the detail draws the facts
// behind it. A package with no record keeps the page it has.
const Verdict = Detail?.Verdict;

// The section's one caption, by the kind of record the package has.
const Lede =
	Detail === undefined
		? undefined
		: {
				Syntax: "The comment syntax the scanner knows, and the extensions it leaves alone.",
				Compress:
					"The address the gate writes, the store behind it, the four answers the retrieval returns, and the tools the gate never touches.",
				Guard: "The two lists the guard compares, the order it compares them in, and the lines it leaves.",
			}[Detail.Kind];

// The badge tone a verdict carries, and the tone an effect at a seam carries:
// the marked value takes the accent, and the allowed verdict, the record, the
// advice, and the pass stay quiet.
const Tone = (Label: string): "accent" | "quiet" =>
	Label === "deny" || Label === "rewrite" ? "accent" : "quiet";

// The character table the family's source documents, when the site has
// authored one: the code points it maps, the character each one becomes, and
// the law it obeys. The twins share the record through the `ets-` prefix.
const Tabulation = TableFor(Entry.Slug);

// The summary as one sentence. The period is appended here rather than in the
// markup, because two adjacent expressions split across lines render with a
// space between them, and the page would print "on a timer ." forever.
const Sentence = /[.!?:;,]$/.test(Entry.Summary) ? Entry.Summary : `${Entry.Summary}.`;

// The portrait's one sentence, with its period, for the same reason.
const Role =
	Portrait === undefined
		? undefined
		: /[.!?:;,]$/.test(Portrait.Role)
			? Portrait.Role
			: `${Portrait.Role}.`;

// Where the rewrite lands, for the stream families the site has authored it for.
const ReachChannel = ReachFor(Entry.Slug);

// The pair, when the family rewrites one code point for another: the character
// that arrives, and what the reader gets. Read from the table record so the
// picture cannot disagree with the table beside it.
const Ellipsis = TableFor(Entry.Slug)?.Entry?.[0];

const PairRecord =
	Ellipsis === undefined
		? undefined
		: {
				Before: {
					Label: "arrives",
					Glyph: String.fromCodePoint(
						Number.parseInt(Ellipsis.Code.replace("U+", ""), 16),
					),
					Code: Ellipsis.Code,
					Name: Ellipsis.Name ?? "the code point",
				},
				After: {
					Label: "the reader sees",
					Glyph: Ellipsis.To,
					Code: `${Ellipsis.To.length} x U+002E`,
					Name: "the default replacement",
				},
			};

// The twin: the same package in the other release tree, found by the prefix
// law the content maps already use, run the other way. A package with no
// counterpart gets a note that says so rather than a link to nothing.
const Twin = Package.find(
	(Item) =>
		Item.Slug ===
		(Entry.Family === "EffectTS" ? Entry.Slug.replace(/^ets-/, "") : `ets-${Entry.Slug}`),
);

// The twin's one difference, by the kind of package: the hooks' twins agree on
// the listeners, the order, and the ledger strings, and differ in the ledger
// file's name and the factory base import; the plugins' twins agree on the
// surface and differ in the wiring; the rest carry the same names and job.
const TwinNote =
	Twin === undefined
		? "No package in the other release tree carries its name, so this one stands alone in the family."
		: Entry.Kind === "hook"
			? "It registers the same listeners in the same order and composes the same ledger strings; the ledger file's name, which carries the package identity, and the factory base import are the only differences."
			: Entry.Kind === "plugin"
				? "It registers the same surface under the other runtime, and the two trees differ in the wiring: the Effect tree returns Effect envelopes where this one returns the dispatch envelope."
				: "It carries the same names and the same job in the other release tree, and its wiring is that tree's own.";

// The family's answers at this seam, with this package marked: the row's
// position is the order the behavior map registers them in, not a ranking. An
// ETS page marks its Classic record as the twin, because the map holds the one
// identity and the tree holds the other.
const Position = (Slug: string): string =>
	Slug === Entry.Slug ? "this package" : Slug === Identity ? "its twin" : "neighbour";

const Answer = Own.map((Item) => [
	{ Text: Item.Slug, Href: PackageHref(Item.Slug) },
	{ Badge: { Label: Item.Effect, Tone: Tone(Item.Effect) } },
	Position(Item.Slug),
]);

// The neighbours' one caption, by what the seam holds.
const FamilyNote =
	Behavior === undefined
		? "The behavior map documents no seam for this package, so it has no neighbour to name at one."
		: `The behavior map lists ${Plural(Own.length, "answer")} at ${Behavior.Seam}, in the order the family registers them.`;

// The three calls every plugin page shares. The fixture is the site's one
// conversation, so a reader who moves between plugins stays in the same frame.
const Call = Conversation.map((Item) => [
	{ Code: String(Item.Seq) },
	{ Code: Item.Call },
	{ Badge: { Label: Item.Outcome, Tone: "quiet" as const } },
]);

// The frame's caption, with the count read from the fixture rather than typed.
const TurnNote = `The same ${Plural(Conversation.length, "call")} on every plugin page, so a reader who moves between plugins stays in the same frame.`;

// What the person meets: the effect when the behavior map records the seam,
// and the portrait's shape when the package is not a listener. A machine draws
// the mechanism; only a sentence says the wait, the silence, and the refusal,
// so the view carries one paragraph per plugin.
const Persona = Behavior !== undefined ? Behavior.Effect : Portrait?.Shape;

const Seen =
	Persona === undefined
		? "The person sees the result and never the contract: this package documents no seam and no portrait, so the page cannot place the wait."
		: {
				rewrite:
					"The person sees the text after the rewrite and not what it replaced, so the change stays invisible unless the source is read beside the result.",
				record: "The person sees the effect and not the record: the line that testifies to what happened sits in a file, and the page prints the line rather than a screen that shows it.",
				advise: "The person sees the note arrive as context rather than as content, so the result it is about reads exactly as it did before.",
				pass: "The person sees the harness as it was: this package observes the seam and changes nothing the model reads.",
				gate: "The person sees the decision once, as the answer the call returns, and never the bytes the check compared or the line it wrote.",
				tool: "The person sees the call and its output; the gate, the fence, and the ledger behind it never reach the transcript.",
				service:
					"The person sees the effect of a service another package calls, and the contract itself stays invisible until a caller breaks it.",
				bundle: "The person sees the harness ready sooner and never the rail that mounted the family; a specifier that fails is one warning, not a stop.",
				stream: "The person sees the live view keep its last snapshot and never the events that replaced it.",
				layer: "The person sees one behavior and not the layer beneath it, because the layer is a set of names other packages import.",
				surface:
					"The person sees a tab and an overlay assembled from what the adapters registered, and not the order behind them.",
				buffer: "The person sees the newest entries first and not the ring that dropped the oldest one.",
			}[Persona];

// The portrait's shape machine belongs to Person when the package answers a
// person - a gate that refuses, a note that advises, a record that testifies,
// a rewrite the reader receives - and to Architecture when the shape is the
// plugin's own structure. The machine renders once, and the other view points
// at it.
const Ask =
	Portrait !== undefined &&
	(Portrait.Shape === "gate" ||
		Portrait.Shape === "advise" ||
		Portrait.Shape === "record" ||
		Portrait.Shape === "rewrite");

// A dependency that is itself a package in the family links to its page; an
// external one stays plain text.
const Depend = Entry.Dependencies.map((Dependency) => {
	const Found = Package.find((Item) => Item.Name === Dependency);

	return [
		Found ? { Text: Dependency, Href: Found.Href, Icon: Found.Slug } : Dependency,
		Dependency.startsWith("@playform/") ? "family" : "external",
	];
});

// The graph's edges point from a dependency to the consumer, so the packages
// that require this one are the edges that leave it.
const RequiredBy = Catalogue.Edge.filter((Link) => Link.Source === Entry.Slug)
	.map((Link) => Package.find((Item) => Item.Slug === Link.Target))
	.filter((Item) => Item !== undefined);

// The worked example, when this package is one of the normalize hooks.
const Example = Sample.filter((Item) => Item.Slug === Entry.Slug.replace(/^ets-/, ""));

// The knobs the plugin documents, so a reader can set it up from this page.
const Knob = ConfigFor(Entry.Slug).map((Item) => [
	Item.Field,
	Item.Type,
	Item.Default,
	Item.Meaning,
]);

// The versions the package's own changelog records, newest first.
const Release = VersionOf(Entry).sort((Left, Right) => {
	const LeftPart = Left.split(".").map(Number);
	const RightPart = Right.split(".").map(Number);

	for (let Index = 0; Index < 3; Index += 1) {
		const Difference = (RightPart[Index] ?? 0) - (LeftPart[Index] ?? 0);

		if (Difference !== 0) {
			return Difference;
		}
	}

	return 0;
});

// The files this page was built from, one row per file, in the order the
// readers above touch them. A file the page does not read gets no row.
const File = [
	{
		Name: "package.json",
		Role: "The name, the version, the private flag, and the dependencies.",
		Present: true,
	},
	{
		Name: "README.md",
		Role: "The summary, the surface table, and the configuration table.",
		Present: SurfaceFor(Entry.Slug).length > 0 || ConfigFor(Entry.Slug).length > 0,
	},
	{
		Name: "CHANGELOG.md",
		Role: "The release lines and their versions.",
		Present: Release.length > 0,
	},
	{
		Name: "cordis.patch.yml",
		Role: "Activation: the bundle entry that mounts the plugin.",
		Present: true,
	},
	{
		Name: "Source/Function/Apply.ts",
		Role: "The listeners, their registration order, and the service the flow calls.",
		Present: Current !== undefined,
	},
];
---

<Base Title={Entry.Slug} Description={Entry.Summary}>
	<Breadcrumb
		Trail={[
			{ Href: Route.Package, Label: "Package" },
			{ Href: Entry.Href, Label: Entry.Slug },
		]}
	/>

	<PageHero Eyebrow={`${Entry.Kind} / ${Entry.Family}`} Title={Entry.Slug} Lede={Entry.Summary}>
		<Icon slot="Mark" Name={Entry.Slug} Size={88} Priority />
		<Fragment slot="Actions">
			<VersionPill Version={Entry.Version} Private={Entry.Private} />
			<Badge Label={Entry.Kind} Tone="accent" />
			<Badge Label={Entry.Family} />
		</Fragment>
	</PageHero>

	<section class="section">
		<SectionHeader Title="Facts" />
		<div class="section__body">
			<Definition
				Definition={[
					{ Term: "Package", Detail: Entry.Name },
					{ Term: "Version", Detail: Entry.Version },
					{ Term: "Kind", Detail: Entry.Kind },
					{ Term: "Release", Detail: Entry.Family },
					{ Term: "Licence", Detail: Entry.Licence },
					{ Term: "Directory", Detail: Entry.Directory },
				]}
			/>
		</div>
	</section>

	<section class="section">
		<SectionHeader Title="What it does" />
		<div class="section__body stack">
			<p class="lede">{Sentence}</p>
			<p class="muted">
				<a href={`${Entry.Source}/README.md`}>Read the full description in the README</a>.
			</p>
		</div>
	</section>

	<View />

	<section class="section view-panel" id="conversation" data-relevance="primary">
		<SectionHeader
			Title="Conversation"
			Lede="The turn as a document: the calls every plugin page shares, what this package changes in them, and the order its work happens in."
		/>
		<div class="section__body stack">
			<nav class="stack" aria-label="How to read this turn">
				<p class="muted">
					The same run reads three ways: the conversation as it happened, the function it
					serves, and the architecture that makes it possible.
				</p>
				<div class="cluster">
					<a class="button" href="#conversational">
						Conversational
					</a>
					<a class="button button--quiet" href="#functional">
						Functional
					</a>
					<a class="button button--quiet" href="#architectural">
						Architectural
					</a>
				</div>
			</nav>
			<section id="conversational" class="stack">
				<h3>Conversational</h3>
				<SessionView client:load />
			</section>
			<header class="section-header">
				<h3>The turn</h3>
				<p class="section-header__lede">{TurnNote}</p>
			</header>
			<Table
				Caption={`The ${Plural(Conversation.length, "call")} every plugin page shares, in sequence order`}
				Head={["Seq", "Call", "Outcome"]}
				Row={Call}
			/>

			{Delta !== undefined && (
				<>
					<header class="section-header">
						<h3>Change</h3>
						<p class="section-header__lede">
							The one line that differs with this package installed, transcribed from
							its source by the dissection.
						</p>
					</header>
					<Difference Before={Delta.Before} After={Delta.After} />
					<dl class="definition">
						<div class="definition__row">
							<dt class="definition__term">Property</dt>
							<dd class="definition__detail">{Delta.Property}</dd>
						</div>
						<div class="definition__row">
							<dt class="definition__term">Knob</dt>
							<dd class="definition__detail">{Delta.Knob}</dd>
						</div>
						<div class="definition__row">
							<dt class="definition__term">Seam</dt>
							<dd class="definition__detail">{Delta.Seam}</dd>
						</div>
					</dl>
					{Delta.Off === true && (
						<p class="muted">
							This package ships disabled: the left side of the pair is what the
							harness does with the package installed but inactive, and enabling it is
							one line in the profile's bundle patch.
						</p>
					)}
				</>
			)}

			{Entry.Slug === "hook-dsh-ccr" && (
				<>
					<header class="section-header">
						<h3>Retrieve</h3>
						<p class="section-header__lede">
							The loop the marker opens: the result arrives, the gate replaces it, the
							model asks for the bytes by hash, and the store returns them exactly.
						</p>
					</header>
					<Retrieve
						Marker="<<<CCR:9d3c1f0a7b2e4d5c6a8b9c0d|terminal|5231>>>"
						Hash="9d3c1f0a7b2e4d5c6a8b9c0d"
						Size={5231}
						Preview="[terminal:exit 0 | 142 lines | make: *** Error 1]"
						Body="make: Entering directory '/repo'&#10;go build ./...&#10;make: *** Error 1"
					/>
				</>
			)}

			{Current !== undefined && (
				<>
					<header class="section-header">
						<h3>Flow</h3>
						<p class="section-header__lede">
							The order this package's work happens in, with the branch that decides
							it inline, transcribed from the source; the rule it obeys is the last
							band of Architecture.
						</p>
					</header>
					<Flow Stage={Current.Stage} />
				</>
			)}
		</div>
	</section>

	<section class="section view-panel" id="harness" data-relevance="muted">
		<SectionHeader
			Title="Harness"
			Lede="The laws the package states, the line it writes when it loads, the seam the harness dispatches with none of the family, and the surface and knobs a run can set."
		/>
		<div class="section__body stack">
			{SchemeFor(Entry.Slug) !== undefined && (
				<>
					<header class="section-header">
						<h3>Scheme</h3>
						<p class="section-header__lede">
							The laws the package states in its own SCHEME.md: when it runs, what it
							refuses, and what stays identical because of it.
						</p>
					</header>
					<Scheme Scheme={SchemeFor(Entry.Slug)!} />
				</>
			)}

			{ActivationData.Slug.includes(Entry.Slug) && (
				<>
					<header class="section-header">
						<h3>Activation</h3>
						<p class="section-header__lede">
							The one line this package writes when it loads, as a template and as the
							strings the source composes from it.
						</p>
					</header>
					<Activation />
				</>
			)}

			<header class="section-header">
				<h3>Default</h3>
				<p class="section-header__lede">
					What the harness does at this package's seam with none of the family installed,
					so the surface below has something to be a difference from.
				</p>
			</header>
			{Behavior !== undefined && Harness !== undefined ? (
				<>
					<p class="lede">
						{Harness.Harness.length > 0
							? `The harness dispatches ${Behavior.Seam} as a ${Harness.Mode} and already has listeners there: ${Harness.Harness.join(", ")}.`
							: `The harness dispatches ${Behavior.Seam} as a ${Harness.Mode}, and its event matrix lists no listener of its own there.`}
					</p>
					<p class="muted">
						{Harness.Mode === "waterfall"
							? "A waterfall listener receives the payload and may return a changed one, so the harness's own listeners can already change what the model reads. This package adds another listener to that list."
							: "An emit listener observes a fact that already happened, so the harness's own listeners can record it and cannot change it. This package records beside them, or acts on the world rather than on the payload."}
					</p>
				</>
			) : (
				<Absence
					Title="No documented seam"
					Note={
						Behavior === undefined
							? "The behavior map does not document a seam for this package, so the page cannot show a default to compare against. It is a library, a base, or a package whose work is a tool rather than a listener."
							: `The harness does not declare ${Behavior.Seam} in its own event matrix, so the event is the family's own and only the family listens.`
					}
				/>
			)}

			<header class="section-header">
				<h3>Surface</h3>
				<p class="section-header__lede">
					Every listener, tool, service, and knob the README documents.
				</p>
			</header>
			{SurfaceFor(Entry.Slug).length > 0 ? (
				<Table
					Caption={`The surfaces ${Entry.Slug} registers`}
					Head={["Kind", "Name", "What"]}
					Row={SurfaceFor(Entry.Slug).map((Item) => [Item.Kind, Item.Name, Item.What])}
				/>
			) : (
				<Absence
					Title="No surface"
					Note="The README documents no listener, tool, service, or configuration, so this package registers nothing a page can list."
				/>
			)}

			<header class="section-header">
				<h3>Install</h3>
				<p class="section-header__lede">The package as the profile adds it.</p>
			</header>
			<CodeBlock Label="Install" Language="sh" Code={`pnpm add ${Entry.Name}`} />

			<header class="section-header">
				<h3>Configuration</h3>
				<p class="section-header__lede">
					Every knob this plugin documents, with its default.
				</p>
			</header>
			{Knob.length > 0 ? (
				<Table
					Caption={`Configuration of ${Entry.Slug}`}
					Head={["Field", "Type", "Default", "Meaning"]}
					Row={Knob}
				/>
			) : (
				<Absence
					Title="No configuration"
					Note="The README documents no knob, so the package reads no field and takes no option."
				/>
			)}
		</div>
	</section>

	<section class="section view-panel" id="family" data-relevance="muted">
		<SectionHeader
			Title="Family"
			Lede="The neighbours at the same seam, the arms beyond it, the twin in the other release tree, and the packages this one needs."
		/>
		<div class="section__body stack">
			<header class="section-header">
				<h3>Neighbours</h3>
				<p class="section-header__lede">{FamilyNote}</p>
			</header>
			{Answer.length > 0 && (
				<Table
					Caption={`The family's answers at ${Behavior?.Seam}, in the order the behavior map lists them`}
					Head={["Answer", "Effect", "Position"]}
					Row={Answer}
				/>
			)}

			<header class="section-header">
				<h3>Arms</h3>
				<p class="section-header__lede">
					The seams its source also registers, beyond the one its README documents.
				</p>
			</header>
			{Arm.length > 0 ? (
				<ul class="cluster">
					{Arm.map((Name) => (
						<li>
							{HookFor(Name).length > 0 ? (
								<a class="mono" href={SeamHref(Name)}>
									<Badge Label={Name} Tone="quiet" />
								</a>
							) : (
								<Badge Label={Name} Tone="quiet" />
							)}
						</li>
					))}
				</ul>
			) : (
				<p class="muted">
					Its source registers no seam beyond the one its README documents.
				</p>
			)}

			<header class="section-header">
				<h3>Twin</h3>
				<p class="section-header__lede">
					The same package in the other release tree, when one exists.
				</p>
			</header>
			{Twin === undefined ? (
				<Absence Title="No twin" Note={TwinNote} />
			) : (
				<div class="stack">
					<p class="lede">
						Its twin is&nbsp;<a href={Twin.Href}>{Twin.Slug}</a>.
					</p>
					<p class="muted">{TwinNote}</p>
				</div>
			)}

			<header class="section-header">
				<h3>Dependencies</h3>
				<p class="section-header__lede">
					The packages this one imports, and whether each one is the family's own.
				</p>
			</header>
			{Entry.Dependencies.length > 0 ? (
				<Table
					Caption={`Dependencies of ${Entry.Slug}`}
					Head={["Package", "Role"]}
					Row={Depend}
				/>
			) : (
				<Absence
					Title="No dependency"
					Note="The manifest declares no dependency, so this package stands alone in the graph."
				/>
			)}

			{RequiredBy.length > 0 && (
				<>
					<header class="section-header">
						<h3>Required by</h3>
						<p class="section-header__lede">
							The packages that depend on this one, so the family's edges read in both
							directions.
						</p>
					</header>
					<ul class="cluster">
						{RequiredBy.map((Item) => (
							<li>
								<a class="mono cluster" href={Item!.Href}>
									<Icon Name={Item!.Slug} Size={32} />
									{Item!.Slug}
								</a>
							</li>
						))}
					</ul>
				</>
			)}
		</div>
	</section>

	<section class="section view-panel" id="person" data-relevance="muted">
		<SectionHeader Title="Person" Lede="What the person waits for, reads, and never sees." />
		<div class="section__body stack">
			<p class="lede">{Seen}</p>

			{Ask ? (
				<>
					{Portrait?.Shape === "gate" && Verdict !== undefined && (
						<Gate Gate={Verdict} Slug={Entry.Slug} />
					)}
					{Portrait?.Shape === "gate" && Verdict === undefined && (
						<p class="muted">
							The source records no verdict table for this package, so no gate machine
							is drawn; the branch it takes is in the flow above.
						</p>
					)}
					{Portrait?.Shape === "advise" && <Advise Slug={Entry.Slug} />}
					{Portrait?.Shape === "record" && <Record Slug={Entry.Slug} />}
					{Portrait?.Shape === "rewrite" && <Rewrite Slug={Entry.Slug} />}
				</>
			) : (
				<p class="muted">
					{Portrait === undefined ? (
						<>
							The site has authored no portrait for this package, so it has no shape
							machine; the facts its source documents are in&nbsp;
							<a href="#architecture">Architecture</a>.
						</>
					) : (
						<>
							Its shape machine belongs to&nbsp;
							<a href="#architecture">Architecture</a>.
						</>
					)}
				</p>
			)}
		</div>
	</section>

	<section class="section view-panel" id="architecture" data-relevance="primary">
		<SectionHeader
			Title="Architecture"
			Lede="This plugin's own structure: the shape the portrait gives it, the facts its source documents, and the rule its flow obeys."
		/>
		<div class="section__body stack">
			{Portrait !== undefined && (
				<>
					<header class="section-header">
						<h3>Shape</h3>
						<p class="section-header__lede">Plugs into&nbsp;{Portrait.Plugs}.</p>
					</header>
					{PairRecord !== undefined && (
						<Pair Before={PairRecord.Before} After={PairRecord.After} />
					)}
					{ReachChannel.length > 0 && (
						<Reach
							Channel={ReachChannel}
							Pass="A kind that is off is passed through untouched, by identity."
						/>
					)}
					{ReachChannel.length === 0 && (
						<>
							<p class="lede">{Role}</p>
							<ul class="stack">
								{Portrait.Does.map((Item) => (
									<li>{Item}</li>
								))}
							</ul>
						</>
					)}
					{!Ask && (
						<>
							{Portrait.Shape === "stream" && <Stream Slug={Entry.Slug} />}
							{Portrait.Shape === "layer" && <Layer Slug={Entry.Slug} />}
							{Portrait.Shape === "surface" && <Surface Slug={Entry.Slug} />}
							{Portrait.Shape === "buffer" && <Buffer Slug={Entry.Slug} />}
							{Portrait.Shape === "tool" && <Tool Slug={Entry.Slug} />}
							{Portrait.Shape === "service" && <Service Slug={Entry.Slug} />}
							{Portrait.Shape === "bundle" && <Bundle Slug={Entry.Slug} />}
						</>
					)}
					{Ask && (
						<p class="muted">
							Its shape machine belongs to&nbsp;<a href="#person">Person</a>.
						</p>
					)}
				</>
			)}

			{Detail !== undefined && (
				<>
					<header class="section-header">
						<h3>Detail</h3>
						<p class="section-header__lede">{Lede}</p>
					</header>
					{Detail.Kind === "Syntax" && (
						<>
							<Family Family={Detail.Family} />
							<Absent Absent={Detail.Absent} />
						</>
					)}
					{Detail.Kind === "Compress" && (
						<>
							<Schema Properties={Detail.Marker} />
							<Storage Storage={Detail.Storage} />
							<Table
								Caption="The four answers ccr_retrieve can return"
								Head={[
									"Call",
									"The store answers",
									"The model receives",
									"The ledger",
								]}
								Row={Detail.Retrieval.map((Item) => [
									{ Code: Item.Call },
									Item.Answer,
									Item.Model,
									{ Code: Item.Line },
								])}
							/>
							<Absent Label="Never compressed" Absent={Detail.Exempt} />
						</>
					)}
					{Detail.Kind === "Guard" && (
						<>
							<Policy Policy={Detail.Policy} />
							<Ladder Rung={Detail.Order} />
							<Table
								Caption="The exact command shapes the guard judges"
								Head={["Command", "Verdict", "Why"]}
								Row={Detail.Command.map((Item) => [
									{ Code: Item.Shape },
									{
										Badge: {
											Label: Item.Verdict,
											Tone: Tone(Item.Verdict),
										},
									},
									Item.Why,
								])}
							/>
							<Ledger Ledger={Detail.Ledger} />
						</>
					)}
				</>
			)}

			{Tabulation !== undefined && (
				<>
					<header class="section-header">
						<h3>Table</h3>
						<p class="section-header__lede">
							The family's own character table: the code points it maps, the character
							each one becomes, and the law it obeys.
						</p>
					</header>
					<Normalizer Table={Tabulation} />
				</>
			)}

			{Example.length > 0 && (
				<>
					<header class="section-header">
						<h3>Transform</h3>
						<p class="section-header__lede">
							The worked example its README documents: the code point it names and the
							replacement it ships.
						</p>
					</header>
					<Transform Sample={Example} />
				</>
			)}

			{Current !== undefined && (
				<Callout Title="Rule">
					<p>{Current.Rule}</p>
				</Callout>
			)}
		</div>
	</section>

	<section class="section">
		<SectionHeader
			Title="Record"
			Lede="The release line, the source, and the files this page was read from."
		/>
		<div class="section__body stack">
			{Release.length > 0 && (
				<>
					<header class="section-header">
						<h3>Release</h3>
						<p class="section-header__lede">
							The versions the package's own changelog records, newest first.
						</p>
					</header>
					<ul class="cluster">
						{Release.map((Version) => (
							<li>
								<Badge
									Label={Version}
									Tone={Version === Entry.Version ? "accent" : "neutral"}
								/>
							</li>
						))}
					</ul>
				</>
			)}

			<header class="section-header">
				<h3>Source</h3>
				<p class="section-header__lede">The package as the repository holds it.</p>
			</header>
			<p class="lede">
				<a href={Entry.Source}>Open the package source</a>
			</p>

			<header class="section-header">
				<h3>Origin</h3>
				<p class="section-header__lede">
					The files this page was built from, and what each one supplies.
				</p>
			</header>
			<Disclosure Summary="The files this page was read from" Count={File.length}>
				<Origin Source={Entry.Source} File={File} />
			</Disclosure>
		</div>
	</section>

	<Provenance
		Data="The monorepo, read during the build"
		Connection="Build-time read; nothing is fetched at runtime"
		Capture="package.json, README.md, CHANGELOG.md, Source/Function/Apply.ts"
		Note="This page is static. It cannot invoke the plugin, read a ledger, or change a configuration. Every figure comes from those files; a missing README falls back to the manifest's own description, and a package with no surface table shows no surface section."
	/>

	<Pager
		Previous={Previous ? { Href: Previous.Href, Label: Previous.Slug } : undefined}
		Next={Next ? { Href: Next.Href, Label: Next.Slug } : undefined}
	/>
</Base>
