---
import Base from "@Layout/Base.astro";

import Badge from "@Component/Badge.astro";
import Breadcrumb from "@Component/Breadcrumb.astro";
import CodeBlock from "@Component/CodeBlock.astro";
import Definitions from "@Component/Definitions.astro";
import Pager from "@Component/Pager.astro";
import PageHero from "@Component/PageHero.astro";
import SectionHeader from "@Component/SectionHeader.astro";
import Table from "@Component/Table.astro";
import VersionPill from "@Component/VersionPill.astro";

import { Routes } from "@Library/Links";
import { Packages, type PackageRecord } from "@Library/Packages.server";

export function getStaticPaths() {
	return Packages.map((Package) => ({
		params: { slug: Package.Slug },
		props: { Package },
	}));
}

interface Props {
	Package: PackageRecord;
}

const { Package } = Astro.props;
const Index = Packages.findIndex((Entry) => Entry.Slug === Package.Slug);
const Previous = Index > 0 ? Packages[Index - 1] : undefined;
const Next = Index >= 0 && Index < Packages.length - 1 ? Packages[Index + 1] : undefined;
---

<Base Title={Package.Slug} Description={Package.Summary}>
	<Breadcrumb
		Trail={[
			{ Href: Routes.Package, Label: "Package" },
			{ Href: Package.Href, Label: Package.Slug },
		]}
	/>

	<PageHero
		Eyebrow={`${Package.Kind} / ${Package.Family}`}
		Title={Package.Slug}
		Lede={Package.Summary}
	>
		<Fragment slot="Actions">
			<VersionPill Version={Package.Version} Private={Package.Private} />
			<Badge Label={Package.Kind} Tone="accent" />
			<Badge Label={Package.Family} />
		</Fragment>
	</PageHero>

	<section class="section">
		<SectionHeader Title="Facts" />
		<div class="section__body">
			<Definitions
				Definitions={[
					{ Term: "Package", Detail: Package.Name },
					{ Term: "Version", Detail: Package.Version },
					{ Term: "Kind", Detail: Package.Kind },
					{ Term: "Release", Detail: Package.Family },
					{ Term: "Licence", Detail: Package.Licence },
					{ Term: "Directory", Detail: Package.Directory },
					{ Term: "Test", Detail: String(Package.Tests) },
					{ Term: "Module", Detail: String(Package.Modules) },
				]}
			/>
		</div>
	</section>

	<section class="section">
		<SectionHeader Title="What it does" />
		<div class="section__body stack">
			<p class="lede">{Package.Summary}.</p>
			<p class="muted">
				<a href={`${Package.Source}/README.md`}>Read the full description in the README</a>.
			</p>
		</div>
	</section>

	{
		Package.Dependencies.length > 0 && (
			<section class="section">
				<SectionHeader Title="Dependencies" />
				<div class="section__body">
					<Table
						Caption={`Dependencies of ${Package.Slug}`}
						Head={["Package", "Role"]}
						Rows={Package.Dependencies.map((Dependency) => [
							Dependency,
							Dependency.startsWith("@playform/") ? "family" : "external",
						])}
					/>
				</div>
			</section>
		)
	}

	<section class="section">
		<SectionHeader Title="Source" />
		<div class="section__body stack">
			<p class="lede">
				<a href={Package.Source}>Open the package in the monorepo</a>
			</p>
			<CodeBlock Label="Install" Language="sh" Code={`pnpm add ${Package.Name}`} />
		</div>
	</section>

	<Pager
		Previous={Previous ? { Href: Previous.Href, Label: Previous.Slug } : undefined}
		Next={Next ? { Href: Next.Href, Label: Next.Slug } : undefined}
	/>
</Base>
