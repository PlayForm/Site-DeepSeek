---
import Absence from "@Component/Absence.astro";
import Badge from "@Component/Badge.astro";
import Breadcrumb from "@Component/Breadcrumb.astro";
import CodeBlock from "@Component/CodeBlock.astro";
import Definition from "@Component/Definition.astro";
import Disclosure from "@Component/Disclosure.astro";
import Icon from "@Component/Icon.astro";
import Origin from "@Component/Origin.astro";
import PageHero from "@Component/PageHero.astro";
import Pager from "@Component/Pager.astro";
import Provenance from "@Component/Provenance.astro";
import SectionHeader from "@Component/SectionHeader.astro";
import Table from "@Component/Table.astro";
import Transform from "@Component/Transform.astro";
import VersionPill from "@Component/VersionPill.astro";
import { Transform as Sample } from "@Content/Transform";
import Base from "@Layout/Base.astro";
import { ConfigFor } from "@Library/Config.server";
import Catalogue from "@Library/Graph/Catalogue.server";
import { Route } from "@Library/Link";
import { Package, type PackageRecord } from "@Library/Package.server";
import { VersionOf } from "@Library/Release.server";
import { SurfaceFor } from "@Library/Surface.server";

export function getStaticPaths() {
	return Package.map((Entry) => ({
		params: { slug: Entry.Slug },
		props: { Entry },
	}));
}

interface Props {
	Entry: PackageRecord;
}

const { Entry } = Astro.props;
const Index = Package.findIndex((Candidate) => Candidate.Slug === Entry.Slug);
const Previous = Index > 0 ? Package[Index - 1] : undefined;
const Next = Index >= 0 && Index < Package.length - 1 ? Package[Index + 1] : undefined;

// A dependency that is itself a package in the family links to its page; an
// external one stays plain text.
const Depend = Entry.Dependencies.map((Dependency) => {
	const Found = Package.find((Item) => Item.Name === Dependency);

	return [
		Found ? { Text: Dependency, Href: Found.Href, Icon: Found.Slug } : Dependency,
		Dependency.startsWith("@playform/") ? "family" : "external",
	];
});

// The graph's edges point from a dependency to the consumer, so the packages
// that require this one are the edges that leave it.
const RequiredBy = Catalogue.Edge.filter((Link) => Link.Source === Entry.Slug)
	.map((Link) => Package.find((Item) => Item.Slug === Link.Target))
	.filter((Item) => Item !== undefined);

// The worked example, when this package is one of the normalize hooks.
const Example = Sample.filter((Item) => Item.Slug === Entry.Slug.replace(/^ets-/, ""));

// The knobs the plugin documents, so a reader can set it up from this page.
const Knob = ConfigFor(Entry.Slug).map((Item) => [
	Item.Field,
	Item.Type,
	Item.Default,
	Item.Meaning,
]);

// The versions the package's own changelog records, newest first.
const Release = VersionOf(Entry).sort((Left, Right) => {
	const LeftPart = Left.split(".").map(Number);
	const RightPart = Right.split(".").map(Number);

	for (let Index = 0; Index < 3; Index += 1) {
		const Difference = (RightPart[Index] ?? 0) - (LeftPart[Index] ?? 0);

		if (Difference !== 0) {
			return Difference;
		}
	}

	return 0;
});

// The files this page was built from, one row per file, in the order the
// readers above touch them. A file the page does not read gets no row.
const File = [
	{
		Name: "package.json",
		Role: "The name, the version, the private flag, and the dependencies.",
		Present: true,
	},
	{
		Name: "README.md",
		Role: "The summary, the surface table, and the configuration table.",
		Present: SurfaceFor(Entry.Slug).length > 0 || ConfigFor(Entry.Slug).length > 0,
	},
	{
		Name: "CHANGELOG.md",
		Role: "The release lines and their versions.",
		Present: Release.length > 0,
	},
	{
		Name: "cordis.patch.yml",
		Role: "Activation: the bundle entry that mounts the plugin.",
		Present: true,
	},
];
---

<Base Title={Entry.Slug} Description={Entry.Summary}>
	<Breadcrumb
		Trail={[
			{ Href: Route.Package, Label: "Package" },
			{ Href: Entry.Href, Label: Entry.Slug },
		]}
	/>

	<PageHero Eyebrow={`${Entry.Kind} / ${Entry.Family}`} Title={Entry.Slug} Lede={Entry.Summary}>
		<Icon slot="Mark" Name={Entry.Slug} Size={88} Priority />
		<Fragment slot="Actions">
			<VersionPill Version={Entry.Version} Private={Entry.Private} />
			<Badge Label={Entry.Kind} Tone="accent" />
			<Badge Label={Entry.Family} />
		</Fragment>
	</PageHero>

	<section class="section">
		<SectionHeader Title="Facts" />
		<div class="section__body">
			<Definition
				Definition={[
					{ Term: "Package", Detail: Entry.Name },
					{ Term: "Version", Detail: Entry.Version },
					{ Term: "Kind", Detail: Entry.Kind },
					{ Term: "Release", Detail: Entry.Family },
					{ Term: "Licence", Detail: Entry.Licence },
					{ Term: "Directory", Detail: Entry.Directory },
				]}
			/>
		</div>
	</section>

	<section class="section">
		<SectionHeader Title="What it does" />
		<div class="section__body stack">
			<p class="lede">{Entry.Summary}{/[.!?:;,]$/.test(Entry.Summary) ? "" : "."}</p>
			<p class="muted">
				<a href={`${Entry.Source}/README.md`}>Read the full description in the README</a>.
			</p>
		</div>
	</section>

	<section class="section">
		<SectionHeader Title="Install" />
		<div class="section__body">
			<CodeBlock Label="Install" Language="sh" Code={`pnpm add ${Entry.Name}`} />
		</div>
	</section>

	<section class="section">
		<SectionHeader Title="Surface" />
		<div class="section__body">
			{SurfaceFor(Entry.Slug).length > 0 ? (
				<Table
					Caption={`The surfaces ${Entry.Slug} registers`}
					Head={["Kind", "Name", "What"]}
					Row={SurfaceFor(Entry.Slug).map((Item) => [Item.Kind, Item.Name, Item.What])}
				/>
			) : (
				<Absence
					Title="No surface"
					Note="The README documents no listener, tool, service, or configuration, so this package registers nothing a page can list."
				/>
			)}
		</div>
	</section>

	<section class="section">
		<SectionHeader Title="Dependencies" />
		<div class="section__body">
			{Entry.Dependencies.length > 0 ? (
				<Table
					Caption={`Dependencies of ${Entry.Slug}`}
					Head={["Package", "Role"]}
					Row={Depend}
				/>
			) : (
				<Absence
					Title="No dependency"
					Note="The manifest declares no dependency, so this package stands alone in the graph."
				/>
			)}
		</div>
	</section>

	{RequiredBy.length > 0 && (
		<section class="section">
			<SectionHeader Title="Required by" />
			<div class="section__body">
				<ul class="cluster">
					{RequiredBy.map((Item) => (
						<li>
							<a class="mono cluster" href={Item!.Href}>
								<Icon Name={Item!.Slug} Size={32} />
								{Item!.Slug}
							</a>
						</li>
					))}
				</ul>
			</div>
		</section>
	)}

	{Example.length > 0 && (
		<section class="section">
			<SectionHeader Title="Transform" />
			<div class="section__body">
				<Transform Sample={Example} />
			</div>
		</section>
	)}

	<section class="section">
		<SectionHeader
			Title="Configuration"
			Lede={
				Knob.length > 0 ? "Every knob this plugin documents, with its default." : undefined
			}
		/>
		<div class="section__body">
			{Knob.length > 0 ? (
				<Table
					Caption={`Configuration of ${Entry.Slug}`}
					Head={["Field", "Type", "Default", "Meaning"]}
					Row={Knob}
				/>
			) : (
				<Absence
					Title="No configuration"
					Note="The README documents no knob, so the package reads no field and takes no option."
				/>
			)}
		</div>
	</section>

	{Release.length > 0 && (
		<section class="section">
			<SectionHeader Title="Release" />
			<div class="section__body">
				<ul class="cluster">
					{Release.map((Version) => (
						<li>
							<Badge
								Label={Version}
								Tone={Version === Entry.Version ? "accent" : "neutral"}
							/>
						</li>
					))}
				</ul>
			</div>
		</section>
	)}

	<section class="section">
		<SectionHeader Title="Source" />
		<div class="section__body stack">
			<p class="lede">
				<a href={Entry.Source}>Open the package source</a>
			</p>
		</div>
	</section>

	<section class="section">
		<SectionHeader Title="Origin" />
		<div class="section__body">
			<Disclosure Summary="The files this page was read from" Count={File.length}>
				<Origin Source={Entry.Source} File={File} />
			</Disclosure>
		</div>
	</section>

	<Provenance
		Data="The monorepo, read during the build"
		Connection="Build-time read; nothing is fetched at runtime"
		Capture="package.json, README.md, CHANGELOG.md"
		Note="This page is static. It cannot invoke the plugin, read a ledger, or change a configuration. Every figure comes from those three files; a missing README falls back to the manifest's own description, and a package with no surface table shows no surface section."
	/>

	<Pager
		Previous={Previous ? { Href: Previous.Href, Label: Previous.Slug } : undefined}
		Next={Next ? { Href: Next.Href, Label: Next.Slug } : undefined}
	/>
</Base>
