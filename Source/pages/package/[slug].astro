---
import Absence from "@Component/Absence.astro";
import Badge from "@Component/Badge.astro";
import Breadcrumb from "@Component/Breadcrumb.astro";
import Buffer from "@Component/Buffer.astro";
import CodeBlock from "@Component/CodeBlock.astro";
import Definition from "@Component/Definition.astro";
import Difference from "@Component/Difference.astro";
import Disclosure from "@Component/Disclosure.astro";
import Icon from "@Component/Icon.astro";
import Layer from "@Component/Layer.astro";
import Origin from "@Component/Origin.astro";
import PageHero from "@Component/PageHero.astro";
import Pager from "@Component/Pager.astro";
import Provenance from "@Component/Provenance.astro";
import SectionHeader from "@Component/SectionHeader.astro";
import Stream from "@Component/Stream.astro";
import Surface from "@Component/Surface.astro";
import Table from "@Component/Table.astro";
import Transform from "@Component/Transform.astro";
import VersionPill from "@Component/VersionPill.astro";
import { ArmFor } from "@Content/Arm";
import { BehaviorFor } from "@Content/Behavior";
import { DeltaFor } from "@Content/Delta";
import { SeamFor } from "@Content/Harness";
import { HookFor } from "@Content/Hook";
import { PortraitFor } from "@Content/Portrait";
import { Transform as Sample } from "@Content/Transform";
import Base from "@Layout/Base.astro";
import { ConfigFor } from "@Library/Config.server";
import Catalogue from "@Library/Graph/Catalogue.server";
import { Route } from "@Library/Link";
import { Package, type PackageRecord } from "@Library/Package.server";
import { VersionOf } from "@Library/Release.server";
import { SurfaceFor } from "@Library/Surface.server";

export function getStaticPaths() {
	return Package.map((Entry) => ({
		params: { slug: Entry.Slug },
		props: { Entry },
	}));
}

interface Props {
	Entry: PackageRecord;
}

const { Entry } = Astro.props;
const Index = Package.findIndex((Candidate) => Candidate.Slug === Entry.Slug);
const Previous = Index > 0 ? Package[Index - 1] : undefined;
const Next = Index >= 0 && Index < Package.length - 1 ? Package[Index + 1] : undefined;

// The package's own seam, when the behavior map documents one, and the
// harness's side of that seam: its dispatch mode and the listeners it already
// has there. A package with no documented seam has no default to compare
// against, and the page says that rather than inventing one.
const Behavior = BehaviorFor(Entry.Slug);
const Harness = Behavior === undefined ? undefined : SeamFor(Behavior.Seam);
const Arm = ArmFor(Entry.Slug);

// The harness's own plugins at that seam, when this site documents one there.
// The link is the dissection: the package page says what the family adds, and
// the plugin page shows the line it changes.
const Own = Behavior === undefined ? [] : HookFor(Behavior.Seam);

// The dissected change, when this package has one: the one line that differs
// with the package installed, transcribed from the source by the dissection.
const Delta = DeltaFor(Entry.Slug);

// The authored presentation, when this package has one: what it is, what it
// plugs into, and the one picture that fits its kind. A package with no
// record keeps the page it has, because the page never invents a portrait.
const Portrait = PortraitFor(Entry.Slug);

// The summary as one sentence. The period is appended here rather than in the
// markup, because two adjacent expressions split across lines render with a
// space between them, and the page would print "on a timer ." forever.
const Sentence = /[.!?:;,]$/.test(Entry.Summary) ? Entry.Summary : `${Entry.Summary}.`;

// A dependency that is itself a package in the family links to its page; an
// external one stays plain text.
const Depend = Entry.Dependencies.map((Dependency) => {
	const Found = Package.find((Item) => Item.Name === Dependency);

	return [
		Found ? { Text: Dependency, Href: Found.Href, Icon: Found.Slug } : Dependency,
		Dependency.startsWith("@playform/") ? "family" : "external",
	];
});

// The graph's edges point from a dependency to the consumer, so the packages
// that require this one are the edges that leave it.
const RequiredBy = Catalogue.Edge.filter((Link) => Link.Source === Entry.Slug)
	.map((Link) => Package.find((Item) => Item.Slug === Link.Target))
	.filter((Item) => Item !== undefined);

// The worked example, when this package is one of the normalize hooks.
const Example = Sample.filter((Item) => Item.Slug === Entry.Slug.replace(/^ets-/, ""));

// The knobs the plugin documents, so a reader can set it up from this page.
const Knob = ConfigFor(Entry.Slug).map((Item) => [
	Item.Field,
	Item.Type,
	Item.Default,
	Item.Meaning,
]);

// The versions the package's own changelog records, newest first.
const Release = VersionOf(Entry).sort((Left, Right) => {
	const LeftPart = Left.split(".").map(Number);
	const RightPart = Right.split(".").map(Number);

	for (let Index = 0; Index < 3; Index += 1) {
		const Difference = (RightPart[Index] ?? 0) - (LeftPart[Index] ?? 0);

		if (Difference !== 0) {
			return Difference;
		}
	}

	return 0;
});

// The files this page was built from, one row per file, in the order the
// readers above touch them. A file the page does not read gets no row.
const File = [
	{
		Name: "package.json",
		Role: "The name, the version, the private flag, and the dependencies.",
		Present: true,
	},
	{
		Name: "README.md",
		Role: "The summary, the surface table, and the configuration table.",
		Present: SurfaceFor(Entry.Slug).length > 0 || ConfigFor(Entry.Slug).length > 0,
	},
	{
		Name: "CHANGELOG.md",
		Role: "The release lines and their versions.",
		Present: Release.length > 0,
	},
	{
		Name: "cordis.patch.yml",
		Role: "Activation: the bundle entry that mounts the plugin.",
		Present: true,
	},
];
---

<Base Title={Entry.Slug} Description={Entry.Summary}>
	<Breadcrumb
		Trail={[
			{ Href: Route.Package, Label: "Package" },
			{ Href: Entry.Href, Label: Entry.Slug },
		]}
	/>

	<PageHero Eyebrow={`${Entry.Kind} / ${Entry.Family}`} Title={Entry.Slug} Lede={Entry.Summary}>
		<Icon slot="Mark" Name={Entry.Slug} Size={88} Priority />
		<Fragment slot="Actions">
			<VersionPill Version={Entry.Version} Private={Entry.Private} />
			<Badge Label={Entry.Kind} Tone="accent" />
			<Badge Label={Entry.Family} />
		</Fragment>
	</PageHero>

	<section class="section">
		<SectionHeader Title="Facts" />
		<div class="section__body">
			<Definition
				Definition={[
					{ Term: "Package", Detail: Entry.Name },
					{ Term: "Version", Detail: Entry.Version },
					{ Term: "Kind", Detail: Entry.Kind },
					{ Term: "Release", Detail: Entry.Family },
					{ Term: "Licence", Detail: Entry.Licence },
					{ Term: "Directory", Detail: Entry.Directory },
				]}
			/>
		</div>
	</section>

	<section class="section">
		<SectionHeader Title="What it does" />
		<div class="section__body stack">
			<p class="lede">{Sentence}</p>
			<p class="muted">
				<a href={`${Entry.Source}/README.md`}>Read the full description in the README</a>.
			</p>
		</div>
	</section>

	{
		Portrait !== undefined && (
			<section class="section">
				<SectionHeader Title={Portrait.Role} Lede={`Plugs into ${Portrait.Plugs}.`} />
				<div class="section__body stack">
					<ul class="stack">
						{Portrait.Does.map((Item) => (
							<li>{Item}</li>
						))}
					</ul>
					{Portrait.Shape === "stream" && <Stream Slug={Entry.Slug} />}
					{Portrait.Shape === "layer" && <Layer Slug={Entry.Slug} />}
					{Portrait.Shape === "surface" && <Surface Slug={Entry.Slug} />}
					{Portrait.Shape === "buffer" && <Buffer Slug={Entry.Slug} />}
				</div>
			</section>
		)
	}

	<section class="section">
		<SectionHeader Title="Install" />
		<div class="section__body">
			<CodeBlock Label="Install" Language="sh" Code={`pnpm add ${Entry.Name}`} />
		</div>
	</section>

	<section class="section">
		<SectionHeader
			Title="Default"
			Lede="What the harness does at this package's seam with none of the family installed, so the surface below has something to be a difference from."
		/>
		<div class="section__body stack">
			{Behavior !== undefined && Harness !== undefined ? (
				<>
					<p class="lede">
						{Harness.Harness.length > 0
							? `The harness dispatches ${Behavior.Seam} as a ${Harness.Mode} and already has listeners there: ${Harness.Harness.join(", ")}.`
							: `The harness dispatches ${Behavior.Seam} as a ${Harness.Mode}, and its event matrix lists no listener of its own there.`}
					</p>
					<p class="muted">
						{Harness.Mode === "waterfall"
							? "A waterfall listener receives the payload and may return a changed one, so the harness's own listeners can already change what the model reads. This package adds another listener to that list."
							: "An emit listener observes a fact that already happened, so the harness's own listeners can record it and cannot change it. This package records beside them, or acts on the world rather than on the payload."}
					</p>
				</>
			) : (
				<Absence
					Title="No documented seam"
					Note={
						Behavior === undefined
							? "The behavior map does not document a seam for this package, so the page cannot show a default to compare against. It is a library, a base, or a package whose work is a tool rather than a listener."
							: `The harness does not declare ${Behavior.Seam} in its own event matrix, so the event is the family's own and only the family listens.`
					}
				/>
			)}
			{Arm.length > 0 && (
				<p class="muted">
					Its source also registers at {Arm.join(", ")}, beyond the seam its README
					documents.
				</p>
			)}
			{Own.length > 0 && (
				<p class="muted">
					The harness ships its own plugin at this seam:{" "}
					{Own.map((Item, Index) => (
						<Fragment>
							{Index > 0 && ", "}
							<a href={`/plugin/${Item.Slug}/`}>{Item.Slug}</a>
						</Fragment>
					))}
					, and its page shows the line it changes.
				</p>
			)}
		</div>
	</section>

	{Delta !== undefined && (
		<section class="section">
			<SectionHeader
				Title="Change"
				Lede="The one line that differs with this package installed, transcribed from its source by the dissection."
			/>
			<div class="section__body stack">
				<Difference Before={Delta.Before} After={Delta.After} />
				<dl class="definition">
					<div class="definition__row">
						<dt class="definition__term">Property</dt>
						<dd class="definition__detail">{Delta.Property}</dd>
					</div>
					<div class="definition__row">
						<dt class="definition__term">Knob</dt>
						<dd class="definition__detail">{Delta.Knob}</dd>
					</div>
					<div class="definition__row">
						<dt class="definition__term">Seam</dt>
						<dd class="definition__detail">{Delta.Seam}</dd>
					</div>
				</dl>
				{Delta.Off === true && (
					<p class="muted">
						This package ships disabled: the left side of the pair is what the harness
						does with the package installed but inactive, and enabling it is one line in
						the profile's bundle patch.
					</p>
				)}
			</div>
		</section>
	)}

	<section class="section">
		<SectionHeader Title="Surface" />
		<div class="section__body">
			{SurfaceFor(Entry.Slug).length > 0 ? (
				<Table
					Caption={`The surfaces ${Entry.Slug} registers`}
					Head={["Kind", "Name", "What"]}
					Row={SurfaceFor(Entry.Slug).map((Item) => [Item.Kind, Item.Name, Item.What])}
				/>
			) : (
				<Absence
					Title="No surface"
					Note="The README documents no listener, tool, service, or configuration, so this package registers nothing a page can list."
				/>
			)}
		</div>
	</section>

	<section class="section">
		<SectionHeader Title="Dependencies" />
		<div class="section__body">
			{Entry.Dependencies.length > 0 ? (
				<Table
					Caption={`Dependencies of ${Entry.Slug}`}
					Head={["Package", "Role"]}
					Row={Depend}
				/>
			) : (
				<Absence
					Title="No dependency"
					Note="The manifest declares no dependency, so this package stands alone in the graph."
				/>
			)}
		</div>
	</section>

	{RequiredBy.length > 0 && (
		<section class="section">
			<SectionHeader Title="Required by" />
			<div class="section__body">
				<ul class="cluster">
					{RequiredBy.map((Item) => (
						<li>
							<a class="mono cluster" href={Item!.Href}>
								<Icon Name={Item!.Slug} Size={32} />
								{Item!.Slug}
							</a>
						</li>
					))}
				</ul>
			</div>
		</section>
	)}

	{Example.length > 0 && (
		<section class="section">
			<SectionHeader Title="Transform" />
			<div class="section__body">
				<Transform Sample={Example} />
			</div>
		</section>
	)}

	<section class="section">
		<SectionHeader
			Title="Configuration"
			Lede={
				Knob.length > 0 ? "Every knob this plugin documents, with its default." : undefined
			}
		/>
		<div class="section__body">
			{Knob.length > 0 ? (
				<Table
					Caption={`Configuration of ${Entry.Slug}`}
					Head={["Field", "Type", "Default", "Meaning"]}
					Row={Knob}
				/>
			) : (
				<Absence
					Title="No configuration"
					Note="The README documents no knob, so the package reads no field and takes no option."
				/>
			)}
		</div>
	</section>

	{Release.length > 0 && (
		<section class="section">
			<SectionHeader Title="Release" />
			<div class="section__body">
				<ul class="cluster">
					{Release.map((Version) => (
						<li>
							<Badge
								Label={Version}
								Tone={Version === Entry.Version ? "accent" : "neutral"}
							/>
						</li>
					))}
				</ul>
			</div>
		</section>
	)}

	<section class="section">
		<SectionHeader Title="Source" />
		<div class="section__body stack">
			<p class="lede">
				<a href={Entry.Source}>Open the package source</a>
			</p>
		</div>
	</section>

	<section class="section">
		<SectionHeader Title="Origin" />
		<div class="section__body">
			<Disclosure Summary="The files this page was read from" Count={File.length}>
				<Origin Source={Entry.Source} File={File} />
			</Disclosure>
		</div>
	</section>

	<Provenance
		Data="The monorepo, read during the build"
		Connection="Build-time read; nothing is fetched at runtime"
		Capture="package.json, README.md, CHANGELOG.md"
		Note="This page is static. It cannot invoke the plugin, read a ledger, or change a configuration. Every figure comes from those three files; a missing README falls back to the manifest's own description, and a package with no surface table shows no surface section."
	/>

	<Pager
		Previous={Previous ? { Href: Previous.Href, Label: Previous.Slug } : undefined}
		Next={Next ? { Href: Next.Href, Label: Next.Slug } : undefined}
	/>
</Base>
