---
import Base from "@Layout/Base.astro";
import ArrowIcon from "@Component/ArrowIcon.astro";
import Badge from "@Component/Badge.astro";
import BrandIcon from "@Component/BrandIcon.astro";
import Card from "@Component/Card.astro";
import CodeBlock from "@Component/CodeBlock.astro";
import Concept from "@Component/Concept.astro";
import PageHero from "@Component/PageHero.astro";
import SectionHeader from "@Component/SectionHeader.astro";
import Seams from "@Component/Seams.astro";
import Terminal from "@Component/Terminal.astro";
import { Counts, Versions, Families, Methods, Trace, Policy, Pack } from "@Library/Content";
import { Link, Links } from "@Library/Links";

// The furnace diagram, from the package README.
const Furnace = [
	"  THE CONSUMERS BRING THEIR OWN METAL         THE FACTORY POURS THE MOLD",
	`  (model logic: a Config extension,           (${Methods.Count} methods on ctx.pluginFactory,`,
	'   a pure transform, an update engine          inject: ["fs"] - it calls ctx.fs)',
	"   and every ledger string)",
	"",
	"  hook-dsh-package-governor ────►┐",
	"  hook-dsh-package-pinner ───────┤       ctx.pluginFactory (Service)",
	"  hook-dsh-cargo-governor ───────┤         │",
	'  hook-dsh-normalize-dash ───────┤         ├─ Append(state, msg) ──► "<Module>: <msg>" on the logger',
	'  hook-dsh-normalize-quotes ─────┤         │                        + "[<ISO>] <msg>" appended to the ledger file',
	"  hook-dsh-normalize-ellipsis ───┤         ├─ Match(path, list) ───► the exclusion-first segment match",
	"  hook-dsh-normalize-spaces ─────┤         ├─ Discover(dir) ──────► nearest registry.json walk-up",
	"  hook-dsh-normalize-invisible ──┤         ├─ Parse(path) ─────────► contained JSON read (null on any failure)",
	"  hook-dsh-normalize-fullwidth ──┘         ├─ ResolvePolicy(...) ──► union keep-list: global policy → <dir>/",
	"                                           │                        registry-adjacent → + P3 chain keys",
	"                                           ├─ Gate(...) ───────────► g1 gates: target → actor → kind →",
	"                                           │                        Stash idempotence → basename → excluded",
	"                                           ├─ Write(...) ──────────► the ONE shared executor (intent / policy /",
	"                                           │                         observe / stash / the content transform)",
	"                                           ├─ GuardedWrite(...) ──► replaceIfVersion + the P4 sandbox fence",
	"                                           ├─ Refresh(...) ───────► Stash seed + fs/observed re-emit (same actor)",
	"                                           ├─ Continue(..., tfm) ─► Inflight → readText → keep-list →",
	"                                           │                        the model's transform → GuardedWrite →",
	"                                           │                        message → Refresh → contained throws",
	"                                           ├─ State(ctx, cfg, s) ─► cell unwrap + shared fields + extras",
	"                                           ├─ Wire(ctx, st, obs) ─► the fiber-owned fs/observed registration",
	"                                           ├─ Attach(ctx, {...}) ─► P1 jobs controller / P2 inflight disposal /",
	"                                           │                        P5 storage domain (probed, graceful)",
	"                                           ├─ Journal(state, ...) ─► the P5 package_governance writer",
	"                                           ├─ Schema(shared?, m) ─► the Schemastery schema factory",
	"                                           ├─ Seam(state, name) ──► probe-once optional-service accessor",
	"                                           ├─ UpdateKey(target) ──► the namespaced Inflight key (update stages)",
	"                                           ├─ RegisterGovern(...) ─► the direct-govern registry (per basename)",
	"                                           └─ Govern(target, ...) ─► the direct-govern executor (GovernSteps,",
	"                                                                     the registered steps - the registry view",
];

// The consumers table, from the README's Where It Fits.
const Consumers = [
	{
		Name: "hook-dsh-package-governor",
		Inject: '["fs", "pluginFactory"]',
		Uses: "Gate, Discover/Parse, Continue, GuardedWrite, Refresh, State, Wire, Attach, Journal, Append, UpdateKey",
	},
	{
		Name: "hook-dsh-package-pinner",
		Inject: '["fs", "pluginFactory"]',
		Uses: "Gate, Discover, Continue (pin pass), State, Wire, Attach, Journal, Append",
	},
	{
		Name: "hook-dsh-cargo-governor",
		Inject: '["fs", "pluginFactory"]',
		Uses: "Gate, Discover/Parse, Continue (TOML surgery), State, Wire, Attach, Journal, Append, UpdateKey, Seam",
	},
	{
		Name: "hook-dsh-normalize-dash + the five hook-dsh-normalize-* flavors",
		Inject: '["pluginFactory"]',
		Uses: "State, Append - plus the named Schema export (shared: false) for their config",
	},
	{
		Name: "plugin-dsh-normalize-file",
		Inject: '["pluginFactory", "fs", "tools"]',
		Uses: "State, Append, Journal, Write - the one consumer that writes",
	},
	{
		Name: "hook-dsh-ccr + hook-dsh-tool-coach (the guardians)",
		Inject: '["pluginFactory", "tools"]',
		Uses: "State, Append, Seam - and the volatile-refresh path for every hot knob",
	},
	{
		Name: "hook-dsh-live-containers",
		Inject: '["pluginFactory", "tools", "systemPrompt", "shell", "shellEnv", "workingDirectory"]',
		Uses: "State, Append",
	},
];

// The In Action write, end to end, from the README.
const InAction = [
	"// Source/Function/Transform.ts of a consumer (condensed to its shape):",
	"export default (Current, Section, Keep) => {",
	"\tconst Document = JSON.parse(Current); // Current: the RAW file text",
	"\tconst Outcome = Pin(Document, Section, Keep); // the module's own logic",
	"\tswitch (true) {",
	"\t\tcase !Outcome: // nothing to pin",
	"\t\t\treturn null; // every no-op path logs itself, then null",
	"\t\tdefault:",
	"\t\t\treturn {",
	'\t\t\t\tnext: Outcome.Next, // written as JSON.stringify(next, null, 2) + "\\n"',
	"\t\t\t\tcount: Outcome.Pinned,",
	"\t\t\t\tmessage: `pinned ${Path} (${Outcome.Pinned} versions)`,",
	"\t\t\t}; // Continue: GuardedWrite → Refresh → Append → journal",
	"\t}",
	"};",
	"",
	"transcript:  the write tool result shows exactly what the author wrote",
	"pinner ledger:  [2026-10-03T09:16:01.880Z] pinned <project>/acme/tool/package.json (7 versions)",
];

// The factory's two Append wrappers, from the README's Ledger section.
const LedgerLines = [
	"logger:  <State.Module>: <message>      (State.Module = the consumer's historical prefix)",
	"ledger:  [<ISO timestamp>] <message>    (appendFileSync, best-effort, when log is enabled)",
];

// The policy block's eight action classes and their D6 defaults (SCHEME 2.19).
const PolicyRows = [
	{ Action: "read", Default: "auto", Meaning: "read-only inspection of the workspace" },
	{ Action: "index", Default: "auto", Meaning: "building or refreshing the index" },
	{ Action: "record", Default: "auto", Meaning: "recording a decision, an outcome or a journal entry" },
	{ Action: "suggest", Default: "auto", Meaning: "emitting a suggestion or a note" },
	{ Action: "write", Default: "approve", Meaning: "writing a file" },
	{ Action: "commit", Default: "approve", Meaning: "committing a batch of writes" },
	{ Action: "spawn", Default: "approve", Meaning: "spawning an agent or starting a job" },
	{ Action: "message", Default: "auto", Meaning: "sending a message to another agent (inside the session)" },
];

const Related = [
	{
		Name: "lib-dsh-core",
		Desc: "The pure layer the factory deliberately does not re-export - the hooks import the core's helpers directly.",
	},
	{
		Name: "hook-dsh-package-governor",
		Desc: "A governance hook child: injects the service and supplies its own transform, update engine and ledger strings.",
	},
	{
		Name: "hook-dsh-normalize-dash",
		Desc: "The factory's first NON-MANIFEST module: injects only the service and uses State/Append and the named Schema export.",
	},
	{
		Name: "hook-dsh-ccr",
		Desc: "A NON-MANIFEST hook child from the guardians: owns its schema and its strings, hooks the tools/post-execute waterfall through the service's plumbing.",
	},
	{
		Name: "hook-dsh-tool-coach",
		Desc: "The coach hook child: five listeners plus the loader/volatile-update refresh this service's State builder registers for every volatile knob.",
	},
];
---

<Base
	Title="plugin-dsh-factory - DSH Family @ PlayForm"
	Description={`${Families.Factory} - the furnace of the DSH governance family. The FIRST service-provider bundle in the DeepSeek Harness plugin family. ONE service holding EVERY piece of common machinery the family's hooks used to duplicate.`}
>
	<main class="container container--main">
		<div class="eyebrow-row">
			<Badge Variant="primary" Dot>
				PLUGIN DETAIL
			</Badge>
			<Badge>ROLE: FACTORY</Badge>
			<Badge>SERVICE PROVIDER</Badge>
		</div>

		<section class="page-hero">
			<h1 class="page-hero__title">plugin-dsh-factory</h1>
			<p class="page-hero__sub">
				{Families.Factory} • <BrandIcon Name="deepseek" /> <em>The DeepSeek Harness Plugin Family for PlayForm.</em>
			</p>
			<p class="page-hero__sub">
				The <strong>furnace of the DSH governance family</strong>.
				The FIRST service-provider bundle in the DeepSeek Harness plugin family.
			</p>
			<p class="page-hero__sub">
				Loading it registers ONE class plugin (export default class PluginFactory extends Service, super(ctx, "pluginFactory"), static inject = ["fs"]) that exposes <code>ctx.pluginFactory</code>.
				A single service holding EVERY piece of common machinery the family's hooks used to duplicate.
			</p>
			<p class="page-hero__sub">ONE service.</p>
			<p class="page-hero__sub">{Methods.Word} methods (<a href={Link(Links.OurRepo, "Classic/packages/plugin-dsh-factory/Source/Function/Govern.ts")}>the direct-govern pair</a> RegisterGovern + Govern and the GovernSteps registry among them).</p>
			<p class="page-hero__sub">
				The hooks bring their own metal.
				The factory pours the mold.
			</p>
		</section>

		<section class="section">
			<div class="snippet-list">
				<Terminal Pkg="plugin-dsh-factory"/>
			</div>
			<div class="inspect-card">
				<span class="inspect-card__meta">
					<span class="live-dot"></span>INSPECTED
				</span>
				<div class="workbench-controls__group">
					<span class="workbench-controls__label">Namespace:</span>
					<span class="hook-tally">@playform/plugin-dsh-factory</span>
					<span class="workbench-controls__label">Release:</span>
					<Badge Variant="outline">v{Versions.Release}</Badge>
				</div>
				<div class="workbench-controls__group">
					<span class="workbench-controls__label">Archetype:</span>
					<Badge Variant="outline">Service</Badge>
					<span class="workbench-controls__label">Injects:</span>
					<Badge>fs</Badge>
					<span class="workbench-controls__label">Exposes:</span>
					<Badge Variant="active">ctx.pluginFactory</Badge>
				</div>
			</div>
		</section>

		<p class="page-hero__sub" style="margin-top: var(--space-md)">
			The profile wiring for this plugin - the bundles list, the patch entry and the restart - is on the <a href="/setup/">setup page</a>.
		</p>

		<section class="section">
			<SectionHeader Title="Where It Fits" Metadata="FAMILY POSITION: THE PARENT SERVICE" />
			<div class="concept-list">
				<Concept
					ID="factory-family-position"
					Title="The family position"
					Diagram={`${Families.Factory} as the family's parent service - every other package consuming it (the three governance hooks injecting the service; the six normalize flavors consuming State/Append and the Schema helper) - its own parent the filesystem service (inject: ["fs"]).`}
				>
					<p>
						The family's parent service ({Families.Factory}).
						Forty-five of the {Counts.PackagesClassic} Classic packages depend on it.
						The three governance hooks inject the service.
						The six normalize flavors consume State/Append and the Schema helper.
						Its own parent is the filesystem service (inject: ["fs"]).
					</p>
				</Concept>
				<Concept
					ID="factory-core-boundary"
					Title="The non-reexport boundary"
					Diagram="The pure layer the factory deliberately does not re-export - [lib-dsh-core](Ours:Classic/packages/lib-dsh-core/Source) (its service surface stays stable) - the hooks importing the core's helpers directly."
				>
					<p>
						The pure layer it deliberately does <strong>NOT</strong> re-export is <strong>lib-dsh-core</strong> (its service surface stays stable).
						The hooks import the core's helpers directly.
					</p>
				</Concept>
				<Concept
					ID="factory-conventions"
					Title="The ecosystem conventions"
					Diagram="The DSH plugin family as the DeepSeek Harness plugin layer of the PlayForm ecosystem - TypeScript-first Source/ to Target/, the deterministic @playform build, prepublishOnly-only - the same conventions as every other @playform package."
				>
					<p>
						The DSH plugin family is the DeepSeek Harness plugin layer of the PlayForm ecosystem.
						TypeScript-first Source/ <ArrowIcon Direction="right" Tone="accent" /> Target/, the deterministic @playform build, prepublishOnly-only.
						The same conventions as EVERY other @playform package.
					</p>
				</Concept>
			</div>
			<p class="page-hero__sub" style="margin-top: var(--space-md)">
				The Effect-TS twin is{" "}
				<a href={Link(Links.OurRepo, "EffectTS/packages/ets-plugin-dsh-factory/Source")}><code>@playform/ets-plugin-dsh-factory</code></a>{" "}
				- the same contracts under the <code>ets-</code> prefix, built on the shared{" "}
				<code>@playform/ets-base-dsh</code> base.
			</p>
			<div class="table-wrap">
				<table class="table">
					<thead>
						<tr>
							<th>Consumer</th>
							<th>Injects</th>
							<th>Uses</th>
						</tr>
					</thead>
					<tbody>
						{Consumers.map((Row) => (
							<tr>
								<td>
									<strong>{Row.Name}</strong>
								</td>
								<td>{Row.Inject}</td>
								<td>{Row.Uses}</td>
							</tr>
						))}
					</tbody>
				</table>
			</div>
			<p class="page-hero__sub" style="margin-top: var(--space-md)">
				The other 32 consumers are the orchestration, workspace and suggester families: each
				injects the service for <code>State</code> and <code>Append</code>, and the workspace
				packages also consume the <code>ctx.trace</code> bus it provides. The seven Classic
				packages that do not depend on the factory are the three <code>client-*</code>
				packages and the four libraries (<code>lib-dsh-core</code>,{" "}
				<code>lib-dsh-pack</code>, <code>lib-dsh-trace</code>,{" "}
				<code>lib-dsh-workspace-live</code>).
			</p>
		</section>

		<section class="section">
			<SectionHeader Title="In the DeepSeek Harness" Metadata="THE SERVICE BEHIND THE SEAMS" />
			<p class="page-hero__sub" style="margin-bottom: var(--space-md)">
				The factory is the family's bridge into the harness internals.
				It sits under EVERY consumer and drives the actual facilities:
			</p>
			<Seams
				Seams={[
					{
						Seam: "The tool layer (write / edit / str_replace_editor / raw-write)",
						What: "The fs/observed events the governance hooks react to are fired by the tool layer ONLY, for EVERY harness write or edit. [GuardedWrite](Ours:Classic/packages/plugin-dsh-factory/Source/Function/Write.ts) and Refresh keep the author's next guarded write from ever failing a stale-version check.",
						Outcome: "One trigger law for the whole machine, any agent, any thread.",
					},
					{
						Seam: "ctx.fs - the filesystem service (dsh-fs)",
						What: "EVERY write of a GOVERNED file goes through [ctx.fs](Harness:packages/fs/fs) (the [fs/write-intent waterfall](Harness:packages/fs/fs/src/index.ts), the standing sandbox policy, the [fs/observed emit](Harness:packages/fs/fs/src/index.ts)). ONLY the ledger append and auxiliary discovery reads are plain-fs exemptions, documented.",
						Outcome:
							"Writes that the observation policy and the sandbox see like built-in writes.",
					},
					{
						Seam: "ctx.jobs - the jobs facility",
						What: "Attach registers the root's job controller (which serves EVERY owner). It runs the update stages inside the [jobs envelope](Harness:packages/jobs) (kind governor-update, unowned), with the detached contained continuation as the probed fallback.",
						Outcome: "Update stages that NEVER block or abort the author's session.",
					},
					{
						Seam: "The storage domain",
						What: "[Journal](Ours:Classic/packages/plugin-dsh-factory/Source/Function/Journal.ts) writes the package_governance v2 records when the [storage facility](Harness:packages/storage/storage-domain) is present (probed, graceful). The queue drains, or the records buffer/drop and the human ledger stays the complete record.",
						Outcome: "A machine-readable governance history beside the human ledger.",
					},
					{
						Seam: "Sessions / the ledger",
						What: "Append composes the two wrappers - <State.Module>: <message> on the logger and [<ISO>] <message> in the durable ledger file - around EVERY consumer message.",
						Outcome:
							'"Did it activate / what happened" is answerable from the ledger alone.',
					},
				]}
			/>
		</section>

		<section class="section">
			<SectionHeader Title="The Problem" Metadata="THREE CONSUMERS, ONE MACHINE" />
			<div class="concept-list">
				<Concept
					ID="factory-problem-copies"
					Title="The triplicated machinery"
					Diagram="Three independent consumers of the same machinery already existing - the governor, the pinner and the cargo governor each maintaining their own copy of: the ledger (Append), the exclusion match (Match), the registry / policy walk-up discovery (Discover/Parse), the union keep-list resolution with the P3 chain-keys interlock, the g1 gate set, the version-guarded write with the P4 sandbox fence, the P3/U2 observation-policy refresh, the detached contained continuation scaffolding, the State construction with defensive cell unwrap, the ctx.on wiring, the P1/P2/P5 lifecycle effects, the Schemastery schema shape, and the probe-once optional-service accessor."
				>
					<p>
						Three independent consumers of the <em>same</em> machinery already existed.
						The governor, the pinner and the cargo governor EACH maintained their own copy of:
					</p>
					<ul class="concept-values">
						<li>
							the ledger (Append).
							the exclusion match (Match).
							the registry / policy walk-up discovery (Discover/Parse).
							the union keep-list resolution with the P3 chain-keys interlock.
							the g1 gate set.
							the version-guarded write with the P4 sandbox fence.
							the P3/U2 observation-policy refresh.
							the detached contained continuation scaffolding.
							the State construction with defensive cell unwrap.
							the ctx.on wiring.
							the P1/P2/P5 lifecycle effects.
							the Schemastery schema shape.
							and the probe-once optional-service accessor.
						</li>
					</ul>
				</Concept>
				<Concept
					ID="factory-problem-triple"
					Title="The triple-application cost"
					Diagram="Every bug fix or hardening pass - the sandbox fence, the stale-version leak, the in-flight disposal - having to be applied three times; the factory making it apply once."
				>
					<p>
						EVERY bug fix or hardening pass - the sandbox fence, the stale-version leak, the in-flight disposal - had to be applied three times.
					</p>
					<p>
						The factory makes it apply <strong>once</strong>.
					</p>
				</Concept>
			</div>
		</section>

		<section class="section">
			<SectionHeader Title="How It Works" Metadata="THE FURNACE" />
			<div class="code-block">{Furnace.join("\n")}</div>
			<p class="page-hero__sub" style="margin-top: var(--space-md)">
				A consumer NEVER re-implements the mold.
				It injects the service (inject: ["pluginFactory"], the loader holds it PENDING until the factory exists) and supplies ONLY its own three parts:
			</p>
			<div class="grid grid--3" style="margin-top: var(--space-sm)">
				<Card
					Variant="white"
					Name="1. A Config extension"
					Desc="export const Config = Schema({ logFile: ... }, { myField: ... }) via the standalone named Schema export. Usable at module-evaluation time, before ANY service instance exists. shared: false emits the minimal block for non-manifest modules."
				>
					<Badge slot="badge">CONFIG</Badge>
				</Card>
				<Card
					Variant="white"
					Name="2. A transform"
					Desc="The pure (current, section, keep) => { next, count, message? } | null function. current is the RAW file text (null when the read failed). The consumer decodes, applies its logic, logs its own no-op/refusal lines and returns null for EVERY no-op path."
				>
					<Badge slot="badge">TRANSFORM</Badge>
				</Card>
				<Card
					Variant="white"
					Name="3. An update engine (optional)"
					Desc="ncu/cargo dispatch, cooldowns, circuit breakers, the first-wins update-policy path pick: model logic, built on GuardedWrite/Refresh/Seam/Journal/UpdateKey."
				>
					<Badge slot="badge">UPDATE ENGINE</Badge>
				</Card>
			</div>
			<div class="concept-list">
				<Concept
					ID="factory-not-owned"
					Title="What the factory deliberately does NOT own"
					Diagram={"The three ownership boundaries: the consumer ledger strings (every message a hook logs - \"skipped (excluded) ...\", \"observed non-JSON package.json ... - skipped\", \"REFUSED rewrite ...\", \"pinned ...\", \"governed ... → ...\", the activated (...) proof - composed and logged by the hook through the factory's Append), the transforms (the consumer supplies the pure function; the factory only drives it inside Continue), and the update engines (the factory gives them GuardedWrite/Refresh/Seam/Journal/UpdateKey to build with)."}
				>
					<p>
						The consumer ledger strings - EVERY message a hook logs - are composed and logged by the hook through the factory's Append.
						"skipped (excluded) ...", "observed non-JSON package.json ... - skipped", "REFUSED rewrite ...", "pinned ...", "governed ... → ...", the activated (...) proof.
					</p>
					<p>
						It does NOT own the transforms.
						The consumer supplies the pure function; the factory ONLY drives it inside Continue.
						It does NOT own the update engines.
						The factory gives them GuardedWrite/Refresh/Seam/Journal/UpdateKey to build with.</p>
					<p>
						Full contract: <span class="file-mention"><BrandIcon Name="file-markdown" Size="0.9em" />SCHEME.md</span>.

					</p>
				</Concept>
				<Concept
					ID="factory-verification"
					Title="Verification"
					Diagram={`The three gates: tsc --noEmit - zero errors; pnpm run prepublishOnly - minified Target/ (+ .d.ts twins); node Target/Test/<Folder>/Test.js - the eight test folders, ${Counts.Factory.Classic} checks, ALL PASS.`}
				>
					<p>
						tsc --noEmit - zero errors.
						pnpm run prepublishOnly - minified Target/ (+ <span class="file-mention"><BrandIcon Name="file-ts" Size="0.9em" />.d.ts</span> twins).
						node <span class="file-mention"><BrandIcon Name="file-js" Size="0.9em" />Target/Test/&lt;Folder&gt;/Test.js</span> - the eight test folders, {Counts.Factory.Classic} checks, ALL PASS.
					</p>
					<p>
						The coverage: EVERY primitive.
						the Gate matrix.
						BOTH GuardedWrite postures.
						the full Continue lifecycle.
						State defaults + cell unwrap.
						Attach's three effects.
						Journal's queue/drain/silent-skip.
						Schema's volatile cells.
						and Seam's probe-once caching.
					</p>
				</Concept>
			</div>
		</section>

		<section class="section">
			<SectionHeader Title="The Config" Metadata="NONE - IT IS THE CONFIG MACHINERY" />
			<div class="concept-list">
				<Concept
					ID="factory-config-machinery"
					Title="No schema of its own - it IS the config machinery"
					Diagram="The factory registering no Config schema of its own - its Schema(shared?, m) instance method being the Schemastery schema factory every consumer builds its schema with."
				>
					<p>
						The factory registers NO Config schema of its own - it <strong>is</strong> the config machinery.
					</p>
					<p>
						Its <code>Schema(shared?, m)</code> instance method is the Schemastery schema factory EVERY consumer builds its schema with.
					</p>
				</Concept>
				<Concept
					ID="factory-config-entrypoints"
					Title="The two Schema entry points"
					Diagram="The standalone named Schema export making the same factory usable at module-evaluation time, before any service instance exists (the loader needs Config at load) - alongside the instance method."
				>
					<p>
						The standalone named <code>Schema</code> export makes the same factory usable at module-evaluation time, before ANY service instance exists (the loader needs Config at load).
					</p>
				</Concept>
				<Concept
					ID="factory-config-blocks"
					Title="shared: false vs the shared defaults"
					Diagram="shared: false emitting the minimal block (log and logFile, with logFile defaulting to the empty string - no updateCooldownMs/mutationTools/policyFile/exclude) for non-manifest modules like the normalize flavors - the shared defaults carrying the family's block - volatile cells (log, logFile and any consumer's own hot fields) committing without remounting the plugin, the factory's State builder unwrapping them defensively."
				>
					<p>
						<code>shared: false</code> emits the minimal block - <code>log</code> and{" "}
						<code>logFile</code>, with <code>logFile</code> defaulting to the empty
						string (no updateCooldownMs/mutationTools/policyFile/exclude) - for
						non-manifest modules like the normalize flavors.
						The shared defaults carry the family's block.
					</p>
					<p>
						Volatile cells (log, logFile and ANY consumer's own hot fields) commit
						WITHOUT remounting the plugin.
						The factory's State builder unwraps them defensively.
					</p>
				</Concept>
				<Concept
					ID="factory-config-volatile-refresh"
					Title="The volatile-refresh listener: hot edits land in place"
					Diagram="The granular-volatile fix: the factory's State builder now keeps the raw config's { get } cells in place and registers a loader/volatile-update listener that re-reads the whole object and refreshes the State fields LIVE - one leaf change, one dispatch, no remount, no new activation line. The normalize family's volatile scopes (conversation/reasoning/toolInput/toolResults/files/batch) and every volatile knob of the ccr hook and the tool-coach ride exactly this path."
				>
					<p>
						The volatile-refresh fix (the granular-volatile plan).
						The State builder keeps the raw config's <code>&#123; get &#125;</code> cells IN PLACE.
						It registers a <code>loader/volatile-update</code> listener that refreshes the State fields IN PLACE.
						ONE leaf change commits ONE dispatch.
						The whole object is re-read LIVE.
						NO remount.
						NO new activation line.
					</p>
					<p>
						The normalize family's volatile <code>scopes</code> object (conversation / reasoning / toolInput / toolResults / files / batch), the ccr hook's volatile <code>thresholdBytes</code>/<code>previewMaxChars</code>/<code>multipliers</code> and EVERY volatile knob of the <a href="/plugins/hook-dsh-tool-coach/">tool-coach</a> ride exactly this path.
						<strong>a flip lands on the next judged call</strong>.
					</p>
				</Concept>
			</div>
		</section>

		<section class="section">
			<SectionHeader Title="The completion surfaces" Metadata="THE TRACE BUS · THE POLICY BLOCK · THE PACK LAYER" />
			<div class="concept-list">
				<Concept
					ID="factory-trace-bus"
					Title="The trace bus: one service, three events"
					Diagram={`The factory's constructor building one bus and providing it as ctx.trace: an emitter completing the envelope, a bounded ring of ${Trace.Ring} envelopes, and per-kind dispatch to the listeners - ${Trace.Events} events (observe/stamp, graph/indexed, graph/invalidated), ${Trace.EnvelopeFields} envelope fields (trace, kind, at, actor, payload), and ${Trace.Adapters} plugin-owned Source/Trace adapters.`}
				>
					<p>
						The factory is the home of the workspace family's trace bus. Its constructor
						builds one bus and provides it as <code>ctx.trace</code>; the vocabulary and
						the detached loop live in{" "}
						<a href={Link(Links.OurRepo, "Classic/packages/lib-dsh-trace/Source")}><code>@playform/lib-dsh-trace</code></a>,
						and every adapting plugin carries its own <code>Source/Trace/</code> adapter -
						no plugin imports another.
					</p>
					<p>
						The bus completes the envelope{" "}
						<code>&#123; trace, kind, at, actor, payload &#125;</code> (the bus assigns{" "}
						<code>trace-&lt;n&gt;</code> and <code>at</code> when the emitter supplied
						none), pushes it into a bounded ring - the fixed <code>Bound</code> of{" "}
						{Trace.Ring}, with no config knob - and dispatches it to the listeners of its
						kind. {Trace.Events} events: <code>observe/stamp</code>,{" "}
						<code>graph/indexed</code> and <code>graph/invalidated</code>.
					</p>
					<p>
						Every listener runs inside its own try/catch and the whole emit is contained:
						the bus never throws into a caller, and a late emit or a late subscription
						after the unload effect is a contained no-op. The service adds no method to
						the {Methods.Count}-method surface and no config field.
					</p>
				</Concept>
				<Concept
					ID="factory-policy-block"
					Title={`The policy block: ${Policy.Actions} actions, ${Policy.Approve} of them approved by hand`}
					Diagram={`Policy() composing the shared ${Policy.Actions}-action block into a consumer's schema and Decide(policy, action) answering one verdict: ${Policy.Auto} actions default to auto (read, index, record, suggest, message) and ${Policy.Approve} to approve (write, commit, spawn) - a missing key falls back to its default, and a malformed value can only be more conservative.`}
				>
					<p>
						<code>Policy()</code> and <code>Decide(policy, action)</code> are named
						exports of the entry, not service methods: the class surface stays at the
						documented {Methods.Count}. The loader needs the composed config at
						module-evaluation time, before any service instance exists - the same reason
						the standalone <code>Schema</code> export exists.
					</p>
					<p>
						The block carries one key per action class, each a{" "}
						<code>Schema.union(["auto", "approve"])</code> with the D6 default, and the
						whole block is volatile - one hot-editable object whose flip re-reads
						wholesale into the consumer's mapped <code>State.Allow</code> field.
					</p>
					<p>
						A missing key falls back to that action's default, and a malformed value is
						treated as missing - a bad config can only be more conservative for write,
						commit and spawn, and never silently widens an automatic action. The helper
						never throws.
					</p>
				</Concept>
				<Concept
					ID="factory-pack-layer"
					Title="The pack layer: the workspace-pack schema under the policy"
					Diagram={`@playform/lib-dsh-pack: ${Pack.Families} built-in families across ${Pack.Domains} domains, the ${Pack.Layers}-layer resolution (the user layer, the repo layer, the cycle-guarded extends chain) and the strict YAML-subset parser - a resolved pack's policy section overriding the block's defaults per action, its value winning and an absent action keeping the D6 default.`}
				>
					<p>
						The pack is the data layer under the policy:{" "}
						<a href={Link(Links.OurRepo, "Classic/packages/lib-dsh-pack/Source")}><code>@playform/lib-dsh-pack</code></a>{" "}
						carries {Pack.Families} built-in families across {Pack.Domains} domains, the{" "}
						{Pack.Layers}-layer resolution - the user layer{" "}
						<code>~/.dsh/playform/workspaces/&lt;repo-slug&gt;.yml</code> read first, the
						repo layer <code>&lt;repo&gt;/.dsh/pack.yml</code> overriding it, and a
						cycle-guarded <code>extends:</code> chain - and the strict YAML-subset parser.
					</p>
					<p>
						A pack's <code>policy</code> section carries the same action-to-verdict
						mapping and overrides the block's defaults per action when a pack is
						resolved: the pack's value wins, and an absent action keeps the D6 default.
					</p>
				</Concept>
			</div>
			<div class="table-wrap">
				<table class="table">
					<thead>
						<tr>
							<th>Action</th>
							<th>Default</th>
							<th>Meaning</th>
						</tr>
					</thead>
					<tbody>
						{PolicyRows.map((Row) => (
							<tr>
								<td>
									<strong>{Row.Action}</strong>
								</td>
								<td>{Row.Default}</td>
								<td>{Row.Meaning}</td>
							</tr>
						))}
					</tbody>
				</table>
			</div>
		</section>

		<section class="section">
			<SectionHeader Title="In Action" Metadata="A GOVERNED WRITE, END TO END" />
			<p class="section-kicker">
				The consumer supplies the transform - the ONLY code in the chain it writes
			</p>
			<CodeBlock Language="typescript" Source={InAction.join("\n")} />
			<p class="section-kicker" style="margin-top: var(--space-md)">
				<BrandIcon Name="swap" />After - the write the factory performed, as the author and the ledger see it
			</p>
			<div class="concept-list">
				<Concept
					ID="factory-in-action"
					Title="The factory's part of that one pass"
					Diagram="The one pass as the factory performs it: Gate deciding the actor and the path, Discover finding the nearest registry.json, Continue running the transform detached and contained, GuardedWrite carrying replaceIfVersion past the P4 sandbox fence, Refresh re-emitting the fresh version with the same actor, Append composing the logger's line from the module's message."
				>
					<p>
						Gate decided the actor and the path.
						Discover found the nearest <span class="file-mention"><BrandIcon Name="file-json" Size="0.9em" />registry.json</span>.
						Continue ran the transform detached and contained.
						GuardedWrite carried replaceIfVersion past the P4 sandbox fence.
						Refresh re-emitted the fresh version with the same actor.
						Append composed the logger's line from the module's message.
					</p>
					<p>The consumer composed the ONLY string in the chain.</p>
				</Concept>
			</div>
		</section>

		<section class="section">
			<SectionHeader Title="The Ledger" Metadata="TWO WRAPPERS, CONSUMER'S MESSAGE" />
			<div class="concept-list">
				<Concept
					ID="factory-ledger-service"
					Title="A service, not a module"
					Diagram="The factory registering no activation line and owning no ledger strings - its Append(state, message) being the family's one ledger mechanism, composing exactly two wrappers around the CONSUMER's message."
				>
					<p>
						The factory registers NO activation line and owns NO ledger strings - it is a service, NOT a module.
					</p>
					<p>
						Its <code>Append(state, message)</code> is the family's ONE ledger mechanism.
						It composes exactly two wrappers around the CONSUMER's message:
					</p>
				</Concept>
			</div>
			<div class="code-block">{LedgerLines.join("\n")}</div>
			<div class="concept-list">
				<Concept
					ID="factory-ledger-boundary"
					Title="The ownership boundary"
					Diagram={"Every string a hook logs - \"skipped (excluded) ...\", \"governed <path> → <version>\", \"pinned <path> (N versions)\", the activated (...) proof - composed and logged by the hook, through the factory's Append - the factory's own composed strings parameterized machinery (the unreadable-policy line taking the policy file name; the suppressed-error lines taking state.Module as the prefix), staying byte-identical when a consumer keeps its historical name."}
				>
					<p>
						Every ledger string a hook logs is composed and logged by the hook, through the factory's Append.
						"skipped (excluded) ...", "governed &lt;path&gt; → &lt;version&gt;", "pinned &lt;path&gt; (N versions)", the activated (...) proof.
					</p>
					<p>
						The factory's own composed strings are parameterized machinery.
						The unreadable-policy line takes the policy file name.
						The suppressed-error lines take state.Module as the prefix.
						They stay byte-identical when a consumer keeps its historical name.
					</p>
				</Concept>
			</div>
		</section>

