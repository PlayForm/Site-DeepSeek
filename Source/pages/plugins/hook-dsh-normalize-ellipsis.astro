---
import Base from "@Layout/Base.astro";
import ArrowIcon from "@Component/ArrowIcon.astro";
import Badge from "@Component/Badge.astro";
import FlavorBadge from "@Component/FlavorBadge.astro";
import BrandIcon from "@Component/BrandIcon.astro";
import Card from "@Component/Card.astro";
import CodeBlock from "@Component/CodeBlock.astro";
import Compare from "@Component/Compare.astro";
import Concept from "@Component/Concept.astro";
import PageHero from "@Component/PageHero.astro";
import SectionHeader from "@Component/SectionHeader.astro";
import Seams from "@Component/Seams.astro";
import Terminal from "@Component/Terminal.astro";
import { Counts, Versions, Families, FamilyPosition } from "@Library/Content";
import { Link, Links } from "@Library/Links";
import { Mention } from "@Library/FileIcon";

// The stream pipeline, from the package README (class flavor).
const Pipeline = [
	"  llm/stream waterfall (options, next)     the interceptable wrapper around",
	"       │                                   EVERY streaming model call",
	"       ▼  next() called FIRST, always - options never touched",
	"  Normalize(upstream, state)               the async generator",
	"       │   for await (chunk of upstream)",
	"       ▼",
	"  CoreChunk(chunk, transform, reasoning, toolArgs, raw)  the core's per-chunk dispatch",
	"       │",
	'       ├─ text-delta ─────────► Replace(text, Ellipsis, "...")  rewrite the text field',
	"       ├─ reasoning-delta ────► same, when normalizeReasoning (default ON)",
	"       ├─ block-end ──────────► the assembled block's text fields -",
	"       │                        TextBlock.text / ReasoningBlock.text (plus a",
	"       │                        runtime `thinking` string field) - the deltas",
	"       │                        AND the block must agree, or consumers see",
	"       │                        inconsistencies",
	'       ├─ tool-call-delta ────► Replace(argumentsDelta, Ellipsis, "...") when',
	"       │                        normalizeToolArguments (IMPLEMENTED, default",
	"       │                        OFF - execution-critical raw JSON, the user's",
	"       │                        accepted risk; this profile's patch turns it",
	"       │                        on) - the assembled ToolCallBlock.arguments",
	"       │                        follows the same flag via block-end",
	"       │                        The gate is THREE-WAY with the flag on: a",
	'       │                        delta/block whose `name` is "edit" passes',
	"       │                        through BY IDENTITY (the edit tool's",
	"       │                        `old_string` must match the real file bytes),",
	"       │                        and a call whose arguments open with the",
	'       │                        `{"__normalize":false` marker (FIRST key,',
	"       │                        tracked per call id) passes through",
	"       │                        UNNORMALIZED with the marker entry stripped,",
	"       │                        so the executed call carries no unknown key",
	"       └─ block-start / usage / finish",
	"                                ──► PASSTHROUGH BY IDENTITY, ALWAYS",
	"                                    (usage/finish ordering is the",
	"                                     adapter contract)",
	"       │   count === 0 → original chunk BY IDENTITY; rewritten → shallow copy",
	"       ▼",
	"  yield ──► downstream consumers = the live UI + the durable transcript",
	"       │    (order preserved, no buffering; upstream throws propagate)",
	"       ▼  normal loop completion, Count > 0",
	"  Factory.Append ──► `hook-dsh-normalize-ellipsis: normalized N ellipsis char(s) in one stream`",
];

// The transform class, from the README.
const TransformClass = ["[\\u2026]  →  replacement"];

// The six siblings, from the README (this bundle highlighted).
const Siblings = [
	{
		Flavor: "hook-dsh-normalize-dash",
		Table: "core Dashes class",
		Sub: "→ replacement (default -)",
		This: false,
	},
	{
		Flavor: "hook-dsh-normalize-quotes",
		Table: "core Quotes MAP",
		Sub: "curly → straight",
		This: false,
	},
	{
		Flavor: "hook-dsh-normalize-ellipsis (this bundle)",
		Table: "core Ellipsis class",
		Sub: "U+2026 → ...",
		This: true,
	},
	{
		Flavor: "hook-dsh-normalize-spaces",
		Table: "core Spaces class",
		Sub: 'unicode spaces → " "',
		This: false,
	},
	{
		Flavor: "hook-dsh-normalize-invisible",
		Table: "core Invisible class",
		Sub: 'removed (default "")',
		This: false,
	},
	{
		Flavor: "hook-dsh-normalize-fullwidth",
		Table: "core Fullwidth MAP",
		Sub: "full-width → half-width",
		This: false,
	},
];

const Config = [
	{
		Field: "log",
		Type: "boolean",
		Default: "true",
		Volatile: "yes",
		Meaning: "write the durable ledger file",
	},
	{
		Field: "logFile",
		Type: "string",
		Default: "~/.dsh/hook-dsh-normalize-ellipsis.log",
		Volatile: "yes",
		Meaning: "the ellipsis ledger (separate from the family's logs)",
	},
	{
		Field: "replacement",
		Type: "string",
		Default: "...",
		Volatile: "yes",
		Meaning:
			"the transform's only knob - hot-editable, the next stream picks it up with no remount",
	},
	{
		Field: "normalizeReasoning",
		Type: "boolean",
		Default: "true",
		Volatile: "no",
		Meaning: "normalize reasoning deltas and the assembled reasoning block too",
	},
	{
		Field: "normalizeToolArguments",
		Type: "boolean",
		Default: "false",
		Volatile: "no",
		Meaning:
			'IMPLEMENTED (default OFF): rewrite the tool-call argumentsDelta and the assembled ToolCallBlock.arguments when on (with the edit name exemption and the {"__normalize":false raw-marker pass-through) - execution-critical raw JSON, the user\'s accepted risk; the example patch turns it on',
	},
];

// The stream example, from the README's In Action (literal character preserved).
const StreamExample = [
	"text-delta in (what the model wrote):",
	"",
	'  "loading the modules, one by one, until the whole set is ready and then …"',
	"",
	"text-delta out (what reaches the transcript):",
	"",
	'  "loading the modules, one by one, until the whole set is ready and then ..."',
];

// The ledger strings, from the README.
const LedgerStrings = [
	"hook-dsh-normalize-ellipsis: activated (replacement=..., reasoning=on, toolArgs=off, logFile=~/.dsh/hook-dsh-normalize-ellipsis.log)",
	"hook-dsh-normalize-ellipsis: normalized 3 ellipsis char(s) in one stream",
];
---

<Base
	Title="hook-dsh-normalize-ellipsis - DSH Family @ PlayForm"
	Description={`${Families.Ellipsis} - the ellipsis normalizer for model output: hooks the llm/stream waterfall and turns every horizontal ellipsis (U+2026) into the ASCII three-dot sequence, live in the transcript.`}
>
	<main class="container container--main">
		<div class="eyebrow-row">
			<Badge Variant="primary" Dot>
				PLUGIN DETAIL
			</Badge>
			<span class="flavor-cell flavor-cell--compact">
				<FlavorBadge Flavor="ELLIPSIS" />
			</span>
			<Badge>CLASS FLAVOR</Badge>
		</div>

		<section class="page-hero">
			<h1 class="page-hero__title">hook-dsh-normalize-ellipsis</h1>
			<p class="page-hero__sub">
				{Families.Ellipsis} • <BrandIcon Name="deepseek" /> <em>The DeepSeek Harness Plugin
				Family for PlayForm.</em> The <strong>ellipsis normalizer for model output</strong> - a
				DeepSeek Harness plugin that hooks the{" "}
				<a href={Link(Links.DeepSeekHarness, "packages/llm/llm/src/index.ts")}><code>llm/stream</code></a>{" "}
				waterfall (the interceptable wrapper around EVERY streaming model call, bound to the{" "}
				<a href={Link(Links.DeepSeekHarness, "packages/llm/llm/src/index.ts")}><code class="code-token">LlmRuntime</code></a>
				) and normalizes the horizontal ellipsis in model output, live in the transcript:
				every typographic three-dot ellipsis code point becomes the ASCII three-dot sequence
				- <code class="code-token">U+2026</code> to
				<code>...</code>.</p>
			<p class="page-hero__sub">A CLASS flavor of the normalize family: the core's
				<code>Ellipsis</code> class plus a configurable <code>replacement</code> string
				(default <code>...</code>).</p>
			<p class="page-hero__sub">The family's raw-write tool (registered by
				<a href={Link(Links.OurRepo, "Classic/packages/hook-dsh-normalize-dash/Source")}>hook-dsh-normalize-dash</a>
				) bypasses this flavor's transforms too - the exemption is family-wide.
			
			</p>
		</section>

		<section class="section">
			<div class="snippet-list">
				<Terminal Command="pnpm add @playform/hook-dsh-normalize-ellipsis" />
			</div>
			<div class="inspect-card">
				<span class="inspect-card__meta">
					<span class="live-dot"></span>INSPECTED
				</span>
				<div class="workbench-controls__group">
					<span class="workbench-controls__label">Namespace:</span>
					<span class="hook-tally">@playform/hook-dsh-normalize-ellipsis</span>
					<span class="workbench-controls__label">Release:</span>
					<Badge Variant="outline">v{Versions.Release}</Badge>
				</div>
				<div class="workbench-controls__group">
					<span class="workbench-controls__label">Archetype:</span>
					<Badge Variant="outline">Hook</Badge>
					<span class="workbench-controls__label">Event:</span>
					<Badge>llm/stream</Badge>
					<span class="workbench-controls__label">Table:</span>
					<Badge Variant="active">core Ellipsis class</Badge>
				</div>
			</div>
		</section>

		<p class="page-hero__sub" style="margin-top: var(--space-md)">
			The profile wiring for this plugin - the bundles list, the patch entry and the restart -
			is on the <a href="/setup/">setup page</a>.
		</p>
		<section class="section">
			<SectionHeader Title="Where It Fits" Meta={FamilyPosition(3)} />
			<div class="concept-list">
				<Concept
					Id="ellipsis-family-position"
					Title="The family position"
					Diagram={`${Families.Ellipsis} as a hook child of the plugin-dsh-factory service and the hook-dsh-core machinery - the third of the six stream normalizer siblings.`}
				>
					<p>
						A hook child of the{" "}
						<strong>
							<a
								href={Link(
									Links.OurRepo,
									"Classic/packages/plugin-dsh-factory/Source",
								)}
							>plugin-dsh-factory</a>
						</strong>{" "}
						service ({Families.Ellipsis}) and the <strong>hook-dsh-core</strong>{" "}
						machinery; the third of the six stream normalizer siblings.
					</p>
				</Concept>
			</div>
			<div class="table-wrap">
				<table class="table">
					<thead>
						<tr>
							<th>Flavor</th>
							<th>Table</th>
							<th>Substitution</th>
						</tr>
					</thead>
					<tbody>
						{Siblings.map((Row) => (
							<tr>
								<td>
									<strong>{Row.Flavor}</strong>
								</td>
								<td>{Row.Table}</td>
								<td>
									{Row.Sub.split("→").map((Part, Index) => (
										<Fragment>
											{Index > 0 && (
												<ArrowIcon Direction="right" Tone="accent" />
											)}
											<span set:html={Mention(Part)} />
										</Fragment>
									))}
								</td>
							</tr>
						))}
					</tbody>
				</table>
			</div>
			<div class="concept-list">
				<Concept
					Id="ellipsis-non-manifest"
					Title="A non-manifest factory consumer"
					Diagram={"The flavor's factory surface: injecting [\"pluginFactory\"], using only State and Append, the config composed by the factory's standalone Schema helper with shared: false - the minimal block, no fs/observed dead fields - touching no files, always calling next(), composing with other llm/stream listeners regardless of registration order."}
				>
					<p>
						It injects{" "}
						<code>["pluginFactory"]</code> and uses only <code>State</code> (cell unwrap
						+ shared Ledger/Enabled mappings + its own fields) and <code>Append</code>;
						the config is composed by the factory's standalone <code>Schema</code>{" "}
						helper with
						<code>shared: false</code> - the minimal block, no{" "}
						<a href={Link(Links.DeepSeekHarness, "packages/fs/fs/src/index.ts")}><code class="code-token">fs/observed</code></a>{" "}
						dead fields.
					</p>
					<p>
						It touches no files, so{" "}
						<a href={Link(Links.DeepSeekHarness, "packages/fs/fs/src/index.ts")}><code class="code-token">fs/write-intent</code></a>{" "}
						and{" "}
						<a href={Link(Links.DeepSeekHarness, "packages/fs/fs/src/index.ts")}><code class="code-token">fs/observed</code></a>{" "}
						never see it; it wraps the downstream result and always calls{" "}
						<code>next()</code>, so it composes with other{" "}
						<a href={Link(Links.DeepSeekHarness, "packages/llm/llm/src/index.ts")}><code class="code-token">llm/stream</code></a>{" "}
						listeners regardless of registration order.
					</p>
				</Concept>
			</div>
		</section>

		<section class="section">
			<SectionHeader Title="In the DeepSeek Harness" Meta="WHERE THE FLAVOR OPERATES" />
			<Seams
				Seams={[
					{
						Seam: "llm/stream - the model stream waterfall",
						What: "The plugin's listener wraps [the interceptable waterfall](Harness:packages/llm/llm/src/index.ts) around EVERY streaming model call (bound to the LlmRuntime): next() is called first, options are never touched, one chunk in - one chunk out, upstream throws propagate.",
						Outcome:
							"Three literal dots reach the live UI and the durable transcript as the stream is born.",
					},
					{
						Seam: "The model stream vocabulary (dsh-llm)",
						What: "The chunk/block shapes it rewrites come from the harness's stream vocabulary ([@deepseek-ai/dsh-llm](Harness:packages/llm/llm), type-only): text deltas, reasoning deltas and assembled blocks must agree.",
						Outcome:
							"No inconsistencies between deltas and blocks for downstream consumers.",
					},
					{
						Seam: "The factory service",
						What: "A non-manifest factory consumer: State for the config (the replacement is a hot-editable volatile cell - no remount) and Append for every ledger line; it touches no files.",
						Outcome:
							"Composes with other [llm/stream](Harness:packages/llm/llm/src/index.ts) listeners regardless of registration order.",
					},
					{
						Seam: "The raw-write exemption (family-wide)",
						What: "The family's raw-write tool (registered by [hook-dsh-normalize-dash](Ours:Classic/packages/hook-dsh-normalize-dash/Source)) passes through this flavor's stream transforms by identity - the tool's explicit normalize parameter is the only normalization it applies.",
						Outcome:
							"Per-call control stays with the agent, even with every stream flavor armed.",
					},
					{
						Seam: "The ledger / session",
						What: "Two lines through [the factory's Append](Ours:Classic/packages/plugin-dsh-factory/Source): the activation proof from apply() and the per-stream count line on a normal completion with N > 0.",
						Outcome: "A thrown-away stream writes no ledger line.",
					},
				]}
			/>
		</section>

		<section class="section">
			<SectionHeader Title="The Problem" Meta="WHY THE ELLIPSIS FLAVOR EXISTS" />
			<div class="concept-list">
				<Concept
					Id="ellipsis-problem"
					Title="The collapsed typographic run is simply wrong downstream"
					Diagram="Text processors collapsing the typographic three-dot run into a single code point - U+2026, the horizontal ellipsis - while code blocks, commands and diffs expect three literal dots."
				>
					<p>
						Text processors collapse the typographic three-dot run into a single code
						point - <code class="code-token">U+2026</code>, the horizontal ellipsis.
					</p>
					<p>
						In code blocks, commands and diffs the collapsed form is simply wrong: three
						literal dots are what every parser, shell and search expects.</p>
					<p>This flavor
						makes the ASCII spelling the one that reaches the transcript.
					
					</p>
				</Concept>
			</div>
		</section>

		<section class="section">
			<SectionHeader Title="How It Works" Meta="THE STREAM PIPELINE" />
			<div class="code-block">{Pipeline.join("\n")}</div>
			<div class="concept-list">
				<Concept
					Id="ellipsis-transform"
					Title="The transform: the core's Ellipsis class"
					Diagram="Exactly the core's Ellipsis class (@playform/hook-dsh-core's Normalize/Ellipsis), applied per text segment through the core's generic class-to-string Replace."
				>
					<p>
						<strong>The transform</strong> - exactly the core's <code>Ellipsis</code>{" "}
						class (
						<a href={Link(Links.OurRepo, "Classic/packages/hook-dsh-core/Source")}>@playform/hook-dsh-core</a>
						's Normalize/Ellipsis), applied per text segment through the core's generic
						class-to-string <code>Replace</code>:
					</p>
				</Concept>
			</div>
			<div class="code-block">
				{TransformClass.join("\n")}
			</div>
			<div class="concept-list">
				<Concept
					Id="ellipsis-coverage"
					Title="One code point, one replacement"
					Diagram="U+2026 (horizontal ellipsis - the typographic three-dot run collapsed into one code point by text processors) becoming the config replacement (default ..., the ASCII three-dot sequence - the ellipsis's own ASCII spelling) - no context rules, whole-chunk replacement, no lookahead, chunk-boundary-safe."
				>
					<p>
						<code class="code-token">U+2026</code> (horizontal ellipsis - the typographic
						three-dot run collapsed into
						one code point by text processors) becomes the config{" "}
						<code>replacement</code> (default <code>...</code>, the ASCII three-dot
						sequence - the ellipsis's own ASCII spelling).
					</p>
					<p>
						No context rules - whole-chunk replacement, no lookahead;
						chunk-boundary-safe.
					</p>
				</Concept>
				<Concept
					Id="ellipsis-mechanics"
					Title="The function replacer and the per-code-point count"
					Diagram="The replacement applied with a function replacer, so a custom replacement containing $ patterns is inserted literally - and replaced characters counted per stream for the ledger line, each replaced ellipsis code point counting once even though the default replacement emits three characters."
				>
					<p>
						The replacement is applied with a function replacer, so a custom{" "}
						<code>replacement</code> containing <code>$</code> patterns is inserted
						literally.
					</p>
					<p>
						Replaced characters are counted per stream for the ledger line - each
						replaced ellipsis code point counts once, even though the default
						replacement emits three characters.
					</p>
				</Concept>
			</div>
		</section>

		<section class="section">
			<SectionHeader Title="The Config" Meta="SCHEMA + DEFAULTS AT LOAD" />
			<div class="table-wrap">
				<table class="table">
					<thead>
						<tr>
							<th>Field</th>
							<th>Type</th>
							<th>Default</th>
							<th>Volatile</th>
							<th>Meaning</th>
						</tr>
					</thead>
					<tbody>
						{Config.map((Row) => (
							<tr>
								<td>
									<strong>{Row.Field}</strong>
								</td>
								<td>{Row.Type}</td>
								<td set:html={Mention(Row.Default)} />
								<td>{Row.Volatile}</td>
								<td set:html={Mention(Row.Meaning)} />
							</tr>
						))}
					</tbody>
				</table>
			</div>
			<div class="concept-list">
				<Concept
					Id="ellipsis-volatile"
					Title="Volatile cells commit without remounting"
					Diagram="The volatile cells committing without remounting the plugin - the factory's State builder unwrapping them defensively."
				>
					<p>
						They commit without remounting the plugin; the factory's State
						builder unwraps them defensively.
					</p>
					<p>
						Example{" "}
						<a
							href={Link(
								Links.OurRepo,
								"Classic/packages/plugin-dsh-factory/cordis.patch.yml",
							)}
						><span class="file-mention"><BrandIcon Name="file-yaml" Size="0.9em" />cordis.patch.yml</span></a>{" "}
						row:
					</p>
				</Concept>
			</div>
			<CodeBlock
				Language="yaml"
				Style="margin-top: var(--space-sm)"
				Source={[
					"- insert:",
					"      - id: hook-dsh-normalize-ellipsis",
					'        name: "@playform/hook-dsh-normalize-ellipsis"',
					"        config:",
					"            log: true",
					"            logFile: ~/.dsh/hook-dsh-normalize-ellipsis.log",
					'            replacement: "..."',
				].join("\n")}
			/>
		</section>

		<section class="section">
			<SectionHeader Title="In Action" Meta="ONE STREAM, ONE TRANSFORMATION" />
			<p class="page-hero__sub" style="margin-bottom: var(--space-md)">
				One stream, one transformation. The model emits the collapsed typographic ellipsis;
				the live UI and the transcript receive three ASCII dots:
			</p>
			<p class="section-kicker">
				Before <ArrowIcon Direction="right" Tone="accent" /> after - the model stream, then
				what reaches the transcript
			</p>
			<Compare
				Id="ellipsis-stream"
				Flavor="ellipsis"
				Raw={StreamExample.slice(0, 4)}
				Clean={StreamExample.slice(4)}
			/>
			<div class="concept-list">
				<Concept
					Id="ellipsis-in-action"
					Title="The counted expansion"
					Diagram="The single U+2026 code point becoming the three-dot ASCII sequence ... - dots that were already ASCII untouched, each replaced code point counting once in the ledger even though it expands to three characters."
				>
					<p>
						The single <code class="code-token">U+2026</code> code point becomes the
						three-dot ASCII sequence{" "}
						<code>...</code>; dots that were already ASCII are untouched.
					</p>
					<p>
						Each replaced code point counts once in the ledger even though it expands to
						three characters - which is why one ellipsis can show up as{" "}
						<code>normalized 3 ellipsis char(s)</code> for three collapsed code points,
						not nine output characters (the count line shown below).
					</p>
				</Concept>
				<Concept
					Id="ellipsis-hot-replacement"
					Title="The replacement is hot-editable"
					Diagram="The replacement changed in the config - say to . . . - with the very next stream picking it up with no remount."
				>
					<p>
						Change it in the config (say
						to <code>. . .</code>) and the very next stream picks it up with no remount.
					</p>
				</Concept>
				<Concept
					Id="ellipsis-pass-coverage"
					Title="The same pass runs over reasoning and tool-call arguments"
					Diagram="The pass running over reasoning deltas when normalizeReasoning is on, and over tool-call arguments when the example patch enables normalizeToolArguments - with the edit name exempt and raw-marker calls passing through unnormalized."
				>
					<p>
						The same pass runs over reasoning deltas when{" "}
						<code>normalizeReasoning</code> is on, and over tool-call arguments when the
						example patch enables <code>normalizeToolArguments</code> - with the{" "}
						<code>edit</code> name exempt and raw-marker calls passing through
						unnormalized.
					</p>
				</Concept>
			</div>
		</section>

		<section class="section">
			<SectionHeader Title="The Ledger" Meta="TWO LINES VIA FACTORY APPEND" />
			<p class="page-hero__sub" style="margin-bottom: var(--space-md)">
				Two lines, both written through the factory's <code>Append</code> (the
				hook-dsh-normalize-ellipsis: prefix is the logger's
				<code>&lt;State.Module&gt;:</code>; the durable file line is
				<code>[&lt;ISO&gt;] &lt;message&gt;</code>):
			</p>
			<div class="code-block">{LedgerStrings.join("\n")}</div>
			<p class="page-hero__sub" style="margin-top: var(--space-md)">
				The activation line is written by <code>apply()</code>; the count line only follows
				a normal stream completion and only when N &gt; 0 (a thrown-away stream writes no
				ledger line).
			</p>
		</section>

