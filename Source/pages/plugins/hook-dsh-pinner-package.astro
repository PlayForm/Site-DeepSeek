---
import Base from "@Layout/Base.astro";
import ArrowIcon from "@Component/ArrowIcon.astro";
import Badge from "@Component/Badge.astro";
import BrandIcon from "@Component/BrandIcon.astro";
import Card from "@Component/Card.astro";
import CodeBlock from "@Component/CodeBlock.astro";
import PageHero from "@Component/PageHero.astro";
import SectionHeader from "@Component/SectionHeader.astro";
import Seams from "@Component/Seams.astro";
import Terminal from "@Component/Terminal.astro";
import { Counts, Versions, Families } from "@Library/Content";
import { Link, Links } from "@Library/Links";

// The diagram set (Source/Content/Mermaid, rendered by Render.mjs): every
// one of this page's placeholders renders its pre-rendered SVG inline.
const Diagrams = import.meta.glob("/Source/Content/Mermaid/*.svg", {
	query: "?raw",
	import: "default",
	eager: true,
}) as Record<string, string>;
const PinSvg = Diagrams["/Source/Content/Mermaid/pin-then-bump-exact.svg"];
const KeepSvg = Diagrams["/Source/Content/Mermaid/keep-list-precedence.svg"];
const FamilySvg = Diagrams["/Source/Content/Mermaid/family-position.svg"];
const LedgersSvg = Diagrams["/Source/Content/Mermaid/independent-ledgers.svg"];
const InjectSvg = Diagrams["/Source/Content/Mermaid/injected-services.svg"];
const FactoryRespSvg = Diagrams["/Source/Content/Mermaid/factory-responsibilities.svg"];
const CoreHelpersSvg = Diagrams["/Source/Content/Mermaid/core-helpers.svg"];
const OwnedSvg = Diagrams["/Source/Content/Mermaid/pinner-owned-logic.svg"];
const DirectGovernSvg = Diagrams["/Source/Content/Mermaid/direct-govern-entry.svg"];
const IdemSvg = Diagrams["/Source/Content/Mermaid/idempotence.svg"];
const KeepPolicySvg = Diagrams["/Source/Content/Mermaid/keep-list-policy.svg"];
const WildcardSvg = Diagrams["/Source/Content/Mermaid/wildcard-behavior.svg"];
const RefusalSvg = Diagrams["/Source/Content/Mermaid/refusal-guard.svg"];
const VersionCoherSvg = Diagrams["/Source/Content/Mermaid/version-coherence.svg"];

// The pipeline P = Rewrite ∘ Pin ∘ Resolve ∘ Decode diagram, from the package README.
const Pipeline = [
	'  fs/observed (target, {kind:"present", version}, actor)',
	"  ── fired by the TOOL LAYER ONLY, for every harness write/edit, any thread ──►",
	"       │",
	"       ▼",
	'  G1  Factory.Gate ── displayPath → actor ∈ mutationTools → kind "present" →',
	'  │                    Stash idempotence → basename "package.json" → excluded?',
	"  │     excluded ──► ledger `skipped (excluded) <path>`   (every other gate",
	"  ▼                  outcome is silent)                      outcome proceeds)",
	"  G2  Factory.Discover ── nearest registry.json walk-up (an exempt plain-fs",
	"  │     probe - it exists ONLY as a location for the co-located",
	"  │     pin-policy.json); Stash seed (targetKey, version)",
	"  ▼",
	"  g3  PIN PASS  (detached, contained - Factory.Continue; the listener never",
	"  │     awaits) ── ctx.fs.readText → union keep-list (ResolvePolicy: global",
	"  │     policyFile → the file's own directory → registry-adjacent → built-in",
	"  │     default) → Decode (JSON.parse, null on failure) → the RANGE LAW",
	"  │     (the range law - ONE leading ^/~/= stripped per dep) → the REFUSAL",
	"  │     GUARD (core's Refusal) → GuardedWrite (replaceIfVersion + the P4",
	"  │     fence) → ledger `pinned <path> (<N> versions)` → Refresh (P3",
	"  │     re-emit, same actor)",
	"  ▼",
	"  SILENCE: the tool result shows exactly what the author wrote.",
	"  The pinned state is discoverable only by a subsequent read - or in",
	"  the ledger.",
];

// The range law, from the README - for each dependency value, in order.
const RangeLaw = [
	{ N: "1", Condition: "not a string", Action: "untouched", Examples: '"foo": {"imports": ...}' },
	{
		N: "2",
		Condition: "first char not in {^, ~, =}",
		Action: "untouched",
		Examples:
			'"0.3.4", "1.2.3-rc.1", "*", "", ">=1.0.0", "workspace:*", "file:../x", "link:...", "git+https://...", "npm:pkg@1.0.0"',
	},
	{
		N: "3",
		Condition: "whitespace in value",
		Action: "untouched",
		Examples: '"^1.0.0 || 2.0.0", "^1.0.0 <2.0.0"',
	},
	{
		N: "4",
		Condition: "otherwise",
		Action: "strip the one leading prefix",
		Examples: '"^0.3.4" → "0.3.4", "~1.2.3" → "1.2.3", "=2.0.0" → "2.0.0"',
	},
];

// The In Action ledger excerpt, from the README.
const LedgerExcerpt = [
	"[2026-10-03T09:15:22.411Z] activated (pinner, logFile=~/.dsh/hook-dsh-pinner-package.log, sections=[dependencies, devDependencies, peerDependencies, optionalDependencies], exclude=[node_modules, .git, .dsh, .pnpm, .store, DeepSeek Harness.app])",
	"[2026-10-03T09:16:01.880Z] pinned <project>/acme/tool/package.json (2 versions)",
];

// The pinned write itself, from the README.
const PinnedWrite = [
	"{",
	'  "name": "@acme/tool",',
	'  "scripts": { "build": "tsc" },',
	'  "dependencies": {',
	'    "@playform/build": "^0.3.4",',
	'    "tailwindcss": "^3.0.5",',
	'    "@acme/core": "~1.2.3"',
	"  }",
	"}",
];

// The module's composed strings, from the README's Ledger section.
const LedgerStrings = [
	"activated (pinner, logFile=..., sections=[...], exclude=[...])",
	"skipped (excluded) <path>",
	"observed non-JSON package.json <path>",
	"pinned <path> (N versions)",
	"no changes to pin for <path>",
	'REFUSED rewrite of <path>: non-dependency section "<name>" would change',
];

const Related = [
	{
		Name: "plugin-dsh-factory",
		Desc: "The family's furnace: the gate, the discovery, the union keep-list, the guarded write, the refresh, the continuation, the effects and the schema come from it.",
	},
	{
		Name: "hook-dsh-governor-package",
		Desc: "The sibling governor on the same seam: pin → bump-exact, since a fully pinned manifest leaves the governor's update stage nothing to do.",
	},
	{
		Name: "hook-dsh-core",
		Desc: "Supplies the [refusal guard (Refusal)](Ours:Classic/packages/hook-dsh-core/Source/Function/Refusal.ts) and the suppression composer (Suppress) this bundle composes its lines with.",
	},
];
---

<Base
	Title="hook-dsh-pinner-package - DSH Family @ PlayForm"
	Description={`${Families.PinnerPackage} - the silent version pinner of the DeepSeek Harness: hooks fs/observed and pins every dependency version in a written package.json to its static version.`}
>
	<main class="container container--main">
		<div class="eyebrow-row">
			<Badge Variant="primary" Dot>
				PLUGIN DETAIL
			</Badge>
			<Badge>ROLE: PINNER</Badge>
			<Badge>
				<BrandIcon Name="file-json" Size="0.8em" /> GATE: package.json
			</Badge>
		</div>

		<section class="page-hero">
			<h1 class="page-hero__title">hook-dsh-pinner-package</h1>
			<p class="page-hero__sub">
				{Families.PinnerPackage} • <BrandIcon Name="deepseek" /> <em>The DeepSeek Harness
				Plugin Family for PlayForm.</em> The <strong>silent version pinner</strong> of the
				DeepSeek Harness - a plugin on the
				<a href={Link(Links.DeepSeekHarness, "packages/fs/fs/src/index.ts")}><code>fs/observed</code></a> event that pins every dependency version in a written
				<span class="file-mention"><BrandIcon Name="file-json" Size="0.9em" /><code>package.json</code></span> to its STATIC version:{" "}
				<code>"@playform/build": "^0.3.4"</code> becomes <code>"0.3.4"</code>.</p>
			<p class="page-hero__sub">One leading
				range prefix (<code>^</code>,<code>~</code>, or <code>=</code>) is stripped, in
				every dependency section the config declares - and the author never learns.</p>
			<p class="page-hero__sub">A
				factory flavor: pure P-only - no ncu, no jobs, no subprocess, no cooldown.</p>
			<p class="page-hero__sub">Just the
				pin.
			
			</p>
		</section>

		<section class="section">
			<div class="snippet-list">
				<Terminal Command="pnpm add @playform/hook-dsh-pinner-package" />
			</div>
			<div class="inspect-card">
				<span class="inspect-card__meta">
					<span class="live-dot"></span>INSPECTED
				</span>
				<div class="workbench-controls__group">
					<span class="workbench-controls__label">Namespace:</span>
					<span class="hook-tally">@playform/hook-dsh-pinner-package</span>
					<span class="workbench-controls__label">Release:</span>
					<Badge Variant="outline">v{Versions.Release}</Badge>
				</div>
				<div class="workbench-controls__group">
					<span class="workbench-controls__label">Archetype:</span>
					<Badge Variant="outline">Hook</Badge>
					<span class="workbench-controls__label">Event:</span>
					<Badge>fs/observed</Badge>
					<span class="workbench-controls__label">Injects:</span>
					<Badge Variant="active">fs, pluginFactory</Badge>
				</div>
			</div>
		</section>

		<p class="page-hero__sub" style="margin-top: var(--space-md)">
			The profile wiring for this plugin - the bundles list, the patch entry and the restart -
			is on the <a href="/setup/">setup page</a>.
		</p>
		<section class="section">
			<SectionHeader Title="Where It Fits" Meta="FAMILY POSITION: A GOVERNANCE HOOK" />

			<div class="concept-list">
				<section class="concept-block" aria-labelledby="pinner-family-position">
					<div
						class="diagram-placeholder"
						data-diagram="family-position"
						data-diagram-status="implemented"
					>
						<p class="section-kicker">Diagram - Family position</p>
						<figure class="diagram-figure" set:html={FamilySvg} />
						<p>
							Show the pinner's relationship to <a href={Link(Links.OurRepo, "Classic/packages/plugin-dsh-factory/Source")}>plugin-dsh-factory</a>, hook-dsh-core, and
							the sibling package governor.</p>
						<p>Label the shared fs/observed seam.
						
						</p>
					</div>

					<h3 id="pinner-family-position" class="concept-block__title">
							<BrandIcon Name="info" Size="0.75em" />
						Family position
					</h3>

					<p class="page-hero__sub">
						<strong>{Families.PinnerPackage}</strong> is a hook child of the{" "}
						<a href={Link(Links.OurRepo, "Classic/packages/plugin-dsh-factory/Source")}><code>plugin-dsh-factory</code></a> service and the
						<code>hook-dsh-core</code> helpers.</p>
					<p class="page-hero__sub">It is a sibling of the package governor
						on the same <a href={Link(Links.DeepSeekHarness, "packages/fs/fs/src/index.ts")}><code>fs/observed</code></a> seam.
					
					</p>
				</section>

				<section class="concept-block" aria-labelledby="pinner-composition">
					<div
						class="diagram-placeholder"
						data-diagram="pin-then-bump-exact"
						data-diagram-status="implemented"
					>
						<p class="section-kicker">Diagram - Composition</p>
						<figure class="diagram-figure" set:html={PinSvg} />
						<p>
							Show ^0.3.4 -> pinner -> 0.3.4 -> governor update stage: nothing to do.</p>
						<p>
							Show the governor's chain pass separately, noting that it may still
							re-canonicalize chain pins.
						
						</p>
					</div>

					<h3 id="pinner-composition" class="concept-block__title">
							<BrandIcon Name="info" Size="0.75em" />
						Pin <ArrowIcon Direction="right" Tone="accent" /> bump-exact
					</h3>

					<p class="page-hero__sub">
						The pinner turns <code>^0.3.4</code> into <code>0.3.4</code>.</p>
					<p class="page-hero__sub">A fully pinned
						manifest leaves the governor's update stage nothing to do.</p>
					<p class="page-hero__sub">Its chain pass
						may still re-canonicalize chain pins.
					
					</p>
				</section>

				<section class="concept-block" aria-labelledby="pinner-keep-list">
					<div
						class="diagram-placeholder"
						data-diagram="keep-list-precedence"
						data-diagram-status="implemented"
					>
						<p class="section-kicker">Diagram - Policy precedence</p>
						<figure class="diagram-figure" set:html={KeepSvg} />
						<p>
							Show a keep-listed dependency bypassing prefix removal and retaining its
							authored range.
						</p>
					</div>

					<h3 id="pinner-keep-list" class="concept-block__title">
							<BrandIcon Name="info" Size="0.75em" />
						Keep-list wins
					</h3>

					<p class="page-hero__sub">
						The pinner's <a href={Link(Links.OurRepo, "Classic/packages/hook-dsh-pinner-package/Source/Function/Transform.ts")}><span class="file-mention"><BrandIcon Name="file-json" Size="0.9em" /><code>pin-policy.json</code></span></a> keep-list protects selected
						dependencies.</p>
					<p class="page-hero__sub">Their ranges remain exactly as authored.
					
					</p>
				</section>

				<section class="concept-block" aria-labelledby="pinner-ledger-independence">
					<div
						class="diagram-placeholder"
						data-diagram="independent-ledgers"
						data-diagram-status="implemented"
					>
						<p class="section-kicker">Diagram - Independent ledgers</p>
						<figure class="diagram-figure" set:html={LedgersSvg} />
						<p>
							Show pinner -&gt;{" "}
							<span class="log-chip"><BrandIcon Name="file-log" Size="0.9em" />pinner.log</span> and governor -&gt;{" "}
							<span class="log-chip"><BrandIcon Name="file-log" Size="0.9em" />governor.log</span> as separate
							paths.</p>
						<p>Mark activation as independent.
						
						</p>
					</div>

					<h3 id="pinner-ledger-independence" class="concept-block__title">
							<BrandIcon Name="info" Size="0.75em" />
						Separate ledgers and activation
					</h3>

					<p class="page-hero__sub">
						The pinner and governor use separate ledgers:
						<span class="log-chip"><BrandIcon Name="file-log" Size="0.9em" /><code>pinner.log</code></span> and{" "}
						<span class="log-chip"><BrandIcon Name="file-log" Size="0.9em" /><code>governor.log</code></span>. Activating either
						plugin never implies activation of the other.
					</p>
				</section>

				<section class="concept-block" aria-labelledby="pinner-injection">
					<div
						class="diagram-placeholder"
						data-diagram="injected-services"
						data-diagram-status="implemented"
					>
						<p class="section-kicker">Diagram - Injected services</p>
						<figure class="diagram-figure" set:html={InjectSvg} />
						<p>Show fs and pluginFactory as the pinner's two injected services.</p>
					</div>

					<h3 id="pinner-injection" class="concept-block__title">
							<BrandIcon Name="info" Size="0.75em" />
						A factory flavor
					</h3>

					<p class="page-hero__sub">
						The pinner declares
						<code>inject: ["fs", "pluginFactory"]</code>. It composes shared machinery
						with its own pinning logic.
					</p>
				</section>

				<section class="concept-block" aria-labelledby="pinner-factory-machinery">
					<div
						class="diagram-placeholder"
						data-diagram="factory-responsibilities"
						data-diagram-status="implemented"
					>
						<p class="section-kicker">Diagram - Factory machinery</p>
						<figure class="diagram-figure" set:html={FactoryRespSvg} />
						<p>
							Group the factory-provided responsibilities: gate, discovery, union
							keep-list, guarded write, refresh, continuation, effects, and schema.
						</p>
					</div>

					<h3 id="pinner-factory-machinery" class="concept-block__title">
							<BrandIcon Name="info" Size="0.75em" />
						Machinery supplied by the factory
					</h3>

					<p class="page-hero__sub">
						<a href={Link(Links.OurRepo, "Classic/packages/plugin-dsh-factory/Source")}><code>plugin-dsh-factory</code></a> supplies the gate, discovery, union
						keep-list, guarded write, refresh, continuation, effects, and schema.
					</p>
				</section>

				<section class="concept-block" aria-labelledby="pinner-core-helpers">
					<div
						class="diagram-placeholder"
						data-diagram="core-helpers"
						data-diagram-status="implemented"
					>
						<p class="section-kicker">Diagram - Core helpers</p>
						<figure class="diagram-figure" set:html={CoreHelpersSvg} />
						<p>
							Show hook-dsh-core supplying <a href={Link(Links.OurRepo, "Classic/packages/hook-dsh-core/Source/Function/Refusal.ts")}>the refusal guard</a> and suppression composer
							to the pinner.
						</p>
					</div>

					<h3 id="pinner-core-helpers" class="concept-block__title">
							<BrandIcon Name="info" Size="0.75em" />
						Helpers supplied by core
					</h3>

					<p class="page-hero__sub">
						<code>hook-dsh-core</code> supplies <a href={Link(Links.OurRepo, "Classic/packages/hook-dsh-core/Source/Function/Refusal.ts")}>the refusal guard</a> and the suppression
						composer.
					</p>
				</section>

				<section class="concept-block" aria-labelledby="pinner-owned-logic">
					<div
						class="diagram-placeholder"
						data-diagram="pinner-owned-logic"
						data-diagram-status="implemented"
					>
						<p class="section-kicker">Diagram - Local ownership</p>
						<figure class="diagram-figure" set:html={OwnedSvg} />
						<p>
							Show the pinner-owned boundary containing the range law, decode logic,
							and ledger strings.
						</p>
					</div>

					<h3 id="pinner-owned-logic" class="concept-block__title">
							<BrandIcon Name="info" Size="0.75em" />
						Logic owned by this bundle
					</h3>

					<p class="page-hero__sub">
						This bundle owns the range law, decode logic, and every ledger string.
					</p>
				</section>

				<section class="concept-block" aria-labelledby="pinner-direct-govern">
					<div
						class="diagram-placeholder"
						data-diagram="direct-govern-entry"
						data-diagram-status="implemented"
					>
						<p class="section-kicker">Diagram - Direct governance</p>
						<figure class="diagram-figure" set:html={DirectGovernSvg} />
						<p>
							Show apply-time registration with Factory.RegisterGovern.</p>
						<p>Then show the
							raw-write tool's per-call govern selection reaching the same pin pass
							through <a href={Link(Links.OurRepo, "Classic/packages/plugin-dsh-factory/Source/Function/Govern.ts")}>Factory.Govern</a>, alongside the fs/observed event path.
						
						</p>
					</div>

					<h3 id="pinner-direct-govern" class="concept-block__title">
							<BrandIcon Name="info" Size="0.75em" />
						A direct governance entry point
					</h3>

					<p class="page-hero__sub">
						Besides the <a href={Link(Links.DeepSeekHarness, "packages/fs/fs/src/index.ts")}><code>fs/observed</code></a> event path, the chain pass registers
						with the factory's direct-govern registry during <code>apply()</code>:
						<code>Factory.RegisterGovern("package.json", "pin", ...)</code>.
					</p>

					<p class="page-hero__sub">
						The raw-write tool's per-call govern selection can drive the same pin pass
						directly through
						<a href={Link(Links.OurRepo, "Classic/packages/plugin-dsh-factory/Source/Function/Govern.ts")}><code>Factory.Govern</code></a>.
					</p>
				</section>
			</div>
		</section>

		<section class="section">
			<SectionHeader Title="In the DeepSeek Harness" Meta="WHERE THE PINNER OPERATES" />
			<Seams
				Seams={[
					{
						Seam: "fs/observed - the file observation event",
						What: "The pinner's one listener hook: the same event the governor reacts to, fired by the tool layer only for every harness write/edit - so the pin happens after content is on disk, on every write path.",
						Outcome:
							"Static versions become the default outcome of every write, invisibly.",
					},
					{
						Seam: "ctx.fs - the filesystem service (dsh-fs)",
						What: "The pin pass reads the file via ctx.fs.readText and writes via [the factory's guarded write](Ours:Classic/packages/plugin-dsh-factory/Source/Function/Write.ts) (replaceIfVersion + the P4 sandbox fence), with an explicit sandbox policy because the plugin's own exclude list IS its fence.",
						Outcome: "No clobber, no recursion; the re-emit re-enters as a no-op.",
					},
					{
						Seam: "The keep-list policy sidecar",
						What: "ResolvePolicy builds the union keep-list from every readable [pin-policy.json](Ours:Classic/packages/hook-dsh-pinner-package/Source/Function/Transform.ts): global policyFile → the file's own directory → registry-adjacent; the P3 chain-keys interlock protects the governor's chain pins from ever being stripped.",
						Outcome: "Ranges the author marked as intentional stay exactly as written.",
					},
					{
						Seam: "The ledger / session",
						What: "A separate ledger (pinner.log) records activation, exclusions, non-JSON skips, refusals and every pin result; the activation line is written by apply().",
						Outcome:
							'"Did it activate" is answerable from the ledger alone - and never implies the governor\'s ledger.',
					},
				]}
			/>
		</section>

		<section class="section">
			<SectionHeader Title="The Problem" Meta="WHY THE PINNER EXISTS" />
			<p class="page-hero__sub">
				Ranged versions make builds drift: <code>"^0.3.4"</code> today is
				<code>"0.3.5"</code> next week.</p>
			<p class="page-hero__sub">Teams that want reproducible installs want static
				versions - but writing them by hand (or remembering to) is exactly the kind of
				discipline an agent workflow loses.</p>
			<p class="page-hero__sub">The pinner makes static versions the default
				outcome of every write, invisibly.
			
			</p>
		</section>

		<section class="section">
			<SectionHeader
				Title="How It Works"
				Meta="THE PIPELINE P = REWRITE ∘ PIN ∘ RESOLVE ∘ DECODE"
			/>
			<div class="code-block">{Pipeline.join("\n")}</div>
			<p class="page-hero__sub" style="margin-top: var(--space-md)">
				<strong>The range law</strong> (the transform, exactly) - for each dependency value
				(after the keep-list gate), in order:
			</p>
			<div class="table-wrap">
				<table class="table">
					<thead>
						<tr>
							<th>#</th>
							<th>Condition</th>
							<th>Action</th>
							<th>Examples</th>
						</tr>
					</thead>
					<tbody>
						{RangeLaw.map((Row) => (
							<tr>
								<td>
									<strong>{Row.N}</strong>
								</td>
								<td>{Row.Condition}</td>
								<td>{Row.Action}</td>
								<td>{Row.Examples}</td>
							</tr>
						))}
					</tbody>
				</table>
			</div>
			<div class="concept-list">
				<section class="concept-block" aria-labelledby="pinner-idempotence">
					<div
						class="diagram-placeholder"
						data-diagram="idempotence"
						data-diagram-status="implemented"
					>
						<p class="section-kicker">Diagram - Idempotence</p>
						<figure class="diagram-figure" set:html={IdemSvg} />
						<p>
							Show a second write of an already-pinned <span class="file-mention"><BrandIcon Name="file-json" Size="0.9em" />package.json</span> passing the range
							law untouched - the no-op rewrite P(P(c)) = P(c).
						</p>
					</div>

