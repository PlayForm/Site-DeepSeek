---
import Base from "@Layout/Base.astro";
import Badge from "@Component/Badge.astro";
import BrandIcon from "@Component/BrandIcon.astro";
import Card from "@Component/Card.astro";
import CodeBlock from "@Component/CodeBlock.astro";
import Concept from "@Component/Concept.astro";
import SectionHeader from "@Component/SectionHeader.astro";
import Seams from "@Component/Seams.astro";
import Terminal from "@Component/Terminal.astro";
import { Counts, Versions, Families } from "@Library/Content";
import { Link, Links } from "@Library/Links";
import { Mention } from "@Library/FileIcon";

// The five listeners, from SCHEME.md section 1 (the plan's listener table,
// verbatim facts). All plain ctx.on, all fail-open, all next()-first; plus
// the factory's loader/volatile-update refresh (P10) registered by the
// State builder.
const Listeners = [
	{
		N: "1",
		Event: "tools/post-execute",
		Mode: "waterfall, plain (AFTER the ccr { prepend: true } listener)",
		Purpose: "detect + count + tier-1 note + tier-2 strike accounting",
	},
	{
		N: "2",
		Event: "tools/pre-execute",
		Mode: "waterfall, plain, registered unconditionally, no-op unless enforce \u2260 off",
		Purpose: "tier-3 deny ({kind: 'deny', reason})",
	},
	{
		N: "3",
		Event: "agent/pre-step",
		Mode: "plain",
		Purpose: "the user-message reset of the per-agent chain (the RTR precedent)",
	},
	{
		N: "4",
		Event: "system-prompt/assemble",
		Mode: "waterfall, after next(), append-only",
		Purpose: "the tier-2 persistent section",
	},
	{
		N: "5",
		Event: "tools/change",
		Mode: "emit",
		Purpose: "tier-2 section-cache invalidation",
	},
];

// The four tiers, from the README's table (verbatim facts).
const Tiers = [
	{
		Tier: "0",
		Channel: "Ledger only",
		When: "every detected offense, immediately",
		Sees: "nothing (the durable log line)",
	},
	{
		Tier: "1",
		Channel: "tools/post-execute additionalContexts",
		When: "a class reaches threshold (3) strikes within window (8) judged calls, cooldown (10) between notes",
		Sees: "a labeled notice (source {kind: 'tool-coach', form: 'notice', summary: '<tool> <class> \u00d7 <n>'}) naming the correct tool with its LIVE registry description",
	},
	{
		Tier: "2",
		Channel: "system-prompt/assemble section",
		When: "escalateThreshold (6) offenses since the last note",
		Sees: "the persistent \"Tool discipline\" section: 3 fixed rules + a live-fetched tool table (\u2264 maxSectionTools 8 rows); off again after cleanWindow (12) clean calls",
	},
	{
		Tier: "3",
		Channel: "tools/pre-execute deny",
		When: "enforce \u2260 off, class matches, enforceThreshold (4) strikes since the last note",
		Sees: "the call is blocked; the deny reason IS the lesson (\"...use the edit tool...\")",
	},
];

// Representative pattern rows, from Variable/Patterns.ts (24 built-in
// DEFAULT_PATTERNS; the user's patternTable rows are APPENDED and may not
// duplicate a built-in pattern - fail-loud).
const Patterns = [
	{ Pattern: "sed -i (including -i.bak)", Class: "write", Tool: "edit" },
	{ Pattern: "perl -pi / perl ... -i", Class: "write", Tool: "edit" },
	{ Pattern: "awk redirecting anywhere but /dev/null", Class: "write", Tool: "edit" },
	{ Pattern: "echo/printf with a file redirect tail", Class: "write", Tool: "edit" },
	{ Pattern: "tee with a file operand (tee -a appends)", Class: "write", Tool: "edit" },
	{ Pattern: "heredoc-to-file (<< MARKER > file)", Class: "write", Tool: "edit" },
	{ Pattern: "python -c writing files (open 'w'/'a', .write, shutil, exec/eval)", Class: "write", Tool: "edit" },
	{ Pattern: "truncate -s / dd of= (full replacement)", Class: "write", Tool: "write" },
	{ Pattern: "cat/less/more/nl/od/xxd reading file content", Class: "read", Tool: "read" },
	{ Pattern: "head/tail slices", Class: "read", Tool: "read" },
	{ Pattern: "sed -n slices", Class: "read", Tool: "read" },
	{ Pattern: "terminal grep of the family's ccr.db / sqlite3 on the ledgers", Class: "search", Tool: "ccr_retrieve" },
	{ Pattern: "grep/egrep/rg/ack/ag/sift", Class: "search", Tool: "grep" },
	{ Pattern: "find with a name/path/size/newer predicate", Class: "search", Tool: "glob" },
	{ Pattern: "ls -R / tree / find -type f listing", Class: "discovery", Tool: "glob" },
	{ Pattern: "pwd/cd in a bash call", Class: "discovery", Tool: "working_directory" },
	{ Pattern: "curl/wget", Class: "discovery", Tool: "web_fetch" },
	{ Pattern: "nohup/screen/tmux/disown", Class: "control", Tool: "run_in_background" },
	{ Pattern: "cron/at/launchctl", Class: "control", Tool: "schedule_create" },
	{ Pattern: "npm install -g / pnpm add -g / yarn global add", Class: "control", Tool: "plugin_manager" },
];

// The config schema table, from the shipped Variable/Config.ts defaults
// (the plan's section 3.4 schema, verbatim). EVERY cell is volatile - a
// flip lands on the next judged call.
const Config = [
	{
		Field: "logFile",
		Type: "string",
		Default: "~/.dsh/hook-dsh-tool-coach.log",
		Meaning: "the coach's ledger, SEPARATE from the family's logs (one log per module)",
	},
	{
		Field: "enabled",
		Type: "boolean",
		Default: "true",
		Meaning: "the MASTER switch, distinct from the shared log cell (which governs only the durable ledger file)",
	},
	{
		Field: "judgeTools",
		Type: "string[]",
		Default: "[bash, pwsh]",
		Meaning: "the terminal tools judged; the dedicated tools are never judged",
	},
	{
		Field: "threshold",
		Type: "number",
		Default: "3",
		Meaning: "tier-1 strikes per class within the window",
	},
	{
		Field: "window",
		Type: "number",
		Default: "8",
		Meaning: "the sliding window of judged calls (counting in judged calls; per-agent, keyed on the Agent object)",
	},
	{
		Field: "cooldown",
		Type: "number",
		Default: "10",
		Meaning: "judged calls between tier-1 notes",
	},
	{
		Field: "escalateThreshold",
		Type: "number",
		Default: "6",
		Meaning: "total offenses since the last note that turn on the tier-2 section",
	},
	{
		Field: "cleanWindow",
		Type: "number",
		Default: "12",
		Meaning: "consecutive clean judged calls that clear the tier-2 section",
	},
	{
		Field: "enforce",
		Type: "'off' | 'write' | 'all'",
		Default: "off",
		Meaning: "tier-3: write denies write-class only, all adds read and search; discovery and control are NEVER denied",
	},
	{
		Field: "enforceThreshold",
		Type: "number",
		Default: "4",
		Meaning: "per-class strikes since the last note that arm the tier-3 deny",
	},
	{
		Field: "exemptPatterns",
		Type: "string[]",
		Default: "DEFAULT_EXEMPTS",
		Meaning: "the legitimate-bash boundary, matched per pipeline anchored at the head (an exempt head dominates its pipe)",
	},
	{
		Field: "patternTable",
		Type: "row[]",
		Default: "DEFAULT_PATTERNS (24 rows)",
		Meaning: "the regression rows (pattern, class, tool, optional note); user rows are APPENDED and may not duplicate a built-in pattern - fail-loud",
	},
	{
		Field: "notes",
		Type: "object",
		Default: "{ first, persistent, denied }",
		Meaning: "the three coaching templates (volatile object, plain leaves - one template edit commits one update)",
	},
	{
		Field: "fetchLive",
		Type: "boolean",
		Default: "true",
		Meaning: "the live tool-table fetch through ctx.tools.schemas(); false is the escape hatch (static only, no failure line)",
	},
	{
		Field: "maxSectionTools",
		Type: "number",
		Default: "8",
		Meaning: "the tier-2 tool-table row cap (1-24; cap-24 fills mapped tools then alphabetical top-up)",
	},
	{
		Field: "sectionTtl",
		Type: "number",
		Default: "20",
		Meaning: "judged calls the tier-2 section text is cached for; rebuilt also on tools/change",
	},
];

// The tier-1 note (NOTE_FIRST, Variable/Notes.ts) with the placeholders
// filled from the live registry values - the note the model sees after the
// fourth same-class offense.
const NoteFirst = [
	"Tool-coach note (strike 4, read-class bash pattern):",
	"- \"cat config.json\" is forbidden for file content. Use the read tool instead.",
	"- read: Read a UTF-8 text file and return line-numbered content. (key parameter: file_path).",
	"- terminal edits produce no fs/observed event, so the governor/pinner/normalize plugins never see them.",
	"The terminal runs COMMANDS (builds, tests, git, package managers); the tools handle CONTENT.",
];

// The tier-2 persistent section (NOTE_PERSISTENT) with the placeholders
// filled and a live-fetched tool table (maxSectionTools 8; five mapped rows
// shown). The em dashes are part of the template.
const NotePersistent = [
	"Tool discipline (persistent, from tool-coach):",
	"- NEVER read file content through the terminal: \"cat config.json-style\" commands (cat/head/tail/sed -n/grep <file>) are forbidden \u2014 use the read and grep/glob tools.",
	"- NEVER mutate file content through the terminal: sed -i-style commands (sed -i/awk/echo >/tee/heredoc >) are forbidden \u2014 use the write and edit tools. terminal edits produce no fs/observed event, so the governor/pinner/normalize plugins never see them.",
	"- The terminal is for COMMANDS (builds, tests, git, package managers, process/service control).",
	"Mapped tools (live from the harness registry):",
	"| tool | purpose |",
	"| --- | --- |",
	"| read | Read a UTF-8 text file and return line-numbered content. |",
	"| edit | Edit an existing UTF-8 text file by replacing literal text. |",
	"| write | Create or fully replace a UTF-8 text file. |",
	"| grep | Search file contents with a ripgrep regular expression. |",
	"| glob | Find files, not directories, whose paths match a glob pattern, including hidden and ignored files. |",
];

// The tier-3 deny reason (NOTE_DENIED) with the placeholders filled - the
// deny reason IS the lesson.
const NoteDenied = [
	"Blocked by tool-coach: \"echo x > notes.md\" is forbidden (write-class bash pattern). Use the edit tool for this operation instead \u2014 Edit an existing UTF-8 text file by replacing literal text. (key parameter: old_string). Then rerun only the legitimate command parts (build/test/git), if any.",
];

// The In Action ledger excerpt: the tier-0 form (the operative plan's
// canonical string) plus the smoke battery's byte-exact lines (R2, R3, R4).
const LedgerExcerpt = [
	"offense <tool> <class> <pattern>",
	"strike 4/3 bash read -> note read",
	"escalated persistent section (8 strikes)",
	"persistent section cleared (12 clean calls)",
];

// The ten ledger strings, from the operative plan's canonical list
// (Documentation/Plans/TOOL-COACH-OPERATIVE-PLAN.md §4.2, byte-exact; the
// module composes these, the durable file carries them in [ISO] form with
// the hook-dsh-tool-coach: prefix).
const LedgerStrings = [
	"offense <tool> <class> <pattern>",
	"strike <n>/<threshold> <tool> <class> -> note <tool>",
	"cooldown suppressed <n> <tool> <class>",
	"escalated persistent section (<strikes> strikes)",
	"persistent section cleared (<clean> clean calls)",
	"section rebuilt (ttl <calls> | tools/change)",
	"denied <tool> <class> <pattern> -> use <tool>",
	"exempt <tool> <pattern-head>",
	"schema fetch failed -> static fallback",
	"disabled (enabled=false)",
];

const Related = [
	{
		Name: "plugin-dsh-factory",
		Desc: "The family's furnace: the Schema helper composing this module's NON-MANIFEST config schema and the loader/volatile-update refresh the State builder registers.",
	},
	{
		Name: "hook-dsh-ccr",
		Desc: "The sibling on the same waterfall: the coach's post-execute listener registers AFTER the ccr { prepend: true } listener, so it observes the compressed result - and its own notes never replace content.",
	},
	{
		Name: "hook-dsh-package-governor",
		Desc: "The governed writes this coach protects: terminal file edits are invisible to the fs/observed chain the governor depends on - the coach closes that gap by teaching, not by rewriting.",
	},
	{
		Name: "hook-dsh-package-pinner",
		Desc: "The pinner sees only tool-layer writes; a sed -i edit bypasses it entirely - the coach's tier ladder is the countermeasure.",
	},
	{
		Name: "hook-dsh-normalize-dash",
		Desc: "The normalize family's file writes go through the tool layer; terminal edits never trigger them - the coach's TRACEABILITY line says exactly that.",
	},
];
---

<Base
	Title="hook-dsh-tool-coach - DSH Family @ PlayForm"
	Description={`${Families.Coach} - the terminal coach of the DeepSeek Harness. Judges EVERY bash/pwsh call through a four-tier ladder - tier-0 ledger lines, tier-1 live-fetched coaching notes, tier-2 a persistent system-prompt discipline section, tier-3 an optional hard deny - teaching the model to stop using the terminal for file content.`}
>
	<main class="container container--main">
		<div class="eyebrow-row">
			<Badge Variant="primary" Dot>
				PLUGIN DETAIL
			</Badge>
			<Badge>ROLE: COACH</Badge>
			<Badge>
				<BrandIcon Name="terminal" Size="0.8em" /> GATE: terminal tool calls (bash, pwsh)
			</Badge>
		</div>

		<section class="page-hero">
			<h1 class="page-hero__title">hook-dsh-tool-coach</h1>
			<p class="page-hero__sub">
				{Families.Coach} &bull; <BrandIcon Name="deepseek" /> <em>The DeepSeek Harness
				Plugin Family for PlayForm.</em>
			</p>
			<p class="page-hero__sub">
				The <strong>terminal coach</strong> of the
				DeepSeek Harness - a plugin that teaches the model to stop using the terminal
				for file content.
			</p>
			<p class="page-hero__sub">
				The one-sentence rule it enforces: <strong>the terminal runs
				COMMANDS (builds, tests, git, package managers); the tools handle
				CONTENT.</strong>
			</p>
			<p class="page-hero__sub">
				It watches the terminal tool calls (<code>bash</code>, <code>pwsh</code>; the dedicated tools are NEVER judged).
				It runs a four-tier coaching ladder that escalates from silent observation to a persistent system-prompt section to an optional hard deny.
			</p>
			<p class="page-hero__sub">Why it exists: terminal file edits are invisible to the
				plugin system - the harness's <a href={Link(Links.DeepSeekHarness, "packages/fs/fs/src/index.ts")}><code>fs/observed</code></a> chain
				(the trigger of the governor, the pinner and the normalize plugins) fires ONLY
				on tool-layer writes, so a <code>sed -i</code>/<code>python -c</code> edit
				bypasses all of them.
			</p>
			<p class="page-hero__sub">The coach goes where that regression flows.</p>
			<p class="page-hero__sub">A NON-MANIFEST factory flavor: the family's furnace
				composes the schema and the volatile refresh; this package owns its schema and
				its strings.
			</p>
		</section>

		<section class="section">
			<div class="snippet-list">
				<Terminal Pkg="hook-dsh-tool-coach" Rail />
			</div>
			<div class="inspect-card">
				<span class="inspect-card__meta">
					<span class="live-dot"></span>INSPECTED
				</span>
				<div class="workbench-controls__group">
					<span class="workbench-controls__label">Namespace:</span>
					<span class="hook-tally">@playform/hook-dsh-tool-coach</span>
					<span class="workbench-controls__label">Release:</span>
					<Badge Variant="outline">v{Versions.Release}</Badge>
				</div>
				<div class="workbench-controls__group">
					<span class="workbench-controls__label">Archetype:</span>
					<Badge Variant="outline">Hook</Badge>
					<span class="workbench-controls__label">Events:</span>
					<Badge>tools/post-execute</Badge>
					<Badge>tools/pre-execute</Badge>
					<Badge>system-prompt/assemble</Badge>
					<span class="workbench-controls__label">Injects:</span>
					<Badge Variant="active">pluginFactory, tools</Badge>
				</div>
			</div>
		</section>

		<p class="page-hero__sub" style="margin-top: var(--space-md)">
			The profile wiring for this plugin - the bundles list, the patch entry and the restart -
			is on the <a href="/setup/">setup page</a>.
		</p>
		<section class="section">
			<SectionHeader Title="Where It Fits" Meta="FAMILY POSITION: A GUARDIAN HOOK" />
			<div class="concept-list">
				<Concept
					ID="coach-family-position"
					Title="The family position"
					Diagram={`${Families.Coach} as a hook child of the plugin-dsh-factory service - no hook children of its own - a NON-MANIFEST module (no fs/observed Wire, no Attach, no factory Schema): the coach owns its schema and its strings. ` + `apply returns NOTHING; the state is exposed via ctx.__hookDshToolCoachState.`}
				>
					<p>
						A hook child of the <strong><a href={Link(Links.OurRepo, "Classic/packages/plugin-dsh-factory/Source")}>plugin-dsh-factory</a></strong> service ({Families.Coach}).
						A NON-MANIFEST module (no fs/observed Wire, no Attach, no factory Schema) -
						the coach owns its schema and its strings.
					</p>
					<p>
						<code>apply</code> returns NOTHING; the state is exposed via{" "}
						<code>ctx.__hookDshToolCoachState</code>.{" "}
						<code>inject: ["pluginFactory", "tools"]</code>.
					</p>
				</Concept>
			</div>
			<div class="table-wrap">
				<table class="table">
					<thead>
						<tr>
							<th>#</th>
							<th>Event</th>
							<th>Mode</th>
							<th>Purpose</th>
						</tr>
					</thead>
					<tbody>
						{Listeners.map((Row) => (
							<tr>
								<td>
									<strong>{Row.N}</strong>
								</td>
								<td set:html={Mention(Row.Event)} />
								<td>{Row.Mode}</td>
								<td>{Row.Purpose}</td>
							</tr>
						))}
					</tbody>
				</table>
			</div>
			<div class="concept-list">
				<Concept
					ID="coach-ccr-ordering"
					Title="Sharing the waterfall with the ccr hook, safely"
					Diagram={"The coach's tools/post-execute listener registering plain - AFTER the ccr { prepend: true } listener - so it observes the (possibly compressed) result; its tier-1 notes are append-only additionalContexts and the tier-2 section is append-only, touching nothing else (PTC + structured-output preserved). " + "Order safety: the ccr {<<<CCR:} marker guard makes any load order safe, and the coach never replaces content."}
				>
					<p>
						The coach's <code>tools/post-execute</code> listener registers plain.
						It registers AFTER the <a href="/plugins/hook-dsh-ccr/">ccr</a> <code>{"{ prepend: true }"}</code> listener.
						So it observes the (possibly compressed) result.
					</p>
					<p>
						The <code>&lt;&lt;&lt;CCR:</code> marker guard makes any load order safe.
						The coach never replaces content.
						Its tier-1 notes are append-only <code>additionalContexts</code>.
						The tier-2 section is append-only (PTC + structured-output preserved).
					</p>
				</Concept>
				<Concept
					ID="coach-non-manifest"
					Title="Machinery-wise it is a NON-MANIFEST factory flavor"
					Diagram={'inject: ["pluginFactory", "tools"] - the config schema composed by the factory\'s standalone Schema(false, {...}) helper (the NON-MANIFEST posture: the coach hooks the tool waterfalls, not fs/observed, so the schema never advertises updateCooldownMs/mutationTools/policyFile/exclude) - plus the factory\'s loader/volatile-update refresh (P10) registered by the State builder.'}
				>
					<p>
						<code>inject: ["pluginFactory", "tools"]</code> - the config schema is composed by the factory's standalone{" "}
						<a href={Link(Links.OurRepo, "Classic/packages/plugin-dsh-factory/Source")}><code>{"Schema(false, {...})"}</code></a> helper.
						The NON-MANIFEST posture: the coach hooks the tool waterfalls, not <code>fs/observed</code>.
						So the schema never advertises updateCooldownMs/mutationTools/policyFile/exclude - machinery the module has none of.
					</p>
					<p>
						Plus the factory's <code>loader/volatile-update</code> refresh (P10) registered by the State builder.
						Every knob is volatile - hot-edited without remounting.
						A flip lands on the next judged call.
					</p>
				</Concept>
			</div>
		</section>

		<section class="section">
			<SectionHeader Title="In the DeepSeek Harness" Meta="WHERE THE COACH OPERATES" />
			<Seams
				Seams={[
					{
						Seam: "tools/post-execute - the detection listener",
						What: "Listener 1 ([tools/post-execute](Harness:docs/subsystems/tools.md)): per judged terminal call - normalize, classify, exempt override, count - logging every offense (tier 0) and firing the tier-1 note through additionalContexts when a class crosses the threshold.",
						Outcome:
							"The regression is counted where it flows; the dedicated tools are never judged.",
					},
					{
						Seam: "tools/pre-execute - the tier-3 deny",
						What: "Listener 2 ([tools/pre-execute](Harness:docs/subsystems/tools.md)), registered unconditionally and a no-op unless enforce \u2260 off: per-class strikes since the last note crossing enforceThreshold return {kind: 'deny', reason} - the reason being the NOTE_DENIED text.",
						Outcome:
							"The denied call is blocked and the deny reason IS the lesson; discovery and control are NEVER denied.",
					},
					{
						Seam: "system-prompt/assemble - the tier-2 section",
						What: "Listener 4, after next(), append-only: when the escalation threshold is crossed it appends ONE section ({name: 'hook-dsh-tool-coach', text}) to next()'s assembly - touching nothing else, PTC + structured-output preserved. " + "The text is cached for sectionTtl judged calls and invalidated on tools/change.",
						Outcome:
							"The persistent \"Tool discipline\" section: 3 fixed rules + the live-fetched tool table.",
					},
					{
						Seam: "agent/pre-step + tools/change",
						What: "Listener 3 ([agent/pre-step](Harness:docs/event-producer-consumer.md)) resets the per-agent chain with the user message (the repeat-tool-reminder precedent); listener 5 (tools/change emit) invalidates the tier-2 section cache so the tool table rebuilds.",
						Outcome:
							"Counting is per-agent; the section never shows a stale tool table.",
					},
					{
						Seam: "ctx.tools.schemas() - the live fetch",
						What: "The dynamic instruction engine fetches each mapped tool's LIVE registry data through [ctx.tools.schemas()](Harness:docs/subsystems/tools.md) (the same way the model itself is given tools): the name, the FIRST SENTENCE of the description (\u2264 120 chars, parenthesis-aware) and the primary parameter key (parameters.properties[0]). " + "Tier 1/3 fetch per note; tier 2 caches per sectionTtl.",
						Outcome:
							"Every note names the correct tool with its live description; any fetch failure degrades to the static STATIC_TOOL_LINES table and logs schema fetch failed -> static fallback - a note never fails a waterfall.",
					},
					{
						Seam: "loader/volatile-update - the volatile refresh",
						What: "EVERY knob of the config schema is volatile: the factory's State builder registers the loader/volatile-update listener and refreshes the mapped State fields IN PLACE, so a flip (enabled, enforce, threshold, fetchLive, maxSectionTools, sectionTtl, ...) takes effect on the next judged call.",
						Outcome: "No remounting; the smoke asserts the flip lands live.",
					},
					{
						Seam: "The ledger / session",
						What: "One log per module - logFile (default ~/.dsh/hook-dsh-tool-coach.log) - recording the ten byte-exact strings in [ISO] form; apply returns NOTHING, so 'did it activate' is answerable from the ledger and the state attachment alone.",
						Outcome:
							"The coaching state is discoverable from the ledger alone.",
					},
				]}
			/>
		</section>

		<section class="section">
			<SectionHeader Title="The four tiers" Meta="THE COACHING LADDER" />
			<div class="concept-list">
				<Concept
					ID="coach-tiers"
					Title="From silent observation to the optional hard deny"
					Diagram="Counting in judged calls, per-agent (a WeakMap keyed on the Agent object): tier 0 logs every offense; tier 1 notes at the threshold with the cooldown; tier 2 turns on the persistent section at the escalation threshold and clears after the clean window; tier 3 denies at the enforce threshold - off by default (enforce: 'off')."
				>
					<p>
						Tier 3 is off by default (<code>enforce: 'off'</code>).
						<code>write</code> denies only write-class segments.
						<code>all</code> adds read and search.
					</p>
					<p>
						Discovery and control are <strong>never denied</strong>, even at <code>all</code>.
						Flagging them hard would dilute the write/read signal.
					</p>
				</Concept>
			</div>
			<div class="table-wrap">
				<table class="table">
					<thead>
						<tr>
							<th>Tier</th>
							<th>Channel</th>
							<th>When it fires</th>
							<th>What the model sees</th>
						</tr>
					</thead>
					<tbody>
						{Tiers.map((Row) => (
							<tr>
								<td>
									<strong>{Row.Tier}</strong>
								</td>
								<td set:html={Mention(Row.Channel)} />
								<td>{Row.When}</td>
